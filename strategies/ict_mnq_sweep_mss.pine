//@version=6
// =============================================================================
// ICT MNQ — Liquidity Sweep → MSS → Displacement  (5m execution, HTF filtered)
//
// A STRATEGY, not an indicator: it places real orders so TradingView's
// Strategy Tester produces a P&L you can audit.
//
// The sequence it trades:
//   1. SWEEP        price raids a live liquidity pool (PDH/PDL, Asia or London
//                   range extreme, or an untaken swing) and CLOSES back inside.
//   2. MSS          within a few bars a candle CLOSES through the swing that
//                   stood before the sweep, with a displacement body.
//   3. ENTRY        on that confirmation. Optionally wait for an FVG retrace.
//   4. RISK         ATR stop capped by the sweep extreme, fixed-R target,
//                   optional breakeven and partial, flat before the close.
//
// Defaults come from a study on MNQ/NQ/ES/MES/QQQ/SPY (see README). Read the
// "What the research actually said" section there before sizing up — the
// honest summary is that the HTF direction filter and the session filter are
// the parts that repeated across markets, and the entry timing was the single
// biggest lever. Everything here is configurable so you can verify it yourself.
// =============================================================================

strategy("ICT MNQ — Sweep → MSS → Displacement", overlay = true,
     initial_capital        = 25000,
     default_qty_type       = strategy.fixed,
     default_qty_value      = 1,
     pyramiding             = 0,
     calc_on_every_tick     = false,
     commission_type        = strategy.commission.cash_per_order,
     commission_value       = 0.52,      // ≈ $1.04 round turn on 1 MNQ
     slippage               = 1,         // ticks; MNQ tick = 0.25 pt = $0.50
     max_boxes_count        = 200, max_lines_count = 200, max_labels_count = 200)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
var string G_SESS  = "Session"
var string G_HTF   = "Higher-Timeframe Filter"
var string G_STRUC = "Structure & Sweep"
var string G_ENTRY = "Entry"
var string G_RISK  = "Risk & Targets"
var string G_SIZE  = "Position Sizing"
var string G_UI    = "Display"

sessTz       = input.string("America/New_York", "Session Timezone",              group = G_SESS)
useSession   = input.bool(true,  "Only take setups inside the session",          group = G_SESS)
tradeSession = input.session("0930-1330", "Entry Window",                        group = G_SESS,
     tooltip = "09:30-13:30 ET. The NY PM block after 13:30 was the weakest slice on every market tested.")
flatten      = input.bool(true,  "Flatten before the close",                     group = G_SESS)
flatTime     = input.session("1555-1600", "Flatten Window",                      group = G_SESS)

useHTF       = input.bool(true,  "Require higher-timeframe agreement",           group = G_HTF,
     tooltip = "The single most consistent filter in testing: counter-trend setups lost on 5 of 6 markets.")
htf1         = input.timeframe("30", "HTF #1",                                   group = G_HTF)
htf2         = input.timeframe("60", "HTF #2",                                   group = G_HTF)
htfLook      = input.int(3, "HTF candles compared for a break", minval = 1,      group = G_HTF)
htfConfirmed = input.bool(true,  "Use only closed HTF candles",                  group = G_HTF,
     tooltip = "Leave ON. Off reads the live HTF candle — no future data, but the state can flip mid-candle.")
useHTF3      = input.bool(false, "Also require a third HTF (4H / Daily)",        group = G_HTF,
     tooltip = "Default OFF on purpose: 4H and Daily alignment did NOT improve results in testing.")
htf3         = input.timeframe("240", "HTF #3",                                  group = G_HTF)

pivotLen     = input.int(1,  "Swing Pivot Strength", minval = 1, maxval = 5,     group = G_STRUC,
     tooltip = "1 = short-term structure. Higher values gave fewer and worse setups in testing.")
poolBars     = input.int(120, "Liquidity Pool Memory (bars)", minval = 10,       group = G_STRUC)
usePD        = input.bool(true, "Use prior-day high/low as pools",               group = G_STRUC)
useAsiaLon   = input.bool(true, "Use Asia / London range extremes as pools",     group = G_STRUC)
asiaSess     = input.session("1800-0200", "Asia Range",                          group = G_STRUC)
lonSess      = input.session("0200-0800", "London Range",                        group = G_STRUC)
minSweepAtr  = input.float(0.0, "Min Sweep Depth (× ATR)", minval = 0, step=0.1, group = G_STRUC)
maxSweepAtr  = input.float(3.0, "Max Sweep Depth (× ATR)", minval = 0.5, step=0.5, group = G_STRUC)
mssWindow    = input.int(6,  "Max bars from sweep to MSS", minval = 1,           group = G_STRUC)
dispAtr      = input.float(0.25, "Min Displacement Body (× ATR)", minval = 0, step = 0.05, group = G_STRUC)

entryMode    = input.string("On MSS close", "Entry Mode", options = ["On MSS close", "FVG limit", "FVG limit, else market"], group = G_ENTRY,
     tooltip = "Testing was clear and it contradicts the usual teaching: waiting for the FVG retrace only filled the setups that stalled. 'On MSS close' produced 2.5x the trades and a better factor.")
fvgWait      = input.int(6,  "Bars to wait for the FVG fill", minval = 1,        group = G_ENTRY)
ceFrac       = input.float(0.0, "FVG Entry Depth (0 = near edge, 0.5 = CE, 1 = far edge)", minval = 0, maxval = 1, step = 0.1, group = G_ENTRY)
useIfvg      = input.bool(true, "Allow inverted-FVG entries",                    group = G_ENTRY)
maxPerDay    = input.int(2,  "Max entries per day", minval = 1,                  group = G_ENTRY)

atrLen       = input.int(14, "ATR Length", minval = 2,                           group = G_RISK)
stopAtr      = input.float(1.0, "Stop Distance (× ATR)", minval = 0.2, step=0.05,group = G_RISK,
     tooltip = "Measured MAE after a valid setup averaged ~1.5 ATR, so anything under ~0.75 ATR sits inside the noise.")
capBySweep   = input.bool(true, "Never place the stop beyond the sweep extreme", group = G_RISK)
rrTarget     = input.float(2.0, "Target (R multiple)", minval = 0.5, step = 0.25,group = G_RISK)
useLiqTarget = input.bool(false, "Target opposing liquidity instead",            group = G_RISK)
minRR        = input.float(1.5, "  Liquidity target: minimum R", minval=0.5, step=0.25, group = G_RISK)
maxRR        = input.float(4.0, "  Liquidity target: maximum R", minval=1.0, step=0.5,  group = G_RISK)
beTrigger    = input.float(1.0, "Move stop to breakeven at (R, 0 = off)", minval = 0, step = 0.5, group = G_RISK)
partialAt    = input.float(0.0, "Take partial at (R, 0 = off)", minval = 0, step = 0.5, group = G_RISK)
partialPct   = input.int(50, "  Partial size (%)", minval = 10, maxval = 90,     group = G_RISK)
maxHold      = input.int(0,  "Time stop (bars, 0 = off)", minval = 0,            group = G_RISK)

useVwapFilt  = input.bool(false, "Require price on the correct side of VWAP",    group = G_RISK,
     tooltip = "Default OFF: VWAP side pointed the same way as the HTF filter but weaker, and was largely redundant with it.")

useRiskQty   = input.bool(false, "Size position by risk instead of fixed qty",   group = G_SIZE)
riskPerTrade = input.float(250, "Risk per trade ($)", minval = 1,                group = G_SIZE)
pointValue   = input.float(2.0, "Point value ($ per index point)",  minval=0.01, group = G_SIZE,
     tooltip = "MNQ = 2, NQ = 20, MES = 5, ES = 50.")

showZones    = input.bool(true, "Draw sweeps, MSS and FVGs",                     group = G_UI)
showLevels   = input.bool(true, "Draw live liquidity pools",                     group = G_UI)
bullCol      = input.color(#26A69A, "Bull",                                      group = G_UI)
bearCol      = input.color(#EF5350, "Bear",                                      group = G_UI)

// ─────────────────────────────────────────────────────────────
// HIGHER-TIMEFRAME STRUCTURE
// A HTF is "bullish" once it closes above the highest high of the previous
// `htfLook` HTF candles, "bearish" once it closes below their lowest low, and
// it holds that state until the opposite break. lookahead_off everywhere, and
// with "use only closed HTF candles" on, the read is one HTF bar behind, so
// nothing here repaints.
// ─────────────────────────────────────────────────────────────
[h1L, l1L, c1L] = request.security(syminfo.tickerid, htf1,
     [ta.highest(high, htfLook)[1], ta.lowest(low, htfLook)[1], close], lookahead = barmerge.lookahead_off)
[h1C, l1C, c1C] = request.security(syminfo.tickerid, htf1,
     [ta.highest(high, htfLook)[2], ta.lowest(low, htfLook)[2], close[1]], lookahead = barmerge.lookahead_off)
[h2L, l2L, c2L] = request.security(syminfo.tickerid, htf2,
     [ta.highest(high, htfLook)[1], ta.lowest(low, htfLook)[1], close], lookahead = barmerge.lookahead_off)
[h2C, l2C, c2C] = request.security(syminfo.tickerid, htf2,
     [ta.highest(high, htfLook)[2], ta.lowest(low, htfLook)[2], close[1]], lookahead = barmerge.lookahead_off)
[h3L, l3L, c3L] = request.security(syminfo.tickerid, htf3,
     [ta.highest(high, htfLook)[1], ta.lowest(low, htfLook)[1], close], lookahead = barmerge.lookahead_off)
[h3C, l3C, c3C] = request.security(syminfo.tickerid, htf3,
     [ta.highest(high, htfLook)[2], ta.lowest(low, htfLook)[2], close[1]], lookahead = barmerge.lookahead_off)

structState(float hh, float ll, float cl) =>
    var int st = 0
    if not (na(hh) or na(ll) or na(cl))
        if cl > hh
            st := 1
        else if cl < ll
            st := -1
    st

bias1 = structState(htfConfirmed ? h1C : h1L, htfConfirmed ? l1C : l1L, htfConfirmed ? c1C : c1L)
bias2 = structState(htfConfirmed ? h2C : h2L, htfConfirmed ? l2C : l2L, htfConfirmed ? c2C : c2L)
bias3 = structState(htfConfirmed ? h3C : h3L, htfConfirmed ? l3C : l3L, htfConfirmed ? c3C : c3L)

htfAgrees(int dir) =>
    ok = not useHTF or (bias1 == dir and bias2 == dir)
    ok and (not useHTF3 or bias3 == dir)

// ─────────────────────────────────────────────────────────────
// CONTEXT: ATR, VWAP, sessions, day counter
// ─────────────────────────────────────────────────────────────
atr      = ta.atr(atrLen)
vwapVal  = ta.vwap(hlc3)
inTrade  = useSession ? not na(time(timeframe.period, tradeSession, sessTz)) : true
inFlat   = not na(time(timeframe.period, flatTime, sessTz))
newDay   = ta.change(time("D")) != 0

var int tradesToday = 0
if newDay
    tradesToday := 0

// ─────────────────────────────────────────────────────────────
// LIQUIDITY POOLS
// A pool is a price other traders' stops sit under/over. It stays "live" until
// price trades through it — that trade-through is the sweep.
// ─────────────────────────────────────────────────────────────
var array<float> sellPx = array.new<float>()
var array<int>   sellBr = array.new<int>()
var array<float> buyPx  = array.new<float>()
var array<int>   buyBr   = array.new<int>()
var array<float> pivHi  = array.new<float>()
var array<float> pivLo  = array.new<float>()

ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)

if not na(ph)
    array.push(buyPx, ph)
    array.push(buyBr, bar_index - pivotLen)
    array.push(pivHi, ph)
    if array.size(pivHi) > 60
        array.shift(pivHi)
if not na(pl)
    array.push(sellPx, pl)
    array.push(sellBr, bar_index - pivotLen)
    array.push(pivLo, pl)
    if array.size(pivLo) > 60
        array.shift(pivLo)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)
if usePD and newDay and not na(pdh)
    array.push(buyPx, pdh)
    array.push(buyBr, bar_index)
    array.push(sellPx, pdl)
    array.push(sellBr, bar_index)

inAsia = not na(time(timeframe.period, asiaSess, sessTz))
inLon  = not na(time(timeframe.period, lonSess,  sessTz))
var float asiaH = na
var float asiaL = na
var float lonH  = na
var float lonL  = na
if inAsia
    asiaH := inAsia[1] ? math.max(nz(asiaH, high), high) : high
    asiaL := inAsia[1] ? math.min(nz(asiaL, low),  low)  : low
if inLon
    lonH := inLon[1] ? math.max(nz(lonH, high), high) : high
    lonL := inLon[1] ? math.min(nz(lonL, low),  low)  : low
if useAsiaLon and inAsia[1] and not inAsia and not na(asiaH)
    array.push(buyPx, asiaH)
    array.push(buyBr, bar_index)
    array.push(sellPx, asiaL)
    array.push(sellBr, bar_index)
if useAsiaLon and inLon[1] and not inLon and not na(lonH)
    array.push(buyPx, lonH)
    array.push(buyBr, bar_index)
    array.push(sellPx, lonL)
    array.push(sellBr, bar_index)

// ─────────────────────────────────────────────────────────────
// SWEEP DETECTION — raid a live pool, close back inside
// ─────────────────────────────────────────────────────────────
float sweptSellLvl = na
float sweptBuyLvl  = na
if array.size(sellPx) > 0
    for i = array.size(sellPx) - 1 to 0
        p = array.get(sellPx, i)
        if low < p
            if close > p and (na(sweptSellLvl) or p > sweptSellLvl)
                sweptSellLvl := p
            array.remove(sellPx, i)
            array.remove(sellBr, i)
        else if bar_index - array.get(sellBr, i) > poolBars
            array.remove(sellPx, i)
            array.remove(sellBr, i)
if array.size(buyPx) > 0
    for i = array.size(buyPx) - 1 to 0
        p = array.get(buyPx, i)
        if high > p
            if close < p and (na(sweptBuyLvl) or p < sweptBuyLvl)
                sweptBuyLvl := p
            array.remove(buyPx, i)
            array.remove(buyBr, i)
        else if bar_index - array.get(buyBr, i) > poolBars
            array.remove(buyPx, i)
            array.remove(buyBr, i)

depthOkL = not na(sweptSellLvl) and (sweptSellLvl - low)  >= minSweepAtr * atr and (sweptSellLvl - low)  <= maxSweepAtr * atr
depthOkS = not na(sweptBuyLvl)  and (high - sweptBuyLvl)  >= minSweepAtr * atr and (high - sweptBuyLvl)  <= maxSweepAtr * atr

// most recent swing that price must reclaim to call the shift
trigAbove() =>
    float t = na
    if array.size(pivHi) > 0
        for i = array.size(pivHi) - 1 to 0
            if na(t) and array.get(pivHi, i) > close
                t := array.get(pivHi, i)
    t
trigBelow() =>
    float t = na
    if array.size(pivLo) > 0
        for i = array.size(pivLo) - 1 to 0
            if na(t) and array.get(pivLo, i) < close
                t := array.get(pivLo, i)
    t

// pending sweep context, one per side
var int   swLoBar  = na
var float swLoPx   = na
var float swLoTrig = na
var int   swHiBar  = na
var float swHiPx   = na
var float swHiTrig = na

if depthOkL
    tg = trigAbove()
    if not na(tg)
        swLoBar := bar_index, swLoPx := low, swLoTrig := tg
if depthOkS
    tg = trigBelow()
    if not na(tg)
        swHiBar := bar_index, swHiPx := high, swHiTrig := tg

// expire or invalidate a pending sweep
if not na(swLoBar) and ((bar_index - swLoBar > mssWindow) or (low < swLoPx and bar_index > swLoBar))
    swLoBar  := na
    swLoPx   := na
    swLoTrig := na
if not na(swHiBar) and ((bar_index - swHiBar > mssWindow) or (high > swHiPx and bar_index > swHiBar))
    swHiBar  := na
    swHiPx   := na
    swHiTrig := na

// ─────────────────────────────────────────────────────────────
// MARKET STRUCTURE SHIFT + DISPLACEMENT
// The sweep alone is not a signal. The signal is the sweep being REJECTED:
// a candle closing back through the swing that stood before the raid, with a
// body big enough to be a real displacement rather than a drift.
// ─────────────────────────────────────────────────────────────
dispOk   = math.abs(close - open) >= dispAtr * atr
mssLong  = not na(swLoBar) and bar_index > swLoBar and close > swLoTrig and dispOk
mssShort = not na(swHiBar) and bar_index > swHiBar and close < swHiTrig and dispOk

// ── fair value gaps left by the displacement leg ──
legLenL = na(swLoBar) ? 0 : math.min(bar_index - swLoBar, 30)
legLenS = na(swHiBar) ? 0 : math.min(bar_index - swHiBar, 30)

findGapLong(int look) =>
    float gb = na
    float gt = na
    for k = 0 to math.max(look, 0)
        if na(gt) and low[k] > high[k + 2]
            gb := high[k + 2]
            gt := low[k]
    [gb, gt]

findGapShort(int look) =>
    float gb = na
    float gt = na
    for k = 0 to math.max(look, 0)
        if na(gt) and high[k] < low[k + 2]
            gb := high[k]
            gt := low[k + 2]
    [gb, gt]

// inverted FVG: an opposite-polarity gap the displacement closed through, which
// then acts as support (long) or resistance (short)
findIfvgLong(int look) =>
    float gb = na
    float gt = na
    for k = 0 to math.max(look, 0)
        if na(gt) and high[k] < low[k + 2] and close > low[k + 2]
            gb := high[k]
            gt := low[k + 2]
    [gb, gt]

findIfvgShort(int look) =>
    float gb = na
    float gt = na
    for k = 0 to math.max(look, 0)
        if na(gt) and low[k] > high[k + 2] and close < high[k + 2]
            gb := high[k + 2]
            gt := low[k]
    [gb, gt]

// ─────────────────────────────────────────────────────────────
// ENTRY
// ─────────────────────────────────────────────────────────────
vwapOkL = not useVwapFilt or close > vwapVal
vwapOkS = not useVwapFilt or close < vwapVal

var bool  orderLive = false
var int   orderBar  = na
var float pendRisk  = na
var float pendRR    = na
var int   pendDir   = 0

flat      = strategy.position_size == 0
canArm    = inTrade and not inFlat and tradesToday < maxPerDay and flat and not orderLive and not na(atr) and atr > 0
takeLong  = canArm and mssLong  and htfAgrees(1)  and vwapOkL
takeShort = canArm and mssShort and htfAgrees(-1) and vwapOkS

// risk distance: ATR-based, optionally pulled in to the sweep extreme when that
// is nearer, never tighter than half an ATR (below that the stop sits inside
// the noise the sweep itself just created)
riskLong() =>
    atrStop   = close - stopAtr * atr
    sweepStop = na(swLoPx) ? atrStop : swLoPx - 0.1 * atr
    st = capBySweep ? math.max(atrStop, math.min(sweepStop, close - 0.5 * atr)) : atrStop
    close - st
riskShort() =>
    atrStop   = close + stopAtr * atr
    sweepStop = na(swHiPx) ? atrStop : swHiPx + 0.1 * atr
    st = capBySweep ? math.min(atrStop, math.max(sweepStop, close + 0.5 * atr)) : atrStop
    st - close

// target: fixed R, or the nearest opposing pool that is at least minRR away
liqRR(int dir, float risk) =>
    float best = na
    if dir > 0 and array.size(buyPx) > 0
        for i = 0 to array.size(buyPx) - 1
            p = array.get(buyPx, i)
            if p > close + minRR * risk and (na(best) or p < best)
                best := p
    if dir < 0 and array.size(sellPx) > 0
        for i = 0 to array.size(sellPx) - 1
            p = array.get(sellPx, i)
            if p < close - minRR * risk and (na(best) or p > best)
                best := p
    na(best) ? rrTarget : math.min(math.abs(best - close) / risk, maxRR)

qtyFor(float risk) =>
    useRiskQty ? math.max(1, math.floor(riskPerTrade / math.max(risk * pointValue, 0.01))) : 1

// The gap the displacement left, resolved once per bar. A fresh FVG is
// preferred; an inverted FVG is the fallback when the leg gapped through an
// opposing one instead of leaving its own.
[gapLB, gapLT] = findGapLong(legLenL)
[gapSB, gapST] = findGapShort(legLenS)
[ifvLB, ifvLT] = findIfvgLong(legLenL)
[ifvSB, ifvST] = findIfvgShort(legLenS)

zoneLB = na(gapLT) and useIfvg ? ifvLB : gapLB
zoneLT = na(gapLT) and useIfvg ? ifvLT : gapLT
zoneSB = na(gapST) and useIfvg ? ifvSB : gapSB
zoneST = na(gapST) and useIfvg ? ifvST : gapST

// entry price for the retracement modes
entryLongPx  = na(zoneLT) ? na : zoneLT - ceFrac * (zoneLT - zoneLB)
entryShortPx = na(zoneSB) ? na : zoneSB + ceFrac * (zoneST - zoneSB)

if takeLong
    r   = riskLong()
    rr  = useLiqTarget ? liqRR(1, r) : rrTarget
    lim = entryMode == "On MSS close" ? na : entryLongPx
    ok  = entryMode == "On MSS close" or (not na(lim) and lim < close)
    if ok
        pendRisk := r
        pendRR   := rr
        pendDir  := 1
        orderLive := true
        orderBar  := bar_index
        tradesToday += 1
        if na(lim)
            strategy.entry("ICT L", strategy.long, qty = qtyFor(r))
        else
            strategy.entry("ICT L", strategy.long, qty = qtyFor(r), limit = lim)

if takeShort
    r   = riskShort()
    rr  = useLiqTarget ? liqRR(-1, r) : rrTarget
    lim = entryMode == "On MSS close" ? na : entryShortPx
    ok  = entryMode == "On MSS close" or (not na(lim) and lim > close)
    if ok
        pendRisk := r
        pendRR   := rr
        pendDir  := -1
        orderLive := true
        orderBar  := bar_index
        tradesToday += 1
        if na(lim)
            strategy.entry("ICT S", strategy.short, qty = qtyFor(r))
        else
            strategy.entry("ICT S", strategy.short, qty = qtyFor(r), limit = lim)

// ─────────────────────────────────────────────────────────────
// ORDER LIFECYCLE — a resting limit is not a position
// ─────────────────────────────────────────────────────────────
if orderLive and not flat
    orderLive := false                      // filled
if orderLive and flat and not na(orderBar) and bar_index - orderBar >= fvgWait
    strategy.cancel("ICT L")
    strategy.cancel("ICT S")
    if entryMode == "FVG limit, else market" and pendDir != 0
        if pendDir > 0
            strategy.entry("ICT L", strategy.long,  qty = qtyFor(pendRisk))
        else
            strategy.entry("ICT S", strategy.short, qty = qtyFor(pendRisk))
    else
        orderLive := false

// ─────────────────────────────────────────────────────────────
// EXITS — stop, target, breakeven, partial, time stop, close-out
// Levels are anchored to the ACTUAL average fill, not to the signal bar's
// close, so the R multiple you see is the R multiple you got.
// ─────────────────────────────────────────────────────────────
var float stopPx  = na
var float tp1Px   = na
var float tp2Px   = na
var bool  beArmed = false

if strategy.position_size != 0
    e   = strategy.position_avg_price
    dir = strategy.position_size > 0 ? 1 : -1
    if na(stopPx)
        stopPx  := e - dir * pendRisk
        tp2Px   := e + dir * pendRR * pendRisk
        tp1Px   := partialAt > 0 ? e + dir * partialAt * pendRisk : na
        beArmed := false
    mfe = dir > 0 ? high - e : e - low
    if beTrigger > 0 and not beArmed and mfe >= beTrigger * pendRisk
        beArmed := true
    curStop = beArmed ? e : stopPx
    if dir > 0
        if partialAt > 0
            strategy.exit("X1", from_entry = "ICT L", qty_percent = partialPct, stop = curStop, limit = tp1Px)
            strategy.exit("X2", from_entry = "ICT L", stop = curStop, limit = tp2Px)
        else
            strategy.exit("X", from_entry = "ICT L", stop = curStop, limit = tp2Px)
    else
        if partialAt > 0
            strategy.exit("X1", from_entry = "ICT S", qty_percent = partialPct, stop = curStop, limit = tp1Px)
            strategy.exit("X2", from_entry = "ICT S", stop = curStop, limit = tp2Px)
        else
            strategy.exit("X", from_entry = "ICT S", stop = curStop, limit = tp2Px)
    if maxHold > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= maxHold
        strategy.close_all("time stop")
else
    stopPx  := na
    tp1Px   := na
    tp2Px   := na
    beArmed := false

if flatten and inFlat
    strategy.close_all("session close")
    strategy.cancel_all()

// ─────────────────────────────────────────────────────────────
// DISPLAY
// ─────────────────────────────────────────────────────────────
plotshape(showZones and depthOkL, "Sweep low",  shape.triangleup,   location.belowbar, color.new(bullCol, 40), size = size.tiny)
plotshape(showZones and depthOkS, "Sweep high", shape.triangledown, location.abovebar, color.new(bearCol, 40), size = size.tiny)
plotshape(showZones and takeLong,  "MSS up",   shape.labelup,   location.belowbar, bullCol, size = size.small, text = "MSS")
plotshape(showZones and takeShort, "MSS down", shape.labeldown, location.abovebar, bearCol, size = size.small, text = "MSS")

if showZones and takeLong and not na(zoneLT)
    box.new(bar_index - 2, zoneLT, bar_index + 8, zoneLB, border_color = bullCol, bgcolor = color.new(bullCol, 85))
if showZones and takeShort and not na(zoneST)
    box.new(bar_index - 2, zoneST, bar_index + 8, zoneSB, border_color = bearCol, bgcolor = color.new(bearCol, 85))

plot(showLevels and not na(pdh) ? pdh : na, "PDH", color.new(color.gray, 40), 1, plot.style_linebr)
plot(showLevels and not na(pdl) ? pdl : na, "PDL", color.new(color.gray, 40), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? stopPx : na, "Stop",   color.new(bearCol, 0), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? tp2Px  : na, "Target", color.new(bullCol, 0), 1, plot.style_linebr)

bgcolor(useSession and inTrade ? color.new(color.blue, 94) : na, title = "Entry window")

alertcondition(takeLong,  "ICT long",  "ICT sweep + MSS long")
alertcondition(takeShort, "ICT short", "ICT sweep + MSS short")
