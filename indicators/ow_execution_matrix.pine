//@version=6
indicator("Quant Engine: OW Execution Matrix", "OW EXEC", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     max_bars_back = 5000)

// ============================================================================
// Obizhaeva & Wang (2005), "Optimal Trading Strategy and Supply/Demand
// Dynamics", implemented for NQ / MNQ.
//
// WHAT THIS IS.  An execution-cost tool, not a signal generator.  The paper
// is about how to work a large order through a limit order book whose depth
// refills over time, and that is exactly what this script does:
//
//   1. it measures the book's impact parameters from the chart's own tape --
//      instantaneous impact 1/q, permanent impact lambda, transient impact
//      kappa = 1/q - lambda, and the resilience rho at which the transient
//      part decays;
//   2. it solves the paper's optimal execution problem for your order size
//      and horizon (Propositions 2/3 risk-neutral, Proposition 4 risk-averse);
//   3. it prices that schedule against TWAP and against a market order, in
//      points, ticks and dollars.
//
// WHAT THIS IS NOT.  It does not predict direction.  The transient deviation
// D_t was tested as a mean-reversion signal on 2 years of MNQ/NQ and it does
// not survive: with Newey-West errors it reaches t = -2.4 at one horizon, and
// it adds nothing over a plain EWMA of past returns (neither term survives
// when both are in the regression).  The steady-state line this script draws
// is a liquidity read, not an entry.  See README.md for the full test.
//
// KEY RESULT OF THE PAPER, and why the schedule looks the way it does: the
// optimal strategy is a discrete clip now, a constant continuous flow, and a
// discrete clip at the horizon -- and its SHAPE depends only on rho and T,
// not on lambda or on the depth q.  Those two only set the cost.  The first
// clip pushes the book off its steady state so fresh orders are drawn in; the
// continuous flow eats them at the rate they arrive; the last clip cleans up
// because the state of the book after T no longer matters.
//
// Calibration (full-sample, 2y of Yahoo data, see backtest/ow_impact.py):
//   MNQ 15m  rho 0.2832/bar (half-life 2.45 bars = 37 min)  transient 22.1%
//   NQ  15m  rho 0.3182/bar (half-life 2.18 bars = 33 min)  transient 20.5%
//   MNQ  5m  rho 0.1407/bar (half-life 4.93 bars = 25 min)  transient 12.6%
//   NQ   5m  rho 0.1492/bar (half-life 4.65 bars = 23 min)  transient 12.9%
// 15m is the validated timeframe: on 5m the impact curve is not monotone and
// the live estimator returns a usable rho only ~40% of the time.
// ============================================================================

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
var string G_ORDER = "Order To Execute"
var string G_MODEL = "Book Model"
var string G_UI    = "Display"

orderSide  = input.string("Buy", "Side", options = ["Buy", "Sell"],           group = G_ORDER)
orderSize  = input.float(500, "Order Size (contracts)", minval = 1, step = 25, group = G_ORDER)
horizonBar = input.int(8, "Execution Horizon (bars)", minval = 1, maxval = 400, group = G_ORDER)
urgency    = input.float(0.0, "Urgency (0 = risk-neutral)", minval = 0.0, maxval = 50.0, step = 0.25,
     tooltip = "Dimensionless risk aversion, a*sigma^2/(kappa*rho) in the paper's Proposition 4. " +
               "0 solves the risk-neutral problem. Raising it front-loads the schedule: you pay more " +
               "expected impact to cut the variance of the fill price.", group = G_ORDER)

paramSrc   = input.string("Validated preset", "Parameter Source",
     options = ["Validated preset", "Live estimate", "Manual"],
     tooltip = "Preset uses the full-sample fits shipped with this script (most reliable). " +
               "Live re-estimates from the visible tape every bar (noisier: at a 2000-bar window " +
               "the 10-90 range of rho is roughly 0.16-0.39 against a full-sample 0.28).", group = G_MODEL)
estWin     = input.int(2000, "Estimation Window (bars)", minval = 200, maxval = 4000, step = 100, group = G_MODEL)
rhoSmooth  = input.int(100, "Live Estimate Smoothing (bars)", minval = 1, maxval = 500, group = G_MODEL)
advLen     = input.int(100, "Volume Baseline (bars)", minval = 20,                     group = G_MODEL)
rhoMan     = input.float(0.2832, "Manual rho (per bar)", minval = 0.001, step = 0.01,  group = G_MODEL)
kapMan     = input.float(7.091, "Manual kappa (pts per ADV)", minval = 0.0, step = 0.1, group = G_MODEL)
lamMan     = input.float(24.994, "Manual lambda (pts per ADV)", minval = 0.0, step = 0.1, group = G_MODEL)
depthCal   = input.float(1.0, "Depth Calibration (x)", minval = 0.05, maxval = 20.0, step = 0.05,
     tooltip = "Scales the measured depth q. Signed flow is proxied from bar shape (close-location " +
               "value x volume), so the ABSOLUTE cost level is uncalibrated even though the decay " +
               "shape is well identified. Compare the cost line against your own fills and set this " +
               "so they agree; >1 means the real book is deeper and costs are lower.", group = G_MODEL)

showPlan   = input.bool(true,  "Draw Execution Plan",   group = G_UI)
showSteady = input.bool(true,  "Draw Steady-State Value", group = G_UI)
showDash   = input.bool(true,  "Show Dashboard",        group = G_UI)
buyCol     = input.color(#00E676, "Buy Color",          group = G_UI)
sellCol    = input.color(#FF5252, "Sell Color",         group = G_UI)

bool isBuy = orderSide == "Buy"
int  dir   = isBuy ? 1 : -1
color sideCol = isBuy ? buyCol : sellCol

// ─────────────────────────────────────────────────────────────
// SIGNED ORDER FLOW
// ─────────────────────────────────────────────────────────────
// Bar-level proxy for the buy/sell imbalance: close-location value times
// volume, normalised by trailing average volume. Normalising by ADV makes the
// impact coefficients read as "points per 1 ADV of signed flow", which is
// scale-free across contracts AND adapts automatically to today's volume --
// a preset fitted when ADV was 28k stays correct when ADV is 56k, because the
// same contract count is then a smaller fraction of an ADV.
float clv    = high > low ? (2.0 * close - high - low) / (high - low) : 0.0
float advCon = ta.sma(volume, advLen)
float x      = advCon > 0 ? clv * volume / advCon : 0.0

// ─────────────────────────────────────────────────────────────
// IMPACT-DECAY ESTIMATOR
// ─────────────────────────────────────────────────────────────
// beta_k = the share of a flow impulse still in the price k bars later,
//   beta_k = cov(c_t - c_{t-k-2}, x_{t-k-1}) / var(x_{t-k-1})
// Both series are historical at bar t, so this is causal. Crucially the
// regressor x is built only from (h, l, c, v) of ITS OWN bar and the window
// endpoints are c_{t} and c_{t-k-2}, so no price observation is shared
// between the two sides -- bid-ask bounce cannot manufacture the decay.
f_beta(float xs, float ys, int len) =>
    float mx  = ta.sma(xs, len)
    float my  = ta.sma(ys, len)
    float cov = ta.sma(xs * ys, len) - mx * my
    float vr  = ta.sma(xs * xs, len) - mx * mx
    vr > 0 ? cov / vr : na

float b0  = f_beta(x[1],  close - close[2],  estWin)
float b2  = f_beta(x[3],  close - close[4],  estWin)
float b4  = f_beta(x[5],  close - close[6],  estWin)
float b8  = f_beta(x[9],  close - close[10], estWin)
float b24 = f_beta(x[25], close - close[26], estWin)

// long lag ~ the permanent component; the rest of beta_0 is transient
float lamRaw = b24
float kapRaw = b0 - lamRaw

// rho implied by each intermediate lag, from beta_m = lambda + kappa e^{-rho m}
f_rho_at(float bm, float lam, float kap, int m) =>
    float frac = kap > 0 ? (bm - lam) / kap : na
    na(frac) or frac <= 0.02 or frac >= 0.999 ? na : -math.log(frac) / m

float r2 = f_rho_at(b2, lamRaw, kapRaw, 2)
float r4 = f_rho_at(b4, lamRaw, kapRaw, 4)
float r8 = f_rho_at(b8, lamRaw, kapRaw, 8)
int   nR = (na(r2) ? 0 : 1) + (na(r4) ? 0 : 1) + (na(r8) ? 0 : 1)
float rhoRaw = nR > 0 ? (nz(r2) + nz(r4) + nz(r8)) / nR : na
bool  liveOk = kapRaw > 0 and b0 > 0 and nR > 0

// clamp to a sane band and smooth: single-window estimates are noisy
float rhoClamped = na(rhoRaw) ? na : math.min(math.max(rhoRaw, 0.01), 3.0)
var float rhoLive = na
var float kapLive = na
var float lamLive = na
if liveOk and not na(rhoClamped)
    rhoLive := na(rhoLive) ? rhoClamped : rhoLive + (2.0 / (rhoSmooth + 1)) * (rhoClamped - rhoLive)
    kapLive := na(kapLive) ? kapRaw     : kapLive + (2.0 / (rhoSmooth + 1)) * (kapRaw - kapLive)
    lamLive := na(lamLive) ? lamRaw     : lamLive + (2.0 / (rhoSmooth + 1)) * (lamRaw - lamLive)

// ─────────────────────────────────────────────────────────────
// PRESETS  (full-sample fits — see README and backtest/ow_impact.py)
// ─────────────────────────────────────────────────────────────
int  tfSec = timeframe.in_seconds()
bool is15m = tfSec == 900
bool is5m  = tfSec == 300
string sym = str.upper(syminfo.ticker)
bool isMNQ = str.contains(sym, "MNQ")
bool isNQ  = not isMNQ and str.contains(sym, "NQ")

float pRho = is5m ? (isMNQ ? 0.1407 : 0.1492) : (isMNQ ? 0.2832 : 0.3182)
float pKap = is5m ? (isMNQ ? 1.465  : 1.256)  : (isMNQ ? 7.091  : 5.957)
float pLam = is5m ? (isMNQ ? 10.192 : 8.502)  : (isMNQ ? 24.994 : 23.065)

float rhoEff = paramSrc == "Manual" ? rhoMan : paramSrc == "Live estimate" ? rhoLive : pRho
float kapEff = paramSrc == "Manual" ? kapMan : paramSrc == "Live estimate" ? kapLive : pKap
float lamEff = paramSrc == "Manual" ? lamMan : paramSrc == "Live estimate" ? lamLive : pLam

// depth calibration scales every impact coefficient (q -> q * depthCal)
kapEff := kapEff / depthCal
lamEff := lamEff / depthCal
float invqEff = lamEff + kapEff
bool  modelOk = not na(rhoEff) and not na(kapEff) and not na(lamEff) and rhoEff > 0 and invqEff > 0

// ─────────────────────────────────────────────────────────────
// TRANSIENT DEVIATION D_t AND THE STEADY-STATE VALUE
// ─────────────────────────────────────────────────────────────
// The paper's eq. (10): D_t = sum_i kappa x_i e^{-rho(t-t_i)}, which in
// discrete bars is just an EWMA of signed flow with decay phi = e^{-rho}.
// V_t = A_t - s/2 - D_t is the price with the transient impact stripped out.
float phi = modelOk ? math.exp(-rhoEff) : 0.0
var float flowState = 0.0
flowState := phi * flowState + nz(x)
float devD    = modelOk ? kapEff * flowState : na
float steadyV = modelOk ? close - devD : na

plot(showSteady and modelOk ? steadyV : na, "Steady-State Value",
     color = color.new(color.aqua, 25), linewidth = 2)

// ─────────────────────────────────────────────────────────────
// OPTIMAL EXECUTION SOLVER
// ─────────────────────────────────────────────────────────────
// Risk-neutral (Prop 2/3) is closed form. Risk-averse (Prop 4) integrates the
// Riccati equation (A.22) backwards for f, forms the continuous-trade locus
// X_t = g(t) D_t with g = -(f' - rho f)/(kappa f' + a sigma^2), takes the
// opening clip from the jump onto that locus, x0 = X0/(1 + kappa g(0)), then
// walks the state forward. Verified against the closed form and against the
// paper's Table 1 in backtest/ow_execution.py (worst error 1.1e-9).
f_fprime(float f, float rho, float kap, float asig2) =>
    (kap * rho * rho * f * f + 2.0 * asig2 * rho * f - 2.0 * asig2 * rho) / (2.0 * rho * kap + asig2)

// Returns [first clip, continuous total, last clip, path cost]. The path cost
// is accumulated during the same forward walk that produces the schedule, so
// a front-loaded plan is priced exactly rather than with the risk-neutral
// formula (which does not apply to it). It is na on the risk-neutral branch,
// where the caller uses the exact closed form instead.
f_schedule(float X0, float T, float rho, float kap, float lam, float invq, float urg) =>
    array<float> out = array.new<float>(4, na)
    if urg <= 0.0
        float x0 = X0 / (rho * T + 2.0)
        array.set(out, 0, x0)
        array.set(out, 1, X0 - 2.0 * x0)
        array.set(out, 2, x0)
    else
        int   N     = 400
        float asig2 = urg * kap * rho
        float h     = T / N
        array<float> fA = array.new<float>(N + 1, 0.0)
        array.set(fA, N, 1.0)
        for i = N to 1
            float y  = array.get(fA, i)
            float k1 = f_fprime(y, rho, kap, asig2)
            float k2 = f_fprime(y - 0.5 * h * k1, rho, kap, asig2)
            float k3 = f_fprime(y - 0.5 * h * k2, rho, kap, asig2)
            float k4 = f_fprime(y - h * k3, rho, kap, asig2)
            array.set(fA, i - 1, y - (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4))
        array<float> gA = array.new<float>(N + 1, 0.0)
        for i = 0 to N
            float fv = array.get(fA, i)
            float fp = f_fprime(fv, rho, kap, asig2)
            array.set(gA, i, -(fp - rho * fv) / (kap * fp + asig2))
        float x0   = X0 / (1.0 + kap * array.get(gA, 0))
        float Xrem = X0 - x0
        float D    = kap * x0
        float xc   = x0
        float cost = 0.5 * invq * x0 * x0
        for i = 0 to N - 1
            float g  = array.get(gA, i)
            float gp = i == 0 ? (array.get(gA, 1) - array.get(gA, 0)) / h :
                 (array.get(gA, i + 1) - array.get(gA, i - 1)) / (2.0 * h)
            float m  = math.min(math.max((rho * g - gp) * D / (1.0 + kap * g), 0.0), Xrem / h)
            cost += (lam * xc + D) * m * h
            Xrem -= m * h
            D    += (-rho * D + kap * m) * h
            xc   += m * h
        float xT = math.max(Xrem, 0.0)
        cost += (lam * xc + D + 0.5 * invq * xT) * xT
        array.set(out, 0, x0)
        array.set(out, 1, X0 - x0 - xT)
        array.set(out, 2, xT)
        array.set(out, 3, cost)
    out

// ─────────────────────────────────────────────────────────────
// COSTS  (net of the strategy-independent fundamental term)
// ─────────────────────────────────────────────────────────────
f_cost_ow(float X0, float T, float rho, float kap, float lam) =>
    0.5 * lam * X0 * X0 + kap * X0 * X0 / (rho * T + 2.0)

f_cost_twap(float X0, float T, float rho, float kap, float lam) =>
    float rt = rho * T
    rt <= 0 ? 0.5 * lam * X0 * X0 + kap * X0 * X0 :
         0.5 * lam * X0 * X0 + kap * X0 * X0 * (rt - (1.0 - math.exp(-rt))) / (rt * rt)

// ─────────────────────────────────────────────────────────────
// PLAN + DASHBOARD (last bar only)
// ─────────────────────────────────────────────────────────────
f_row(table t, int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color = color.new(color.silver, 0), text_halign = text.align_left,  text_size = size.small)
    table.cell(t, 1, r, v, text_color = vc,                         text_halign = text.align_right, text_size = size.small)

f_qty(float v) =>
    str.tostring(math.round(v), "#,###")

f_place(line ln, int la, int lb, float y) =>
    line.set_xy1(ln, la, y)
    line.set_xy2(ln, lb, y)

// drawing handles are reused: barstate.islast fires on every realtime tick,
// so creating fresh objects each time would churn through the object budget
var box   planBox = na
var line  lnArr   = na
var line  lnOW    = na
var line  lnTW    = na
var line  lnMKT   = na
var label lbOW    = na
var label lbMKT   = na
var label lbPlan  = na

if barstate.islast
    float advNow = nz(advCon)
    bool  ready  = modelOk and advNow > 0 and orderSize > 0
    // order size expressed in ADV units, the unit the coefficients are in
    float X0   = ready ? orderSize / advNow : na
    float T    = horizonBar
    float ptv  = syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0

    float x0   = na
    float cont = na
    float xT   = na
    float cPath = na
    if ready
        array<float> plan = f_schedule(X0, T, rhoEff, kapEff, lamEff, invqEff, urgency)
        x0    := array.get(plan, 0)
        cont  := array.get(plan, 1)
        xT    := array.get(plan, 2)
        cPath := array.get(plan, 3)

    // costs in points*ADV -> per contract in points -> dollars
    float cOW  = ready ? (na(cPath) ? f_cost_ow(X0, T, rhoEff, kapEff, lamEff) : cPath) : na
    float cTW  = ready ? f_cost_twap(X0, T, rhoEff, kapEff, lamEff) : na
    float cMKT = ready ? 0.5 * invqEff * X0 * X0 : na
    float ptsOW  = ready ? cOW  * advNow / orderSize : na
    float ptsTW  = ready ? cTW  * advNow / orderSize : na
    float ptsMKT = ready ? cMKT * advNow / orderSize : na
    float usdOW  = ready ? cOW  * advNow * ptv : na
    float usdTW  = ready ? cTW  * advNow * ptv : na
    float usdMKT = ready ? cMKT * advNow * ptv : na

    // ── on-chart plan ────────────────────────────────────────
    if showPlan and ready
        int xa = bar_index
        int xb = bar_index + horizonBar
        float arrival = close
        float pOW  = arrival + dir * ptsOW
        float pTW  = arrival + dir * ptsTW
        float pMKT = arrival + dir * ptsMKT

        if na(planBox)
            planBox := box.new(xa, arrival, xb, arrival, bgcolor = color.new(sideCol, 93),
                 border_color = color.new(sideCol, 70))
            lnArr   := line.new(xa, arrival, xb, arrival, color = color.new(color.gray, 20),
                 width = 1, style = line.style_dashed)
            lnOW    := line.new(xa, pOW,  xb, pOW,  color = sideCol, width = 2)
            lnTW    := line.new(xa, pTW,  xb, pTW,  color = color.new(color.orange, 20),
                 width = 1, style = line.style_dotted)
            lnMKT   := line.new(xa, pMKT, xb, pMKT, color = color.new(color.red, 20),
                 width = 1, style = line.style_dotted)
            lbOW    := label.new(xb, pOW,  style = label.style_label_left, textcolor = color.white, size = size.small)
            lbMKT   := label.new(xb, pMKT, style = label.style_label_left, textcolor = color.white, size = size.small)
            lbPlan  := label.new(xa, arrival, style = label.style_label_up, textcolor = color.white, size = size.small)

        box.set_lefttop(planBox, xa, math.max(pMKT, arrival))
        box.set_rightbottom(planBox, xb, math.min(pMKT, arrival))
        box.set_bgcolor(planBox, color.new(sideCol, 93))
        box.set_border_color(planBox, color.new(sideCol, 70))
        f_place(lnArr, xa, xb, arrival)
        f_place(lnOW,  xa, xb, pOW)
        f_place(lnTW,  xa, xb, pTW)
        f_place(lnMKT, xa, xb, pMKT)
        line.set_color(lnOW, sideCol)

        label.set_xy(lbOW, xb, pOW)
        label.set_color(lbOW, color.new(sideCol, 15))
        label.set_text(lbOW, "OW avg " + str.tostring(pOW, format.mintick) +
             "  (" + str.tostring(ptsOW, "#.###") + " pts/ct)")
        label.set_xy(lbMKT, xb, pMKT)
        label.set_color(lbMKT, color.new(color.red, 40))
        label.set_text(lbMKT, "market now " + str.tostring(ptsMKT, "#.###") + " pts/ct")
        label.set_xy(lbPlan, xa, arrival)
        label.set_color(lbPlan, color.new(sideCol, 20))
        label.set_text(lbPlan, (isBuy ? "BUY " : "SELL ") + f_qty(orderSize) +
             " over " + str.tostring(horizonBar) + " bars" +
             "\nnow " + f_qty(x0 * advNow) +
             "  |  " + f_qty(cont * advNow / horizonBar) + "/bar" +
             "  |  end " + f_qty(xT * advNow))
    else if not na(planBox)
        box.delete(planBox)
        line.delete(lnArr)
        line.delete(lnOW)
        line.delete(lnTW)
        line.delete(lnMKT)
        label.delete(lbOW)
        label.delete(lbMKT)
        label.delete(lbPlan)
        planBox := na

    // ── dashboard ────────────────────────────────────────────
    if showDash
        var table dash = table.new(position.top_right, 2, 17,
             bgcolor = color.new(#101418, 12), border_width = 1,
             border_color = color.new(color.gray, 70), frame_width = 1,
             frame_color = color.new(color.gray, 55))

        table.cell(dash, 0, 0, "OBIZHAEVA–WANG EXECUTION", text_color = color.white, text_size = size.small)
        table.merge_cells(dash, 0, 0, 1, 0)

        if not ready
            f_row(dash, 1, "Status", na(rhoEff) ? "warming up…" : "no volume data", color.orange)
            f_row(dash, 2, "Needs", na(rhoEff) ?
                 (paramSrc == "Live estimate" ? str.tostring(estWin + 30) + " bars of history"
                                              : "a positive rho") : str.tostring(advLen) + " bars of volume",
                 color.silver)
        else
            float hl = math.log(2) / rhoEff
            f_row(dash, 1, "Source", paramSrc + (paramSrc == "Live estimate" and not liveOk ? " (stale)" : ""),
                 paramSrc == "Live estimate" and not liveOk ? color.orange : color.aqua)
            f_row(dash, 2, "Resilience ρ", str.tostring(rhoEff, "#.####") + " /bar", color.white)
            f_row(dash, 3, "Impact half-life", str.tostring(hl, "#.##") + " bars  (" +
                 str.tostring(hl * tfSec / 60.0, "#.#") + " min)", color.white)
            f_row(dash, 4, "Transient share", str.tostring(100.0 * kapEff / invqEff, "#.#") + "%", color.white)
            f_row(dash, 5, "Depth q", f_qty(advNow / invqEff) + " ct/pt", color.white)
            f_row(dash, 6, "Deviation D", (devD >= 0 ? "+" : "") + str.tostring(devD, format.mintick) + " pts",
                 math.abs(devD) < syminfo.mintick ? color.silver : devD > 0 ? color.new(color.red, 0) : color.new(color.teal, 0))

            table.cell(dash, 0, 7, "SCHEDULE — " + (isBuy ? "BUY " : "SELL ") + f_qty(orderSize) +
                 " / " + str.tostring(horizonBar) + " bars", text_color = sideCol, text_size = size.small)
            table.merge_cells(dash, 0, 7, 1, 7)
            f_row(dash, 8,  "Clip now",      f_qty(x0 * advNow)   + "  (" + str.tostring(100.0 * x0 / X0, "#.#") + "%)", color.white)
            f_row(dash, 9,  "Continuous",    f_qty(cont * advNow / horizonBar) + " /bar  (" + str.tostring(100.0 * cont / X0, "#.#") + "%)", color.white)
            f_row(dash, 10, "Clip at end",   f_qty(xT * advNow)   + "  (" + str.tostring(100.0 * xT / X0, "#.#") + "%)", color.white)

            table.cell(dash, 0, 11, "EXPECTED IMPACT COST", text_color = color.white, text_size = size.small)
            table.merge_cells(dash, 0, 11, 1, 11)
            f_row(dash, 12, "Obizhaeva–Wang", str.tostring(ptsOW, "#.###") + " pts  $" + f_qty(usdOW), color.new(color.teal, 0))
            f_row(dash, 13, "TWAP",           str.tostring(ptsTW, "#.###") + " pts  $" + f_qty(usdTW), color.orange)
            f_row(dash, 14, "Market order",   str.tostring(ptsMKT, "#.###") + " pts  $" + f_qty(usdMKT), color.new(color.red, 0))
            f_row(dash, 15, urgency > 0 ? "vs TWAP (cost of urgency)" : "Saved vs TWAP",
                 (usdTW - usdOW >= 0 ? "$" + f_qty(usdTW - usdOW) : "-$" + f_qty(usdOW - usdTW)) +
                 "  (" + str.tostring(100.0 * (cTW - cOW) / cTW, "#.##") + "%)",
                 usdTW - usdOW >= 0 ? color.new(color.teal, 0) : color.orange)

            // validity advisory: 15m is the validated timeframe on NQ/MNQ
            bool tfOk  = is15m or is5m
            bool symOk = isMNQ or isNQ
            string warn = not symOk ? "⚠ calibrated on NQ/MNQ only" :
                 not tfOk ? "⚠ preset is 5m/15m only" :
                 is5m ? "⚠ 5m: weak identification" : "✓ 15m validated"
            f_row(dash, 16, "Validity", warn, str.startswith(warn, "✓") ? color.new(color.teal, 0) : color.orange)
