//@version=6
indicator("Order Flow Big-Move Bubbles", "OF Bubbles", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// ORDER FLOW BIG-MOVE BUBBLES
//
// Keeps the chart clean: a bubble appears ONLY when one of three order-flow
// setups meant to flag a possible large move prints on a closed bar. Green =
// setup for an up move, red = for a down move. The circle sits at the bar's
// volume-weighted price and is larger when the setup is stronger; the label
// says which setup it is, and hovering it shows the exact numbers behind it.
//
//   ABS  absorption / trapped traders (reversal) — the bar sweeps the N-bar
//        low/high on heavy volume, aggressive delta hits the sweep hard, yet
//        price closes back inside: passive orders absorbed the aggression and
//        the aggressors are trapped on the wrong side.
//   DIV  delta divergence (reversal) — the bar sweeps the N-bar low/high, but
//        the net delta since the prior extreme points the other way: price
//        went lower while buyers were the aggressors (or higher on sellers).
//   BRK  initiative breakout (continuation) — the bar CLOSES beyond the N-bar
//        high/low on heavy volume with extreme same-way delta and a strong
//        close: aggressive traders broke the level and held it.
//
// FILTERS: bubbles show only inside your trade windows (default 09:30–11:30
// New York), and optionally only at a key level — prior-day high/low,
// overnight high/low, opening-range high/low or VWAP (drawn on the chart). A
// bubble at a key level is starred (★PDL etc.). Setups the filters hide are
// still graded silently, so the dashboard shows whether each filter helps.
//
// No indicator knows a move is coming. The self-check grades every bubble on
// this chart's own history (did price reach the target before the
// invalidation line?) so the dashboard shows how the setups actually did —
// pessimistically, without fees or slippage. Treat that as evidence, not a
// promise.
//
// WHERE THE DELTA COMES FROM (only data TradingView really provides — bars
// without data stay empty instead of guessed):
//   Intrabar   every 1m bar inside the chart bar is classified up or down by
//              its close vs open (ties: vs prior close, then prior direction)
//              and its whole volume booked that way — the same method as
//              TradingView's built-in Volume Delta / CVD. Signals on 3m+
//              charts use this, so they normally match after a reload
//              (TradingView notes realtime intrabar data can occasionally be
//              corrected later, which can change a borderline signal).
//   LIVE tick  realtime bars watched from their first trade: volume traded on
//              an uptick = buying, on a downtick = selling. Closest Pine gets
//              to exchange bid/ask delta, but it exists only while the chart
//              is open. Used for the 1m chart (where 1m history is too coarse)
//              and for the dashboard's live bar readout.
//   Low-res    the intrabar is as large as the chart bar (1m chart, free plan
//              without seconds data): history is just each bar's volume
//              signed by its direction — never used for signals.
// ============================================================================

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
var string G_SIG  = "Big-Move Bubbles"
var string G_TIME = "Time Filter"
var string G_LVL  = "Key Levels"
var string G_SELF = "Self-Check (grades each bubble on this chart)"
var string G_ALL  = "Every-Bar Bubbles (optional)"
var string G_DATA = "Data Source"
var string G_DISP = "Display"

showSig  = input.bool(true,  "Show Big-Move Bubbles",                         group = G_SIG)
useAbs   = input.bool(true,  "ABS — Absorption / Trapped Traders (reversal)", group = G_SIG)
useDiv   = input.bool(true,  "DIV — Delta Divergence (reversal)",             group = G_SIG)
useBrk   = input.bool(true,  "BRK — Initiative Breakout (continuation)",      group = G_SIG)
sweepLen = input.int(20,     "Level Lookback (bars)", minval = 2, maxval = 200, group = G_SIG,
     tooltip = "The high/low a bar must sweep (ABS, DIV) or close beyond (BRK).")
avgLen   = input.int(50,     "Average |Δ| Length (bars)", minval = 5, maxval = 500, group = G_SIG)
relVolIn = input.float(1.5,  "Min Relative Volume (ABS, BRK)", minval = 0.0, step = 0.1, group = G_SIG,
     tooltip = "Bar volume ÷ its prior 20-bar average. Big moves start with heavy participation; 1.5 = 50% above normal. 0 = off.")
absMult  = input.float(2.0,  "ABS: Opposing Δ ≥ × Avg |Δ|", minval = 0.5, step = 0.1, group = G_SIG)
absClose = input.float(0.5,  "ABS: Min Close Position (fraction of range)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_SIG,
     tooltip = "Long: the close must be at least this far up the bar's range (0.5 = upper half). Short: mirrored.")
divMult  = input.float(1.0,  "DIV: Net Δ Since Prior Extreme ≥ × Avg |Δ|", minval = 0.1, step = 0.1, group = G_SIG)
brkMult  = input.float(2.5,  "BRK: Same-Way Δ ≥ × Avg |Δ|", minval = 0.5, step = 0.1, group = G_SIG)
brkClose = input.float(0.7,  "BRK: Min Close Position (fraction of range)", minval = 0.5, maxval = 1.0, step = 0.05, group = G_SIG)
cooldown = input.int(10,     "Min Bars Between Bubbles (per side)", minval = 0, group = G_SIG)

useTime  = input.bool(true,  "Only Show Bubbles Inside Trade Windows", group = G_TIME,
     tooltip = "Setups outside the windows get no bubble or alert, but they are still graded silently: the dashboard's 'outside window' row shows how they would have done, so you can see whether the filter helps. With both windows unticked the filter is off.")
win1On   = input.bool(true,  "Window 1", inline = "w1", group = G_TIME)
win1     = input.session("0930-1130", "", inline = "w1", group = G_TIME)
win2On   = input.bool(false, "Window 2", inline = "w2", group = G_TIME)
win2     = input.session("1330-1600", "", inline = "w2", group = G_TIME)
winTz    = input.string("America/New_York", "Window Time Zone", options = ["America/New_York", "America/Chicago", "Europe/London", "UTC"], group = G_TIME)

showPD   = input.bool(true,  "Prior Day High / Low (PDH / PDL)", group = G_LVL)
pdSrc    = input.string("RTH 09:30–16:00 NY", "Prior Day From", options = ["RTH 09:30–16:00 NY", "Full Session"], group = G_LVL,
     tooltip = "RTH = the last regular session (09:30–16:00 New York). Full Session = the whole previous trading day from the daily bar.")
showON   = input.bool(true,  "Overnight High / Low (ONH / ONL, 18:00–09:30 NY)", group = G_LVL,
     tooltip = "Built from this chart's bars between 18:00 and 09:30 New York; shown from 09:30 until the next overnight starts.")
showOR   = input.bool(true,  "Opening Range High / Low (ORH / ORL)", group = G_LVL)
orMins   = input.int(15,     "Opening Range Minutes (from 09:30 NY)", minval = 1, maxval = 120, group = G_LVL,
     tooltip = "Shown once the range is complete, until 16:00. Needs chart bars no longer than the range (e.g. 1m/5m/15m for 15 minutes).")
showVW   = input.bool(true,  "VWAP", group = G_LVL)
vwAnchor = input.string("Trading Day (18:00 NY)", "VWAP Anchor", options = ["Trading Day (18:00 NY)", "RTH Open (09:30 NY)"], group = G_LVL)
lvlTol   = input.float(0.15, "Level Touch Tolerance (× ATR 14)", minval = 0.0, step = 0.05, group = G_LVL,
     tooltip = "Reversal (ABS/DIV) long: the bar traded within this distance of a level, or through it, and closed above it (short: mirrored). Breakout (BRK): the bar crossed the level and closed beyond it.")
onlyLvl  = input.bool(false, "Only Show Bubbles at a Key Level", group = G_LVL,
     tooltip = "Bubbles away from levels get no bubble or alert but are still graded silently, so the dashboard compares 'at key level' with 'away from levels'.")
drawLvl  = input.bool(true,  "Draw Levels on Chart", group = G_LVL)

gradeOn  = input.bool(true,  "Grade Every Bubble",                            group = G_SELF,
     tooltip = "Entry = the bubble bar's close. Invalidation = one tick beyond that bar's low (long) / high (short). Win = price trades at least one tick through the target first. Loss = invalidation reached first; a gap past it is booked at the bar's open, and if both print in one bar it counts as a loss. Unresolved after N bars = closed at market. No fees or slippage.")
rrTarget = input.float(2.0,  "Target (R multiple)", minval = 0.5, step = 0.5, group = G_SELF)
maxHold  = input.int(30,     "Bars to Resolve", minval = 1, maxval = 500,     group = G_SELF)
showLvl  = input.bool(true,  "Draw Invalidation Line",                        group = G_SELF)
showOut  = input.bool(true,  "Show Outcome Labels",                           group = G_SELF)

showBub  = input.bool(false, "Show Every-Bar Delta Bubbles", group = G_ALL,
     tooltip = "Off = only big-move setup bubbles. On = also a bubble on every bar with above-average delta.")
bubMin   = input.float(1.0,  "Hide Bubbles Smaller Than × Avg |Δ|", minval = 0.0, step = 0.25, group = G_ALL)
bubText  = input.float(2.5,  "Print the Δ Number on Bubbles ≥ × Avg |Δ|", minval = 0.5, step = 0.25, group = G_ALL)

ibChoice = input.string("Auto", "Intrabar Resolution", options = ["Auto", "1 minute"], group = G_DATA,
     tooltip = "Lower-timeframe bars used to split each chart bar's volume into buying and selling. Auto = 1 minute on intraday charts, 5 minutes on daily, 60 minutes above.")
useLive  = input.bool(true, "Live Tick Delta on Realtime Bars", group = G_DATA,
     tooltip = "While the chart is open, measure delta tick by tick (uptick volume = buying, downtick volume = selling). Only bars watched from their first trade use it. On 1m charts big-move bubbles come from this; it restarts whenever the chart reloads.")
minRes   = input.int(3, "Min Intrabars per Bar for Signals", minval = 1, group = G_DATA,
     tooltip = "Intrabar delta is trusted for signals only when each chart bar holds at least this many intrabars (5m chart / 1m data = 5). A 1m chart with 1m data has 1, so its signals come from live ticks.")

bullCol  = input.color(#26A69A, "Up / Buying Color",    group = G_DISP)
bearCol  = input.color(#EF5350, "Down / Selling Color", group = G_DISP)
showDash = input.bool(true, "Show Dashboard",            group = G_DISP)
dashData = input.bool(true, "Dashboard: Show Data Rows",  group = G_DISP,
     tooltip = "Off = only the bubble status and self-check rows.")
dashPos  = input.string("Bottom Right", "Dashboard Position", options = ["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group = G_DISP)
cvdReset = input.string("Trading Day", "CVD Anchor (dashboard)", options = ["Trading Day", "RTH Open (09:30 NY)", "Week", "Never"], group = G_DISP)

// data-quality grades, lowest to highest
const int Q_NONE  = 0   // no intrabar data for this bar
const int Q_LOW   = 1   // intrabar as large as the chart bar
const int Q_IB    = 2   // classified from intrabars
const int Q_TICK  = 3   // measured live, tick by tick
const int WARM    = 20  // bars an average needs before signals may use it
const int MAXOPEN = 60  // most setups graded at once
// self-check buckets: 0-2 = visible ABS/DIV/BRK, 3 = in window at a key level,
// 4 = in window away from levels, 5 = outside the trade windows
const int NBUCKET = 6

// ─────────────────────────────────────────────────────────────
// TYPES & HELPERS
// ─────────────────────────────────────────────────────────────
type Setup
    int   kind     // 0 ABS, 1 DIV, 2 BRK
    bool  isLong
    int   bar
    float entry
    float stop
    float target
    float risk
    line  lvl
    bool  vis      // drawn on the chart (passed the filters)
    bool  inW      // inside a trade window
    bool  atL      // formed at a key level

f_tfLabel(simple string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? str.tostring(s / 60) + "m" : s < 86400 ? str.tostring(s / 3600) + "H" : tf

f_signed(float x) =>
    na(x) ? "—" : (x > 0 ? "+" : "") + str.tostring(x, format.volume)

f_kindName(int k) =>
    k == 0 ? "ABS" : k == 1 ? "DIV" : "BRK"

// ─────────────────────────────────────────────────────────────
// INTRABAR ENGINE (history + forming bar)
// ─────────────────────────────────────────────────────────────
string ibTf = timeframe.isseconds ? "1S" : ibChoice == "1 minute" or timeframe.isintraday ? "1" : timeframe.isdaily ? "5" : "60"

int    ibSec   = timeframe.in_seconds(ibTf)
int    chSec   = timeframe.in_seconds()
int    expRes  = math.max(1, math.floor(chSec / ibSec))
bool   ibSigOk = expRes >= minRes
string ibLabel = f_tfLabel(ibTf)

// runs on each intrabar: the whole intrabar volume goes to its direction
f_upDown() =>
    var bool isBuy = true
    if close > open
        isBuy := true
    else if close < open
        isBuy := false
    else if close > close[1]
        isBuy := true
    else if close < close[1]
        isBuy := false
    float v = nz(volume)
    [isBuy ? v : 0.0, isBuy ? 0.0 : v, hlc3 * v]

// Heikin Ashi / Renko etc. would feed synthetic prices — always read real bars.
// 100000 = the intrabar cap of every non-professional plan, so 5m/15m history
// is covered instead of only the latest chart-bar-count of 1m bars.
string ibSym = chart.is_standard ? syminfo.tickerid : ticker.standard(syminfo.tickerid)
[ibBuyArr, ibSellArr, ibPvArr] = request.security_lower_tf(ibSym, ibTf, f_upDown(),
     ignore_invalid_timeframe = true, calc_bars_count = 100000)

int   ibCount = na(ibBuyArr) ? 0 : array.size(ibBuyArr)
float ibBuy   = ibCount > 0 ? array.sum(ibBuyArr)  : na
float ibSell  = ibCount > 0 ? array.sum(ibSellArr) : na
float ibDelta = ibBuy - ibSell
float ibVol   = ibBuy + ibSell
// volume-weighted typical price of the bar's intrabars — where its bubble sits
float ibVwap  = ibCount > 0 and ibVol > 0 ? array.sum(ibPvArr) / ibVol : hl2
int   ibQ     = ibCount == 0 ? Q_NONE : ibSigOk ? Q_IB : Q_LOW

// ─────────────────────────────────────────────────────────────
// LIVE TICK ENGINE (realtime only — varip survives intrabar updates)
// ─────────────────────────────────────────────────────────────
// Bar Replay feeds whole bars, not ticks; non-standard charts feed synthetic
// prices — neither is real tick data
var bool isReplay = str.contains(syminfo.tickerid, "replay")
bool     tickOn   = useLive and chart.is_standard and not isReplay

varip int   tkBar      = -1
varip int   tkStartBar = -1
varip float tkLastPx   = na
varip float tkLastVol  = 0.0
varip int   tkLastDir  = 0
varip float tkBuy      = 0.0
varip float tkSell     = 0.0
varip float tkVol      = 0.0
varip float tkPV       = 0.0
varip int   tkUpdates  = 0

if tickOn and barstate.isrealtime
    if tkStartBar < 0
        tkStartBar := bar_index
    if bar_index != tkBar
        tkBar     := bar_index
        tkBuy     := 0.0
        tkSell    := 0.0
        tkVol     := 0.0
        tkPV      := 0.0
        tkLastVol := 0.0
        tkUpdates := 0
    float v   = nz(volume)
    // bar volume only grows; a drop is a feed correction, so keep the high-water
    // mark and never count the same contracts twice
    float dv  = math.max(v - tkLastVol, 0.0)
    int   dir = na(tkLastPx) ? 0 : close > tkLastPx ? 1 : close < tkLastPx ? -1 : tkLastDir
    if dv > 0
        if dir > 0
            tkBuy += dv
        else if dir < 0
            tkSell += dv
        tkVol     += dv
        tkPV      += close * dv
        tkUpdates += 1
    tkLastDir := dir
    tkLastPx  := close
    tkLastVol := math.max(tkLastVol, v)

// the bar the script started on was joined mid-bar — only later bars are complete
bool  tickFull = tickOn and barstate.isrealtime and tkStartBar >= 0 and bar_index > tkStartBar
float tkVwap   = tkVol > 0 ? tkPV / tkVol : hl2

// ─────────────────────────────────────────────────────────────
// BEST AVAILABLE DELTA PER BAR (readout only — signals pick their own source)
// ─────────────────────────────────────────────────────────────
int   quality = tickFull ? Q_TICK : ibQ
float buyV    = tickFull ? tkBuy  : ibBuy
float sellV   = tickFull ? tkSell : ibSell
float delta   = quality == Q_NONE ? na : buyV - sellV

var float totVol = 0.0
totVol += nz(volume)
if barstate.islast and totVol == 0
    runtime.error("This symbol has no volume data, so buy/sell delta can't be calculated.")

// coverage counters (var rolls back on realtime updates, so each bar counts once)
var int nAll  = 0
var int nTick = 0
var int nIb   = 0
var int nLow  = 0
nAll += 1
if quality == Q_TICK
    nTick += 1
else if quality == Q_IB
    nIb += 1
else if quality == Q_LOW
    nLow += 1

// ─────────────────────────────────────────────────────────────
// CVD + HIGHER-TIMEFRAME DELTA (intrabar data only: one consistent scale that
// matches TradingView's own CVD and is rebuilt from history on reload)
// ─────────────────────────────────────────────────────────────
bool dayChg   = timeframe.change("D")
bool weekChg  = timeframe.change("W")
bool rthNow   = not na(time(timeframe.period, "0930-1600", "America/New_York"))
// the day change also catches charts whose session is RTH-only
bool rthStart = rthNow and (not rthNow[1] or dayChg)

bool cvdResetNow = switch cvdReset
    "Trading Day"         => dayChg
    "RTH Open (09:30 NY)" => rthStart
    "Week"                => weekChg
    => false

var float cvd     = 0.0
var bool  cvdFull = false
// a reset on the very first loaded bar may be mid-period, so it doesn't count as full
if cvdResetNow
    cvd     := 0.0
    cvdFull := bar_index > 0
if ibCount > 0
    cvd += ibDelta
else
    cvdFull := false

f_htfDelta(simple string tf, float d) =>
    var float acc  = 0.0
    var bool  full = false
    if timeframe.change(tf)
        acc  := 0.0
        full := bar_index > 0
    if na(d)
        full := false
    else
        acc += d
    [acc, full]

float ibD = ibCount > 0 ? ibDelta : na
[d5,  f5]  = f_htfDelta("5",  ibD)
[d15, f15] = f_htfDelta("15", ibD)
[d60, f60] = f_htfDelta("60", ibD)

// ─────────────────────────────────────────────────────────────
// TIME FILTER
// ─────────────────────────────────────────────────────────────
bool inW1   = not na(time(timeframe.period, win1, winTz))
bool inW2   = not na(time(timeframe.period, win2, winTz))
bool anyWin = win1On or win2On
bool timeOn = useTime and anyWin
bool inWin  = not timeOn or (win1On and inW1) or (win2On and inW2)

// ─────────────────────────────────────────────────────────────
// KEY LEVELS — built only from bars that already exist (no look-ahead), so a
// level a bubble is matched to was known when the bubble printed
// ─────────────────────────────────────────────────────────────
// a session that starts on the first loaded bar may be partial, so it is skipped
bool rthOpenBar = rthStart and bar_index > 0
bool rthEnd     = not rthNow and rthNow[1]

// prior regular session (09:30–16:00 NY)
var float rthHiRun = na
var float rthLoRun = na
var bool  rthLive  = false
var float pdhR     = na
var float pdlR     = na
// finalize on the first bar after RTH, or at the next open on RTH-only charts
if (rthEnd or rthOpenBar) and rthLive
    pdhR    := rthHiRun
    pdlR    := rthLoRun
    rthLive := false
if rthOpenBar
    rthHiRun := high
    rthLoRun := low
    rthLive  := true
else if rthNow and rthLive
    rthHiRun := math.max(rthHiRun, high)
    rthLoRun := math.min(rthLoRun, low)

// prior full trading day from the daily bar ([1] + lookahead_on = no future leak)
[pdhD, pdlD] = request.security(ibSym, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// overnight session (18:00–09:30 NY), valid from 09:30 until the next 18:00
bool onNow   = not na(time(timeframe.period, "1800-0930", "America/New_York"))
bool onStart = onNow and not onNow[1] and bar_index > 0
bool onEnd   = not onNow and onNow[1]
var float onHiRun = na
var float onLoRun = na
var bool  onLive  = false
var float onhV    = na
var float onlV    = na
if onStart
    onHiRun := high
    onLoRun := low
    onLive  := true
    onhV    := na
    onlV    := na
else if onNow and onLive
    onHiRun := math.max(onHiRun, high)
    onLoRun := math.min(onLoRun, low)
if onEnd and onLive
    onhV   := onHiRun
    onlV   := onLoRun
    onLive := false

// opening range: the first orMins minutes after 09:30 NY, valid until 16:00
bool orOk = chSec <= orMins * 60
var float orHiRun = na
var float orLoRun = na
var int   orEndT  = na
var float orhV    = na
var float orlV    = na
if rthOpenBar
    orHiRun := high
    orLoRun := low
    orEndT  := time + orMins * 60000
    orhV    := na
    orlV    := na
else if not na(orEndT) and rthNow
    if time < orEndT
        orHiRun := math.max(orHiRun, high)
        orLoRun := math.min(orLoRun, low)
    else if na(orhV)
        orhV := orHiRun
        orlV := orLoRun
if rthEnd
    orEndT := na
    orhV   := na
    orlV   := na

// VWAP from the chart's real volume
bool  vwReset = vwAnchor == "RTH Open (09:30 NY)" ? rthOpenBar : dayChg
float vwapV   = ta.vwap(hlc3, vwReset)

bool  pdRth = pdSrc == "RTH 09:30–16:00 NY"
float lvPDH = showPD ? (pdRth ? pdhR : pdhD) : na
float lvPDL = showPD ? (pdRth ? pdlR : pdlD) : na
float lvONH = showON ? onhV : na
float lvONL = showON ? onlV : na
float lvORH = showOR and orOk ? orhV : na
float lvORL = showOR and orOk ? orlV : na
float lvVW  = showVW ? vwapV : na

float atr14     = ta.atr(14)
float tolPx     = lvlTol * nz(atr14)
// taken on every bar so the level test below can run conditionally
float prevClose = nz(close[1], open)

// did a setup in this direction form at level L?
f_hit(float L, bool isLong, bool isBrk) =>
    bool hit = false
    if not na(L)
        if isBrk
            hit := isLong ? close > L and math.min(open, prevClose) <= L : close < L and math.max(open, prevClose) >= L
        else
            hit := isLong ? low <= L + tolPx and close > L : high >= L - tolPx and close < L
    hit

// first matching level by priority ("" = none)
f_levelAt(bool isLong, bool isBrk) =>
    f_hit(lvPDH, isLong, isBrk) ? "PDH" : f_hit(lvPDL, isLong, isBrk) ? "PDL" :
         f_hit(lvONH, isLong, isBrk) ? "ONH" : f_hit(lvONL, isLong, isBrk) ? "ONL" :
         f_hit(lvORH, isLong, isBrk) ? "ORH" : f_hit(lvORL, isLong, isBrk) ? "ORL" :
         f_hit(lvVW, isLong, isBrk) ? "VWAP" : ""

f_levelPx(string n) =>
    n == "PDH" ? lvPDH : n == "PDL" ? lvPDL : n == "ONH" ? lvONH : n == "ONL" ? lvONL :
         n == "ORH" ? lvORH : n == "ORL" ? lvORL : n == "VWAP" ? lvVW : na

// ─────────────────────────────────────────────────────────────
// |Δ| BASELINES — tick delta and intrabar delta live on different scales
// (whole-intrabar classification overstates |Δ|), so each is only ever
// compared with its own kind. Running mean until the EMA span is reached, so
// the first bars don't dominate the baseline.
// ─────────────────────────────────────────────────────────────
float alpha = 2.0 / (avgLen + 1)

var float avgIb  = na
var int   nIbAvg = 0
if ibCount > 0
    nIbAvg += 1
    avgIb  := nz(avgIb) + (math.abs(ibDelta) - nz(avgIb)) * math.max(alpha, 1.0 / nIbAvg)

var float avgTick  = na
var int   nTickAvg = 0
if quality == Q_TICK
    nTickAvg += 1
    avgTick  := nz(avgTick) + (math.abs(delta) - nz(avgTick)) * math.max(alpha, 1.0 / nTickAvg)

// ─────────────────────────────────────────────────────────────
// SIGNAL SOURCE — intrabar wherever it is signal-grade (3m+ charts: the same
// data live and after a reload, apart from rare provider corrections, so
// alerts match the chart); live ticks only where history is too coarse (1m
// chart on a free plan)
// ─────────────────────────────────────────────────────────────
bool  ibUsable = ibSigOk and ibCount > 0
bool  tickWarm = nTickAvg > WARM
bool  useTick  = not ibSigOk and quality == Q_TICK and tickWarm
float sigDelta = useTick ? delta : ibUsable ? ibDelta : na
float sigAvg   = useTick ? avgTick[1] : avgIb[1]
bool  sigReady = useTick or (ibUsable and nIbAvg > WARM)

// running delta + count of bars missing that kind, per kind, to measure a leg
var float cumIb = 0.0
var int   badIb = 0
var float cumTk = 0.0
var int   badTk = 0
if ibUsable
    cumIb += ibDelta
else
    badIb += 1
if quality == Q_TICK
    cumTk += delta
else
    badTk += 1
max_bars_back(cumIb, 256)
max_bars_back(badIb, 256)
max_bars_back(cumTk, 256)
max_bars_back(badTk, 256)

float prevLL = ta.lowest(low, sweepLen)[1]
float prevHH = ta.highest(high, sweepLen)[1]
// bars back from this bar to the bar that set the prior extreme (1..sweepLen)
int   llBack = 1 - nz(ta.lowestbars(low, sweepLen)[1])
int   hhBack = 1 - nz(ta.highestbars(high, sweepLen)[1])

// net delta of the signal's own data kind, from the bar after the prior
// extreme through this bar; valid only if every bar in between has that kind
float legBull   = useTick ? cumTk - cumTk[llBack] : cumIb - cumIb[llBack]
float legBear   = useTick ? cumTk - cumTk[hhBack] : cumIb - cumIb[hhBack]
bool  legBullOk = useTick ? badTk == badTk[llBack] : badIb == badIb[llBack]
bool  legBearOk = useTick ? badTk == badTk[hhBack] : badIb == badIb[hhBack]

float rng          = math.max(high - low, syminfo.mintick)
float bullClosePos = (close - low) / rng
float bearClosePos = (high - close) / rng

bool sweepBull = low < prevLL and close > prevLL
bool sweepBear = high > prevHH and close < prevHH

// relative volume against the prior 20 bars (the bar isn't in its own average)
float volAvg = ta.sma(nz(volume), 20)[1]
float relVol = volAvg > 0 ? nz(volume) / volAvg : na
bool  volOk  = relVolIn <= 0 or (not na(relVol) and relVol >= relVolIn)

bool baseOk = barstate.isconfirmed and chart.is_standard and sigReady and not na(sigDelta) and not na(sigAvg) and sigAvg > 0

bool bullAbs = useAbs and baseOk and volOk and sweepBull and sigDelta <= -absMult * sigAvg and bullClosePos >= absClose
bool bearAbs = useAbs and baseOk and volOk and sweepBear and sigDelta >=  absMult * sigAvg and bearClosePos >= absClose
bool bullDiv = useDiv and baseOk and sweepBull and not bullAbs and legBullOk and legBull >=  divMult * sigAvg
bool bearDiv = useDiv and baseOk and sweepBear and not bearAbs and legBearOk and legBear <= -divMult * sigAvg
// a breakout is a CLOSE beyond the level, so it never coincides with a same-side
// sweep; a wide bar can sweep the low and close above the high, which the kind
// selection below treats as a breakout
bool bullBrk = useBrk and baseOk and volOk and close > prevHH and sigDelta >=  brkMult * sigAvg and bullClosePos >= brkClose
bool bearBrk = useBrk and baseOk and volOk and close < prevLL and sigDelta <= -brkMult * sigAvg and bearClosePos >= brkClose

bool bullAny = bullAbs or bullDiv or bullBrk
bool bearAny = bearAbs or bearDiv or bearBrk
// an outside bar that qualifies both ways has no directional read, whatever the cooldowns
bool bullOne = bullAny and not bearAny
bool bearOne = bearAny and not bullAny

int bullKind = bullAbs ? 0 : bullBrk ? 2 : 1
int bearKind = bearAbs ? 0 : bearBrk ? 2 : 1

// key level the setup formed at ("" = none)
string bullLvl = bullOne ? f_levelAt(true,  bullKind == 2) : ""
string bearLvl = bearOne ? f_levelAt(false, bearKind == 2) : ""

// shown = inside a trade window (and at a level, if that filter is on); the
// rest are graded silently so the dashboard can show what the filters do
bool bullShow = inWin and (not onlyLvl or bullLvl != "")
bool bearShow = inWin and (not onlyLvl or bearLvl != "")

f_cdOk(int last) =>
    cooldown == 0 or na(last) or bar_index - last >= cooldown

var int lastBullSig = na
var int lastBearSig = na
var int lastBullHid = na
var int lastBearHid = na
bool bullSig = bullOne and bullShow and f_cdOk(lastBullSig)
bool bearSig = bearOne and bearShow and f_cdOk(lastBearSig)
bool bullHid = bullOne and not bullShow and f_cdOk(lastBullHid)
bool bearHid = bearOne and not bearShow and f_cdOk(lastBearHid)
if bullSig
    lastBullSig := bar_index
if bearSig
    lastBearSig := bar_index
if bullHid
    lastBullHid := bar_index
if bearHid
    lastBearHid := bar_index

// setup strength relative to its own trigger level → bubble size
float bullStr = not bullSig ? na : bullKind == 0 ? -sigDelta / sigAvg / absMult :
     bullKind == 1 ? legBull / sigAvg / divMult : sigDelta / sigAvg / brkMult
float bearStr = not bearSig ? na : bearKind == 0 ? sigDelta / sigAvg / absMult :
     bearKind == 1 ? -legBear / sigAvg / divMult : -sigDelta / sigAvg / brkMult

// ─────────────────────────────────────────────────────────────
// BIG-MOVE BUBBLES
// ─────────────────────────────────────────────────────────────
float evY = useTick ? tkVwap : ibVwap
plotshape(showSig and bullSig and bullStr <  1.5 ? evY : na, "Up Setup",            shape.circle, location.absolute, color.new(bullCol, 35), size = size.large, display = display.pane)
plotshape(showSig and bullSig and bullStr >= 1.5 ? evY : na, "Up Setup (strong)",   shape.circle, location.absolute, color.new(bullCol, 20), size = size.huge,  display = display.pane)
plotshape(showSig and bearSig and bearStr <  1.5 ? evY : na, "Down Setup",          shape.circle, location.absolute, color.new(bearCol, 35), size = size.large, display = display.pane)
plotshape(showSig and bearSig and bearStr >= 1.5 ? evY : na, "Down Setup (strong)", shape.circle, location.absolute, color.new(bearCol, 20), size = size.huge,  display = display.pane)

string sigSrc = useTick ? "live tick-rule" : ibLabel + " intrabars"
string rvTxt  = na(relVol) ? "" : "\nVolume " + str.tostring(relVol, "#.#") + "× its 20-bar average"
string notTxt = (gradeOn ? "\nGraded by the self-check; not" : "\nNot graded (self-check off); not") + " a guarantee — confirm with price."

f_lvlTxt(string n) =>
    n == "" ? "\nNot at a key level" : "\n★ At key level " + n + " " + str.tostring(f_levelPx(n), format.mintick)

if bullSig
    string tip = bullKind == 0 ?
         "ABSORPTION → reversal UP setup. Swept the " + str.tostring(sweepLen) + "-bar low and sellers hit it hard (Δ " + f_signed(sigDelta) +
         " = " + str.tostring(-sigDelta / sigAvg, "#.#") + "× avg |Δ|), yet the bar closed back above the old low at " +
         str.tostring(bullClosePos * 100, "#") + "% of its range — sellers trapped below." :
         bullKind == 1 ?
         "DELTA DIVERGENCE → reversal UP setup. Swept the " + str.tostring(sweepLen) + "-bar low, but net Δ since the prior low is " +
         f_signed(legBull) + " (" + str.tostring(legBull / sigAvg, "#.#") + "× avg |Δ|) — buyers were the aggressors into the new low." :
         "INITIATIVE BREAKOUT → continuation UP setup. Closed above the " + str.tostring(sweepLen) + "-bar high on Δ " + f_signed(sigDelta) +
         " = " + str.tostring(sigDelta / sigAvg, "#.#") + "× avg |Δ|, closing at " + str.tostring(bullClosePos * 100, "#") +
         "% of its range — buyers broke the level and held it."
    if showSig
        label.new(bar_index, low, f_kindName(bullKind) + (bullStr >= 1.5 ? " ▲▲" : " ▲") + (bullLvl != "" ? " ★" + bullLvl : ""), yloc = yloc.belowbar,
             style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.small,
             tooltip = tip + f_lvlTxt(bullLvl) + rvTxt + "\nInvalid at or below " + str.tostring(low - syminfo.mintick, format.mintick) +
                  (gradeOn ? " · graded target " + str.tostring(close + rrTarget * (close - low + syminfo.mintick), format.mintick) : "") +
                  "\nData: " + sigSrc + notTxt)
    alert("OF Bubbles: " + f_kindName(bullKind) + " UP setup" + (bullLvl != "" ? " at " + bullLvl : "") + " on " + syminfo.ticker + " " + f_tfLabel(timeframe.period) +
         " @ " + str.tostring(close, format.mintick) + " — invalid at or below " + str.tostring(low - syminfo.mintick, format.mintick),
         alert.freq_once_per_bar_close)
if bearSig
    string tip = bearKind == 0 ?
         "ABSORPTION → reversal DOWN setup. Swept the " + str.tostring(sweepLen) + "-bar high and buyers hit it hard (Δ " + f_signed(sigDelta) +
         " = " + str.tostring(sigDelta / sigAvg, "#.#") + "× avg |Δ|), yet the bar closed back below the old high at " +
         str.tostring((1 - bearClosePos) * 100, "#") + "% of its range — buyers trapped above." :
         bearKind == 1 ?
         "DELTA DIVERGENCE → reversal DOWN setup. Swept the " + str.tostring(sweepLen) + "-bar high, but net Δ since the prior high is " +
         f_signed(legBear) + " (" + str.tostring(-legBear / sigAvg, "#.#") + "× avg |Δ|) — sellers were the aggressors into the new high." :
         "INITIATIVE BREAKOUT → continuation DOWN setup. Closed below the " + str.tostring(sweepLen) + "-bar low on Δ " + f_signed(sigDelta) +
         " = " + str.tostring(-sigDelta / sigAvg, "#.#") + "× avg |Δ|, closing at " + str.tostring((1 - bearClosePos) * 100, "#") +
         "% of its range — sellers broke the level and held it."
    if showSig
        label.new(bar_index, high, f_kindName(bearKind) + (bearStr >= 1.5 ? " ▼▼" : " ▼") + (bearLvl != "" ? " ★" + bearLvl : ""), yloc = yloc.abovebar,
             style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.small,
             tooltip = tip + f_lvlTxt(bearLvl) + rvTxt + "\nInvalid at or above " + str.tostring(high + syminfo.mintick, format.mintick) +
                  (gradeOn ? " · graded target " + str.tostring(close - rrTarget * (high + syminfo.mintick - close), format.mintick) : "") +
                  "\nData: " + sigSrc + notTxt)
    alert("OF Bubbles: " + f_kindName(bearKind) + " DOWN setup" + (bearLvl != "" ? " at " + bearLvl : "") + " on " + syminfo.ticker + " " + f_tfLabel(timeframe.period) +
         " @ " + str.tostring(close, format.mintick) + " — invalid at or above " + str.tostring(high + syminfo.mintick, format.mintick),
         alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────
// SELF-CHECK — grades every bubble on this chart, pessimistically
// ─────────────────────────────────────────────────────────────
var array<Setup> setups = array.new<Setup>()
var array<int>   gWin   = array.new<int>(NBUCKET, 0)
var array<int>   gLoss  = array.new<int>(NBUCKET, 0)
var array<int>   gTime  = array.new<int>(NBUCKET, 0)
var array<float> gNetR  = array.new<float>(NBUCKET, 0.0)

f_add(int b, int res, float r) =>
    if res == 1
        array.set(gWin, b, array.get(gWin, b) + 1)
    else if res == -1
        array.set(gLoss, b, array.get(gLoss, b) + 1)
    else
        array.set(gTime, b, array.get(gTime, b) + 1)
    array.set(gNetR, b, array.get(gNetR, b) + r)

// visible setups count in their kind's row; every setup also counts in exactly
// one filter row (at level / away from levels / outside window)
f_book(Setup s, int res, float r) =>
    if s.vis
        f_add(s.kind, res, r)
    f_add(s.inW ? (s.atL ? 3 : 4) : 5, res, r)

f_open(int kind, bool isLong, bool vis, bool inW, bool atL) =>
    float entry = close
    float stop  = isLong ? low - syminfo.mintick : high + syminfo.mintick
    float risk  = math.abs(entry - stop)
    if risk > 0
        line ln = vis and showLvl ? line.new(bar_index, stop, bar_index + 1, stop, color = color.new(isLong ? bullCol : bearCol, 25),
             style = line.style_dotted, width = 1) : na
        array.push(setups, Setup.new(kind, isLong, bar_index, entry, stop,
             isLong ? entry + rrTarget * risk : entry - rrTarget * risk, risk, ln, vis, inW, atL))

if gradeOn and barstate.isconfirmed
    // grade the setups opened on earlier bars (entry is the signal bar's close)
    if array.size(setups) > 0
        for i = array.size(setups) - 1 to 0
            Setup s = array.get(setups, i)
            if not na(s.lvl)
                line.set_x2(s.lvl, bar_index)
            bool  stopHit = s.isLong ? low  <= s.stop : high >= s.stop
            // a resting target order isn't guaranteed a fill on a touch: price must trade through it
            bool  tgtHit  = s.isLong ? high >= s.target + syminfo.mintick : low <= s.target - syminfo.mintick
            int   res     = 0     // 1 win, -1 loss, 2 time exit
            float r       = 0.0
            float exitPx  = close
            // invalidation beats target when both print inside one bar
            if stopHit
                res    := -1
                // a gap past the line (e.g. the 18:00 ET reopen) fills at the open, not at the line
                exitPx := s.isLong ? math.min(open, s.stop) : math.max(open, s.stop)
                r      := (s.isLong ? exitPx - s.entry : s.entry - exitPx) / s.risk
            else if tgtHit
                res    := 1
                exitPx := s.target
                r      := rrTarget
            else if bar_index - s.bar >= maxHold
                res := 2
                r   := (s.isLong ? close - s.entry : s.entry - close) / s.risk
            if res != 0
                f_book(s, res, r)
                if not na(s.lvl)
                    line.set_color(s.lvl, color.new(color.gray, 60))
                if showOut and s.vis
                    label.new(bar_index, exitPx,
                         (res == 1 ? "✔ " : res == -1 ? "✘ " : "⏱ ") + f_kindName(s.kind) + " " + (r >= 0 ? "+" : "") + str.tostring(r, "#.#") + "R",
                         style = label.style_label_left, size = size.tiny, textcolor = color.white,
                         color = color.new(res == 1 ? color.teal : res == -1 ? color.maroon : color.gray, 25))
                array.remove(setups, i)
    // open this bar's setup after grading, so it is never graded on its own bar
    if bullSig or bullHid
        f_open(bullKind, true,  bullSig, inWin, bullLvl != "")
    if bearSig or bearHid
        f_open(bearKind, false, bearSig, inWin, bearLvl != "")
    // cap the open set; anything evicted is closed at market, never dropped
    while array.size(setups) > MAXOPEN
        Setup old = array.shift(setups)
        f_book(old, 2, (old.isLong ? close - old.entry : old.entry - close) / old.risk)
        if not na(old.lvl)
            line.set_color(old.lvl, color.new(color.gray, 60))

// ─────────────────────────────────────────────────────────────
// EVERY-BAR DELTA BUBBLES (optional, off by default)
// ─────────────────────────────────────────────────────────────
// live bars use tick delta once its own baseline has a few bars; until then
// the bubble shows the bar's intrabar delta so sizes stay comparable
bool  bubTick = quality == Q_TICK and nTickAvg > 5
float bubD    = bubTick ? delta : ibCount > 0 ? ibDelta : na
float bubAvg  = bubTick ? avgTick[1] : avgIb[1]
int   bubQ    = bubTick ? Q_TICK : ibQ
float bubY    = bubTick ? tkVwap : ibVwap
float bubR    = na(bubD) or na(bubAvg) or bubAvg <= 0 or (not bubTick and nIbAvg < 6) ? na : math.abs(bubD) / bubAvg
int   bubTr   = bubQ == Q_TICK ? 0 : bubQ == Q_IB ? 25 : 60
color bubCol  = na(bubD) ? na : color.new(bubD >= 0 ? bullCol : bearCol, bubTr)

// exceptional bars get a numbered bubble once the bar has closed; every other
// qualifying bar (and the forming bar) gets a plain circle sized by |Δ|
bool numbered = showBub and barstate.isconfirmed and not na(bubR) and bubR >= bubText and bubR >= bubMin
bool circled  = showBub and not na(bubR) and bubR >= bubMin and not numbered
int  tier     = not circled ? 0 : bubR < 1.0 ? 1 : bubR < 1.5 ? 2 : bubR < 2.5 ? 3 : bubR < 4.0 ? 4 : 5

plotshape(tier == 1 ? bubY : na, "Δ Bubble XS", shape.circle, location.absolute, bubCol, size = size.tiny,   display = display.pane)
plotshape(tier == 2 ? bubY : na, "Δ Bubble S",  shape.circle, location.absolute, bubCol, size = size.small,  display = display.pane)
plotshape(tier == 3 ? bubY : na, "Δ Bubble M",  shape.circle, location.absolute, bubCol, size = size.normal, display = display.pane)
plotshape(tier == 4 ? bubY : na, "Δ Bubble L",  shape.circle, location.absolute, bubCol, size = size.large,  display = display.pane)
plotshape(tier == 5 ? bubY : na, "Δ Bubble XL", shape.circle, location.absolute, bubCol, size = size.huge,   display = display.pane)

var array<label> numLbls = array.new<label>()
if numbered
    string bubSrc = bubQ == Q_TICK ? "live tick-rule" : bubQ == Q_IB ? ibLabel + " intrabars" : ibLabel + " bar (low-res)"
    float  bB     = bubTick ? tkBuy  : ibBuy
    float  bS     = bubTick ? tkSell : ibSell
    array.push(numLbls, label.new(bar_index, bubY, f_signed(bubD), style = label.style_label_center,
         color = bubCol, textcolor = color.white, size = bubR >= 4.0 ? size.normal : size.small,
         tooltip = "Δ " + f_signed(bubD) + " = " + str.tostring(bubR, "#.#") + "× avg |Δ|" +
              "\nBuy " + str.tostring(bB, format.volume) + " · Sell " + str.tostring(bS, format.volume) +
              (bubTick ? "\nAt the live VWAP " : "\nAt ≈VWAP of the " + ibLabel + " bars (hlc3) ") + str.tostring(bubY, format.mintick) +
              "\nData: " + bubSrc))
    // cap number labels at 150 so they never push setup labels out of the 500-label budget
    if array.size(numLbls) > 150
        label.delete(array.shift(numLbls))

// ─────────────────────────────────────────────────────────────
// KEY LEVEL LINES
// ─────────────────────────────────────────────────────────────
// a one-bar gap wherever a level changes, so new days don't draw connectors
f_brk(float v) =>
    v != v[1] ? na : v

float pPDH = f_brk(lvPDH)
float pPDL = f_brk(lvPDL)
float pONH = f_brk(lvONH)
float pONL = f_brk(lvONL)
float pORH = f_brk(lvORH)
float pORL = f_brk(lvORL)
color colPD = color.new(#FF9800, 15)
color colON = color.new(#B388FF, 15)
color colOR = color.new(#90A4AE, 15)
color colVW = color.new(#FFD54F, 20)
plot(drawLvl ? pPDH  : na, "PDH",  colPD, 1, plot.style_linebr, display = display.pane + display.data_window)
plot(drawLvl ? pPDL  : na, "PDL",  colPD, 1, plot.style_linebr, display = display.pane + display.data_window)
plot(drawLvl ? pONH  : na, "ONH",  colON, 1, plot.style_linebr, display = display.pane + display.data_window)
plot(drawLvl ? pONL  : na, "ONL",  colON, 1, plot.style_linebr, display = display.pane + display.data_window)
plot(drawLvl ? pORH  : na, "ORH",  colOR, 1, plot.style_linebr, display = display.pane + display.data_window)
plot(drawLvl ? pORL  : na, "ORL",  colOR, 1, plot.style_linebr, display = display.pane + display.data_window)
plot(drawLvl ? lvVW  : na, "VWAP", colVW, 1, plot.style_line,   display = display.pane + display.data_window)

// names at the right edge: recreated on the last bar so they stay the newest
// labels (never garbage-collected) and never pile up
var array<label> lvlTags = array.new<label>()
f_tag(string n, float v, color c) =>
    if not na(v)
        array.push(lvlTags, label.new(bar_index + 2, v, n + " " + str.tostring(v, format.mintick),
             style = label.style_label_left, size = size.tiny, textcolor = c, color = color.new(color.black, 100)))
if barstate.islast
    while array.size(lvlTags) > 0
        label.delete(array.pop(lvlTags))
    if drawLvl
        f_tag("PDH",  lvPDH, colPD)
        f_tag("PDL",  lvPDL, colPD)
        f_tag("ONH",  lvONH, colON)
        f_tag("ONL",  lvONL, colON)
        f_tag("ORH",  lvORH, colOR)
        f_tag("ORL",  lvORL, colOR)
        f_tag("VWAP", lvVW,  colVW)

// raw numbers in the Data Window (location.top keeps them off the price scale)
plotchar(buyV,    "Buy Volume",  "", location.top, color = bullCol, display = display.data_window, format = format.volume)
plotchar(sellV,   "Sell Volume", "", location.top, color = bearCol, display = display.data_window, format = format.volume)
plotchar(delta,   "Delta",       "", location.top, display = display.data_window, format = format.volume)
plotchar(quality, "Data Quality (3 live · 2 intrabar · 1 low-res · 0 none)", "", location.top, display = display.data_window)

// ─────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────
f_row(table t, int r, string k, string v, color vc, string tip = "") =>
    table.cell(t, 0, r, k, text_color = color.silver, text_halign = text.align_left,  text_size = size.small, tooltip = tip)
    table.cell(t, 1, r, v, text_color = vc,           text_halign = text.align_right, text_size = size.small, tooltip = tip)

f_htfText(simple string tf, float acc, bool full) =>
    int    tfSec = timeframe.in_seconds(tf)
    string txt   = "n/a on this chart"
    if tfSec >= chSec and tfSec % chSec == 0
        string tag = not full ? "  partial" : tfSec / ibSec < minRes ? "  low-res" : ""
        txt := f_signed(acc) + tag
    txt

f_htfColor(simple string tf, float acc) =>
    int tfSec = timeframe.in_seconds(tf)
    tfSec >= chSec and tfSec % chSec == 0 ? (acc >= 0 ? bullCol : bearCol) : color.gray

f_gradeText(int k) =>
    int   w  = array.get(gWin, k)
    int   l  = array.get(gLoss, k)
    int   t  = array.get(gTime, k)
    float nr = array.get(gNetR, k)
    int   n  = w + l + t
    n == 0 ? "no closed setups yet" :
         str.tostring(w) + "W " + str.tostring(l) + "L " + str.tostring(t) + "T" +
         (w + l > 0 ? " · " + str.tostring(100.0 * w / (w + l), "#") + "%" : "") +
         " · " + (nr >= 0 ? "+" : "") + str.tostring(nr, "#.#") + "R"

f_gradeColor(int k) =>
    int n = array.get(gWin, k) + array.get(gLoss, k) + array.get(gTime, k)
    n == 0 ? color.gray : array.get(gNetR, k) >= 0 ? bullCol : bearCol

if showDash and barstate.islast
    var table dash = table.new(dashPos == "Top Right" ? position.top_right : dashPos == "Bottom Left" ? position.bottom_left :
         dashPos == "Top Left" ? position.top_left : position.bottom_right, 2, 18,
         bgcolor = color.new(#101418, 15), border_width = 1,
         border_color = color.new(color.gray, 70), frame_width = 1, frame_color = color.new(color.gray, 55))

    string sigTxt = not chart.is_standard ? "off · non-standard chart" :
         ibSigOk ? (nIbAvg > WARM ? "ready · " + ibLabel + " data" : "warming up") :
         not tickOn ? "off · history too coarse" :
         tickWarm ? "ready · live ticks (restart on reload)" :
         "needs " + str.tostring(WARM + 1 - nTickAvg) + " more live bars"

    string tzTxt  = winTz == "America/New_York" ? "NY" : winTz == "America/Chicago" ? "CHI" : winTz == "Europe/London" ? "LDN" : "UTC"
    string winTxt = not timeOn ? "all hours" :
         (win1On ? win1 : "") + (win1On and win2On ? ", " : "") + (win2On ? win2 : "") + " " + tzTxt
    string fltTxt = winTxt + (onlyLvl ? " · ★ levels only" : "")

    int openVis = 0
    if array.size(setups) > 0
        for i = 0 to array.size(setups) - 1
            Setup su = array.get(setups, i)
            if su.vis
                openVis += 1

    table.cell(dash, 0, 0, "ORDER FLOW BUBBLES", text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 0, f_tfLabel(timeframe.period) + " chart · " + ibLabel + " data", text_color = color.silver, text_halign = text.align_right, text_size = size.small)
    f_row(dash, 1,  "Big-move bubbles", sigTxt, str.startswith(sigTxt, "ready") ? bullCol : color.orange)
    f_row(dash, 2,  "Showing", fltTxt, color.white, "Bubbles are drawn only for setups that pass these filters.")
    f_row(dash, 3,  "Self-check", gradeOn ? "target " + str.tostring(rrTarget, "#.#") + "R · needs " +
         str.tostring(100.0 / (1.0 + rrTarget), "#") + "% wins" : "off", color.silver)
    f_row(dash, 4,  "  ABS (reversal)",     not useAbs ? "off" : gradeOn ? f_gradeText(0) : "—", gradeOn and useAbs ? f_gradeColor(0) : color.gray,
         "Bubbles shown on the chart only.")
    f_row(dash, 5,  "  DIV (reversal)",     not useDiv ? "off" : gradeOn ? f_gradeText(1) : "—", gradeOn and useDiv ? f_gradeColor(1) : color.gray,
         "Bubbles shown on the chart only.")
    f_row(dash, 6,  "  BRK (continuation)", not useBrk ? "off" : gradeOn ? f_gradeText(2) : "—", gradeOn and useBrk ? f_gradeColor(2) : color.gray,
         "Bubbles shown on the chart only.")
    f_row(dash, 7,  "  ★ at key level",    gradeOn ? f_gradeText(3) : "—", gradeOn ? f_gradeColor(3) : color.gray,
         "Every setup inside the trade windows that formed at a key level — shown or hidden.")
    f_row(dash, 8,  "  away from levels",  gradeOn ? f_gradeText(4) : "—", gradeOn ? f_gradeColor(4) : color.gray,
         "Every setup inside the trade windows that did NOT form at a key level — shown or hidden. Compare with the row above.")
    f_row(dash, 9,  "  outside window",    not timeOn ? "time filter off" : gradeOn ? f_gradeText(5) : "—",
         timeOn and gradeOn ? f_gradeColor(5) : color.gray,
         "Setups outside the trade windows, graded silently (no bubble). If this row beats the ones above, the window is hurting.")
    f_row(dash, 10, "  open now", gradeOn ? str.tostring(openVis) : "—", color.aqua)
    if dashData
        string srcTxt = quality == Q_TICK ? "LIVE tick-rule · " + str.tostring(tkUpdates) + " updates" :
             quality == Q_IB  ? ibLabel + " intrabars · " + str.tostring(ibCount) :
             quality == Q_LOW ? ibLabel + " bar · low-res" : "no data"
        color srcCol = quality == Q_TICK ? color.aqua : quality == Q_IB ? color.white : quality == Q_LOW ? color.orange : color.gray
        float tot    = nz(buyV) + nz(sellV)
        float buyPct = tot > 0 ? 100.0 * buyV / tot : na
        string cvdTag = cvdReset == "Never" or cvdFull ? "" : "  partial"
        f_row(dash, 11, "This bar", srcTxt, srcCol)
        f_row(dash, 12, "  Δ",
             f_signed(delta) + (na(buyPct) ? "" : "  ·  " + str.tostring(buyPct, "#") + "% buy"),
             na(delta) ? color.gray : delta >= 0 ? bullCol : bearCol)
        f_row(dash, 13, "CVD (" + cvdReset + ")", f_signed(cvd) + cvdTag, cvd >= 0 ? bullCol : bearCol)
        f_row(dash, 14, "5m bar Δ (" + ibLabel + " data)",  f_htfText("5",  d5,  f5),  f_htfColor("5",  d5))
        f_row(dash, 15, "15m bar Δ (" + ibLabel + " data)", f_htfText("15", d15, f15), f_htfColor("15", d15))
        f_row(dash, 16, "1H bar Δ (" + ibLabel + " data)",  f_htfText("60", d60, f60), f_htfColor("60", d60))
        f_row(dash, 17, "Bars with data", str.tostring(nTick + nIb + nLow) + " / " + str.tostring(nAll) +
             "  (live " + str.tostring(nTick) + " · low-res " + str.tostring(nLow) + ")", color.silver)

// ─────────────────────────────────────────────────────────────
// ALERTS (use "Any alert() function call" for messages with levels)
// ─────────────────────────────────────────────────────────────
alertcondition(bullSig, "Any Up Setup",   "OF Bubbles: big-move UP setup (ABS / DIV / BRK)")
alertcondition(bearSig, "Any Down Setup", "OF Bubbles: big-move DOWN setup (ABS / DIV / BRK)")
alertcondition(bullSig and bullLvl != "", "★ Up Setup at Key Level",   "OF Bubbles: big-move UP setup at a key level")
alertcondition(bearSig and bearLvl != "", "★ Down Setup at Key Level", "OF Bubbles: big-move DOWN setup at a key level")
alertcondition(bullSig and bullKind == 0, "Bullish Absorption",          "OF Bubbles: bullish absorption at a swept low")
alertcondition(bearSig and bearKind == 0, "Bearish Absorption",          "OF Bubbles: bearish absorption at a swept high")
alertcondition(bullSig and bullKind == 1, "Bullish Delta Divergence",    "OF Bubbles: bullish delta divergence at a swept low")
alertcondition(bearSig and bearKind == 1, "Bearish Delta Divergence",    "OF Bubbles: bearish delta divergence at a swept high")
alertcondition(bullSig and bullKind == 2, "Bullish Initiative Breakout", "OF Bubbles: buyers broke and held the high on extreme delta")
alertcondition(bearSig and bearKind == 2, "Bearish Initiative Breakout", "OF Bubbles: sellers broke and held the low on extreme delta")
