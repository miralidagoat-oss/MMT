//@version=6
indicator("TERMINUS v2 · Price-Axis Survival Reversal Engine", shorttitle = "TERMINUS", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ============================================================================
// Visual grammar: three tiers, one accent per side, nothing saturated except
// the two levels that actually matter right now.
//   tier 1  active terminus  — tinted zone + border + projection + readout
//   tier 2  ladder nodes     — faint zone + level tick + aligned readout
//   tier 3  dormant nodes    — neutral slate wash, no border, no text
// Per-bar terminus dots are gone (they painted the whole chart); the trail is
// opt-in and otherwise lives in the data window. Everything on the chart is
// keyed to probability, so weak structure fades instead of shouting.
//
// ── corrections ─────────────────────────────────────────────────────────────
// 1. Node merge now decays existing mass to the present before adding fresh
//    mass, then re-bases the decay clock.
// 2. Node eviction ranks by decayed mass (f_mass), not raw birth mass.
// 3. Session clock handles windows that cross midnight.
// 4. The survival scan skips walls price has already closed through.
// 5. f_pct keeps one decimal below ~10%.
// 6. alertcondition hooks for threshold crossings and terminus touches.
// 7. tauRem priced from time_close, not time. Measured with
//    backtest/calibrate_terminus.py: reach reliability 0.0029 -> 0.0016.
//
// ── v2 ──────────────────────────────────────────────────────────────────────
// 8. Wall hold is calibrated on the chart's own history. The hold model's
//    output (1 - exp(-(Km·mass + Ks·√stops))) used hand-set weights and was
//    never checked, so the headline reach·hold figure was half guess. Every
//    wall's first test is now graded: held = a close `reactAdr` ADR back
//    from the wall before price closes through it; failed = closes through
//    first. The model's score is the prior, pulled toward what walls in the
//    same score band actually did, then toward the same band + side, then
//    (when price is near enough for it to describe the arrival) the same
//    exhaustion state. The dashboard shows model-said vs actually-held.
// 9. The exhaustion readout now feeds that calibration instead of being
//    display-only, so its effect on hold is measured rather than asserted.
// 10. Reach is priced from the session's own average range. The daily ADR
//    includes the overnight range, but tauRem is a fraction of the session,
//    so on futures the remaining volatility was overstated. "Daily range"
//    stays available (it is what calibrate_terminus.py measured; re-run it).
// 11. Reach calibration readout: at each hour of the session every wall's
//    reach probability is recorded, then scored at the session end. The
//    dashboard shows predicted vs hit and the reliability term.
// 12. Symbols without volume (SPX, most FX/CFD feeds) weigh every bar
//    equally. Before, absorbed volume was always 0, so no node was ever born,
//    and effort/CVD were flat.
// 13. SMT symbol auto-picks NQ on S&P charts and ES elsewhere; a symbol equal
//    to the chart's own is switched off (it compared ES with itself before,
//    so it could never fire on ES).
// 14. Node birth and epoch accumulation run on confirmed bars only, so live
//    nodes no longer flicker with the developing close on the epoch's first
//    bar. Historical results are unchanged.
// 15. tauRem falls back to the bar open on charts without a bar close time.
// 16. The volatility regime ratio (ATR14 / ATR200) is taken over session bars
//    only. On charts that include the overnight, the 200-bar average at the
//    open was mostly quiet overnight bars, so the ratio pinned high and every
//    reach was overstated at each open. On synthetic 24h data with a busy
//    session and quiet overnight, reach said 48% vs 27% hit with the daily
//    range and all-bar ratio; with both fixes it says 27% vs 27%. Session-only
//    charts are unchanged. ETA uses the session-bar volatility as well.
// ============================================================================

// ════════════════════════════ INPUTS ════════════════════════════
string G1 = "Memory field (absorption nodes)"
string epochTF   = input.timeframe("1D", "Epoch (node birth cadence)", group = G1)
int    nBins     = input.int(48, "Profile bins per epoch", minval = 12, maxval = 200, group = G1)
float  peakMult  = input.float(1.35, "Peak threshold (x mean density)", minval = 1.0, step = 0.05, group = G1)
int    topK      = input.int(3, "Nodes born per epoch", minval = 1, maxval = 10, group = G1)
float  wCalmPct  = input.float(0.068, "Node height % of price (calm)", minval = 0.005, step = 0.001, group = G1)
float  wVolPct   = input.float(0.102, "Node height % of price (volatile)", minval = 0.005, step = 0.001, group = G1)
int    maxNodes  = input.int(60, "Max live nodes", minval = 5, maxval = 150, group = G1)
float  maxAgeD   = input.float(20.0, "Max node age (days)", minval = 1.0, group = G1)
float  halfLifeD = input.float(5.0, "Mass half-life (days)", minval = 0.5, group = G1)
float  bandPct   = input.float(10.0, "Distance band (% of price)", minval = 1.0, group = G1)
float  rollPct   = input.float(12.0, "Contract-roll gap wipe (%)", minval = 2.0, group = G1)

string G2 = "Hold model"
float kM       = input.float(0.35, "Km  absorbed-mass weight", minval = 0.0, step = 0.05, group = G2)
float kS       = input.float(0.40, "Ks  stop-fuel weight", minval = 0.0, step = 0.05, group = G2)
float fuelZone = input.float(3.0, "Fuel reach (x node half-height)", minval = 0.5, step = 0.5, group = G2)
int   pivLen   = input.int(5, "Stop-pool pivot length", minval = 2, group = G2)
bool  useCal   = input.bool(true, "Calibrate hold on this chart's history", group = G2, tooltip = "Grades every wall's first test and pulls the model's hold score toward what walls with the same score actually did. Off = the raw model score.")
float reactAdr = input.float(0.20, "Held = reaction of at least (× ADR)", minval = 0.05, maxval = 2.0, step = 0.05, group = G2, tooltip = "After price first reaches a wall, it has held once a bar closes this far back from the wall's near edge before price closes through the wall.")

string G3 = "Reach model"
string tz      = input.string("America/New_York", "Session timezone", group = G3)
int    sStartH = input.int(9, "Session start hour", minval = 0, maxval = 23, group = G3)
int    sStartM = input.int(30, "Session start minute", minval = 0, maxval = 59, group = G3)
int    sEndH   = input.int(16, "Session end hour", minval = 0, maxval = 23, group = G3)
int    sEndM   = input.int(0, "Session end minute", minval = 0, maxval = 59, group = G3)
int    adrLen  = input.int(14, "ADR length (days)", minval = 2, group = G3)
string volSrc  = input.string("Session range", "Reach volatility", options = ["Session range", "Daily range"], group = G3, tooltip = "Session range: the average range of the session itself (falls back to the daily range until 5 full sessions are seen). Daily range: the full-day ADR, which on futures includes the overnight range.")

string G4 = "Regime HMM"
int   hmmLen = input.int(100, "Range baseline length", minval = 20, group = G4)
float muC    = input.float(-0.25, "Calm state mean (log range ratio)", step = 0.05, group = G4)
float sdC    = input.float(0.45, "Calm state sd", minval = 0.05, step = 0.05, group = G4)
float muV    = input.float(0.45, "Volatile state mean", step = 0.05, group = G4)
float sdV    = input.float(0.60, "Volatile state sd", minval = 0.05, step = 0.05, group = G4)
float pStay  = input.float(0.98, "State persistence", minval = 0.5, maxval = 0.999, step = 0.005, group = G4)

string G5 = "Exhaustion (feeds hold calibration)"
int    divLen  = input.int(20, "Extreme / divergence lookback", minval = 5, group = G5)
int    erLen   = input.int(10, "Efficiency length", minval = 3, group = G5)
bool   useSMT  = input.bool(true, "Use intermarket SMT", group = G5)
bool   smtAuto = input.bool(true, "Auto-pick SMT symbol", group = G5, tooltip = "NQ on S&P charts (ES, MES, SPX, SPY…), ES on everything else. Turn off to use the symbol below.")
string smtSym  = input.symbol("CME_MINI:ES1!", "SMT symbol", group = G5)

string G6 = "Display · structure"
bool  showNodes  = input.bool(true, "Memory zones", group = G6)
bool  showLadder = input.bool(true, "Probability ladder", group = G6)
bool  showProj   = input.bool(true, "Terminus projection", group = G6)
bool  showExp    = input.bool(true, "Expected reversal price (dotted)", group = G6)
bool  showTrail  = input.bool(false, "Terminus trail (historical levels)", group = G6)
int   ladderMax  = input.int(3, "Ladder rows per side", minval = 1, maxval = 8, group = G6)
float minProb    = input.float(4.0, "Ladder threshold (% probability)", minval = 0.5, maxval = 50.0, step = 0.5, group = G6)
int   rightPad   = input.int(6, "Zone extension (bars past price)", minval = 0, maxval = 60, group = G6)

string G7 = "Display · dashboard & palette"
bool   showTable = input.bool(true, "Dashboard", group = G7)
bool   tblFull   = input.bool(true, "Full detail (off = compact)", group = G7)
string tblPos    = input.string(position.top_right, "Dashboard position", options = [position.top_right, position.middle_right, position.bottom_right, position.top_left, position.bottom_left], group = G7)
string tblSize   = input.string(size.small, "Dashboard text size", options = [size.tiny, size.small, size.normal], group = G7)
color  colRes    = input.color(color.rgb(199, 106, 114), "Upside (resistance)", group = G7)
color  colSup    = input.color(color.rgb(86, 166, 154), "Downside (support)", group = G7)
color  colNeut   = input.color(color.rgb(120, 132, 148), "Dormant structure", group = G7)
color  colPanel  = input.color(color.rgb(14, 17, 22), "Panel background", group = G7)

string G8 = "Alerts"
float alertThr = input.float(50.0, "Alert threshold (% probability)", minval = 1.0, maxval = 99.0, step = 1.0, group = G8) / 100.0

// Typography and chrome, derived once so every drawing agrees
color colTxt  = color.rgb(226, 232, 240)
color colDim  = color.rgb(126, 137, 153)
color colSect = color.rgb(24, 29, 37)
string MONO   = font.family_monospace

// Model constants
float DAY_MS   = 86400000.0
float CAL_K    = 8.0     // pseudo-tests each calibration level borrows from the level above it
float NEAR_ADR = 0.25    // within this many ADR the current exhaustion reading describes the arrival

// SMT must compare against a different market: NQ for the S&P family, ES for everything else
string chartRoot = syminfo.root
bool   chartIsSP = chartRoot == "ES" or chartRoot == "MES" or chartRoot == "SP" or chartRoot == "SPX" or chartRoot == "SPY" or chartRoot == "VOO" or chartRoot == "IVV" or chartRoot == "XSP" or chartRoot == "US500" or chartRoot == "SPX500" or chartRoot == "SPX500USD"
string smtUse    = smtAuto ? (chartIsSP ? "CME_MINI:NQ1!" : "CME_MINI:ES1!") : smtSym
array<string> smtParts = str.split(smtUse, ":")
string smtName   = smtParts.size() > 0 ? smtParts.last() : smtUse
bool   smtOn     = useSMT and smtName != syminfo.ticker

// ════════════════════════════ TYPES ════════════════════════════
type Node
    float p
    float m
    float w
    int   t
    int   side
    int   id
    int   bornBar = 0
    float prob    = 0.0
    float hold    = 0.0
    float raw     = na
    bool  touched = false
    bool  graded  = false
    int   cell    = -1
    float rawT    = 0.0
    box   bx

// Node calibration fields: raw = the hold model's own score at the last scan, hold = calibrated hold,
// cell = calibration cell locked at the first test (side × score band × exhaustion), rawT = the raw score
// at that moment, graded = the first test has been scored.

// ════════════════════════════ CALIBRATION STATE ════════════════════════════
// hold: 20 cells = side (resistance 0-9, support 10-19) × score band (5) × exhaustion at the test (2)
var array<int>   cN = array.new<int>(20, 0)
var array<int>   cW = array.new<int>(20, 0)
var array<float> cS = array.new<float>(20, 0.0)
// reach: pending hourly predictions, scored at the session end into 10 probability bins
var array<float> rkP   = array.new<float>()
var array<float> rkE   = array.new<float>()
var array<int>   rkS   = array.new<int>()
var array<bool>  rkHit = array.new<bool>()
var array<float> rbN   = array.new<float>(10, 0.0)
var array<float> rbP   = array.new<float>(10, 0.0)
var array<float> rbH   = array.new<float>(10, 0.0)

// ════════════════════════════ FUNCTIONS ════════════════════════════
f_phi(float x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float d = 0.3989422804 * math.exp(-x * x / 2.0)
    float q = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))))
    x >= 0 ? 1.0 - q : q

f_reach(float d, float s) =>
    s > 0 ? math.min(1.0, 2.0 * (1.0 - f_phi(d / s))) : 0.0

f_gauss(float x, float mu, float sd) =>
    math.exp(-0.5 * math.pow((x - mu) / sd, 2)) / sd

f_eta(float d, float sb) =>
    sb > 0 ? math.pow(d / (0.6745 * sb), 2) : na

f_fmtMin(float bars) =>
    float m = bars * timeframe.in_seconds() / 60.0
    na(bars) ? "-" : m < 1.0 ? "AT ZONE" : m < 60.0 ? str.tostring(m, "#") + "m" : str.tostring(m / 60.0, "#.#") + "h"

// One decimal below ~10% so sub-percent probabilities and near-certain
// complements stay distinguishable; whole numbers above that to keep it terse
f_pct(float x) =>
    na(x) ? "-" : str.tostring(x * 100.0, math.abs(x) < 0.095 ? "0.#" : "#") + "%"

f_px(float x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

// Distance in units of the volatility still available — scale-free, so the
// same number means the same thing on any symbol or timeframe
f_sig(float d, float s) =>
    na(d) or s <= 0 ? "-" : str.tostring(d / s, "#.##") + "σ"

// Five-segment meter — reads as a shape, not a number, so the eye can skim it
f_gauge(float v) =>
    int n = na(v) ? 0 : int(math.round(math.max(0.0, math.min(1.0, v)) * 5.0))
    string s = ""
    for i = 1 to 5
        s += i <= n ? "▰" : "▱"
    s

f_kill(array<Node> arr, int i) =>
    Node n = arr.remove(i)
    if not na(n.bx)
        box.delete(n.bx)
    true

// The hold model's own score: absorbed mass plus stop fuel parked just in front of the wall
f_holdRaw(Node n, array<float> res) =>
    float ageD = (time - n.t) / DAY_MS
    float mEff = n.m * math.pow(0.5, ageD / halfLifeD)
    float fuelR = fuelZone * n.w
    int s = 0
    if res.size() > 0
        for k = 0 to res.size() - 1
            float r = res.get(k)
            if n.side == 1 and r >= n.p - n.w - fuelR and r <= n.p + n.w
                s += 1
            if n.side == -1 and r <= n.p + n.w + fuelR and r >= n.p - n.w
                s += 1
    1.0 - math.exp(-(kM * mEff + kS * math.sqrt(s)))

f_band(float raw) =>
    math.max(0, math.min(4, int(math.floor(raw * 5.0))))

f_cellIdx(int sd, float raw, bool exh) =>
    (sd == 1 ? 0 : 10) + f_band(raw) * 2 + (exh ? 1 : 0)

// Calibrated hold. The model's own score is the prior; it is pulled toward what walls in the same score
// band actually did on this chart, then toward walls in the same band on the same side, and - only when
// price is near enough for the current exhaustion reading to describe the arrival - in the same
// exhaustion state. With no history it returns the raw score; with plenty it returns the measured rate.
f_holdCal(int sd, float raw, bool exh, bool near) =>
    int   b  = f_band(raw)
    int   s0 = sd == 1 ? 0 : 10
    float nB = 0.0
    float wB = 0.0
    for i = 0 to 3
        int ix = (i < 2 ? 0 : 10) + b * 2 + i % 2
        nB += cN.get(ix)
        wB += cW.get(ix)
    float pB = (wB + CAL_K * raw) / (nB + CAL_K)
    float nS = cN.get(s0 + b * 2) + cN.get(s0 + b * 2 + 1)
    float wS = cW.get(s0 + b * 2) + cW.get(s0 + b * 2 + 1)
    float pS = (wS + CAL_K * pB) / (nS + CAL_K)
    int   c  = s0 + b * 2 + (exh ? 1 : 0)
    near ? (cW.get(c) + CAL_K * pS) / (cN.get(c) + CAL_K) : pS

// Lock a wall's calibration cell at its first test. The raw score comes from the last scan, taken before
// this bar swept any stop pools in front of the wall.
f_lockCell(Node n, bool exh, array<float> res) =>
    float raw = na(n.raw) ? f_holdRaw(n, res) : n.raw
    n.rawT := raw
    n.cell := f_cellIdx(n.side, raw, exh)
    true

f_grade(Node n, bool held) =>
    cN.set(n.cell, cN.get(n.cell) + 1)
    if held
        cW.set(n.cell, cW.get(n.cell) + 1)
    cS.set(n.cell, cS.get(n.cell) + n.rawT)
    n.graded := true
    true

f_side(array<Node> arr, int sd, float px, float sRem, array<float> res, bool exh, float nearD) =>
    array<float> dist = array.new<float>()
    array<int> idx = array.new<int>()
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Node n = arr.get(i)
            if n.side == sd
                n.prob := 0.0
                // Walls price has already closed through are spent. Distance
                // clamps at zero, so without this they score reach = 1.0 for
                // the rest of the developing bar, before the lifecycle prunes
                // them — the terminus would flicker onto a dead level.
                bool spent = sd == 1 ? px > n.p + n.w : px < n.p - n.w
                if not spent
                    float edge = sd == 1 ? n.p - n.w : n.p + n.w
                    float d = sd == 1 ? math.max(0.0, edge - px) : math.max(0.0, px - edge)
                    dist.push(d)
                    idx.push(i)
    float surv = 1.0
    float bestP = 0.0
    int bestI = -1
    float sumP = 0.0
    float sumPX = 0.0
    if dist.size() > 0
        array<int> ord = dist.sort_indices(order.ascending)
        for j = 0 to ord.size() - 1
            int k = ord.get(j)
            Node n = arr.get(idx.get(k))
            float raw = f_holdRaw(n, res)
            float h = useCal ? f_holdCal(sd, raw, exh, dist.get(k) <= nearD) : raw
            float pr = f_reach(dist.get(k), sRem) * h * surv
            n.raw := raw
            n.hold := h
            n.prob := pr
            surv *= (1.0 - h)
            sumP += pr
            sumPX += pr * n.p
            if pr > bestP
                bestP := pr
                bestI := idx.get(k)
    [bestI, bestP, sumP > 0 ? sumPX / sumP : na, 1.0 - sumP]

// Decayed mass, for readout and eviction ranking — same decay the hold model applies
f_mass(Node n) =>
    n.m * math.pow(0.5, ((time - n.t) / DAY_MS) / halfLifeD)

// ── dashboard cells ──────────────────────────────────────────
f_sec(table tb, int r, string s) =>
    table.cell(tb, 0, r, s, text_color = colTxt, text_size = tblSize, text_halign = text.align_left, bgcolor = colSect, text_font_family = MONO)
    table.cell(tb, 1, r, "", bgcolor = colSect)
    table.cell(tb, 2, r, "", bgcolor = colSect)

f_row(table tb, int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = colDim, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
    table.cell(tb, 1, r, v, text_color = c, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)
    table.cell(tb, 2, r, "", text_size = tblSize)

f_rowG(table tb, int r, string k, string v, color c, float g) =>
    table.cell(tb, 0, r, k, text_color = colDim, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
    table.cell(tb, 1, r, v, text_color = c, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)
    table.cell(tb, 2, r, f_gauge(g), text_color = color.new(c, 35), text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)

// ════════════════════════════ STATE ════════════════════════════
var array<Node>  nodes = array.new<Node>()
var array<float> epP   = array.new<float>()
var array<float> epW   = array.new<float>()
var array<float> resH  = array.new<float>()
var array<float> resL  = array.new<float>()
var int nodeId = 0

// ════════════════════════════ CORE SERIES ════════════════════════════
float atrS = ta.atr(14)
float atrL = ta.atr(200)

float adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen)[1], lookahead = barmerge.lookahead_on)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// Symbols that report no volume weigh every bar equally, so the memory field and effort readout still work
bool  hasVol = ta.cum(nz(volume)) > 0
float vol    = hasVol ? nz(volume) : 1.0

// Session clock — handles windows that cross midnight (overnight futures RTH).
int yy = year(time, tz)
int mo = month(time, tz)
int dd = dayofmonth(time, tz)
int sS = timestamp(tz, yy, mo, dd, sStartH, sStartM)
int sE = timestamp(tz, yy, mo, dd, sEndH, sEndM)
if sE <= sS
    if time < sE
        sS -= 86400000      // we are in the tail of yesterday's session
    else
        sE += 86400000      // session runs on into tomorrow
bool inSess  = time >= sS and time < sE
// a new session also starts on a date change: session-only charts have no bar between sessions
bool sessNew = inSess and (not inSess[1] or sS != sS[1])
bool sessEnd = inSess[1] and (not inSess or sS != sS[1])
// Horizon runs from this bar's CLOSE: the scan prices off `close`, so the
// outcome it describes can only begin on the next bar.
float tauRem = inSess ? math.max(0.0, float(sE - nz(time_close, time))) / float(sE - sS) : 1.0

// Volatility regime from session bars only. On charts that include the overnight, a 200-bar ATR at the
// session open is mostly quiet overnight bars, which inflated this ratio (and every reach) at each open.
float trNow = ta.tr(true)
var float trFast = na
var float trSlow = na
var int   trN    = 0
if inSess
    trFast := na(trFast) ? trNow : trFast + (trNow - trFast) / 14.0
    trSlow := na(trSlow) ? trNow : trSlow + (trNow - trSlow) / 200.0
    trN    += 1
bool  trReady  = inSess and trN >= 200 and nz(trSlow) > 0
float volScale = trReady ? math.max(0.6, math.min(1.8, trFast / trSlow)) : 1.0

// Average range of the session itself, from sessions seen from their first bar
var array<float> sRanges = array.new<float>()
var float sHi   = na
var float sLo   = na
var bool  sFull = false
if sessEnd and barstate.isconfirmed and sFull and not na(sHi)
    sRanges.push(sHi - sLo)
    if sRanges.size() > adrLen
        sRanges.shift()
if sessNew
    sHi   := high
    sLo   := low
    sFull := time - sS <= math.max(timeframe.in_seconds() * 1000, 900000)
else if inSess
    sHi := math.max(sHi, high)
    sLo := math.min(sLo, low)
float avgSessR   = sRanges.size() >= 5 ? sRanges.avg() : na
bool  useSessSig = volSrc == "Session range" and inSess and not na(avgSessR)
float sigDay = useSessSig ? avgSessR / 1.596 : nz(adr) / 1.596
float sigRem = sigDay * math.sqrt(math.max(tauRem, 0.02)) * volScale
float sigBar = (trReady ? trSlow : nz(atrL, nz(atrS))) / 1.596 * volScale

// Regime HMM (2-state forward filter on log range ratio)
float rngNow = high - low
float rngBase = ta.sma(rngNow, hmmLen)
float xr = na
if not na(rngBase)
    xr := math.log(math.max(rngNow, syminfo.mintick) / math.max(rngBase, syminfo.mintick))
var float pV = 0.5
if not na(xr)
    float priC = (1.0 - pV) * pStay + pV * (1.0 - pStay)
    float priV = pV * pStay + (1.0 - pV) * (1.0 - pStay)
    float aC = priC * f_gauss(xr, muC, sdC)
    float aV = priV * f_gauss(xr, muV, sdV)
    if aC + aV > 0
        pV := aV / (aC + aV)
bool hmmReady = bar_index > hmmLen
bool isVolatile = hmmReady and pV > 0.5

// Effort vs result
float bodyAbs = math.abs(close - open)
float effR = vol / (bodyAbs + 0.1 * nz(atrS, rngNow) + syminfo.mintick)
float effMu = ta.sma(effR, 50)
float effSd = ta.stdev(effR, 50)
float effZ = nz(effSd) > 0 ? (effR - nz(effMu)) / effSd : 0.0
float cA = 1.0 / (1.0 + math.exp(-(effZ - 1.0)))
float cAr = ta.highest(cA, 5)

// Synthetic CVD divergence
float clv = rngNow > 0 ? (2.0 * close - high - low) / rngNow : 0.0
var float cvd = 0.0
cvd += vol * clv
bool newHi = high >= ta.highest(high, divLen)
bool newLo = low <= ta.lowest(low, divLen)
float cvdHi = ta.highest(cvd, divLen)
float cvdLo = ta.lowest(cvd, divLen)
bool bearDiv = newHi and cvd < nz(cvdHi, cvd)
bool bullDiv = newLo and cvd > nz(cvdLo, cvd)

// Intermarket SMT
[smtHiGap, smtLoGap] = request.security(smtUse, timeframe.period, [ta.highest(high, divLen) - high, low - ta.lowest(low, divLen)], ignore_invalid_symbol = true)
bool bearSmt = smtOn and newHi and not na(smtHiGap) and smtHiGap > 0
bool bullSmt = smtOn and newLo and not na(smtLoGap) and smtLoGap > 0

bool bearDivR = nz(ta.barssince(bearDiv), 999) <= 5
bool bullDivR = nz(ta.barssince(bullDiv), 999) <= 5
bool bearSmtR = nz(ta.barssince(bearSmt), 999) <= 5
bool bullSmtR = nz(ta.barssince(bullSmt), 999) <= 5

// Efficiency collapse
float erDen = math.sum(math.abs(close - close[1]), erLen)
float er = nz(erDen) > 0 ? math.abs(close - close[erLen]) / erDen : 0.5
float erMA = ta.sma(er, erLen)
bool erLow = er < nz(erMA, er)

float wSum = 3.0 + (smtOn ? 1.0 : 0.0)
float eUp = (nz(cAr) + (bearDivR ? 1.0 : 0.0) + (bearSmtR ? 1.0 : 0.0) + (erLow ? 1.0 : 0.0)) / wSum
float eDn = (nz(cAr) + (bullDivR ? 1.0 : 0.0) + (bullSmtR ? 1.0 : 0.0) + (erLow ? 1.0 : 0.0)) / wSum
bool  exhUp = eUp >= 0.5
bool  exhDn = eDn >= 0.5

// Pivots (global scope, every bar)
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
bool dayChange = timeframe.change("1D")
bool newEpoch = timeframe.change(epochTF)

// ════════════════════════════ CONTRACT-ROLL WIPE ════════════════════════════
bool rollGap = not na(close[1]) and close[1] > 0 and math.abs(open - close[1]) / close[1] * 100.0 > rollPct
if rollGap
    if nodes.size() > 0
        for i = nodes.size() - 1 to 0
            f_kill(nodes, i)
    resH.clear()
    resL.clear()
    epP.clear()
    epW.clear()

// ════════════════════════════ STOP RESERVOIRS ════════════════════════════
if resH.size() > 0
    for i = resH.size() - 1 to 0
        if high > resH.get(i)
            resH.remove(i)
if resL.size() > 0
    for i = resL.size() - 1 to 0
        if low < resL.get(i)
            resL.remove(i)
if not na(ph)
    resH.push(ph)
if not na(pl)
    resL.push(pl)
if dayChange and not na(pdh) and pdh > high
    resH.push(pdh)
if dayChange and not na(pdl) and pdl < low
    resL.push(pdl)
while resH.size() > 80
    resH.shift()
while resL.size() > 80
    resL.shift()

// ════════════════════════════ NODE BIRTH (epoch close) ════════════════════════════
if newEpoch and barstate.isconfirmed and epP.size() > 20
    float lo = epP.min()
    float hi = epP.max()
    float bs = (hi - lo) / nBins
    if bs > 0
        array<float> prof = array.new<float>(nBins, 0.0)
        float tot = 0.0
        for i = 0 to epP.size() - 1
            int b = math.max(0, math.min(nBins - 1, math.floor((epP.get(i) - lo) / bs)))
            prof.set(b, prof.get(b) + epW.get(i))
            tot += epW.get(i)
        if tot > 0
            array<float> smo = array.new<float>(nBins, 0.0)
            for b = 0 to nBins - 1
                float lv = b > 0 ? prof.get(b - 1) : prof.get(b)
                float rv = b < nBins - 1 ? prof.get(b + 1) : prof.get(b)
                smo.set(b, 0.25 * lv + 0.5 * prof.get(b) + 0.25 * rv)
            float meanSm = smo.avg()
            array<float> pkP = array.new<float>()
            array<float> pkM = array.new<float>()
            for b = 1 to nBins - 2
                float v = smo.get(b)
                if v >= smo.get(b - 1) and v > smo.get(b + 1) and v > meanSm * peakMult
                    float w0 = prof.get(b - 1)
                    float w1 = prof.get(b)
                    float w2 = prof.get(b + 1)
                    float ws = w0 + w1 + w2
                    if ws > 0
                        float c0 = lo + (b - 0.5) * bs
                        float c1 = lo + (b + 0.5) * bs
                        float c2 = lo + (b + 1.5) * bs
                        pkP.push((w0 * c0 + w1 * c1 + w2 * c2) / ws)
                        pkM.push(ws / tot * nBins / 3.0)
            if pkM.size() > 0
                array<int> ordPk = pkM.sort_indices(order.descending)
                int take = math.min(topK, ordPk.size())
                float hgt = close * (isVolatile ? wVolPct : wCalmPct) / 100.0
                for j = 0 to take - 1
                    int q = ordPk.get(j)
                    float np = pkP.get(q)
                    float nm = pkM.get(q)
                    bool inBand = math.abs(np - close) / close * 100.0 <= bandPct
                    bool merged = false
                    if inBand and nodes.size() > 0
                        for k = 0 to nodes.size() - 1
                            Node e = nodes.get(k)
                            if math.abs(e.p - np) <= e.w
                                // Decay the standing mass to the present BEFORE
                                // adding fresh mass, then re-base the clock.
                                float dec = math.pow(0.5, ((time - e.t) / DAY_MS) / halfLifeD)
                                e.m := math.min(e.m * dec + 0.5 * nm, 12.0)
                                e.t := time
                                merged := true
                                break
                    if inBand and not merged and math.abs(np - close) > hgt / 2.0
                        if nodes.size() >= maxNodes
                            int lowI = 0
                            float lowM = 1e10
                            for k = 0 to nodes.size() - 1
                                // Rank by decayed mass so the stalest wall goes,
                                // not merely the smallest-at-birth one
                                float mk = f_mass(nodes.get(k))
                                if mk < lowM
                                    lowM := mk
                                    lowI := k
                            f_kill(nodes, lowI)
                        int sd = np > close ? 1 : -1
                        nodeId += 1
                        box bx = na
                        if showNodes
                            // Born neutral and near-invisible; the last-bar pass
                            // re-weights every zone by live probability.
                            bx := box.new(bar_index, np + hgt / 2.0, bar_index + 1, np - hgt / 2.0, border_color = color.new(colNeut, 100), border_width = 0, bgcolor = color.new(colNeut, 94), extend = extend.none)
                        nodes.push(Node.new(p = np, m = nm, w = hgt / 2.0, t = time, side = sd, id = nodeId, bornBar = bar_index, bx = bx))

if newEpoch and barstate.isconfirmed
    epP.clear()
    epW.clear()

// Absorbed-volume accumulation for the running epoch
float uw = high - math.max(open, close)
float lw = math.min(open, close) - low
float absorb = rngNow > 0 ? vol * (1.0 - bodyAbs / rngNow) : 0.0
if barstate.isconfirmed and absorb > 0 and uw + lw > 0
    if uw > 0
        epP.push(math.max(open, close) + uw / 2.0)
        epW.push(absorb * uw / (uw + lw))
    if lw > 0
        epP.push(math.min(open, close) - lw / 2.0)
        epW.push(absorb * lw / (uw + lw))
while epP.size() > 20000
    epP.shift()
    epW.shift()

// ════════════════════════════ NODE LIFECYCLE + HOLD GRADING (every confirmed bar) ════════════════════════════
if barstate.isconfirmed and nodes.size() > 0
    for i = nodes.size() - 1 to 0
        Node n = nodes.get(i)
        float nearE = n.side == 1 ? n.p - n.w : n.p + n.w
        bool  exh   = n.side == 1 ? exhUp : exhDn
        array<float> pools = resL
        if n.side == 1
            pools := resH
        // first test: the bar reaches the wall's near edge
        if not n.touched and bar_index > n.bornBar and (n.side == 1 ? high >= nearE : low <= nearE)
            n.touched := true
            f_lockCell(n, exh, pools)
        // held: a close reactAdr ADR back from the near edge
        if n.touched and not n.graded and nz(adr) > 0 and n.side * (nearE - close) >= reactAdr * adr
            f_grade(n, true)
        bool closedThrough = (n.side == 1 and close > n.p + n.w) or (n.side == -1 and close < n.p - n.w)
        // failed: closed through before holding (a gap straight through an untested wall counts too)
        if closedThrough and not n.graded
            if n.cell < 0
                f_lockCell(n, exh, pools)
            f_grade(n, false)
        bool tooOld = (time - n.t) > maxAgeD * DAY_MS
        bool tooFar = math.abs(n.p - close) / close * 100.0 > bandPct
        if closedThrough or tooOld or tooFar
            f_kill(nodes, i)

// ════════════════════════════ PRICE-AXIS SURVIVAL SCAN ════════════════════════════
float nearD = NEAR_ADR * nz(adr)
[upI, upP, upE, upNone] = f_side(nodes, 1, close, sigRem, resH, exhUp, nearD)
[dnI, dnP, dnE, dnNone] = f_side(nodes, -1, close, sigRem, resL, exhDn, nearD)
Node tU = na
Node tD = na
if upI >= 0
    tU := nodes.get(upI)
if dnI >= 0
    tD := nodes.get(dnI)

// ════════════════════════════ REACH CALIBRATION ════════════════════════════
// At the first bar of each session hour every live wall's reach probability is recorded; each record is
// marked hit if a later bar of the same session reaches the wall, and scored when the session ends.
var int lastCkKey = 0
if barstate.isconfirmed
    if sessEnd and rkP.size() > 0
        for i = 0 to rkP.size() - 1
            int b = math.max(0, math.min(9, int(math.floor(rkP.get(i) * 10.0))))
            rbN.set(b, rbN.get(b) + 1.0)
            rbP.set(b, rbP.get(b) + rkP.get(i))
            rbH.set(b, rbH.get(b) + (rkHit.get(i) ? 1.0 : 0.0))
        rkP.clear()
        rkE.clear()
        rkS.clear()
        rkHit.clear()
    if inSess and rkP.size() > 0
        for i = 0 to rkP.size() - 1
            if not rkHit.get(i) and (rkS.get(i) == 1 ? high >= rkE.get(i) : low <= rkE.get(i))
                rkHit.set(i, true)
    int ckKey = sS + int(math.floor((nz(time_close, time) - sS) / 3600000.0)) * 3600000
    if inSess and ckKey != lastCkKey and tauRem > 0 and sigRem > 0
        lastCkKey := ckKey
        for n in nodes
            bool spent = n.side == 1 ? close > n.p + n.w : close < n.p - n.w
            float edge = n.side == 1 ? n.p - n.w : n.p + n.w
            float d = n.side * (edge - close)
            if not spent and d > 0 and rkP.size() < 3000
                rkP.push(f_reach(d, sigRem))
                rkE.push(edge)
                rkS.push(n.side)
                rkHit.push(false)

// ════════════════════════════ PLOTS ════════════════════════════
// Historical terminus track: off by default, and always available in the data
// window / for alerts even when it is not painted.
float tUpPrice = na
float tDnPrice = na
float tUpW = na
float tDnW = na
if not na(tU)
    tUpPrice := tU.p
    tUpW := tU.w
if not na(tD)
    tDnPrice := tD.p
    tDnW := tD.w
plot(tUpPrice, "Terminus high", color = showTrail ? color.new(colRes, 74) : na, style = plot.style_linebr, linewidth = 1)
plot(tDnPrice, "Terminus low", color = showTrail ? color.new(colSup, 74) : na, style = plot.style_linebr, linewidth = 1)

// ════════════════════════════ ALERTS ════════════════════════════
bool armUp   = ta.crossover(upP, alertThr)
bool armDn   = ta.crossover(dnP, alertThr)
bool touchUp = not na(tUpPrice) and high >= tUpPrice - tUpW and upP >= alertThr
bool touchDn = not na(tDnPrice) and low <= tDnPrice + tDnW and dnP >= alertThr
alertcondition(armUp, "Upside terminus armed", "TERMINUS: upside wall probability crossed the alert threshold")
alertcondition(armDn, "Downside terminus armed", "TERMINUS: downside wall probability crossed the alert threshold")
alertcondition(touchUp, "Upside terminus touched", "TERMINUS: price reached a high-probability upside wall")
alertcondition(touchDn, "Downside terminus touched", "TERMINUS: price reached a high-probability downside wall")

// ════════════════════════════ LAST-BAR RENDER ════════════════════════════
var line  pjU = na
var line  pjD = na
var line  exU = na
var line  exD = na
var label lbU = na
var label lbD = na
var array<label> ladder = array.new<label>()
var array<line>  ladLn  = array.new<line>()
var table dash = table.new(tblPos, 3, 32, bgcolor = color.new(colPanel, 12), border_width = 1, border_color = color.new(color.gray, 82), frame_width = 1, frame_color = color.new(color.gray, 68))

if barstate.islast
    line.delete(pjU)
    line.delete(pjD)
    line.delete(exU)
    line.delete(exD)
    label.delete(lbU)
    label.delete(lbD)
    if ladder.size() > 0
        for i = ladder.size() - 1 to 0
            label.delete(ladder.get(i))
        ladder.clear()
    if ladLn.size() > 0
        for i = ladLn.size() - 1 to 0
            line.delete(ladLn.get(i))
        ladLn.clear()

    float pMin = minProb / 100.0
    int xEdge = bar_index + rightPad

    // Terminus readouts resolved once, so nothing below touches a na node
    int   idU  = -1
    int   idD  = -1
    float pxU  = na
    float pxD  = na
    float hdU  = na
    float hdD  = na
    float gapU = na
    float gapD = na
    float etaU = na
    float etaD = na
    if not na(tU)
        idU  := tU.id
        pxU  := tU.p
        hdU  := tU.hold
        gapU := math.max(0.0, tU.p - tU.w - close)
        etaU := f_eta(gapU, sigBar)
    if not na(tD)
        idD  := tD.id
        pxD  := tD.p
        hdD  := tD.hold
        gapD := math.max(0.0, close - tD.p - tD.w)
        etaD := f_eta(gapD, sigBar)

    // ── every zone re-weighted by live probability ──
    if showNodes and nodes.size() > 0
        for i = 0 to nodes.size() - 1
            Node n = nodes.get(i)
            if not na(n.bx)
                bool isTop = n.id == idU or n.id == idD
                color sc = n.side == 1 ? colRes : colSup
                box.set_right(n.bx, xEdge)
                if isTop
                    box.set_bgcolor(n.bx, color.new(sc, 80))
                    box.set_border_color(n.bx, color.new(sc, 30))
                    box.set_border_width(n.bx, 1)
                else if n.prob >= pMin
                    int tr = int(math.round(93.0 - 11.0 * math.min(1.0, n.prob / 0.5)))
                    box.set_bgcolor(n.bx, color.new(sc, tr))
                    box.set_border_color(n.bx, color.new(sc, 84))
                    box.set_border_width(n.bx, 1)
                else
                    box.set_bgcolor(n.bx, color.new(colNeut, 95))
                    box.set_border_color(n.bx, color.new(colNeut, 100))
                    box.set_border_width(n.bx, 0)

    // ── tier 1: the two levels that actually matter ──
    if showProj and not na(pxU)
        int xU = bar_index + int(math.max(5.0, math.min(nz(etaU, 20.0), 400.0)))
        pjU := line.new(bar_index, pxU, xU, pxU, color = color.new(colRes, 15), width = 2)
        lbU := label.new(xU, pxU, "▲ TERMINUS  " + f_px(pxU) + "\n  reach·hold  " + f_pct(upP) + "\n  wall hold   " + f_pct(hdU) + "\n  eta " + f_fmtMin(etaU) + "  ·  gap " + f_sig(gapU, sigRem), style = label.style_label_left, color = color.new(colPanel, 12), textcolor = colRes, size = size.small, textalign = text.align_left, text_font_family = MONO)
    if showProj and not na(pxD)
        int xD = bar_index + int(math.max(5.0, math.min(nz(etaD, 20.0), 400.0)))
        pjD := line.new(bar_index, pxD, xD, pxD, color = color.new(colSup, 15), width = 2)
        lbD := label.new(xD, pxD, "▼ TERMINUS  " + f_px(pxD) + "\n  reach·hold  " + f_pct(dnP) + "\n  wall hold   " + f_pct(hdD) + "\n  eta " + f_fmtMin(etaD) + "  ·  gap " + f_sig(gapD, sigRem), style = label.style_label_left, color = color.new(colPanel, 12), textcolor = colSup, size = size.small, textalign = text.align_left, text_font_family = MONO)

    // ── probability-weighted expectation: a hairline, numbers live in the panel ──
    if showExp and not na(upE)
        exU := line.new(bar_index, upE, xEdge + 2, upE, color = color.new(colRes, 55), style = line.style_dotted, width = 1)
    if showExp and not na(dnE)
        exD := line.new(bar_index, dnE, xEdge + 2, dnE, color = color.new(colSup, 55), style = line.style_dotted, width = 1)

    // ── tier 2: the walls queued behind the terminus ──
    if showLadder and nodes.size() > 0
        array<float> lpr = array.new<float>()
        array<int>   lix = array.new<int>()
        for i = 0 to nodes.size() - 1
            Node n = nodes.get(i)
            bool drawn = showProj and (n.id == idU or n.id == idD)
            if n.prob >= pMin and not drawn
                lpr.push(n.prob)
                lix.push(i)
        if lpr.size() > 0
            array<int> ord = lpr.sort_indices(order.descending)
            int shownU = 0
            int shownD = 0
            for j = 0 to ord.size() - 1
                Node n = nodes.get(lix.get(ord.get(j)))
                bool room = n.side == 1 ? shownU < ladderMax : shownD < ladderMax
                if room
                    if n.side == 1
                        shownU += 1
                    else
                        shownD += 1
                    bool isTop = n.id == idU or n.id == idD
                    color sc = n.side == 1 ? colRes : colSup
                    string tip = "hold model " + f_pct(n.raw) + " -> calibrated " + f_pct(n.hold)
                    ladLn.push(line.new(bar_index, n.p, xEdge + 3, n.p, color = color.new(sc, isTop ? 30 : 74), width = 1, style = isTop ? line.style_solid : line.style_dotted))
                    ladder.push(label.new(xEdge + 4, n.p, (n.side == 1 ? "▲ " : "▼ ") + f_px(n.p) + "  " + f_gauge(n.prob) + " " + f_pct(n.prob) + "   hold " + f_pct(n.hold) + "   mass " + str.tostring(f_mass(n), "#.#"), style = label.style_label_left, color = color.new(colPanel, 100), textcolor = color.new(sc, isTop ? 0 : 25), size = size.tiny, text_font_family = MONO, tooltip = tip))

    // ── dashboard ──
    if showTable
        table.clear(dash, 0, 0, 2, 31)
        int cntU = 0
        int cntD = 0
        if nodes.size() > 0
            for i = 0 to nodes.size() - 1
                if nodes.get(i).side == 1
                    cntU += 1
                else
                    cntD += 1

        table.cell(dash, 0, 0, "TERMINUS v2", text_color = colTxt, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
        table.cell(dash, 1, 0, "", text_size = tblSize)
        table.cell(dash, 2, 0, "survival field", text_color = colDim, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)

        int r = 1
        f_sec(dash, r, "REGIME")
        r += 1
        f_rowG(dash, r, "state", (isVolatile ? "volatile " : "calm ") + f_pct(isVolatile ? pV : 1.0 - pV), isVolatile ? color.rgb(214, 158, 92) : colTxt, isVolatile ? pV : 1.0 - pV)
        r += 1
        f_rowG(dash, r, "session left", f_pct(tauRem), colTxt, tauRem)
        r += 1
        f_row(dash, r, "σ left", f_px(sigRem) + (useSessSig ? "  session" : "  daily"), colTxt)
        r += 1

        f_sec(dash, r, "UPSIDE")
        r += 1
        f_row(dash, r, "terminus", f_px(pxU), colRes)
        r += 1
        f_rowG(dash, r, "probability", f_pct(upP), colRes, upP)
        r += 1
        if tblFull
            f_rowG(dash, r, "wall hold", f_pct(hdU), colRes, hdU)
            r += 1
            f_row(dash, r, "distance", na(gapU) ? "-" : f_px(gapU) + "  " + f_sig(gapU, sigRem), colRes)
            r += 1
            f_row(dash, r, "E[top]", f_px(upE), colRes)
            r += 1
            f_rowG(dash, r, "no wall holds", f_pct(upNone), colRes, upNone)
            r += 1
        f_row(dash, r, "eta", f_fmtMin(etaU), colRes)
        r += 1

        f_sec(dash, r, "DOWNSIDE")
        r += 1
        f_row(dash, r, "terminus", f_px(pxD), colSup)
        r += 1
        f_rowG(dash, r, "probability", f_pct(dnP), colSup, dnP)
        r += 1
        if tblFull
            f_rowG(dash, r, "wall hold", f_pct(hdD), colSup, hdD)
            r += 1
            f_row(dash, r, "distance", na(gapD) ? "-" : f_px(gapD) + "  " + f_sig(gapD, sigRem), colSup)
            r += 1
            f_row(dash, r, "E[bot]", f_px(dnE), colSup)
            r += 1
            f_rowG(dash, r, "no wall holds", f_pct(dnNone), colSup, dnNone)
            r += 1
        f_row(dash, r, "eta", f_fmtMin(etaD), colSup)
        r += 1

        f_sec(dash, r, "EXHAUSTION")
        r += 1
        f_rowG(dash, r, "upside", f_pct(eUp), colRes, eUp)
        r += 1
        f_rowG(dash, r, "downside", f_pct(eDn), colSup, eDn)
        r += 1
        if tblFull
            f_sec(dash, r, "FIELD")
            r += 1
            f_row(dash, r, "live nodes", str.tostring(cntU) + " up  " + str.tostring(cntD) + " dn", colDim)
            r += 1
            f_row(dash, r, "stop pools", str.tostring(resH.size()) + " up  " + str.tostring(resL.size()) + " dn", colDim)
            r += 1

            // model said vs what happened on this chart
            f_sec(dash, r, "CALIBRATION")
            r += 1
            float hN = cN.sum()
            f_row(dash, r, "hold tests", hN > 0 ? "model " + f_pct(cS.sum() / hN) + "  held " + f_pct(cW.sum() / hN) + "  n " + str.tostring(hN, "#") : "none yet", colDim)
            r += 1
            float rN  = rbN.sum()
            float rel = 0.0
            for b = 0 to 9
                float nb = rbN.get(b)
                if nb > 0
                    rel += math.pow(rbP.get(b) - rbH.get(b), 2) / nb
            f_row(dash, r, "reach", rN > 0 ? "said " + f_pct(rbP.sum() / rN) + "  hit " + f_pct(rbH.sum() / rN) + "  n " + str.tostring(rN, "#") : "no full session yet", colDim)
            r += 1
            f_row(dash, r, "reach reliability", rN > 0 ? str.tostring(rel / rN, "0.0000") : "-", colDim)
            r += 1
