//@version=6
indicator("TERMINUS · Price-Axis Survival Reversal Engine", shorttitle = "TERMINUS", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ============================================================================
// Visual grammar: three tiers, one accent per side, nothing saturated except
// the two levels that actually matter right now.
//   tier 1  active terminus  — tinted zone + border + projection + readout
//   tier 2  ladder nodes     — faint zone + level tick + aligned readout
//   tier 3  dormant nodes    — neutral slate wash, no border, no text
// Everything on the chart is keyed to probability, so weak structure fades
// instead of shouting.
//
// ── corrections ─────────────────────────────────────────────────────────────
// 1. Node merge decays standing mass to the present before adding fresh mass,
//    then re-bases the decay clock.
// 2. Eviction ranks by decayed mass (f_mass), not raw birth mass.
// 3. Session clock handles windows that cross midnight (now modular minutes).
// 4. The survival scan skips walls price has already closed through.
// 5. f_pct keeps one decimal below ~10% AND above ~90%, so sub-percent
//    probabilities and near-certain complements stay distinguishable.
// 6. alertcondition hooks for threshold crossings and terminus touches.
// 7. Horizon priced from the bar CLOSE, not the bar open.
// 8. Hold model is logistic with an intercept. The old 1 − exp(−x) form
//    forced a wall with no mass and no stops to 0% hold. Defaults roughly
//    reproduce the old curve; replace them with fitted coefficients.
// 9. Learned time-of-day variance clock replaces linear session time.
//    Intraday variance is U-shaped, so linear time overstated what was left
//    after the open and understated it into the bell. Falls back to the
//    linear clock until it has warmed up.
// 10. volScale is realised vs EXPECTED-for-this-time-of-day variance. The
//    old atr14/atr200 ratio mostly measured the clock (pinned near the cap
//    every open, the floor every evening).
// 11. HMM range baseline is the same time-of-day profile, so the regime
//    reads the market, not the hour.
// 12. ETA walks the same variance clock the reach model uses, and says
//    "after close" when the median passage lands beyond the horizon.
// 13. Outside the session the horizon is the NEXT session close, so the
//    probabilities no longer jump ~7x at the bell.
// 14. Continuous-futures rolls (NQ1!, ES1!, …) are detected from the 1!/2!
//    spread and memory is SHIFTED by it. The 12% wipe never fired on index
//    futures (rolls gap ~0.5–1%), leaving supports ~0.8% off for 20 days.
// 15. Break acceptance is measured in minutes / depth, not "one close", so
//    the same wall lives or dies the same way on 1m and 15m charts, and a
//    sweep-and-reclaim no longer deletes the wall right before it works.
// 16. Merge moves the node centre (mass-weighted), not just its mass.
// 17. Zone height in ADR units by default (legacy % of price kept).
// 18. Exhaustion is directional (absorption split by wick side, efficiency
//    collapse split by leg direction) and can feed the hold model (bE).
// 19. "no wall holds" split into "never reaches" and "breaks all": the old
//    number was mostly "price never gets there".
// 20. Touch alerts are edge-triggered instead of firing every bar in zone.
// 21. Hold ledger: every first touch is graded (held = reverses N x ADR
//    before acceptance) for real walls AND a placebo field of walls shifted
//    1–3 heights at random. If real ≈ placebo, the memory is decoration.
// 22. Provisional nodes from the developing epoch (experimental, off).
// 23. SMT partner picked from the chart root (NQ↔ES) and disabled when it
//    would compare a symbol with itself.
// ============================================================================

// ════════════════════════════ INPUTS ════════════════════════════
string G1 = "Memory field (absorption nodes)"
string epochTF     = input.timeframe("1D", "Epoch (node birth cadence)", group = G1)
int    nBins       = input.int(48, "Profile bins per epoch", minval = 12, maxval = 200, group = G1)
float  peakMult    = input.float(1.35, "Peak threshold (x mean density)", minval = 1.0, step = 0.05, group = G1)
int    topK        = input.int(3, "Nodes born per epoch", minval = 1, maxval = 10, group = G1)
string hMode       = input.string("ADR fraction", "Zone height mode", options = ["ADR fraction", "% of price (legacy)"], group = G1)
float  hAdr        = input.float(0.05, "Zone height (x ADR)", minval = 0.005, step = 0.005, group = G1)
float  wCalmPct    = input.float(0.068, "Legacy height % of price (calm)", minval = 0.005, step = 0.001, group = G1)
float  wVolPct     = input.float(0.102, "Legacy height % of price (volatile)", minval = 0.005, step = 0.001, group = G1)
int    maxNodes    = input.int(60, "Max live nodes", minval = 5, maxval = 150, group = G1)
float  maxAgeD     = input.float(20.0, "Max node age (days)", minval = 1.0, group = G1)
float  halfLifeD   = input.float(5.0, "Mass half-life (days)", minval = 0.5, group = G1)
float  bandPct     = input.float(10.0, "Distance band (% of price)", minval = 1.0, group = G1)
float  acceptMin   = input.float(15.0, "Break acceptance: minutes of closes beyond", minval = 0.0, step = 5.0, tooltip = "A wall dies after closes beyond its far edge for this long, or one close beyond by the depth below. Set either to 0 for the old one-close rule.", group = G1)
float  acceptDepth = input.float(1.0, "…or one close beyond by (x half-height)", minval = 0.0, step = 0.25, group = G1)
int    provEvery   = input.int(0, "Provisional nodes from today: rebuild every N min (0 = off)", minval = 0, maxval = 720, tooltip = "Experimental. Walls from the developing epoch, drawn dashed, replaced on each rebuild and retired when the epoch closes. Validate with the hold ledger before trusting.", group = G1)

string G1b = "Contract rolls"
bool  rollShiftOn = input.bool(true, "Shift memory across continuous-futures rolls", tooltip = "On 1! continuous contracts, a gap that matches the prior 1!/2! spread is treated as a roll and every node, stop pool and profile sample is shifted by it. Back-adjusting the chart makes this a no-op.", group = G1b)
float rollPct     = input.float(12.0, "Wipe memory on any gap > % (fallback)", minval = 2.0, group = G1b)

string G2 = "Hold model (logistic: replace with fitted coefficients)"
float b0       = input.float(-1.6, "b0  intercept (base hold rate)", step = 0.1, group = G2)
float bM       = input.float(0.70, "bM  decayed absorbed mass", step = 0.05, group = G2)
float bS       = input.float(0.80, "bS  √ stop pools in fuel zone", step = 0.05, group = G2)
float bT       = input.float(0.0, "bT  prior graded touches", step = 0.05, group = G2)
float bE       = input.float(0.0, "bE  exhaustion at the wall (centred)", step = 0.1, group = G2)
float fuelZone = input.float(3.0, "Fuel reach (x node half-height)", minval = 0.5, step = 0.5, group = G2)
int   pivLen   = input.int(5, "Stop-pool pivot length", minval = 2, group = G2)

string G3 = "Reach model"
string tz        = input.string("America/New_York", "Session timezone", group = G3)
int    sStartH   = input.int(9, "Session start hour", minval = 0, maxval = 23, group = G3)
int    sStartM   = input.int(30, "Session start minute", minval = 0, maxval = 59, group = G3)
int    sEndH     = input.int(16, "Session end hour", minval = 0, maxval = 23, group = G3)
int    sEndM     = input.int(0, "Session end minute", minval = 0, maxval = 59, group = G3)
int    adrLen    = input.int(14, "ADR length (days)", minval = 2, group = G3)
bool   useClock  = input.bool(true, "Learned time-of-day variance clock", group = G3)
int    clkMem    = input.int(20, "Clock memory (days)", minval = 2, maxval = 200, group = G3)
int    clkWarm   = input.int(3, "Clock warm-up (days before use)", minval = 1, maxval = 60, group = G3)
int    volWinMin = input.int(120, "Realised-vol window (minutes)", minval = 15, maxval = 1440, group = G3)

string G4 = "Regime HMM"
int   hmmLen = input.int(100, "Range baseline length (warm-up fallback)", minval = 20, group = G4)
float muC    = input.float(-0.25, "Calm state mean (log range ratio)", step = 0.05, group = G4)
float sdC    = input.float(0.45, "Calm state sd", minval = 0.05, step = 0.05, group = G4)
float muV    = input.float(0.45, "Volatile state mean", step = 0.05, group = G4)
float sdV    = input.float(0.60, "Volatile state sd", minval = 0.05, step = 0.05, group = G4)
float pStay  = input.float(0.98, "State persistence", minval = 0.5, maxval = 0.999, step = 0.005, group = G4)

string G5 = "Exhaustion readout"
int    divLen  = input.int(20, "Extreme / divergence lookback", minval = 5, group = G5)
int    erLen   = input.int(10, "Efficiency length", minval = 3, group = G5)
bool   useSMT  = input.bool(true, "Use intermarket SMT", group = G5)
bool   smtAuto = input.bool(true, "Auto-pick SMT partner (NQ↔ES)", group = G5)
string smtSym  = input.symbol("CME_MINI:ES1!", "SMT symbol (manual / other roots)", group = G5)

string G6 = "Display · structure"
bool  showNodes  = input.bool(true, "Memory zones", group = G6)
bool  showLadder = input.bool(true, "Probability ladder", group = G6)
bool  showProj   = input.bool(true, "Terminus projection", group = G6)
bool  showExp    = input.bool(true, "Expected reversal price (dotted)", group = G6)
bool  showTrail  = input.bool(false, "Terminus trail (historical levels)", group = G6)
int   ladderMax  = input.int(3, "Ladder rows per side", minval = 1, maxval = 8, group = G6)
float minProb    = input.float(4.0, "Ladder threshold (% probability)", minval = 0.5, maxval = 50.0, step = 0.5, group = G6)
int   rightPad   = input.int(6, "Zone extension (bars past price)", minval = 0, maxval = 60, group = G6)

string G7 = "Display · dashboard & palette"
bool   showTable = input.bool(true, "Dashboard", group = G7)
bool   tblFull   = input.bool(true, "Full detail (off = compact)", group = G7)
string tblPos    = input.string(position.top_right, "Dashboard position", options = [position.top_right, position.middle_right, position.bottom_right, position.top_left, position.bottom_left], group = G7)
string tblSize   = input.string(size.small, "Dashboard text size", options = [size.tiny, size.small, size.normal], group = G7)
color  colRes    = input.color(color.rgb(199, 106, 114), "Upside (resistance)", group = G7)
color  colSup    = input.color(color.rgb(86, 166, 154), "Downside (support)", group = G7)
color  colNeut   = input.color(color.rgb(120, 132, 148), "Dormant structure", group = G7)
color  colPanel  = input.color(color.rgb(14, 17, 22), "Panel background", group = G7)

string G8 = "Alerts"
float alertThr = input.float(50.0, "Alert threshold (% probability)", minval = 1.0, maxval = 99.0, step = 1.0, group = G8) / 100.0

string G9 = "Hold ledger (self-test)"
bool  useLedger  = input.bool(true, "Grade wall touches", group = G9)
bool  usePlacebo = input.bool(true, "Placebo walls (control group)", tooltip = "Every real wall gets an invisible twin moved 1–3 zone heights up or down (deterministic). Twins are graded by the same rule. Real walls should hold measurably more often than their twins.", group = G9)
float holdRev    = input.float(0.10, "Held = reversal of (x ADR) before acceptance", minval = 0.01, step = 0.01, group = G9)

// Typography and chrome, derived once so every drawing agrees
color  colTxt  = color.rgb(226, 232, 240)
color  colDim  = color.rgb(126, 137, 153)
color  colSect = color.rgb(24, 29, 37)
color  colWarn = color.rgb(214, 158, 92)
string MONO    = font.family_monospace

// ════════════════════════════ TYPES ════════════════════════════
type Node
    float p
    float m
    float w
    int   t
    int   side
    int   id
    float prob    = 0.0
    float hold    = 0.0
    box   bx
    bool  prov    = false
    int   touches = 0
    int   outT
    bool  armed   = false
    int   armT
    float predH   = 0.0

type Ledger
    int   n      = 0
    int   held   = 0
    float pSum   = 0.0
    float bSum   = 0.0
    int   hiN    = 0
    int   hiHeld = 0

// ════════════════════════════ FUNCTIONS ════════════════════════════
f_phi(float x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float d = 0.3989422804 * math.exp(-x * x / 2.0)
    float q = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))))
    x >= 0 ? 1.0 - q : q

f_reach(float d, float s) =>
    s > 0 ? math.min(1.0, 2.0 * (1.0 - f_phi(d / s))) : 0.0

f_gauss(float x, float mu, float sd) =>
    math.exp(-0.5 * math.pow((x - mu) / sd, 2)) / sd

// Median first-passage time in bars (warm-up fallback only)
f_eta(float d, float sb) =>
    sb > 0 ? math.pow(d / (0.6745 * sb), 2) : na

f_mod(float x, float m) =>
    x - m * math.floor(x / m)

// Deterministic hash in [0, 1): the placebo field must be identical on every reload
f_rand(int i) =>
    float x = math.sin(i * 12.9898 + 78.233) * 43758.5453
    x - math.floor(x)

// One decimal below ~10% and above ~90%, whole numbers in between
f_pct(float x) =>
    na(x) ? "-" : str.tostring(x * 100.0, x < 0.095 or x > 0.905 ? "0.#" : "#") + "%"

f_px(float x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

// Distance in units of the volatility still available: scale-free
f_sig(float d, float s) =>
    na(d) or s <= 0 ? "-" : str.tostring(d / s, "#.##") + "σ"

// Five-segment meter: reads as a shape, not a number
f_gauge(float v) =>
    int n = na(v) ? 0 : int(math.round(math.max(0.0, math.min(1.0, v)) * 5.0))
    string s = ""
    for i = 1 to 5
        s += i <= n ? "▰" : "▱"
    s

f_kill(array<Node> arr, int i) =>
    Node n = arr.remove(i)
    if not na(n.bx)
        box.delete(n.bx)
    true

// Decayed mass, for the hold model, readout and eviction ranking
f_mass(Node n) =>
    n.m * math.pow(0.5, ((time - n.t) / 86400000.0) / halfLifeD)

// Logistic hold: P(the wall reverses price | price reaches it)
f_hold(Node n, array<float> res, float ex) =>
    float mEff = f_mass(n)
    float fuelR = fuelZone * n.w
    int s = 0
    if res.size() > 0
        for k = 0 to res.size() - 1
            float r = res.get(k)
            if n.side == 1 and r >= n.p - n.w - fuelR and r <= n.p + n.w
                s += 1
            if n.side == -1 and r <= n.p + n.w + fuelR and r >= n.p - n.w
                s += 1
    float z = b0 + bM * mEff + bS * math.sqrt(s) + bT * n.touches + bE * ex
    1.0 / (1.0 + math.exp(-z))

// Price-axis survival scan for one side. Returns the terminus index and
// probability, the probability-weighted wall price, P(never reaches the first
// wall) and P(breaks through every wall).
f_side(array<Node> arr, int sd, float px, float sRem, array<float> res, float ex) =>
    array<float> dist = array.new<float>()
    array<int> idx = array.new<int>()
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Node n = arr.get(i)
            if n.side == sd
                n.prob := 0.0
                // Walls price is currently beyond are not ahead of it. Distance
                // clamps at zero, so without this they would score reach = 1.0.
                bool spent = sd == 1 ? px > n.p + n.w : px < n.p - n.w
                if not spent
                    float edge = sd == 1 ? n.p - n.w : n.p + n.w
                    float d = sd == 1 ? math.max(0.0, edge - px) : math.max(0.0, px - edge)
                    dist.push(d)
                    idx.push(i)
    float surv = 1.0
    float bestP = 0.0
    int bestI = -1
    float sumP = 0.0
    float sumPX = 0.0
    float pNever = 1.0
    float pThru = 0.0
    if dist.size() > 0
        array<int> ord = dist.sort_indices(order.ascending)
        for j = 0 to ord.size() - 1
            int k = ord.get(j)
            Node n = arr.get(idx.get(k))
            float dk = dist.get(k)
            // Exhaustion only informs the wall price is sitting in right now
            float h = f_hold(n, res, dk == 0.0 ? ex : 0.0)
            float rch = f_reach(dk, sRem)
            float pr = rch * h * surv
            n.hold := h
            n.prob := pr
            surv *= (1.0 - h)
            sumP += pr
            sumPX += pr * n.p
            if j == 0
                pNever := 1.0 - rch
            if j == ord.size() - 1
                pThru := rch * surv
            if pr > bestP
                bestP := pr
                bestI := idx.get(k)
    [bestI, bestP, sumP > 0 ? sumPX / sumP : na, pNever, pThru]

// Profile variance between clock positions a and b (minutes from session
// start; may run past 1440 and wraps). Linear inside a bucket.
f_vspan(array<float> pr, float a, float b, float bw) =>
    float v = 0.0
    float x = a
    int guard = 0
    while x < b - 0.001 and guard < 600
        float xm = f_mod(x, 1440.0)
        int   k  = math.min(int(xm / bw), pr.size() - 1)
        float k0 = k * bw
        float k1 = math.min(k0 + bw, 1440.0)
        float step = math.max(math.min(k1 - xm, b - x), 0.001)
        v += k1 > k0 ? pr.get(k) * step / (k1 - k0) : 0.0
        x += step
        guard += 1
    v

// Minutes from clock position a until the profile accumulates `target`
f_etaMin(array<float> pr, float a, float target, float bw, float maxSpan) =>
    float v = 0.0
    float x = a
    float out = na
    int guard = 0
    while na(out) and x < a + maxSpan - 0.001 and guard < 600
        float xm = f_mod(x, 1440.0)
        int   k  = math.min(int(xm / bw), pr.size() - 1)
        float k0 = k * bw
        float k1 = math.min(k0 + bw, 1440.0)
        float step = math.max(math.min(k1 - xm, a + maxSpan - x), 0.001)
        float dv = k1 > k0 ? pr.get(k) * step / (k1 - k0) : 0.0
        if dv > 0 and v + dv >= target
            out := x - a + step * (target - v) / dv
        else
            v += dv
            x += step
        guard += 1
    out

// Absorption profile peaks for an epoch's wick samples
f_peaks(array<float> P, array<float> W) =>
    array<float> pkP = array.new<float>()
    array<float> pkM = array.new<float>()
    if P.size() > 20
        float lo = P.min()
        float hi = P.max()
        float bs = (hi - lo) / nBins
        if bs > 0
            array<float> prof = array.new<float>(nBins, 0.0)
            float tot = 0.0
            for i = 0 to P.size() - 1
                int bi = math.max(0, math.min(nBins - 1, int(math.floor((P.get(i) - lo) / bs))))
                prof.set(bi, prof.get(bi) + W.get(i))
                tot += W.get(i)
            if tot > 0
                array<float> smo = array.new<float>(nBins, 0.0)
                for b = 0 to nBins - 1
                    float lv = b > 0 ? prof.get(b - 1) : prof.get(b)
                    float rv = b < nBins - 1 ? prof.get(b + 1) : prof.get(b)
                    smo.set(b, 0.25 * lv + 0.5 * prof.get(b) + 0.25 * rv)
                float meanSm = smo.avg()
                for b = 1 to nBins - 2
                    float v = smo.get(b)
                    if v >= smo.get(b - 1) and v > smo.get(b + 1) and v > meanSm * peakMult
                        float w0 = prof.get(b - 1)
                        float w1 = prof.get(b)
                        float w2 = prof.get(b + 1)
                        float ws = w0 + w1 + w2
                        if ws > 0
                            float c0 = lo + (b - 0.5) * bs
                            float c1 = lo + (b + 0.5) * bs
                            float c2 = lo + (b + 1.5) * bs
                            pkP.push((w0 * c0 + w1 * c1 + w2 * c2) / ws)
                            pkM.push(ws / tot * nBins / 3.0)
    [pkP, pkM]

f_mkNode(float np, float nm, float hgt, int sd, int id, bool prov, bool draw) =>
    box bx = na
    if draw
        // Born neutral and near-invisible; the last-bar pass re-weights every
        // zone by live probability.
        bx := box.new(bar_index, np + hgt / 2.0, bar_index + 1, np - hgt / 2.0, border_color = color.new(colNeut, 100), border_width = 0, border_style = prov ? line.style_dashed : line.style_solid, bgcolor = color.new(colNeut, 94), extend = extend.none)
    Node.new(p = np, m = nm, w = hgt / 2.0, t = time, side = sd, id = id, bx = bx, prov = prov)

// Ledger: arm on the first touch of the near edge, pricing hold as it stood
// before this bar's sweep removed any stop pools
f_arm(Node n, array<float> res, float ex) =>
    float near = n.side == 1 ? n.p - n.w : n.p + n.w
    bool touch = n.side == 1 ? high >= near : low <= near
    if touch and not n.armed and not n.prov
        n.armed := true
        n.armT := time
        n.predH := f_hold(n, res, ex)
    touch

// Ledger: resolve an armed touch. Acceptance first (pessimistic); a reversal
// only counts from the bar after the touch, since intrabar order is unknown.
f_resolve(Node n, bool accepted, float revD, Ledger L, float hiThr) =>
    int r = 0
    if n.armed
        float near = n.side == 1 ? n.p - n.w : n.p + n.w
        float rv = revD > 0 ? revD : 4.0 * n.w
        bool back = time > n.armT and (n.side == 1 ? low <= near - rv : high >= near + rv)
        r := accepted ? -1 : back ? 1 : 0
        if r != 0
            float y = r == 1 ? 1.0 : 0.0
            L.n := L.n + 1
            L.held := L.held + (r == 1 ? 1 : 0)
            L.pSum := L.pSum + n.predH
            L.bSum := L.bSum + math.pow(n.predH - y, 2)
            if n.predH >= hiThr
                L.hiN := L.hiN + 1
                L.hiHeld := L.hiHeld + (r == 1 ? 1 : 0)
            n.armed := false
            n.touches := n.touches + 1
    r

f_shiftNodes(array<Node> arr, float s) =>
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Node n = arr.get(i)
            n.p := n.p + s
            n.outT := na
            if not na(n.bx)
                box.set_top(n.bx, n.p + n.w)
                box.set_bottom(n.bx, n.p - n.w)
    true

f_shiftArr(array<float> arr, float s) =>
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            arr.set(i, arr.get(i) + s)
    true

// ── dashboard cells ──────────────────────────────────────────
f_sec(table tb, int r, string s) =>
    table.cell(tb, 0, r, s, text_color = colTxt, text_size = tblSize, text_halign = text.align_left, bgcolor = colSect, text_font_family = MONO)
    table.cell(tb, 1, r, "", bgcolor = colSect)
    table.cell(tb, 2, r, "", bgcolor = colSect)

f_row(table tb, int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = colDim, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
    table.cell(tb, 1, r, v, text_color = c, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)
    table.cell(tb, 2, r, "", text_size = tblSize)

f_rowG(table tb, int r, string k, string v, color c, float g) =>
    table.cell(tb, 0, r, k, text_color = colDim, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
    table.cell(tb, 1, r, v, text_color = c, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)
    table.cell(tb, 2, r, f_gauge(g), text_color = color.new(c, 35), text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)

// ════════════════════════════ STATE ════════════════════════════
var array<Node>  nodes  = array.new<Node>()
var array<Node>  ghosts = array.new<Node>()
var array<float> epP    = array.new<float>()
var array<float> epW    = array.new<float>()
var array<float> resH   = array.new<float>()
var array<float> resL   = array.new<float>()
var int    nodeId        = 0
var int    lastProvT     = na
var float  lastRollShift = na
var int    lastRollT     = na
var Ledger lgR           = Ledger.new()
var Ledger lgG           = Ledger.new()

// ════════════════════════════ CORE SERIES ════════════════════════════
float atrS    = ta.atr(14)
float atrL    = ta.atr(200)
float rngNow  = high - low
float bodyAbs = math.abs(close - open)
float uw      = high - math.max(open, close)
float lw      = math.min(open, close) - low
float r2      = na(close[1]) or close[1] <= 0 ? na : math.pow(math.log(close / close[1]), 2)

float adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen)[1], lookahead = barmerge.lookahead_on)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
float sigDay = nz(adr) / 1.596

// ── Session clock in modular minutes from session start (wraps midnight) ──
float tfMin   = timeframe.in_seconds() / 60.0
float bwMin   = math.max(15.0, tfMin)
int   nBk     = int(math.ceil(1440.0 / bwMin))
int   sOffMin = sStartH * 60 + sStartM
int   eOffMin = sEndH * 60 + sEndM
float sessLen = float(eOffMin > sOffMin ? eOffMin - sOffMin : eOffMin - sOffMin + 1440)

f_pos(int t) =>
    f_mod(hour(t, tz) * 60 + minute(t, tz) - sOffMin, 1440.0)

int   tClose  = na(time_close) ? time + timeframe.in_seconds() * 1000 : time_close
float posO    = f_pos(time)
float posC    = f_pos(tClose)
float posCa   = posC < posO ? posC + 1440.0 : posC
bool  inSess  = posO < sessLen
// Horizon: this session's close, or the next one once the bell has gone.
// Measured from this bar's CLOSE: the scan prices off `close`, so the outcome
// it describes can only begin on the next bar.
float hEnd    = inSess ? sessLen : sessLen + 1440.0
float minLeft = math.max(0.0, hEnd - posCa)

// ── Learned time-of-day profile: variance and mean bar range per bucket ──
var array<float> vProf = array.new<float>(nBk, 0.0)
var array<float> rProf = array.new<float>(nBk, 0.0)
var int   bkCur  = -1
var float accV   = 0.0
var float accR   = 0.0
var int   accN   = 0
var int   nCycle = 0
float clkA = 2.0 / (clkMem + 1.0)
int   bk   = math.min(int(posO / bwMin), nBk - 1)
if barstate.isconfirmed and not na(r2)
    if bk != bkCur
        if bkCur >= 0 and accN > 0
            float pv = vProf.get(bkCur)
            vProf.set(bkCur, pv == 0.0 ? accV : (1.0 - clkA) * pv + clkA * accV)
            float pr0 = rProf.get(bkCur)
            float mr = accR / accN
            rProf.set(bkCur, pr0 == 0.0 ? mr : (1.0 - clkA) * pr0 + clkA * mr)
        if bkCur >= 0 and bk < bkCur
            nCycle += 1
        bkCur := bk
        accV := 0.0
        accR := 0.0
        accN := 0
    accV += r2
    accR += rngNow
    accN += 1

bool  clkReady = useClock and nCycle >= clkWarm
float vDay     = clkReady ? vProf.sum() : 0.0
float vLeft    = clkReady and vDay > 0 ? f_vspan(vProf, posCa, hEnd, bwMin) : 0.0
float tauLin   = inSess ? minLeft / sessLen : 1.0
float tauRem   = clkReady and vDay > 0 ? math.min(1.0, vLeft / vDay) : tauLin

// Realised vs expected-for-this-hour variance over a trailing window
int   volWinBars = math.max(3, int(math.round(volWinMin / tfMin)))
float rvWin      = math.sum(nz(r2), volWinBars)
float evWin      = clkReady and vDay > 0 ? f_vspan(vProf, posCa - volWinBars * tfMin, posCa, bwMin) : 0.0
float volLegacy  = na(atrL) or na(atrS) or atrL <= 0 ? 1.0 : math.max(0.6, math.min(1.8, atrS / atrL))
float volScale   = clkReady and evWin > 0 ? math.max(0.6, math.min(1.8, math.sqrt(rvWin / evWin))) : volLegacy

float sigRem    = sigDay * math.sqrt(math.max(tauRem, 0.02)) * volScale
float sigBarRaw = nz(atrL, atrS) / 1.596
float sigBar    = nz(sigBarRaw) * volLegacy

// Regime HMM (2-state forward filter on log range ratio vs this hour's norm)
float rngSMA  = ta.sma(rngNow, hmmLen)
float rngExp  = clkReady ? rProf.get(bk) : 0.0
float rngBase = rngExp > 0 ? rngExp : rngSMA
float xr = na
if not na(rngBase)
    xr := math.log(math.max(rngNow, syminfo.mintick) / math.max(rngBase, syminfo.mintick))
var float pV = 0.5
if not na(xr)
    float priC = (1.0 - pV) * pStay + pV * (1.0 - pStay)
    float priV = pV * pStay + (1.0 - pV) * (1.0 - pStay)
    float aC = priC * f_gauss(xr, muC, sdC)
    float aV = priV * f_gauss(xr, muV, sdV)
    if aC + aV > 0
        pV := aV / (aC + aV)
bool hmmReady = bar_index > hmmLen
bool isVolatile = hmmReady and pV > 0.5

// Effort vs result, split by which side the rejection wick is on
float effR = nz(volume) / (bodyAbs + 0.1 * nz(atrS, rngNow) + syminfo.mintick)
float effMu = ta.sma(effR, 50)
float effSd = ta.stdev(effR, 50)
float effZ = nz(effSd) > 0 ? (effR - nz(effMu)) / effSd : 0.0
float cA = 1.0 / (1.0 + math.exp(-(effZ - 1.0)))
float wickTot = uw + lw
float cUpR = ta.highest(cA * (wickTot > 0 ? uw / wickTot : 0.5), 5)
float cDnR = ta.highest(cA * (wickTot > 0 ? lw / wickTot : 0.5), 5)

// Synthetic CVD divergence
float clv = rngNow > 0 ? (2.0 * close - high - low) / rngNow : 0.0
var float cvd = 0.0
cvd += nz(volume) * clv
bool newHi = high >= ta.highest(high, divLen)
bool newLo = low <= ta.lowest(low, divLen)
float cvdHi = ta.highest(cvd, divLen)
float cvdLo = ta.lowest(cvd, divLen)
bool bearDiv = newHi and cvd < nz(cvdHi, cvd)
bool bullDiv = newLo and cvd > nz(cvdLo, cvd)

// Intermarket SMT: partner picked from the chart root, never the chart itself
string rt      = syminfo.root
string smtPick = rt == "NQ" or rt == "MNQ" ? "CME_MINI:ES1!" : rt == "ES" or rt == "MES" ? "CME_MINI:NQ1!" : smtSym
string smtUse  = smtAuto ? smtPick : smtSym
bool   smtOn   = useSMT and not str.contains(smtUse, ":" + rt + "1!")
[smtHiGap, smtLoGap] = request.security(smtUse, timeframe.period, [ta.highest(high, divLen) - high, low - ta.lowest(low, divLen)], ignore_invalid_symbol = true)
bool bearSmt = smtOn and newHi and not na(smtHiGap) and smtHiGap > 0
bool bullSmt = smtOn and newLo and not na(smtLoGap) and smtLoGap > 0

bool bearDivR = nz(ta.barssince(bearDiv), 999) <= 5
bool bullDivR = nz(ta.barssince(bullDiv), 999) <= 5
bool bearSmtR = nz(ta.barssince(bearSmt), 999) <= 5
bool bullSmtR = nz(ta.barssince(bullSmt), 999) <= 5

// Efficiency collapse, credited to the side of the leg that is stalling
float erDen = math.sum(math.abs(close - close[1]), erLen)
float er = nz(erDen) > 0 ? math.abs(close - close[erLen]) / erDen : 0.5
float erMA = ta.sma(er, erLen)
bool erLow = er < nz(erMA, er)
bool erUp = erLow and close > close[erLen]
bool erDn = erLow and close < close[erLen]

float wSum = 3.0 + (smtOn ? 1.0 : 0.0)
float eUp = (nz(cUpR) + (bearDivR ? 1.0 : 0.0) + (bearSmtR ? 1.0 : 0.0) + (erUp ? 1.0 : 0.0)) / wSum
float eDn = (nz(cDnR) + (bullDivR ? 1.0 : 0.0) + (bullSmtR ? 1.0 : 0.0) + (erDn ? 1.0 : 0.0)) / wSum

// Pivots (global scope, every bar)
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
bool dayChange = timeframe.change("1D")
bool newEpoch = timeframe.change(epochTF)
bool tfBad = timeframe.in_seconds() >= timeframe.in_seconds(epochTF)

// ── functions that read the series above ──
f_height() =>
    hMode == "ADR fraction" and nz(adr) > 0 ? hAdr * adr : close * (isVolatile ? wVolPct : wCalmPct) / 100.0

f_accept(Node n) =>
    bool beyond = n.side == 1 ? close > n.p + n.w : close < n.p - n.w
    float over = n.side == 1 ? close - n.p - n.w : n.p - n.w - close
    if beyond
        if na(n.outT)
            n.outT := time
    else
        n.outT := na
    beyond and (over >= acceptDepth * n.w or tClose - n.outT >= acceptMin * 60000.0)

// Median first-passage time in minutes, on the same clock and σ as reach
f_etaAny(float d) =>
    float m = na
    if not na(d)
        if d <= 0
            m := 0.0
        else if clkReady and vDay > 0 and sigDay > 0
            float tgt = math.pow(d / 0.6745, 2) * vDay / math.pow(sigDay * volScale, 2)
            float em = f_etaMin(vProf, posCa, tgt, bwMin, 2880.0)
            m := na(em) ? 1e9 : em
        else
            float eb = f_eta(d, sigBar)
            m := na(eb) ? na : eb * tfMin
    m

f_fmtEta(float m) =>
    na(m) ? "-" : m < 1.0 ? "AT ZONE" : m > minLeft ? (inSess ? "after close" : "after next close") : m < 60.0 ? str.tostring(m, "#") + "m" : str.tostring(m / 60.0, "#.#") + "h"

// ════════════════════════════ CONTRACT ROLLS ════════════════════════════
// A roll on a continuous contract gaps by the prior front/next spread. Match
// the gap to that spread and move the memory with it instead of wiping it.
bool   isCont = str.endswith(syminfo.ticker, "1!")
string nextTk = isCont ? syminfo.prefix + ":" + syminfo.root + "2!" : syminfo.tickerid
float  nextC  = request.security(nextTk, timeframe.period, close, ignore_invalid_symbol = true)
float  spread = isCont and not na(nextC) ? nextC - close : 0.0
float  gapO   = na(close[1]) ? 0.0 : open - close[1]
float  spr1   = spread[1]
bool   rolled = rollShiftOn and isCont and not na(spr1) and not na(sigBarRaw) and math.abs(spr1) > 2.0 * sigBarRaw and math.abs(gapO) > 2.0 * sigBarRaw and math.sign(gapO) == math.sign(spr1) and math.abs(gapO - spr1) < 0.35 * math.abs(spr1)
float  rollAdj = 0.0
if rolled
    rollAdj := spr1
    f_shiftNodes(nodes, spr1)
    f_shiftNodes(ghosts, spr1)
    f_shiftArr(resH, spr1)
    f_shiftArr(resL, spr1)
    f_shiftArr(epP, spr1)
    lastRollShift := spr1
    lastRollT := time
else if not na(close[1]) and close[1] > 0 and math.abs(gapO) / close[1] * 100.0 > rollPct
    if nodes.size() > 0
        for i = nodes.size() - 1 to 0
            f_kill(nodes, i)
    ghosts.clear()
    resH.clear()
    resL.clear()
    epP.clear()
    epW.clear()

// ════════════════════════════ LEDGER · ARM ON TOUCH ════════════════════════════
// Runs before the stop reservoirs update, so a wall's predicted hold is the one
// it had before this bar swept any pools on the way in.
if useLedger and barstate.isconfirmed
    if nodes.size() > 0
        for i = 0 to nodes.size() - 1
            Node n = nodes.get(i)
            f_arm(n, n.side == 1 ? resH : resL, (n.side == 1 ? eUp : eDn) - 0.5)
    if ghosts.size() > 0
        for i = 0 to ghosts.size() - 1
            Node g = ghosts.get(i)
            f_arm(g, g.side == 1 ? resH : resL, (g.side == 1 ? eUp : eDn) - 0.5)

// ════════════════════════════ STOP RESERVOIRS ════════════════════════════
if resH.size() > 0
    for i = resH.size() - 1 to 0
        if high > resH.get(i)
            resH.remove(i)
if resL.size() > 0
    for i = resL.size() - 1 to 0
        if low < resL.get(i)
            resL.remove(i)
if not na(ph)
    resH.push(ph)
if not na(pl)
    resL.push(pl)
if dayChange and not na(pdh) and pdh + rollAdj > high
    resH.push(pdh + rollAdj)
if dayChange and not na(pdl) and pdl + rollAdj < low
    resL.push(pdl + rollAdj)
while resH.size() > 80
    resH.shift()
while resL.size() > 80
    resL.shift()

// ════════════════════════════ NODE BIRTH (epoch close) ════════════════════════════
if newEpoch
    // Provisional walls retire; the real birth below absorbs the same structure
    if nodes.size() > 0
        for i = nodes.size() - 1 to 0
            if nodes.get(i).prov
                f_kill(nodes, i)
    lastProvT := time
    [pkP, pkM] = f_peaks(epP, epW)
    if pkM.size() > 0
        array<int> ordPk = pkM.sort_indices(order.descending)
        int take = math.min(topK, ordPk.size())
        float hgt = f_height()
        for j = 0 to take - 1
            int q = ordPk.get(j)
            float np = pkP.get(q)
            float nm = pkM.get(q)
            bool inBand = math.abs(np - close) / close * 100.0 <= bandPct
            bool merged = false
            if inBand and nodes.size() > 0
                for k = 0 to nodes.size() - 1
                    Node e = nodes.get(k)
                    if math.abs(e.p - np) <= e.w
                        // Decay standing mass to the present, add fresh mass,
                        // and move the centre by mass, then re-base the clock
                        float mOld = f_mass(e)
                        float mNew = 0.5 * nm
                        e.p := (mOld * e.p + mNew * np) / (mOld + mNew)
                        e.m := math.min(mOld + mNew, 12.0)
                        e.t := time
                        if not na(e.bx)
                            box.set_top(e.bx, e.p + e.w)
                            box.set_bottom(e.bx, e.p - e.w)
                        merged := true
                        break
            if inBand and not merged and math.abs(np - close) > hgt / 2.0
                if nodes.size() >= maxNodes
                    int lowI = 0
                    float lowM = 1e10
                    for k = 0 to nodes.size() - 1
                        // Rank by decayed mass so the stalest wall goes
                        float mk = f_mass(nodes.get(k))
                        if mk < lowM
                            lowM := mk
                            lowI := k
                    f_kill(nodes, lowI)
                nodeId += 1
                nodes.push(f_mkNode(np, nm, hgt, np > close ? 1 : -1, nodeId, false, showNodes))
                // Placebo twin: same mass and height, displaced 1–3 heights
                if usePlacebo
                    float sgn = f_rand(nodeId) < 0.5 ? -1.0 : 1.0
                    float gp = np + sgn * (1.0 + 2.0 * f_rand(nodeId + 7919)) * hgt
                    if math.abs(gp - close) > hgt / 2.0 and math.abs(gp - close) / close * 100.0 <= bandPct
                        if ghosts.size() >= maxNodes
                            ghosts.shift()
                        ghosts.push(f_mkNode(gp, nm, hgt, gp > close ? 1 : -1, nodeId, false, false))
    epP.clear()
    epW.clear()

// ════════════════════════════ PROVISIONAL NODES (experimental) ════════════════════════════
if provEvery > 0 and barstate.isconfirmed and not newEpoch and epP.size() > 20 and (na(lastProvT) or time - lastProvT >= provEvery * 60000)
    lastProvT := time
    if nodes.size() > 0
        for i = nodes.size() - 1 to 0
            if nodes.get(i).prov
                f_kill(nodes, i)
    [qP, qM] = f_peaks(epP, epW)
    if qM.size() > 0
        array<int> oq = qM.sort_indices(order.descending)
        int takeQ = math.min(topK, oq.size())
        float hq = f_height()
        for j = 0 to takeQ - 1
            float np = qP.get(oq.get(j))
            bool clash = false
            if nodes.size() > 0
                for k = 0 to nodes.size() - 1
                    Node e = nodes.get(k)
                    if math.abs(e.p - np) <= e.w + hq / 2.0
                        clash := true
                        break
            bool ok = not clash and nodes.size() < maxNodes and math.abs(np - close) > hq / 2.0 and math.abs(np - close) / close * 100.0 <= bandPct
            if ok
                nodeId += 1
                nodes.push(f_mkNode(np, qM.get(oq.get(j)), hq, np > close ? 1 : -1, nodeId, true, showNodes))

// Absorbed-volume accumulation for the running epoch
float absorb = rngNow > 0 ? nz(volume) * (1.0 - bodyAbs / rngNow) : 0.0
if absorb > 0 and uw + lw > 0
    if uw > 0
        epP.push(math.max(open, close) + uw / 2.0)
        epW.push(absorb * uw / (uw + lw))
    if lw > 0
        epP.push(math.min(open, close) - lw / 2.0)
        epW.push(absorb * lw / (uw + lw))
while epP.size() > 20000
    epP.shift()
    epW.shift()

// ════════════════════════════ NODE LIFECYCLE (every confirmed bar) ════════════════════════════
float revD = nz(adr) > 0 ? holdRev * adr : 0.0
if barstate.isconfirmed and nodes.size() > 0
    for i = nodes.size() - 1 to 0
        Node n = nodes.get(i)
        bool acc = f_accept(n)
        if useLedger and not n.prov
            f_resolve(n, acc, revD, lgR, alertThr)
        bool tooOld = (time - n.t) > maxAgeD * 86400000.0
        bool tooFar = math.abs(n.p - close) / close * 100.0 > bandPct
        if acc or tooOld or tooFar
            f_kill(nodes, i)
if barstate.isconfirmed and ghosts.size() > 0
    for i = ghosts.size() - 1 to 0
        Node g = ghosts.get(i)
        bool accG = f_accept(g)
        if useLedger
            f_resolve(g, accG, revD, lgG, alertThr)
        bool oldG = (time - g.t) > maxAgeD * 86400000.0
        bool farG = math.abs(g.p - close) / close * 100.0 > bandPct
        if accG or oldG or farG
            ghosts.remove(i)

// ════════════════════════════ PRICE-AXIS SURVIVAL SCAN ════════════════════════════
[upI, upP, upE, upNever, upThru] = f_side(nodes, 1, close, sigRem, resH, eUp - 0.5)
[dnI, dnP, dnE, dnNever, dnThru] = f_side(nodes, -1, close, sigRem, resL, eDn - 0.5)
Node tU = na
Node tD = na
if upI >= 0
    tU := nodes.get(upI)
if dnI >= 0
    tD := nodes.get(dnI)

// ════════════════════════════ PLOTS ════════════════════════════
float tUpPrice = na
float tDnPrice = na
float tUpW = na
float tDnW = na
int   tUpId = -1
int   tDnId = -1
if not na(tU)
    tUpPrice := tU.p
    tUpW := tU.w
    tUpId := tU.id
if not na(tD)
    tDnPrice := tD.p
    tDnW := tD.w
    tDnId := tD.id
plot(tUpPrice, "Terminus high", color = showTrail ? color.new(colRes, 74) : na, style = plot.style_linebr, linewidth = 1)
plot(tDnPrice, "Terminus low", color = showTrail ? color.new(colSup, 74) : na, style = plot.style_linebr, linewidth = 1)
plot(upP, "P(upside terminus)", display = display.data_window)
plot(dnP, "P(downside terminus)", display = display.data_window)

// ════════════════════════════ ALERTS ════════════════════════════
bool armUp  = ta.crossover(upP, alertThr)
bool armDn  = ta.crossover(dnP, alertThr)
bool nearUp = not na(tUpPrice) and high >= tUpPrice - tUpW and upP >= alertThr
bool nearDn = not na(tDnPrice) and low <= tDnPrice + tDnW and dnP >= alertThr
// Edge-triggered: once per arrival, or when the terminus moves to a new wall
bool touchUp = nearUp and (not nearUp[1] or tUpId != tUpId[1])
bool touchDn = nearDn and (not nearDn[1] or tDnId != tDnId[1])
alertcondition(armUp, "Upside terminus armed", "TERMINUS: upside wall probability crossed the alert threshold")
alertcondition(armDn, "Downside terminus armed", "TERMINUS: downside wall probability crossed the alert threshold")
alertcondition(touchUp, "Upside terminus touched", "TERMINUS: price reached a high-probability upside wall")
alertcondition(touchDn, "Downside terminus touched", "TERMINUS: price reached a high-probability downside wall")

// ════════════════════════════ LAST-BAR RENDER ════════════════════════════
var line  pjU = na
var line  pjD = na
var line  exU = na
var line  exD = na
var label lbU = na
var label lbD = na
var array<label> ladder = array.new<label>()
var array<line>  ladLn  = array.new<line>()
var table dash = table.new(tblPos, 3, 42, bgcolor = color.new(colPanel, 12), border_width = 1, border_color = color.new(color.gray, 82), frame_width = 1, frame_color = color.new(color.gray, 68))

if barstate.islast
    line.delete(pjU)
    line.delete(pjD)
    line.delete(exU)
    line.delete(exD)
    label.delete(lbU)
    label.delete(lbD)
    if ladder.size() > 0
        for i = ladder.size() - 1 to 0
            label.delete(ladder.get(i))
        ladder.clear()
    if ladLn.size() > 0
        for i = ladLn.size() - 1 to 0
            line.delete(ladLn.get(i))
        ladLn.clear()

    float pMin = minProb / 100.0
    int xEdge = bar_index + rightPad

    // Terminus readouts resolved once, so nothing below touches a na node
    int   idU   = -1
    int   idD   = -1
    float pxU   = na
    float pxD   = na
    float hdU   = na
    float hdD   = na
    float gapU  = na
    float gapD  = na
    float etaMU = na
    float etaMD = na
    bool  pvU   = false
    bool  pvD   = false
    if not na(tU)
        idU   := tU.id
        pxU   := tU.p
        hdU   := tU.hold
        pvU   := tU.prov
        gapU  := math.max(0.0, tU.p - tU.w - close)
        etaMU := f_etaAny(gapU)
    if not na(tD)
        idD   := tD.id
        pxD   := tD.p
        hdD   := tD.hold
        pvD   := tD.prov
        gapD  := math.max(0.0, close - tD.p - tD.w)
        etaMD := f_etaAny(gapD)

    // ── every zone re-weighted by live probability ──
    if showNodes and nodes.size() > 0
        for i = 0 to nodes.size() - 1
            Node n = nodes.get(i)
            if not na(n.bx)
                bool isTop = n.id == idU or n.id == idD
                color sc = n.side == 1 ? colRes : colSup
                box.set_right(n.bx, xEdge)
                if isTop
                    box.set_bgcolor(n.bx, color.new(sc, 80))
                    box.set_border_color(n.bx, color.new(sc, 30))
                    box.set_border_width(n.bx, 1)
                else if n.prob >= pMin
                    int tr = int(math.round(93.0 - 11.0 * math.min(1.0, n.prob / 0.5)))
                    box.set_bgcolor(n.bx, color.new(sc, tr))
                    box.set_border_color(n.bx, color.new(sc, 84))
                    box.set_border_width(n.bx, 1)
                else
                    box.set_bgcolor(n.bx, color.new(colNeut, 95))
                    box.set_border_color(n.bx, color.new(colNeut, 100))
                    box.set_border_width(n.bx, 0)

    // ── tier 1: the two levels that actually matter ──
    // Projection length is the median time to reach, capped at the horizon
    if showProj and not na(pxU)
        int xU = bar_index + int(math.max(5.0, math.min(400.0, math.min(nz(etaMU, 1e9), minLeft) / tfMin)))
        pjU := line.new(bar_index, pxU, xU, pxU, color = color.new(colRes, 15), width = 2)
        lbU := label.new(xU, pxU, "▲ TERMINUS  " + f_px(pxU) + (pvU ? "  (dev)" : "") + "\n  reach·hold  " + f_pct(upP) + "\n  wall hold   " + f_pct(hdU) + "\n  eta " + f_fmtEta(etaMU) + "  ·  gap " + f_sig(gapU, sigRem), style = label.style_label_left, color = color.new(colPanel, 12), textcolor = colRes, size = size.small, textalign = text.align_left, text_font_family = MONO)
    if showProj and not na(pxD)
        int xD = bar_index + int(math.max(5.0, math.min(400.0, math.min(nz(etaMD, 1e9), minLeft) / tfMin)))
        pjD := line.new(bar_index, pxD, xD, pxD, color = color.new(colSup, 15), width = 2)
        lbD := label.new(xD, pxD, "▼ TERMINUS  " + f_px(pxD) + (pvD ? "  (dev)" : "") + "\n  reach·hold  " + f_pct(dnP) + "\n  wall hold   " + f_pct(hdD) + "\n  eta " + f_fmtEta(etaMD) + "  ·  gap " + f_sig(gapD, sigRem), style = label.style_label_left, color = color.new(colPanel, 12), textcolor = colSup, size = size.small, textalign = text.align_left, text_font_family = MONO)

    // ── probability-weighted expectation: a hairline, numbers live in the panel ──
    if showExp and not na(upE)
        exU := line.new(bar_index, upE, xEdge + 2, upE, color = color.new(colRes, 55), style = line.style_dotted, width = 1)
    if showExp and not na(dnE)
        exD := line.new(bar_index, dnE, xEdge + 2, dnE, color = color.new(colSup, 55), style = line.style_dotted, width = 1)

    // ── tier 2: the walls queued behind the terminus ──
    if showLadder and nodes.size() > 0
        array<float> lpr = array.new<float>()
        array<int>   lix = array.new<int>()
        for i = 0 to nodes.size() - 1
            Node n = nodes.get(i)
            bool drawn = showProj and (n.id == idU or n.id == idD)
            if n.prob >= pMin and not drawn
                lpr.push(n.prob)
                lix.push(i)
        if lpr.size() > 0
            array<int> ord = lpr.sort_indices(order.descending)
            int shownU = 0
            int shownD = 0
            for j = 0 to ord.size() - 1
                Node n = nodes.get(lix.get(ord.get(j)))
                bool room = n.side == 1 ? shownU < ladderMax : shownD < ladderMax
                if room
                    if n.side == 1
                        shownU += 1
                    else
                        shownD += 1
                    bool isTop = n.id == idU or n.id == idD
                    color sc = n.side == 1 ? colRes : colSup
                    ladLn.push(line.new(bar_index, n.p, xEdge + 3, n.p, color = color.new(sc, isTop ? 30 : 74), width = 1, style = isTop ? line.style_solid : line.style_dotted))
                    ladder.push(label.new(xEdge + 4, n.p, (n.side == 1 ? "▲ " : "▼ ") + f_px(n.p) + "  " + f_gauge(n.prob) + " " + f_pct(n.prob) + "   hold " + f_pct(n.hold) + "   mass " + str.tostring(f_mass(n), "#.#") + (n.prov ? "   dev" : ""), style = label.style_label_left, color = color.new(colPanel, 100), textcolor = color.new(sc, isTop ? 0 : 25), size = size.tiny, text_font_family = MONO))

    // ── dashboard ──
    if showTable
        table.clear(dash, 0, 0, 2, 41)
        int cntU = 0
        int cntD = 0
        int cntP = 0
        if nodes.size() > 0
            for i = 0 to nodes.size() - 1
                Node n = nodes.get(i)
                if n.prov
                    cntP += 1
                else if n.side == 1
                    cntU += 1
                else
                    cntD += 1

        table.cell(dash, 0, 0, "TERMINUS", text_color = colTxt, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
        table.cell(dash, 1, 0, "", text_size = tblSize)
        table.cell(dash, 2, 0, "survival field", text_color = colDim, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)

        int r = 1
        f_sec(dash, r, "REGIME")
        r += 1
        f_rowG(dash, r, "state", (isVolatile ? "volatile " : "calm ") + f_pct(isVolatile ? pV : 1.0 - pV), isVolatile ? colWarn : colTxt, isVolatile ? pV : 1.0 - pV)
        r += 1
        f_rowG(dash, r, "var left", f_pct(tauRem) + (inSess ? " → close" : " → next close"), colTxt, tauRem)
        r += 1
        f_row(dash, r, "σ left", f_px(sigRem), colTxt)
        r += 1
        string clkTxt = not useClock ? "linear (off)" : clkReady ? "learned · " + str.tostring(nCycle) + "d" : "linear · warm " + str.tostring(nCycle) + "/" + str.tostring(clkWarm)
        f_row(dash, r, "clock", clkTxt, clkReady ? colDim : colWarn)
        r += 1

        f_sec(dash, r, "UPSIDE")
        r += 1
        f_row(dash, r, "terminus", f_px(pxU) + (pvU ? " dev" : ""), colRes)
        r += 1
        f_rowG(dash, r, "probability", f_pct(upP), colRes, upP)
        r += 1
        if tblFull
            f_rowG(dash, r, "wall hold", f_pct(hdU), colRes, hdU)
            r += 1
            f_row(dash, r, "distance", na(gapU) ? "-" : f_px(gapU) + "  " + f_sig(gapU, sigRem), colRes)
            r += 1
            f_row(dash, r, "E[top]", f_px(upE), colRes)
            r += 1
            f_rowG(dash, r, "never reaches", f_pct(upNever), colRes, upNever)
            r += 1
            f_rowG(dash, r, "breaks all", f_pct(upThru), colRes, upThru)
            r += 1
        f_row(dash, r, "eta", f_fmtEta(etaMU), colRes)
        r += 1

        f_sec(dash, r, "DOWNSIDE")
        r += 1
        f_row(dash, r, "terminus", f_px(pxD) + (pvD ? " dev" : ""), colSup)
        r += 1
        f_rowG(dash, r, "probability", f_pct(dnP), colSup, dnP)
        r += 1
        if tblFull
            f_rowG(dash, r, "wall hold", f_pct(hdD), colSup, hdD)
            r += 1
            f_row(dash, r, "distance", na(gapD) ? "-" : f_px(gapD) + "  " + f_sig(gapD, sigRem), colSup)
            r += 1
            f_row(dash, r, "E[bot]", f_px(dnE), colSup)
            r += 1
            f_rowG(dash, r, "never reaches", f_pct(dnNever), colSup, dnNever)
            r += 1
            f_rowG(dash, r, "breaks all", f_pct(dnThru), colSup, dnThru)
            r += 1
        f_row(dash, r, "eta", f_fmtEta(etaMD), colSup)
        r += 1

        f_sec(dash, r, "EXHAUSTION")
        r += 1
        f_rowG(dash, r, "upside", f_pct(eUp), colRes, eUp)
        r += 1
        f_rowG(dash, r, "downside", f_pct(eDn), colSup, eDn)
        r += 1

        if tblFull and useLedger
            float rR  = lgR.n > 0 ? float(lgR.held) / lgR.n : na
            float rG  = lgG.n > 0 ? float(lgG.held) / lgG.n : na
            float pAv = lgR.n > 0 ? lgR.pSum / lgR.n : na
            float bri = lgR.n > 0 ? lgR.bSum / lgR.n : na
            float rHi = lgR.hiN > 0 ? float(lgR.hiHeld) / lgR.hiN : na
            string liftTxt = "-"
            if lgR.n > 0 and lgG.n > 0
                float pp = float(lgR.held + lgG.held) / (lgR.n + lgG.n)
                float se = math.sqrt(pp * (1.0 - pp) * (1.0 / lgR.n + 1.0 / lgG.n))
                liftTxt := (rR >= rG ? "+" : "") + str.tostring((rR - rG) * 100.0, "0.0") + " pts" + (se > 0 ? "  z " + str.tostring((rR - rG) / se, "0.0") : "")
            string briTxt = na(bri) ? "-" : str.tostring(bri, "0.000") + " vs " + str.tostring(rR * (1.0 - rR), "0.000") + " flat"
            f_sec(dash, r, "HOLD LEDGER")
            r += 1
            f_row(dash, r, "touches", str.tostring(lgR.n) + " real · " + str.tostring(lgG.n) + " placebo", colDim)
            r += 1
            f_rowG(dash, r, "real held", f_pct(rR), colTxt, rR)
            r += 1
            f_rowG(dash, r, "placebo held", f_pct(rG), colDim, rG)
            r += 1
            f_row(dash, r, "lift", liftTxt, colTxt)
            r += 1
            f_rowG(dash, r, "model said", f_pct(pAv), colTxt, pAv)
            r += 1
            f_row(dash, r, "brier", briTxt, colDim)
            r += 1
            f_row(dash, r, "said ≥ " + f_pct(alertThr), na(rHi) ? "-" : f_pct(rHi) + " of " + str.tostring(lgR.hiN), colTxt)
            r += 1

        if tblFull
            f_sec(dash, r, "FIELD")
            r += 1
            f_row(dash, r, "live nodes", str.tostring(cntU) + " up  " + str.tostring(cntD) + " dn" + (cntP > 0 ? "  " + str.tostring(cntP) + " dev" : ""), colDim)
            r += 1
            f_row(dash, r, "stop pools", str.tostring(resH.size()) + " up  " + str.tostring(resL.size()) + " dn", colDim)
            r += 1
            if not na(lastRollT)
                f_row(dash, r, "last roll", "shift " + f_px(lastRollShift) + " · " + str.tostring((time - lastRollT) / 86400000.0, "#.#") + "d ago", colDim)
                r += 1
            if tfBad
                f_row(dash, r, "⚠ chart TF", "≥ epoch: no nodes", colWarn)
                r += 1
