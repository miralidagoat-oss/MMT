//@version=6
strategy("MMT Session Sweep Strategy [MNQ/NQ 1H]", "MMT Sweep 1H",
     overlay = true, pyramiding = 0, initial_capital = 25000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.80, slippage = 1, max_labels_count = 500)

// ============================================================================
// Strategy port of the walk-forward-validated MNQ/NQ 1H configuration of the
// Alpha Predictive Limit Matrix engine (see README.md for the full study).
//
//   Edge:    liquidity-sweep rejection, mean-reversion. RTH-gated signals
//            (09:30–16:00 ET), limit entry at the rejection-wick midpoint,
//            EWMA-σ stop beyond the wick, 1:4 target, breakeven at +1R.
//   Status:  MNQ 1h walk-forward — IS PF 1.64 / OOS PF 1.43; NQ cross-val
//            PF 1.26. Re-validated on data through Aug 2026.
//   Scope:   validated on 1H charts of MNQ/NQ ONLY. Every intraday
//            timeframe (1m/5m/15m/30m) and 4H tested flat-to-negative
//            across four strategy families — signals are disabled on
//            unvalidated timeframes by default (override in settings).
//
// Differences vs the self-auditing indicator (both are honest, different):
//   - this script takes ONE position at a time (a real 1-contract account);
//     the indicator grades every signal in parallel
//   - TradingView's broker emulator decides same-bar stop/target ambiguity
//     with its own OHLC-path heuristic, which is LESS pessimistic than the
//     study's "stop always wins" rule — expect the tester to flatter
//     results slightly. The study's numbers are the conservative reference.
//   - the target order is deliberately withheld on the fill bar (parity
//     with the study: TP is never credited on the bar the limit fills)
// ============================================================================

// ─────────────────────────────────────────────────────────────
// INPUTS — defaults are the validated MNQ/NQ 1H preset. Changing them
// exits the validated envelope; the dashboard will remind you.
// ─────────────────────────────────────────────────────────────
var string G_SIG   = "Signal Engine (validated MNQ/NQ 1H defaults)"
var string G_TRADE = "Trade Construction"
var string G_SESS  = "Session"
var string G_RISK  = "Risk Guard"
var string G_UI    = "Display"

rbLookback   = input.int(12,     "Sweep Lookback Window",                    minval = 2,                                group = G_SIG)
rbBodyThresh = input.float(0.33, "Max Body-to-Range Ratio",                  minval = 0.05, maxval = 0.95, step = 0.01, group = G_SIG)
minWickFrac  = input.float(0.35, "Min Rejection Wick (fraction of range)",   minval = 0.05, maxval = 0.9,  step = 0.05, group = G_SIG)
minClosePos  = input.float(0.7,  "Min Close Position (fraction of range)",   minval = 0.5,  maxval = 0.95, step = 0.05, group = G_SIG)
sweepSigma   = input.float(0.75, "Min Sweep Depth (σ beyond prior extreme)", minval = 0.0,  maxval = 2.0,  step = 0.25, group = G_SIG)
rangeExpMult = input.float(1.0,  "Min Range Expansion (× 20-bar avg range)", minval = 0.0,  maxval = 3.0,  step = 0.1,  group = G_SIG)
cooldownBars = input.int(10,     "Signal Cooldown (bars, per direction)",    minval = 0,                                group = G_SIG)
volMult      = input.float(0.8,  "Volume Imbalance Multiplier",              minval = 0.1,  step = 0.1,                 group = G_SIG)
volLen       = input.int(20,     "Volume Baseline Length",                   minval = 1,                                group = G_SIG)
lambda       = input.float(0.94, "EWMA Decay Factor (RiskMetrics λ)",        minval = 0.85, maxval = 0.99, step = 0.01, group = G_SIG)
seedLen      = input.int(20,     "Variance Seed Length",                     minval = 5,                                group = G_SIG)

stopSigma    = input.float(1.5,  "Stop Distance (σ past the wick)",          minval = 0.1,  step = 0.1,                 group = G_TRADE)
rrTarget     = input.float(4.0,  "Risk : Reward Target",                     minval = 0.5,  step = 0.5,                 group = G_TRADE)
beTrigger    = input.float(1.0,  "Breakeven Trigger (R, 0 = off)",           minval = 0.0,  step = 0.5,                 group = G_TRADE)
validityBars = input.int(24,     "Unfilled Setup Expiry (bars)",             minval = 1,                                group = G_TRADE)
contracts    = input.int(1,      "Contracts",                                minval = 1,                                group = G_TRADE)

useSession   = input.bool(true,  "Restrict Signals to Session",              group = G_SESS)
sessionStr   = input.session("0930-1600", "Signal Session",                  group = G_SESS)
sessionTz    = input.string("America/New_York", "Session Timezone",          group = G_SESS)

acctSize     = input.float(25000, "Account Size ($)",           minval = 1,  group = G_RISK)
maxRiskPct   = input.float(2.0,  "Max Risk per Trade (%)",      minval = 0.1, maxval = 100, step = 0.5, group = G_RISK,
     tooltip = "The validated config risks a MEDIAN of ~$221/contract on MNQ (mean ≈ $252, p90 ≈ $382, worst observed ≈ $1,040). On a $25,000 account at 1 contract that median is ~0.9% and the 2% budget below ($500) sits above p90 — so the guard only fires on the extreme tail, which is exactly what it is for. The dashboard turns red when a setup exceeds this budget; enable the hard block to skip those signals entirely.")
blockBigRisk = input.bool(false, "Hard-Block Oversized Signals", group = G_RISK)
enforceTf    = input.bool(true,  "Disable Signals on Unvalidated Timeframes", group = G_RISK,
     tooltip = "The edge was validated on 1H only (45m–2h accepted). 1m, 5m, 15m, 30m and 4H all tested flat-to-negative across four strategy families. Untick only if you know exactly what you are doing.")

showLabels   = input.bool(true,  "Show Signal Labels",          group = G_UI)
showStats    = input.bool(true,  "Show Dashboard",              group = G_UI)
bullBase     = input.color(#00E676, "Bull Color",               group = G_UI)
bearBase     = input.color(#FF5252, "Bear Color",               group = G_UI)

// ─────────────────────────────────────────────────────────────
// EWMA VOLATILITY ENGINE (identical to the indicator)
// ─────────────────────────────────────────────────────────────
float logReturn    = na(close[1]) ? 0.0 : math.log(close / close[1])
float seedVariance = ta.variance(logReturn, seedLen)

var float ewmaVariance = na
ewmaVariance := na(ewmaVariance) ? seedVariance : lambda * ewmaVariance + (1.0 - lambda) * logReturn * logReturn

float ewmaVolPrice = math.sqrt(math.max(nz(ewmaVariance), 0.0)) * close
bool  engineReady  = not na(ewmaVariance)

// ─────────────────────────────────────────────────────────────
// SIGNAL DETECTION (identical gates to the indicator's MNQ preset)
// ─────────────────────────────────────────────────────────────
float candleRange   = high - low
float candleBody    = math.abs(close - open)
float topWick       = high - math.max(close, open)
float botWick       = math.min(close, open) - low
float candleMaxBody = math.max(open, close)
float candleMinBody = math.min(open, close)

float safeRange   = math.max(candleRange, syminfo.mintick)
float bullWickDom = botWick / safeRange
float bearWickDom = topWick / safeRange
float volSMA      = ta.sma(nz(volume), volLen)
float rangeSMA    = ta.sma(candleRange, 20)
float bullClosePos = (close - low) / safeRange
float bearClosePos = (high - close) / safeRange

bool bullFlowOk = na(volume) ? bullWickDom >= 0.5 : volSMA > 0 and nz(volume) * bullWickDom >= volSMA * volMult
bool bearFlowOk = na(volume) ? bearWickDom >= 0.5 : volSMA > 0 and nz(volume) * bearWickDom >= volSMA * volMult

var int lastBullSignalBar = na
var int lastBearSignalBar = na
bool bullCooldownOk = cooldownBars == 0 or na(lastBullSignalBar) or bar_index - lastBullSignalBar >= cooldownBars
bool bearCooldownOk = cooldownBars == 0 or na(lastBearSignalBar) or bar_index - lastBearSignalBar >= cooldownBars

float prevHH = ta.highest(high, rbLookback)[1]
float prevLL = ta.lowest(low, rbLookback)[1]

bool smallBody = candleBody <= candleRange * rbBodyThresh
bool rangeOk   = candleRange >= rangeSMA * rangeExpMult
bool inSession = not useSession or not na(time(timeframe.period, sessionStr, sessionTz))

// timeframe guard: the validated envelope is 45m–2h
int  tfSec = timeframe.in_seconds()
bool tfOk  = tfSec >= 2700 and tfSec <= 7200
bool tfGateOk = tfOk or not enforceTf

bool isBullishRB = barstate.isconfirmed and engineReady and inSession and tfGateOk and
     low < prevLL and close > prevLL and
     smallBody and rangeOk and
     bullWickDom >= minWickFrac and
     bullClosePos >= minClosePos and
     prevLL - low >= sweepSigma * ewmaVolPrice and
     bullFlowOk and bullCooldownOk
bool isBearishRB = barstate.isconfirmed and engineReady and inSession and tfGateOk and
     high > prevHH and close < prevHH and
     smallBody and rangeOk and
     bearWickDom >= minWickFrac and
     bearClosePos >= minClosePos and
     high - prevHH >= sweepSigma * ewmaVolPrice and
     bearFlowOk and bearCooldownOk

// a giant outside bar can satisfy both directions at once — conflicting
// information, stand aside (the indicator spawns both; a 1-lot account can't)
bool conflict = isBullishRB and isBearishRB
isBullishRB := isBullishRB and not conflict
isBearishRB := isBearishRB and not conflict

// ─────────────────────────────────────────────────────────────
// ORDER / POSITION STATE
// ─────────────────────────────────────────────────────────────
var int   pendingDir = 0          // 1 long limit working, -1 short, 0 none
var int   pendingBar = na
var float entryLv    = na
var float stopLv     = na
var float tpLv       = na
var float riskAmt    = na
var bool  beArmed    = false

bool inPos      = strategy.position_size != 0
bool justFilled = inPos and strategy.position_size[1] == 0
bool tradeClosedThisBar = strategy.closedtrades > nz(strategy.closedtrades[1])

// order consumed (filled, or filled-and-stopped inside one bar)
if justFilled or (tradeClosedThisBar and not inPos)
    pendingDir := 0
if tradeClosedThisBar and not inPos
    // flat again — clear the trade state so plots stop drawing
    beArmed := false
    entryLv := na
    stopLv  := na
    tpLv    := na
    riskAmt := na

// breakeven management — never arms on the fill bar (parity with the study);
// the moved stop is sent at this bar's close, so it takes effect next bar
if inPos and not justFilled and beTrigger > 0 and not beArmed
    bool  isLong  = strategy.position_size > 0
    float beLevel = isLong ? entryLv + beTrigger * riskAmt : entryLv - beTrigger * riskAmt
    if isLong ? high >= beLevel : low <= beLevel
        beArmed := true
        stopLv  := entryLv
        alert("MMT Sweep: +"+ str.tostring(beTrigger, "#.#") + "R reached — stop moved to breakeven " + str.tostring(entryLv, format.mintick), alert.freq_once_per_bar_close)

// unfilled-limit expiry
if not inPos and pendingDir != 0 and bar_index - pendingBar >= validityBars
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendingDir := 0
    entryLv := na
    stopLv  := na
    tpLv    := na
    riskAmt := na

// ─────────────────────────────────────────────────────────────
// SIGNAL → LIMIT ORDER (skipped while a position is open: one at a time)
// ─────────────────────────────────────────────────────────────
f_post(bool isBull) =>
    float e = isBull ? low + (candleMinBody - low) / 2.0 : high - (high - candleMaxBody) / 2.0
    float s = isBull ? low - ewmaVolPrice * stopSigma : high + ewmaVolPrice * stopSigma
    float r = math.abs(e - s)
    float t = isBull ? e + r * rrTarget : e - r * rrTarget
    [e, s, t, r]

if (isBullishRB or isBearishRB) and not inPos
    [e, s, t, r] = f_post(isBullishRB)
    float dollarRisk = r * syminfo.pointvalue * contracts
    bool oversized = dollarRisk > acctSize * maxRiskPct / 100.0
    if isBullishRB
        lastBullSignalBar := bar_index
    else
        lastBearSignalBar := bar_index
    if blockBigRisk and oversized
        if showLabels
            label.new(bar_index, isBullishRB ? low : high,
                 text = "⛔ signal skipped\n$" + str.tostring(dollarRisk, "#") + " > budget",
                 style = isBullishRB ? label.style_label_up : label.style_label_down,
                 color = color.new(color.gray, 40), textcolor = color.white, size = size.small)
        alert("MMT Sweep: signal skipped — $" + str.tostring(dollarRisk, "#") +
             " risk exceeds the " + str.tostring(maxRiskPct, "#.#") + "% budget", alert.freq_once_per_bar_close)
    else
        entryLv := e
        stopLv  := s
        tpLv    := t
        riskAmt := r
        beArmed := false
        pendingDir := isBullishRB ? 1 : -1
        pendingBar := bar_index
        strategy.cancel(isBullishRB ? "Short" : "Long")
        if isBullishRB
            strategy.entry("Long", strategy.long, qty = contracts, limit = e)
        else
            strategy.entry("Short", strategy.short, qty = contracts, limit = e)
        if showLabels
            label.new(bar_index, isBullishRB ? low : high,
                 text = (isBullishRB ? "🎯 LONG LIMIT" : "🎯 SHORT LIMIT") +
                      "\nE " + str.tostring(e, format.mintick) +
                      "\nS " + str.tostring(s, format.mintick) +
                      "\nT " + str.tostring(t, format.mintick) +
                      "\n≈$" + str.tostring(dollarRisk, "#") + " risk",
                 style = isBullishRB ? label.style_label_up : label.style_label_down,
                 color = color.new(isBullishRB ? bullBase : bearBase, 20),
                 textcolor = color.white, size = size.small)
        alert("MMT Sweep: " + (isBullishRB ? "LONG" : "SHORT") + " limit @ " + str.tostring(e, format.mintick) +
             " | stop " + str.tostring(s, format.mintick) + " | target " + str.tostring(t, format.mintick) +
             " | ~$" + str.tostring(dollarRisk, "#") + " risk/ct", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────
// BRACKET MAINTENANCE
//   while the limit is working: stop-loss only (a fill bar that trades
//   through the stop books the loss, but the target can NOT fill on the
//   entry bar — exact parity with the study's pessimistic accounting)
//   from the first bar close after the fill: stop + target
// ─────────────────────────────────────────────────────────────
if pendingDir != 0 and not inPos
    strategy.exit("Bracket", from_entry = pendingDir == 1 ? "Long" : "Short",
         stop = stopLv, comment_loss = "stopped (entry bar)")
if inPos
    strategy.exit("Bracket", from_entry = strategy.position_size > 0 ? "Long" : "Short",
         stop = stopLv, limit = tpLv,
         comment_profit = "target +" + str.tostring(rrTarget, "#.#") + "R",
         comment_loss = beArmed ? "breakeven scratch" : "stopped -1R")

// ─────────────────────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────────────────────
bool showLv = pendingDir != 0 or inPos
plot(showLv ? entryLv : na, "Entry",  color = color.new(color.yellow, 0), style = plot.style_linebr, linewidth = 2)
plot(showLv ? stopLv  : na, "Stop",   color = color.new(color.red, 0),    style = plot.style_linebr)
plot(showLv ? tpLv    : na, "Target", color = color.new(color.blue, 0),   style = plot.style_linebr, linewidth = 2)

// ─────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────
f_row(table tb, int rw, string k, string v, color vc) =>
    table.cell(tb, 0, rw, k, text_color = color.new(color.silver, 0), text_halign = text.align_left,  text_size = size.small)
    table.cell(tb, 1, rw, v, text_color = vc,                         text_halign = text.align_right, text_size = size.small)

if showStats and barstate.islast
    var table dash = table.new(position.top_right, 2, 12,
         bgcolor = color.new(#101418, 15), border_width = 1,
         border_color = color.new(color.gray, 70), frame_width = 1, frame_color = color.new(color.gray, 55))

    int   closedN  = strategy.closedtrades
    int   wins     = strategy.wintrades
    int   losses   = strategy.losstrades
    float wr       = wins + losses > 0 ? 100.0 * wins / (wins + losses) : na
    float pf       = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float netP     = strategy.netprofit
    float beWR     = 100.0 / (1.0 + rrTarget)
    float curRiskUsd = not na(riskAmt) ? riskAmt * syminfo.pointvalue * contracts : na
    float budgetUsd  = acctSize * maxRiskPct / 100.0

    string posTxt = inPos ? (strategy.position_size > 0 ? "LONG" : "SHORT") + (beArmed ? " (BE armed)" : "") :
         pendingDir != 0 ? (pendingDir == 1 ? "long" : "short") + " limit working" : "flat"

    bool symOk = syminfo.root == "MNQ" or syminfo.root == "NQ"

    table.cell(dash, 0, 0, "MMT SESSION SWEEP — 1H", text_color = color.white, text_size = size.small)
    table.merge_cells(dash, 0, 0, 1, 0)
    f_row(dash, 1, "Closed Trades",  str.tostring(closedN), color.white)
    f_row(dash, 2, "Win Rate (BE " + str.tostring(beWR, "#.#") + "%)", na(wr) ? "—" : str.tostring(wr, "#.#") + "%",
         na(wr) ? color.white : wr > beWR ? color.new(color.teal, 0) : color.new(color.red, 0))
    f_row(dash, 3, "Profit Factor", na(pf) ? "—" : str.tostring(pf, "#.##"),
         na(pf) ? color.white : pf >= 1 ? color.new(color.teal, 0) : color.new(color.red, 0))
    f_row(dash, 4, "Net Profit", (netP >= 0 ? "+$" : "-$") + str.tostring(math.abs(netP), "#,###"),
         netP >= 0 ? color.new(color.teal, 0) : color.new(color.red, 0))
    f_row(dash, 5, "Position", posTxt, color.aqua)
    f_row(dash, 6, "Setup Risk / Budget",
         (na(curRiskUsd) ? "—" : "$" + str.tostring(curRiskUsd, "#")) + " / $" + str.tostring(budgetUsd, "#"),
         na(curRiskUsd) ? color.white : curRiskUsd > budgetUsd ? color.new(color.red, 0) : color.new(color.teal, 0))
    f_row(dash, 7, "Chart TF", tfOk ? "✓ validated (1H)" : enforceTf ? "⛔ signals disabled — use 1H" : "⚠ UNVALIDATED — edge is 1H only",
         tfOk ? color.new(color.teal, 0) : color.new(color.red, 0))
    f_row(dash, 8, "Symbol", symOk ? "✓ " + syminfo.root : "⚠ validated on MNQ/NQ only",
         symOk ? color.new(color.teal, 0) : color.new(color.orange, 0))
    f_row(dash, 9, "Session Gate", useSession ? sessionStr + " " + sessionTz : "off (validated = ON)",
         useSession ? color.new(color.teal, 0) : color.new(color.orange, 0))
    f_row(dash, 10, "Study Reference", "OOS PF 1.43 · WR 26% · ~30 trades/yr", color.gray)
    f_row(dash, 11, "Median Risk (study)", "≈$221/ct · p90 $382 — size accordingly", color.orange)

// ─────────────────────────────────────────────────────────────
// ALERT CONDITIONS (static, for the Alerts dialog)
// ─────────────────────────────────────────────────────────────
alertcondition(isBullishRB, "Bullish Sweep Signal", "MMT Sweep: bullish rejection — long limit posted")
alertcondition(isBearishRB, "Bearish Sweep Signal", "MMT Sweep: bearish rejection — short limit posted")
