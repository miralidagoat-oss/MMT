//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  ICT — LIQUIDITY & MARKET STRUCTURE                  marker-only, no signals
// ═════════════════════════════════════════════════════════════════════════════
//  Zones carry their own label (FVG · +OB · Buyside liquidity), levels are thin
//  rays that end where price takes them, and structure is a hairline with small
//  grey text. Nothing shouts. The only coloured thing on the chart is a raid
//  grade, because that is the one thing worth looking at twice.
//
//  CONCEPTS MARKED
//    Liquidity (BSL/SSL, EQH/EQL) · graded liquidity sweeps · Inducement (IDM)
//    Turtle Soup · Judas Swing · SMT divergence · Displacement
//    BOS · CHoCH · MSS · CISD · FVG · IFVG · CE · Volume imbalance
//    Order blocks · Breaker blocks · Premium/Discount/Equilibrium · OTE
//    PDH/PDL · PWH/PWL · Midnight open · IRL / ERL draw · Daily bias
//    Power of 3 (AMD) · Killzones · Silver Bullet · ICT Macros
//
//  WHAT MAKES A SWEEP GOOD — the grade, in one paragraph
//    A raid is high quality when it takes liquidity that was worth taking and
//    then refuses to stay there: an old level with several equal touches, poked
//    deep enough to trip stops but not so deep it became an expansion, rejected
//    with a dominant wick, reclaimed fast and violently, on real volume, from
//    the right half of the dealing range, ideally while a correlated market
//    refuses to confirm. Each of those is measured, weighted and scored 0-100.
//    A raid that closes and STAYS beyond the level is not graded at all — that
//    is a break, and the level is retired unmarked.
//
//  NON-REPAINTING: events are evaluated on closed bars. A pivot is only known
//  `length` bars after it prints — inherent to what a swing is — and no level is
//  ever back-dated, so a pool cannot be swept before it exists.
// ═════════════════════════════════════════════════════════════════════════════
indicator("ICT — Liquidity & Market Structure", "ICT", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

G_C  = "Core"
G_LQ = "Liquidity"
G_SW = "Sweep grading"
G_WT = "Grade weights"
G_GR = "Grade cut-offs"
G_MS = "Structure — BOS · CHoCH · MSS · IDM"
G_CI = "CISD & displacement"
G_FV = "Fair value gaps"
G_OB = "Order blocks"
G_PD = "Premium / discount / OTE"
G_HT = "HTF liquidity & daily bias"
G_P3 = "Power of 3 (AMD)"
G_TW = "Killzones · Silver Bullet · Macros"
G_SM = "SMT divergence"
G_DB = "Dashboard"
G_ST = "Style"

// ── core ─────────────────────────────────────────────────────────────────────
confirmOnly = input.bool(true,  "Evaluate on closed bars only", group = G_C, tooltip = "Leave this on. Off, events are evaluated intrabar and can appear and disappear until the bar closes.")
atrLen      = input.int(14,     "ATR length", minval = 2, maxval = 200, group = G_C)
liqLen      = input.int(5,      "Liquidity pivot length", minval = 1, maxval = 40, group = G_C, tooltip = "Pivot lookback/forward that defines a liquidity pool. Smaller = more pools.")
swingLen    = input.int(10,     "Structure swing length", minval = 2, maxval = 50, group = G_C, tooltip = "Pivot lookback/forward for the swings BOS / CHoCH / MSS are measured against.")
eqTolAtr    = input.float(0.20, "Equal-level tolerance (× ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G_C, tooltip = "Two pivots inside this distance are one pool and the touch count goes up. This is the EQH / EQL detector. Tighten it toward 0.05 for literally equal highs; widen it toward 0.4 to cluster a rounded top into one pool.")
minTouches  = input.int(2,      "Touches that make it a liquidity band", minval = 2, maxval = 6, group = G_C, tooltip = "Below this a pool stays an unlabelled hairline. 2 = any double-tap is EQH/EQL; 3 is the stricter, more selective read.")

dispLen     = input.int(5,      "Displacement body baseline (bars)", minval = 2, maxval = 100, group = G_C, tooltip = "A displacement candle has a body larger than the average of this many, wicks smaller than the fraction below, and a body of at least the ATR floor. Body size alone is not displacement — a big candle with big wicks is a fight, not a delivery.")
dispWickMax = input.float(0.36, "…max wick as a fraction of the body", minval = 0.05, maxval = 2.0, step = 0.01, group = G_C)
dispBodyAtr = input.float(0.25, "…minimum body (× ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_C)

// ── liquidity ────────────────────────────────────────────────────────────────
showPools    = input.bool(true, "Draw pools until they are taken", group = G_LQ)
poolFilter   = input.string("All", "Draw which pools", options = ["All", "Equal + named only", "Major + named only"], group = G_LQ)
maxPools     = input.int(8,     "Pools tracked per side", minval = 2, maxval = 25, group = G_LQ)
poolAgeRef   = input.int(100,   "Age that counts as fully mature (bars)", minval = 5, maxval = 1000, group = G_LQ)
showPoolTags = input.bool(true, "Label equal and named pools", group = G_LQ, tooltip = "Equal highs/lows are drawn as a band labelled Buyside / Sellside liquidity; named levels (PDH, IDM …) get their name. Single-taps stay unlabelled hairlines.")

// ── sweeps ───────────────────────────────────────────────────────────────────
showSweeps  = input.bool(true,  "Mark graded sweeps", group = G_SW)
minGradeIn  = input.string("D", "Minimum grade drawn", options = ["A+", "A", "B", "C", "D", "F"], group = G_SW)
sweepDetail = input.string("Grade + score", "Label detail", options = ["Grade only", "Grade + score", "Side + grade + score"], group = G_SW)
maxConfirm  = input.int(6,      "Bars allowed to reclaim the level", minval = 0, maxval = 50, group = G_SW, tooltip = "0 = only same-bar raids count. Beyond this the level is treated as broken, not swept.")
maxRunAtr   = input.float(1.20, "Max excursion before it is a break (× ATR)", minval = 0.1, maxval = 10.0, step = 0.1, group = G_SW)
idealLoAtr  = input.float(0.05, "Ideal penetration — floor (× ATR)", minval = 0.0, maxval = 2.0, step = 0.01, group = G_SW, tooltip = "Below this the poke may be too shallow to have tripped resting stops.")
idealHiAtr  = input.float(0.50, "Ideal penetration — ceiling (× ATR)", minval = 0.05, maxval = 5.0, step = 0.05, group = G_SW, tooltip = "Above this the raid starts looking like expansion and the score decays toward the break threshold.")
dispRefAtr  = input.float(1.00, "Displacement that scores full marks (× ATR)", minval = 0.1, maxval = 5.0, step = 0.1, group = G_SW)
volLen      = input.int(20,     "Relative-volume baseline", minval = 2, maxval = 200, group = G_SW)
tsLook      = input.int(20,     "Turtle Soup lookback (bars)", minval = 3, maxval = 200, group = G_SW, tooltip = "A raid on a level that was the extreme of this many bars is a Turtle Soup — a false break of the external range. Tagged TS.")
judasBars   = input.int(12,     "Judas window after a killzone opens (bars)", minval = 1, maxval = 100, group = G_SW, tooltip = "A raid this soon after the London or New York killzone opens is the session's Judas swing. Tagged JD.")
useFollow   = input.bool(true,  "Upgrade the grade on follow-through", group = G_SW, tooltip = "If a CISD or a structure break in the raid's direction lands inside the window, the sweep is re-graded upward and marked ▲. Strictly additive — nothing is downgraded or erased.")
followWin   = input.int(10,     "…window (bars)", minval = 1, maxval = 100, group = G_SW)
followBonus = input.float(8.0,  "…bonus points", minval = 0.0, maxval = 30.0, step = 1.0, group = G_SW)
showSwZone  = input.bool(true,  "Leave the taken liquidity shaded", group = G_SW, tooltip = "After a raid, the pool is replaced by a faded band spanning how long the liquidity stood and how far it was run. Off, the level simply disappears.")
maxSweeps   = input.int(30,     "Sweep marks kept", minval = 5, maxval = 200, group = G_SW)

wPool  = input.float(20, "Liquidity quality of the level", minval = 0, maxval = 100, step = 1, group = G_WT, tooltip = "Touches, age, swing degree, named-level status.")
wDepth = input.float(15, "Penetration depth",              minval = 0, maxval = 100, step = 1, group = G_WT)
wRej   = input.float(15, "Rejection wick",                 minval = 0, maxval = 100, step = 1, group = G_WT)
wSpeed = input.float(15, "Reclaim speed",                  minval = 0, maxval = 100, step = 1, group = G_WT)
wDisp  = input.float(15, "Displacement on the reclaim",    minval = 0, maxval = 100, step = 1, group = G_WT)
wVol   = input.float(10, "Relative volume",                minval = 0, maxval = 100, step = 1, group = G_WT)
wCtx   = input.float(10, "Premium / discount context",     minval = 0, maxval = 100, step = 1, group = G_WT)
wSmt   = input.float(10, "SMT divergence",                 minval = 0, maxval = 100, step = 1, group = G_WT, tooltip = "Only counted when SMT is switched on, so leaving SMT off does not dilute every other factor.")

cutAp = input.float(90, "A+ at or above", minval = 0, maxval = 100, step = 1, group = G_GR)
cutA  = input.float(80, "A  at or above", minval = 0, maxval = 100, step = 1, group = G_GR)
cutB  = input.float(70, "B  at or above", minval = 0, maxval = 100, step = 1, group = G_GR)
cutC  = input.float(58, "C  at or above", minval = 0, maxval = 100, step = 1, group = G_GR)
cutD  = input.float(45, "D  at or above", minval = 0, maxval = 100, step = 1, group = G_GR)

// ── structure ────────────────────────────────────────────────────────────────
showStruct = input.bool(true, "Mark BOS / CHoCH / MSS", group = G_MS)
mssWin     = input.int(15,    "MSS: raid must be within N bars", minval = 1, maxval = 100, group = G_MS, tooltip = "A CHoCH is promoted to MSS only when a graded sweep of the opposite side landed inside this window AND the break carries displacement. Everything else stays a CHoCH.")
maxStruct  = input.int(12,    "Structure marks kept", minval = 2, maxval = 60, group = G_MS)
showIdm    = input.bool(true, "Mark inducement (IDM)", group = G_MS, tooltip = "The last minor pullback inside the current leg — the bait that has to be taken before the real move. Registered as a named, gradeable pool.")

showCisd   = input.bool(true,   "Mark CISD", group = G_CI)
cisdMinRun = input.int(2,       "Minimum candles in the delivery leg", minval = 1, maxval = 10, group = G_CI)
cisdAnchor = input.string("Extreme open", "CISD level", options = ["Run-start open", "Extreme open"], group = G_CI, tooltip = "Run-start open: the open of the first candle of the delivery leg. Extreme open: the highest open of a down leg / lowest open of an up leg — stricter, and the default.")
cisdReqSw  = input.bool(false,  "Only after a graded sweep", group = G_CI)
cisdWin    = input.int(15,      "…sweep window (bars)", minval = 1, maxval = 100, group = G_CI)
maxCisd    = input.int(8,       "CISD marks kept", minval = 2, maxval = 40, group = G_CI)
showDisp   = input.bool(false,  "Mark displacement candles", group = G_CI, tooltip = "A body ≥ the displacement threshold that leaves an FVG behind it. Off by default — the FVG is already the visible signature.")

// ── fair value gaps ──────────────────────────────────────────────────────────
showFvg    = input.bool(true,   "Show fair value gaps", group = G_FV)
showBpr    = input.bool(false,  "Show balance price ranges (BPR)", group = G_FV, tooltip = "Where the newest bullish and bearish FVG overlap, that overlap is a BPR — a gap delivered in both directions, and a stronger reference than either gap alone.")
maxBpr     = input.int(4,       "…kept", minval = 1, maxval = 20, group = G_FV)
fvgMinAtr  = input.float(0.05,  "Minimum gap (× ATR)", minval = 0.0, maxval = 3.0, step = 0.01, group = G_FV)
fvgReqDisp = input.bool(true,   "Require a displacement candle", group = G_FV)
fvgMitig   = input.string("CE (50%)", "Mitigated when price reaches", options = ["Touch", "CE (50%)", "Full fill"], group = G_FV)
fvgOnMit   = input.string("Stop extending", "On mitigation", options = ["Stop extending", "Fade", "Delete"], group = G_FV)
showCe     = input.bool(false,  "Consequent-encroachment (50%) line", group = G_FV)
showIfvg   = input.bool(false,  "Invert into an IFVG when traded through", group = G_FV)
maxFvg     = input.int(12,      "FVGs kept per side", minval = 1, maxval = 40, group = G_FV)
showVi     = input.bool(false,  "Show volume imbalances", group = G_FV, tooltip = "A body-to-body gap where the wicks still overlap — smaller than an FVG and often what price returns for first.")
viMinAtr   = input.float(0.05,  "…minimum gap (× ATR)", minval = 0.0, maxval = 2.0, step = 0.01, group = G_FV)
maxVi      = input.int(10,      "…kept", minval = 1, maxval = 40, group = G_FV)

// ── order blocks ─────────────────────────────────────────────────────────────
showOb    = input.bool(true,  "Show order blocks at structure breaks", group = G_OB)
obMethod  = input.string("Last opposing candle", "Which candle is the block", options = ["Last opposing candle", "Extreme of the leg"], group = G_OB, tooltip = "Last opposing candle: the final down-close before an up-break. Extreme of the leg: the candle that made the low the break rallied from. Both are in common use; the second is the more classical ICT origin.")
obUseBody = input.bool(false, "Use the candle body instead of its full range", group = G_OB)
obLook    = input.int(20,     "Search window (bars)", minval = 3, maxval = 60, group = G_OB)
maxOb     = input.int(5,      "Order blocks kept per side", minval = 1, maxval = 20, group = G_OB)
showBrk   = input.bool(true,  "Flip violated blocks into breakers", group = G_OB)

// ── premium / discount ───────────────────────────────────────────────────────
showPd  = input.bool(false, "Show premium / discount of the dealing range", group = G_PD)
showOte = input.bool(false, "Show the OTE band", group = G_PD)
oteLo   = input.float(0.62, "OTE from", minval = 0.5, maxval = 0.95, step = 0.01, group = G_PD)
oteHi   = input.float(0.79, "OTE to",   minval = 0.5, maxval = 0.99, step = 0.01, group = G_PD)

// ── HTF ──────────────────────────────────────────────────────────────────────
showPdhl = input.bool(true,  "Previous day high / low", group = G_HT)
showPwhl = input.bool(false, "Previous week high / low", group = G_HT)
showMno  = input.bool(true,  "Midnight open (00:00 New York)", group = G_HT)
showNwog = input.bool(true,  "New week opening gap (NWOG)", group = G_HT, tooltip = "Friday's last close to the new week's first open. ICT treats the untraded delivery between them as a standing reference; the dotted line is its consequent encroachment.")
maxNwog  = input.int(3,      "…kept", minval = 1, maxval = 20, group = G_HT)
showNdog = input.bool(false, "New day opening gap (NDOG)", group = G_HT, tooltip = "The same idea between yesterday's close and today's open.")
maxNdog  = input.int(2,      "…kept", minval = 1, maxval = 20, group = G_HT)

// ── power of 3 ───────────────────────────────────────────────────────────────
showPo3  = input.bool(false, "Show the accumulation range", group = G_P3, tooltip = "The Power of 3 read for the current New York day: the opening range is accumulation, the first excursion out of it is manipulation, what follows is distribution. The phase is always reported on the dashboard; this switch only draws the box.")
po3Min   = input.int(120,    "Accumulation window after midnight NY (minutes)", minval = 15, maxval = 600, step = 15, group = G_P3)

// ── time windows ─────────────────────────────────────────────────────────────
showKz  = input.bool(false, "Killzones", group = G_TW, tooltip = "Asia 20:00-00:00 · London 02:00-05:00 · New York AM 07:00-10:00 · London close 10:00-12:00, New York time. Off by default: the AMD sessions indicator already carries session context, and stacking both is noise.")
showSb  = input.bool(false, "Silver Bullet windows", group = G_TW, tooltip = "03:00-04:00, 10:00-11:00 and 14:00-15:00 New York time.")
showMac = input.bool(false, "ICT Macros", group = G_TW, tooltip = "The twenty-minute windows: 02:33-03:00, 04:03-04:30, 08:50-09:10, 09:50-10:10, 10:50-11:10, 11:50-12:10, 13:10-13:40, 15:15-15:45 New York time.")

// ── SMT ──────────────────────────────────────────────────────────────────────
useSmt  = input.bool(false, "Grade with SMT divergence", group = G_SM, tooltip = "At the moment of a raid, a correlated instrument fails to make the matching new extreme. One market takes the liquidity, its partner refuses to follow. Pick a genuinely correlated symbol (ES vs NQ, GC vs SI).")
smtSym  = input.symbol("CME_MINI:ES1!", "Comparison symbol", group = G_SM)
smtLook = input.int(20, "Divergence lookback (bars)", minval = 3, maxval = 200, group = G_SM)

// ── dashboard & style ────────────────────────────────────────────────────────
showDash = input.bool(true, "Show dashboard", group = G_DB)
dashPosIn= input.string("Top right", "Position", options = ["Top left", "Top right", "Bottom left", "Bottom right", "Middle right"], group = G_DB)
dashSzIn = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_DB)

bullCol  = input.color(#1e7a6f, "Bullish", group = G_ST, inline = "c1")
bearCol  = input.color(#a33a30, "Bearish", group = G_ST, inline = "c1")
inkCol   = input.color(#8b909a, "Ink (labels, hairlines)", group = G_ST, inline = "c2")
zoneTr   = input.int(86, "Zone fill transparency",   minval = 50, maxval = 100, group = G_ST)
borderTr = input.int(62, "Zone border transparency", minval = 0,  maxval = 100, group = G_ST)
textTr   = input.int(25, "Zone label transparency",  minval = 0,  maxval = 100, group = G_ST)
kzCol    = input.color(#5c6bc0, "Killzone tint", group = G_ST, inline = "c3")
gapCol   = input.color(#b0863c, "Opening-gap tint", group = G_ST, inline = "c3")
sbCol    = input.color(#c9a227, "Silver Bullet tint", group = G_ST, inline = "c3")
macCol   = input.color(#7e57c2, "Macro tint", group = G_ST, inline = "c4")
winTr    = input.int(92, "Time-window transparency", minval = 60, maxval = 100, group = G_ST)

// ═════════════════════════════════════════════════════════════════════════════
// SERIES   (every ta.* / request.* call is unconditional — required for history)
// ═════════════════════════════════════════════════════════════════════════════
TZ_NY = "America/New_York"

atr     = ta.atr(atrLen)
atrSafe = math.max(nz(atr), syminfo.mintick)
eqTol   = eqTolAtr * atrSafe
volSma  = ta.sma(nz(volume), volLen)
useVol  = not na(volSma) and volSma > 0
relVol  = useVol ? nz(volume) / volSma : (high - low) / atrSafe

barRng = math.max(high - low, syminfo.mintick)
wickUp = (high - math.max(open, close)) / barRng
wickDn = (math.min(open, close) - low) / barRng

lph = ta.pivothigh(high, liqLen, liqLen)
lpl = ta.pivotlow(low,  liqLen, liqLen)
sph = ta.pivothigh(high, swingLen, swingLen)
spl = ta.pivotlow(low,  swingLen, swingLen)

gapUp   = low - high[2]                                            // bullish imbalance
gapDn   = low[2] - high                                            // bearish imbalance

bodyLen  = math.abs(close - open)
meanBody = ta.sma(bodyLen, dispLen)
upWickAbs = high - math.max(close, open)
dnWickAbs = math.min(close, open) - low
tightWick = upWickAbs < bodyLen * dispWickMax and dnWickAbs < bodyLen * dispWickMax
bigBody   = bodyLen > nz(meanBody) and bodyLen >= dispBodyAtr * atrSafe
isDispUp  = close > open and bigBody and tightWick
isDispDn  = close < open and bigBody and tightWick

tsHi = ta.highest(high, tsLook)[1]                                 // external range extremes
tsLo = ta.lowest(low, tsLook)[1]

conf = confirmOnly ? barstate.isconfirmed : true

// completed HTF periods only — lookahead is safe on a bar that has already closed
[pdhV, pdlV, pdcV, pdh2V, pdl2V] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], high[2], low[2]], lookahead = barmerge.lookahead_on)
[pwhV, pwlV] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// SMT — did WE make a new extreme that our correlated partner refused to make?
[smtHigh, smtLow] = request.security(smtSym, timeframe.period, [high, low], ignore_invalid_symbol = true)
smtOk   = not na(smtHigh) and not na(smtLow)
ourHH   = high    > ta.highest(high, smtLook)[1]
ourLL   = low     < ta.lowest(low, smtLook)[1]
cmpHH   = smtHigh > ta.highest(smtHigh, smtLook)[1]
cmpLL   = smtLow  < ta.lowest(smtLow, smtLook)[1]
smtBear = useSmt and smtOk and ourHH and not cmpHH
smtBull = useSmt and smtOk and ourLL and not cmpLL

// ── New York clock: minutes since NY midnight, so every ICT window is one test
intraday = not timeframe.isdwm
nyMin    = intraday ? hour(time, TZ_NY) * 60 + minute(time, TZ_NY) : na
newNyDay = intraday and dayofmonth(time, TZ_NY) != dayofmonth(time[1], TZ_NY)
nyDow     = intraday ? dayofweek(time, TZ_NY) : na
newWeekBar = intraday and nyDow < nyDow[1]         // Friday → Sunday (or Monday)

inKzLon = intraday and nyMin >= 120 and nyMin < 300                //  02:00-05:00
inKzAm  = intraday and nyMin >= 420 and nyMin < 600                //  07:00-10:00
inKzLc  = intraday and nyMin >= 600 and nyMin < 720                //  10:00-12:00 London close
inKzAs  = intraday and nyMin >= 1200                               //  20:00-00:00
inKz    = inKzLon or inKzAm or inKzLc or inKzAs

inSb  = intraday and ((nyMin >= 180 and nyMin < 240) or (nyMin >= 600 and nyMin < 660) or (nyMin >= 840 and nyMin < 900))
inMac = intraday and ((nyMin >= 153 and nyMin < 180) or (nyMin >= 243 and nyMin < 270) or (nyMin >= 530 and nyMin < 550) or (nyMin >= 590 and nyMin < 610) or (nyMin >= 650 and nyMin < 670) or (nyMin >= 710 and nyMin < 730) or (nyMin >= 790 and nyMin < 820) or (nyMin >= 915 and nyMin < 945))

var int kzOpenBar = na
if (inKzLon and not inKzLon[1]) or (inKzAm and not inKzAm[1])
    kzOpenBar := bar_index
inJudas = not na(kzOpenBar) and bar_index - kzOpenBar < judasBars

// ═════════════════════════════════════════════════════════════════════════════
// TYPES
// ═════════════════════════════════════════════════════════════════════════════
type Pool
    float  px
    float  pxAlt
    int    bar
    int    touches
    bool   up
    bool   major
    bool   named
    string tag
    line   ln
    box    bx
    label  lb
    bool   pierced
    int    pBar
    float  ext
    float  wick
    float  volR
    bool   smt
    bool   turtle
    bool   judas

type Sweep
    label  lb
    box    bx
    bool   up
    int    bar
    float  score
    string side
    string tip
    string mark
    bool   done

type Zone
    box    bx
    line   ce
    float  top
    float  btm
    bool   bull
    bool   mitigated
    bool   inverted
    bool   frozen
    bool   spent

type Vi
    box    bx
    float  top
    float  btm
    bool   bull

type Gap
    box    bx
    line   ce

type Ob
    box    bx
    float  top
    float  btm
    bool   bull
    bool   breaker

// ═════════════════════════════════════════════════════════════════════════════
// STATE
// ═════════════════════════════════════════════════════════════════════════════
var array<Pool>  pools   = array.new<Pool>()
var array<Sweep> sweeps  = array.new<Sweep>()
var array<Zone>  fvgs    = array.new<Zone>()
var array<Vi>    vis     = array.new<Vi>()
var array<Zone>  bprs    = array.new<Zone>()
var array<Gap>   nwogs   = array.new<Gap>()
var array<Gap>   ndogs   = array.new<Gap>()
var float        friClose = na
var array<Ob>    obs     = array.new<Ob>()
var array<line>  stLines = array.new<line>()
var array<label> stLabs  = array.new<label>()
var array<line>  ciLines = array.new<line>()
var array<label> ciLabs  = array.new<label>()

// recent minor pivots, kept only so the inducement can be located inside a leg
var array<int>   mlBar = array.new<int>()
var array<float> mlPx  = array.new<float>()
var array<int>   mhBar = array.new<int>()
var array<float> mhPx  = array.new<float>()

var float topPx = na
var int   topBar = na
var bool  topBroken = true
var float btmPx = na
var int   btmBar = na
var bool  btmBroken = true
var int   bias = 0
var float drHi = na
var float drLo = na

var int   lastRaidUpBar = na
var int   lastRaidDnBar = na
var int   lastBullFvgBar = na
var int   lastBearFvgBar = na

var int   runDir = 0
var float runOpenFirst = na
var float runOpenExt = na
var int   runStart = na
var int   runLen = 0
var float bearLegPx = na
var int   bearLegBar = na
var bool  bullCisdArmed = false
var float bullLegPx = na
var int   bullLegBar = na
var bool  bearCisdArmed = false

var int    nGraded = 0
var float  sumScore = 0.0
var int    nHighGrade = 0
var string lastSweepTxt = "—"
var color  lastSweepCol = color.gray

var line  mnoLine = na
var label mnoLab = na
var float mnoPx = na

// Power of 3, per New York day
var float orHi = na
var float orLo = na
var int   po3Stage = 0                 // 0 accumulation · 1 manipulation · 2 distribution
var int   po3Dir = 0                   // which side the manipulation raided
var box   orBox = na

// per-bar event flags (re-initialised every bar — never `var`)
bool bullStructNow = false
bool bearStructNow = false
bool bullCisdNow = false
bool bearCisdNow = false
bool raidUpNow = false
bool raidDnNow = false
int  raidUpRank = -1
int  raidDnRank = -1

// ═════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═════════════════════════════════════════════════════════════════════════════
clamp01(float x) => math.max(0.0, math.min(1.0, nz(x)))

pct(float x) => str.tostring(math.round(clamp01(x) * 100), "#") + "%"

gradeOf(float sc) => sc >= cutAp ? "A+" : sc >= cutA ? "A" : sc >= cutB ? "B" : sc >= cutC ? "C" : sc >= cutD ? "D" : "F"

rankOf(string g) => g == "A+" ? 5 : g == "A" ? 4 : g == "B" ? 3 : g == "C" ? 2 : g == "D" ? 1 : 0

trOf(string g) => g == "A+" ? 0 : g == "A" ? 10 : g == "B" ? 25 : g == "C" ? 42 : g == "D" ? 58 : 70

ink(int tr) => color.new(inkCol, tr)

sideCol(bool bull) => bull ? bullCol : bearCol

// A pool is a hairline until it earns a name: equal touches make it a labelled
// liquidity band, a named level (PDH, IDM …) gets its name at the right edge.
poolText(Pool p) =>
    p.named ? p.tag : p.touches >= minTouches ? (p.up ? "Buyside liquidity" : "Sellside liquidity") : ""

poolDrawable(Pool p) =>
    switch poolFilter
        "Equal + named only" => p.touches >= minTouches or p.named
        "Major + named only" => p.major or p.named
        => true

pushPivot(bars, pxs, b, px) =>
    bars.push(b)
    pxs.push(px)
    while bars.size() > 30
        int   _b = bars.shift()
        float _p = pxs.shift()
    bars.size()

// ═════════════════════════════════════════════════════════════════════════════
// 1 · LIQUIDITY POOLS
// ═════════════════════════════════════════════════════════════════════════════
killPoolArt(Pool p) =>
    line.delete(p.ln)
    box.delete(p.bx)
    label.delete(p.lb)
    true

renderPool(Pool p) =>
    bool _k = killPoolArt(p)
    p.ln := na
    p.bx := na
    p.lb := na
    if showPools and poolDrawable(p)
        color c = sideCol(not p.up)
        if p.touches >= minTouches
            // equal highs / lows: draw the band the touches actually span
            float hiB = math.max(p.px, p.pxAlt)
            float loB = math.min(p.px, p.pxAlt)
            if hiB - loB < eqTol * 0.3
                if p.up
                    loB := hiB - eqTol * 0.3
                else
                    hiB := loB + eqTol * 0.3
            p.bx := box.new(p.bar, hiB, bar_index, loB, border_color = color.new(c, borderTr), border_width = 1, bgcolor = color.new(c, zoneTr))
        else
            p.ln := line.new(p.bar, p.px, bar_index, p.px, color = p.named ? color.new(c, 30) : ink(55), style = p.named ? line.style_solid : line.style_dotted, width = 1)
        string t = poolText(p)
        if showPoolTags and t != ""
            p.lb := label.new(bar_index, p.px, " " + t, style = label.style_none, textcolor = ink(textTr), size = size.tiny, textalign = text.align_left)
    true

// Merging a new pivot into a nearby pool is what turns a second tap into EQH /
// EQL — and the touch count is the single biggest input to the grade.
addPool(float px, int atBar, bool up, bool major, bool named, string tag) =>
    // A level this bar has already traded through is not resting liquidity;
    // registering it would manufacture a sweep out of a move already made.
    bool ok = not na(px) and (up ? high < px : low > px)
    bool merged = false
    if ok and pools.size() > 0
        for i = 0 to pools.size() - 1
            Pool p = pools.get(i)
            if p.up == up and not p.pierced and math.abs(p.px - px) <= eqTol
                p.touches := p.touches + 1
                p.pxAlt   := up ? math.min(p.pxAlt, px) : math.max(p.pxAlt, px)
                p.px      := up ? math.max(p.px, px) : math.min(p.px, px)
                p.major   := p.major or major
                p.named   := p.named or named
                p.bar     := atBar < p.bar ? atBar : p.bar
                if named
                    p.tag := tag
                bool _r = renderPool(p)
                merged := true
                break
    if not merged and ok
        Pool np = Pool.new(px = px, pxAlt = px, bar = atBar, touches = 1, up = up, major = major, named = named, tag = tag, ln = na, bx = na, lb = na, pierced = false, pBar = na, ext = px, wick = 0.0, volR = 1.0, smt = false, turtle = false, judas = false)
        bool _r = renderPool(np)
        pools.push(np)
        int n = 0
        for i = 0 to pools.size() - 1
            if pools.get(i).up == up
                n += 1
        if n > maxPools
            for i = 0 to pools.size() - 1
                Pool old = pools.get(i)
                if old.up == up
                    bool _k = killPoolArt(old)
                    pools.remove(i)
                    break
    merged

pruneSweeps() =>
    while sweeps.size() > maxSweeps
        Sweep s = sweeps.shift()
        label.delete(s.lb)
        box.delete(s.bx)
    sweeps.size()

if conf
    if not na(lph)
        bool _a = addPool(lph, bar_index - liqLen, true, false, false, "swing high")
        int _mh = pushPivot(mhBar, mhPx, bar_index - liqLen, lph)
    if not na(lpl)
        bool _b = addPool(lpl, bar_index - liqLen, false, false, false, "swing low")
        int _ml = pushPivot(mlBar, mlPx, bar_index - liqLen, lpl)
    if not na(sph)
        bool _c = addPool(sph, bar_index - swingLen, true, true, false, "swing high")
        topPx := sph
        topBar := bar_index - swingLen
        topBroken := false
        drHi := sph
    if not na(spl)
        bool _d = addPool(spl, bar_index - swingLen, false, true, false, "swing low")
        btmPx := spl
        btmBar := bar_index - swingLen
        btmBroken := false
        drLo := spl
    if showPdhl and not na(pdhV) and pdhV != nz(pdhV[1], pdhV + 1)
        bool _e = addPool(pdhV, bar_index, true, true, true, "PDH")
        bool _f = addPool(pdlV, bar_index, false, true, true, "PDL")
    if showPwhl and not na(pwhV) and pwhV != nz(pwhV[1], pwhV + 1)
        bool _g = addPool(pwhV, bar_index, true, true, true, "PWH")
        bool _h = addPool(pwlV, bar_index, false, true, true, "PWL")

drValid = not na(drHi) and not na(drLo) and drHi > drLo
drPos   = drValid ? (close - drLo) / (drHi - drLo) : na

// ═════════════════════════════════════════════════════════════════════════════
// 2 · SWEEP ENGINE + GRADING
// ═════════════════════════════════════════════════════════════════════════════
if conf and pools.size() > 0
    for i = pools.size() - 1 to 0
        Pool p = pools.get(i)
        bool drop = false
        bool breached  = p.up ? high > p.px : low < p.px
        bool reclaimed = p.up ? close < p.px : close > p.px

        if not p.pierced and breached
            p.pierced := true
            p.pBar    := bar_index
            p.ext     := p.up ? high : low
            p.wick    := p.up ? wickUp : wickDn
            p.volR    := relVol
            p.smt     := p.up ? smtBear : smtBull
            p.turtle  := p.up ? (not na(tsHi) and p.px >= tsHi) : (not na(tsLo) and p.px <= tsLo)
            p.judas   := inJudas
        else if p.pierced
            p.ext  := p.up ? math.max(p.ext, high) : math.min(p.ext, low)
            p.wick := math.max(p.wick, p.up ? wickUp : wickDn)
            p.volR := math.max(p.volR, relVol)
            p.smt  := p.smt or (p.up ? smtBear : smtBull)

        if p.pierced
            float depth = math.abs(p.ext - p.px) / atrSafe
            if reclaimed
                // ── the raid is confirmed: grade it ─────────────────────────
                int   barsBack = bar_index - p.pBar
                float sDepth = depth <= 0 ? 0.0 : depth < idealLoAtr ? depth / math.max(idealLoAtr, 0.001) : depth <= idealHiAtr ? 1.0 : math.max(0.0, 1.0 - (depth - idealHiAtr) / math.max(maxRunAtr - idealHiAtr, 0.01))
                float sRej   = clamp01(p.wick / 0.6)
                float sSpeed = maxConfirm <= 0 ? 1.0 : clamp01(1.0 - barsBack / math.max(maxConfirm, 1.0))
                float sDisp  = clamp01(math.abs(p.ext - close) / atrSafe / math.max(dispRefAtr, 0.01))
                float sVol   = clamp01((p.volR - 1.0) / 1.5)
                float posLvl = drValid ? (p.px - drLo) / (drHi - drLo) : 0.5
                float sCtx   = drValid ? clamp01((p.up ? posLvl - 0.5 : 0.5 - posLvl) / 0.3) : 0.5
                int   ageBar = p.named ? poolAgeRef : bar_index - p.bar
                float sPool  = 0.35 * clamp01((p.touches - 1) / 3.0) + 0.25 * clamp01(ageBar / math.max(poolAgeRef, 1.0)) + 0.25 * (p.major ? 1.0 : 0.45) + 0.15 * (p.named ? 1.0 : 0.30)
                float sSmt   = p.smt ? 1.0 : 0.35
                float wSmtEff = useSmt ? wSmt : 0.0
                float wSum   = wPool + wDepth + wRej + wSpeed + wDisp + wVol + wCtx + wSmtEff
                float score  = wSum <= 0 ? 0.0 : 100.0 * (wPool * sPool + wDepth * sDepth + wRej * sRej + wSpeed * sSpeed + wDisp * sDisp + wVol * sVol + wCtx * sCtx + wSmtEff * sSmt) / wSum
                string g     = gradeOf(score)
                string side  = p.up ? "BSL" : "SSL"
                string mark  = (p.smt ? " ◆" : "") + (p.turtle ? " TS" : "") + (p.judas ? " JD" : "")

                nGraded  += 1
                sumScore += score
                if rankOf(g) >= 4
                    nHighGrade += 1
                if p.up
                    raidUpNow := true
                    raidUpRank := rankOf(g)
                    lastRaidUpBar := bar_index
                else
                    raidDnNow := true
                    raidDnRank := rankOf(g)
                    lastRaidDnBar := bar_index
                lastSweepTxt := side + " " + g + " " + str.tostring(math.round(score), "#") + mark
                lastSweepCol := sideCol(not p.up)

                if showSweeps and rankOf(g) >= rankOf(minGradeIn)
                    string txt = switch sweepDetail
                        "Grade only"           => g
                        "Side + grade + score" => side + " " + g + " " + str.tostring(math.round(score), "#")
                        => g + " " + str.tostring(math.round(score), "#")
                    string tip = (p.up ? "Buy-side liquidity taken" : "Sell-side liquidity taken") + "   " + g + "  ·  " + str.tostring(score, "#.#") + "/100"
                    tip := tip + "\nlevel " + str.tostring(p.px, format.mintick) + "  ·  " + (p.named ? p.tag : p.touches > 1 ? (p.up ? "EQH ×" : "EQL ×") + str.tostring(p.touches) : p.up ? "swing high" : "swing low") + (p.major ? "  ·  major" : "  ·  minor") + "  ·  age " + str.tostring(bar_index - p.bar) + " bars"
                    tip := tip + "\n──────────────────────────────"
                    tip := tip + "\npool quality                     " + pct(sPool)
                    tip := tip + "\npenetration     " + str.tostring(depth, "#.##") + " ATR      " + pct(sDepth)
                    tip := tip + "\nrejection wick  " + pct(p.wick) + "          " + pct(sRej)
                    tip := tip + "\nreclaim         " + str.tostring(barsBack) + " bar(s)    " + pct(sSpeed)
                    tip := tip + "\ndisplacement    " + str.tostring(math.abs(p.ext - close) / atrSafe, "#.##") + " ATR      " + pct(sDisp)
                    tip := tip + "\nrelative volume " + str.tostring(p.volR, "#.##") + "×        " + pct(sVol) + (useVol ? "" : "  (range proxy)")
                    tip := tip + "\n" + (p.up ? "premium ctx     " : "discount ctx    ") + (drValid ? str.tostring(posLvl, "#.##") : "n/a") + "         " + pct(sCtx)
                    if useSmt
                        tip := tip + "\nSMT divergence  " + (p.smt ? "yes" : "no ") + "            " + pct(sSmt)
                    if p.turtle
                        tip := tip + "\n\nTS · Turtle Soup — this level was the extreme of the last " + str.tostring(tsLook) + " bars, so the raid was a false break of the external range."
                    if p.judas
                        tip := tip + "\nJD · Judas swing — the raid landed inside the first " + str.tostring(judasBars) + " bars of a killzone open."
                    label lb = label.new(p.pBar, p.up ? p.ext + atrSafe * 0.4 : p.ext - atrSafe * 0.4, txt + mark, style = label.style_none, textcolor = color.new(sideCol(not p.up), trOf(g)), size = size.small, textalign = text.align_center, tooltip = tip)
                    box bx = showSwZone ? box.new(math.min(p.bar, bar_index - 1), math.max(p.ext, p.px), bar_index, math.min(p.ext, p.px), border_color = color.new(sideCol(not p.up), 82), border_width = 1, bgcolor = color.new(sideCol(not p.up), 90), text = p.named ? p.tag + " taken" : (p.up ? "Buyside liquidity" : "Sellside liquidity"), text_color = ink(40), text_size = size.tiny, text_halign = text.align_left, text_valign = p.up ? text.align_top : text.align_bottom) : na
                    sweeps.push(Sweep.new(lb = lb, bx = bx, up = p.up, bar = bar_index, score = score, side = side, tip = tip, mark = mark, done = not useFollow))
                    int _p = pruneSweeps()

                if rankOf(g) >= rankOf(minGradeIn)
                    alert(side + " sweep graded " + g + " (" + str.tostring(math.round(score), "#") + ")" + mark + " at " + str.tostring(p.px, format.mintick) + " on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
                drop := true
            else if bar_index - p.pBar >= maxConfirm or depth > maxRunAtr
                // price stayed beyond the level: this was a break, not a raid
                drop := true

        if drop
            bool _k = killPoolArt(p)
            pools.remove(i)

if conf and pools.size() > 0
    for p in pools
        if not na(p.ln)
            line.set_x2(p.ln, bar_index)
        if not na(p.bx)
            box.set_right(p.bx, bar_index)
        if not na(p.lb)
            label.set_x(p.lb, bar_index)
            label.set_y(p.lb, p.px)

// ═════════════════════════════════════════════════════════════════════════════
// 3 · STRUCTURE — BOS · CHoCH · MSS
// ═════════════════════════════════════════════════════════════════════════════
addStruct(string kind, float px, int fromBar, bool bull) =>
    if showStruct
        line ln = line.new(fromBar, px, bar_index, px, color = kind == "MSS" ? color.new(sideCol(bull), 25) : ink(50), style = kind == "BOS" ? line.style_solid : line.style_dashed, width = 1)
        label lb = label.new(int(math.avg(fromBar, bar_index)), bull ? px + atrSafe * 0.25 : px - atrSafe * 0.25, kind, style = label.style_none, textcolor = kind == "MSS" ? color.new(sideCol(bull), 10) : ink(textTr), size = size.tiny, textalign = text.align_center)
        stLines.push(ln)
        stLabs.push(lb)
        while stLines.size() > maxStruct
            line.delete(stLines.shift())
        while stLabs.size() > maxStruct
            label.delete(stLabs.shift())
    showStruct

addOb(bool bull) =>
    if showOb
        float obTop = na
        float obBtm = na
        int   obIdx = na
        if obMethod == "Extreme of the leg"
            float ext = na
            for k = 1 to obLook
                float v = bull ? low[k] : high[k]
                if na(ext) or (bull ? v < ext : v > ext)
                    ext   := v
                    obTop := obUseBody ? math.max(open[k], close[k]) : high[k]
                    obBtm := obUseBody ? math.min(open[k], close[k]) : low[k]
                    obIdx := bar_index - k
        else
            for k = 1 to obLook
                bool opposite = bull ? close[k] < open[k] : close[k] > open[k]
                if opposite
                    obTop := obUseBody ? math.max(open[k], close[k]) : high[k]
                    obBtm := obUseBody ? math.min(open[k], close[k]) : low[k]
                    obIdx := bar_index - k
                    break
        if not na(obIdx) and obTop > obBtm
            box bx = box.new(obIdx, obTop, bar_index, obBtm, border_color = color.new(sideCol(bull), borderTr), border_width = 1, bgcolor = color.new(sideCol(bull), zoneTr), text = bull ? "+OB" : "-OB", text_color = ink(textTr), text_size = size.tiny, text_halign = text.align_center, text_valign = bull ? text.align_bottom : text.align_top)
            obs.push(Ob.new(bx = bx, top = obTop, btm = obBtm, bull = bull, breaker = false))
            int n = 0
            for i = 0 to obs.size() - 1
                if obs.get(i).bull == bull
                    n += 1
            if n > maxOb
                for i = 0 to obs.size() - 1
                    Ob o = obs.get(i)
                    if o.bull == bull
                        box.delete(o.bx)
                        obs.remove(i)
                        break
    showOb

if conf and not na(topPx) and not topBroken and close > topPx
    bool raided = not na(lastRaidDnBar) and bar_index - lastRaidDnBar <= mssWin
    bool disp   = (not na(lastBullFvgBar) and bar_index - lastBullFvgBar <= mssWin) or isDispUp
    string kind = bias == 1 or bias == 0 ? "BOS" : raided and disp ? "MSS" : "CHoCH"
    bool _s = addStruct(kind, topPx, topBar, true)
    bool _o = addOb(true)
    bias := 1
    topBroken := true
    bullStructNow := true

if conf and not na(btmPx) and not btmBroken and close < btmPx
    bool raided = not na(lastRaidUpBar) and bar_index - lastRaidUpBar <= mssWin
    bool disp   = (not na(lastBearFvgBar) and bar_index - lastBearFvgBar <= mssWin) or isDispDn
    string kind = bias == -1 or bias == 0 ? "BOS" : raided and disp ? "MSS" : "CHoCH"
    bool _s = addStruct(kind, btmPx, btmBar, false)
    bool _o = addOb(false)
    bias := -1
    btmBroken := true
    bearStructNow := true

// ── inducement: the last minor pullback inside the current leg, registered as a
//    named pool so it is drawn, tracked and graded like any other liquidity.
if conf and showIdm
    if not na(sph) and not na(btmBar) and not na(topBar) and btmBar < topBar and mlBar.size() > 0
        int   idmBar = -1
        float idmPx  = na
        for k = mlBar.size() - 1 to 0
            int b = mlBar.get(k)
            if b > btmBar and b < topBar
                idmBar := b
                idmPx  := mlPx.get(k)
                break
        if idmBar >= 0
            bool _i = addPool(idmPx, idmBar, false, true, true, "IDM")
    if not na(spl) and not na(topBar) and not na(btmBar) and topBar < btmBar and mhBar.size() > 0
        int   idmBar = -1
        float idmPx  = na
        for k = mhBar.size() - 1 to 0
            int b = mhBar.get(k)
            if b > topBar and b < btmBar
                idmBar := b
                idmPx  := mhPx.get(k)
                break
        if idmBar >= 0
            bool _i = addPool(idmPx, idmBar, true, true, true, "IDM")

// ═════════════════════════════════════════════════════════════════════════════
// 4 · CISD — change in state of delivery
// ═════════════════════════════════════════════════════════════════════════════
addCisd(float px, int fromBar, bool bull) =>
    if showCisd
        line ln = line.new(fromBar, px, bar_index, px, color = color.new(sideCol(bull), 35), style = line.style_dotted, width = 1)
        label lb = label.new(bar_index, bull ? px + atrSafe * 0.25 : px - atrSafe * 0.25, "CISD", style = label.style_none, textcolor = ink(textTr), size = size.tiny, textalign = text.align_left)
        ciLines.push(ln)
        ciLabs.push(lb)
        while ciLines.size() > maxCisd
            line.delete(ciLines.shift())
        while ciLabs.size() > maxCisd
            label.delete(ciLabs.shift())
    showCisd

if conf
    int d = close > open ? 1 : close < open ? -1 : 0
    if d != 0
        if d != runDir
            if runDir == -1 and runLen >= cisdMinRun
                bearLegPx  := cisdAnchor == "Run-start open" ? runOpenFirst : runOpenExt
                bearLegBar := runStart
                bullCisdArmed := true
            if runDir == 1 and runLen >= cisdMinRun
                bullLegPx  := cisdAnchor == "Run-start open" ? runOpenFirst : runOpenExt
                bullLegBar := runStart
                bearCisdArmed := true
            runDir := d
            runStart := bar_index
            runOpenFirst := open
            runOpenExt := open
            runLen := 1
        else
            runLen := runLen + 1
            runOpenExt := d == -1 ? math.max(runOpenExt, open) : math.min(runOpenExt, open)

    if bullCisdArmed and not na(bearLegPx) and close > bearLegPx
        bool okSw = not cisdReqSw or (not na(lastRaidDnBar) and bar_index - lastRaidDnBar <= cisdWin)
        bullCisdArmed := false
        if okSw
            bool _c = addCisd(bearLegPx, bearLegBar, true)
            bullCisdNow := true
    if bearCisdArmed and not na(bullLegPx) and close < bullLegPx
        bool okSw = not cisdReqSw or (not na(lastRaidUpBar) and bar_index - lastRaidUpBar <= cisdWin)
        bearCisdArmed := false
        if okSw
            bool _c = addCisd(bullLegPx, bullLegBar, false)
            bearCisdNow := true

// ═════════════════════════════════════════════════════════════════════════════
// 5 · FAIR VALUE GAPS   (mitigation first, then creation — a new gap can never
//     be "mitigated" by the very bar that created it)
// ═════════════════════════════════════════════════════════════════════════════
if conf and fvgs.size() > 0
    for i = fvgs.size() - 1 to 0
        Zone z = fvgs.get(i)
        bool kill = false
        if not z.frozen
            box.set_right(z.bx, bar_index)
            if not na(z.ce)
                line.set_x2(z.ce, bar_index)
        float mid = math.avg(z.top, z.btm)
        float trigger = fvgMitig == "Touch" ? (z.bull ? z.top : z.btm) : fvgMitig == "Full fill" ? (z.bull ? z.btm : z.top) : mid
        bool hit = z.bull ? low <= trigger : high >= trigger
        if not z.mitigated and hit
            z.mitigated := true
            if fvgOnMit == "Delete"
                kill := true
            else if fvgOnMit == "Fade"
                box.set_bgcolor(z.bx, color.new(sideCol(z.bull), 95))
                box.set_border_color(z.bx, color.new(sideCol(z.bull), 92))
                z.frozen := true
            else
                z.frozen := true
        // traded fully through: invert into an IFVG, or retire it as spent
        bool through = z.bull ? close < z.btm : close > z.top
        if not kill and through and not z.spent
            if showIfvg and not z.inverted
                z.inverted := true
                z.bull := not z.bull
                z.mitigated := false
                z.frozen := false
                box.set_bgcolor(z.bx, color.new(sideCol(z.bull), zoneTr))
                box.set_border_color(z.bx, color.new(sideCol(z.bull), borderTr))
                box.set_text(z.bx, "IFVG")
            else if fvgOnMit == "Delete"
                kill := true
            else
                z.spent := true
                z.frozen := true
                box.set_bgcolor(z.bx, color.new(sideCol(z.bull), 95))
                box.set_border_color(z.bx, color.new(sideCol(z.bull), 92))
                box.set_text_color(z.bx, ink(70))
        if kill
            box.delete(z.bx)
            line.delete(z.ce)
            fvgs.remove(i)

addFvg(bool bull, float top, float btm) =>
    box bx = box.new(bar_index - 2, top, bar_index, btm, border_color = color.new(sideCol(bull), borderTr), border_width = 1, bgcolor = color.new(sideCol(bull), zoneTr), text = "FVG", text_color = ink(textTr), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center)
    line ce = showCe ? line.new(bar_index - 2, math.avg(top, btm), bar_index, math.avg(top, btm), color = ink(55), style = line.style_dashed, width = 1) : na
    fvgs.push(Zone.new(bx = bx, ce = ce, top = top, btm = btm, bull = bull, mitigated = false, inverted = false, frozen = false, spent = false))
    int n = 0
    for i = 0 to fvgs.size() - 1
        if fvgs.get(i).bull == bull
            n += 1
    if n > maxFvg
        for i = 0 to fvgs.size() - 1
            Zone z = fvgs.get(i)
            if z.bull == bull
                box.delete(z.bx)
                line.delete(z.ce)
                fvgs.remove(i)
                break
    true

if conf and showFvg and bar_index > 2
    bool madeUp = false
    bool madeDn = false
    if gapUp > 0 and gapUp >= fvgMinAtr * atrSafe and (not fvgReqDisp or isDispUp[1])
        bool _f = addFvg(true, low, high[2])
        lastBullFvgBar := bar_index
        madeUp := true
    if gapDn > 0 and gapDn >= fvgMinAtr * atrSafe and (not fvgReqDisp or isDispDn[1])
        bool _f = addFvg(false, low[2], high)
        lastBearFvgBar := bar_index
        madeDn := true

    // A gap delivered in both directions is a balance price range — the overlap
    // of the newest bullish and bearish FVG, and a stronger reference than either.
    if showBpr and (madeUp or madeDn) and fvgs.size() > 1
        Zone lastBull = na
        Zone lastBear = na
        for i = fvgs.size() - 1 to 0
            Zone z = fvgs.get(i)
            if z.bull and na(lastBull)
                lastBull := z
            if not z.bull and na(lastBear)
                lastBear := z
        if not na(lastBull) and not na(lastBear)
            float ovTop = math.min(lastBull.top, lastBear.top)
            float ovBtm = math.max(lastBull.btm, lastBear.btm)
            if ovTop > ovBtm
                bool dup = false
                for b in bprs
                    if math.abs(b.top - ovTop) < syminfo.mintick and math.abs(b.btm - ovBtm) < syminfo.mintick
                        dup := true
                if not dup
                    box bb = box.new(bar_index - 2, ovTop, bar_index, ovBtm, border_color = color.new(inkCol, 45), border_width = 1, bgcolor = color.new(inkCol, zoneTr), text = "BPR", text_color = ink(textTr), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center)
                    bprs.push(Zone.new(bx = bb, ce = na, top = ovTop, btm = ovBtm, bull = madeUp, mitigated = false, inverted = false, frozen = false, spent = false))
                    while bprs.size() > maxBpr
                        Zone old = bprs.shift()
                        box.delete(old.bx)

if conf and bprs.size() > 0
    for i = bprs.size() - 1 to 0
        Zone b = bprs.get(i)
        if not b.frozen
            box.set_right(b.bx, bar_index)
        if close > b.top or close < b.btm
            b.frozen := true

// ── volume imbalance: body-to-body gap with the wicks still overlapping
if conf and vis.size() > 0
    for i = vis.size() - 1 to 0
        Vi v = vis.get(i)
        box.set_right(v.bx, bar_index)
        if v.bull ? low <= v.btm : high >= v.top
            box.delete(v.bx)
            vis.remove(i)

addVi(bool bull, float top, float btm) =>
    box bx = box.new(bar_index - 1, top, bar_index, btm, border_color = color.new(sideCol(bull), 75), border_width = 1, bgcolor = color.new(sideCol(bull), 74))
    vis.push(Vi.new(bx = bx, top = top, btm = btm, bull = bull))
    while vis.size() > maxVi
        Vi old = vis.shift()
        box.delete(old.bx)
    true

if conf and showVi and bar_index > 1
    if open > close[1] and low <= high[1] and open - close[1] >= viMinAtr * atrSafe
        bool _v = addVi(true, open, close[1])
    if open < close[1] and high >= low[1] and close[1] - open >= viMinAtr * atrSafe
        bool _v = addVi(false, close[1], open)

// ═════════════════════════════════════════════════════════════════════════════
// 6 · ORDER BLOCKS / BREAKERS
// ═════════════════════════════════════════════════════════════════════════════
if conf and obs.size() > 0
    for i = obs.size() - 1 to 0
        Ob o = obs.get(i)
        box.set_right(o.bx, bar_index)
        if o.bull ? close < o.btm : close > o.top
            if showBrk and not o.breaker
                o.breaker := true
                o.bull := not o.bull
                box.set_bgcolor(o.bx, color.new(sideCol(o.bull), zoneTr))
                box.set_border_color(o.bx, color.new(sideCol(o.bull), borderTr))
                box.set_text(o.bx, o.bull ? "+BRK" : "-BRK")
            else
                box.delete(o.bx)
                obs.remove(i)

// ═════════════════════════════════════════════════════════════════════════════
// 7 · FOLLOW-THROUGH RE-GRADE   (additive only — never downgrades, never erases)
// ═════════════════════════════════════════════════════════════════════════════
if conf and useFollow and sweeps.size() > 0
    for s in sweeps
        if not s.done
            if bar_index - s.bar > followWin
                s.done := true
            else if s.up ? (bearCisdNow or bearStructNow) : (bullCisdNow or bullStructNow)
                s.done := true
                s.score := math.min(100.0, s.score + followBonus)
                string g2 = gradeOf(s.score)
                if not na(s.lb)
                    string t2 = switch sweepDetail
                        "Grade only"           => g2
                        "Side + grade + score" => s.side + " " + g2 + " " + str.tostring(math.round(s.score), "#")
                        => g2 + " " + str.tostring(math.round(s.score), "#")
                    label.set_text(s.lb, t2 + s.mark + " ▲")
                    label.set_textcolor(s.lb, color.new(sideCol(not s.up), trOf(g2)))
                    label.set_tooltip(s.lb, s.tip + "\n──────────────────────────────\n▲ follow-through confirmed (+" + str.tostring(followBonus, "#.#") + ")  →  " + g2)

// ═════════════════════════════════════════════════════════════════════════════
// 8 · PREMIUM / DISCOUNT / EQUILIBRIUM / OTE
// ═════════════════════════════════════════════════════════════════════════════
var box  pdPrem = na
var box  pdDisc = na
var line pdEq   = na
var box  pdOte  = na

if barstate.islast
    if showPd and drValid
        float eq = math.avg(drHi, drLo)
        int   x1 = nz(topBar, bar_index) < nz(btmBar, bar_index) ? nz(topBar, bar_index) : nz(btmBar, bar_index)
        if na(pdPrem)
            pdPrem := box.new(x1, drHi, bar_index, eq, border_color = color.new(bearCol, 80), bgcolor = color.new(bearCol, 94), text = "Premium", text_color = ink(60), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
            pdDisc := box.new(x1, eq, bar_index, drLo, border_color = color.new(bullCol, 80), bgcolor = color.new(bullCol, 94), text = "Discount", text_color = ink(60), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom)
            pdEq   := line.new(x1, eq, bar_index, eq, color = ink(45), style = line.style_dashed, width = 1)
        box.set_lefttop(pdPrem, x1, drHi)
        box.set_rightbottom(pdPrem, bar_index, eq)
        box.set_lefttop(pdDisc, x1, eq)
        box.set_rightbottom(pdDisc, bar_index, drLo)
        line.set_xy1(pdEq, x1, eq)
        line.set_xy2(pdEq, bar_index, eq)
        if showOte
            // OTE is the 62-79% retracement of the leg that built the range.
            bool  legUp = nz(btmBar, 0) < nz(topBar, 0)
            float o1 = legUp ? drHi - (drHi - drLo) * oteLo : drLo + (drHi - drLo) * oteLo
            float o2 = legUp ? drHi - (drHi - drLo) * oteHi : drLo + (drHi - drLo) * oteHi
            if na(pdOte)
                pdOte := box.new(x1, math.max(o1, o2), bar_index, math.min(o1, o2), border_color = ink(70), bgcolor = color.new(sideCol(legUp), 88), text = "OTE", text_color = ink(45), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
            box.set_lefttop(pdOte, x1, math.max(o1, o2))
            box.set_rightbottom(pdOte, bar_index, math.min(o1, o2))
            box.set_bgcolor(pdOte, color.new(sideCol(legUp), 88))
    else if not na(pdPrem) or not na(pdOte)
        box.delete(pdPrem)
        box.delete(pdDisc)
        line.delete(pdEq)
        box.delete(pdOte)
        pdPrem := na
        pdDisc := na
        pdEq   := na
        pdOte  := na

// ═════════════════════════════════════════════════════════════════════════════
// 9 · MIDNIGHT OPEN  ·  POWER OF 3
// ═════════════════════════════════════════════════════════════════════════════
if conf and newNyDay
    mnoPx := open
    if showMno
        line.delete(mnoLine)
        label.delete(mnoLab)
        mnoLine := line.new(bar_index, mnoPx, bar_index, mnoPx, color = ink(40), style = line.style_dashed, width = 1)
        mnoLab  := label.new(bar_index, mnoPx, " midnight open", style = label.style_none, textcolor = ink(textTr), size = size.tiny, textalign = text.align_left)
if showMno and not na(mnoLine)
    line.set_x2(mnoLine, bar_index)
    label.set_x(mnoLab, bar_index)

if conf and intraday
    if newNyDay
        orHi     := high
        orLo     := low
        po3Stage := 0
        po3Dir   := 0
        if showPo3
            box.delete(orBox)
            orBox := box.new(bar_index, high, bar_index, low, border_color = ink(75), border_width = 1, bgcolor = color.new(inkCol, 95), text = "Accumulation", text_color = ink(60), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top)
    else if not na(orHi)
        if not na(nyMin) and nyMin < po3Min
            orHi := math.max(orHi, high)
            orLo := math.min(orLo, low)
            if not na(orBox)
                box.set_top(orBox, orHi)
                box.set_bottom(orBox, orLo)
                box.set_right(orBox, bar_index)
        else if po3Dir == 0
            if high > orHi
                po3Dir   := 1
                po3Stage := 1
            else if low < orLo
                po3Dir   := -1
                po3Stage := 1
        else if po3Stage == 1 and ((po3Dir == 1 and close < orLo) or (po3Dir == -1 and close > orHi))
            po3Stage := 2

addGap(arr, a, b, cap, txt) =>
    box bx = box.new(bar_index - 1, math.max(a, b), bar_index, math.min(a, b), border_color = color.new(gapCol, 55), border_width = 1, bgcolor = color.new(gapCol, zoneTr), extend = extend.right, text = txt, text_color = ink(textTr), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center)
    line ce = line.new(bar_index - 1, math.avg(a, b), bar_index, math.avg(a, b), color = color.new(gapCol, 35), style = line.style_dotted, width = 1, extend = extend.right)
    arr.push(Gap.new(bx = bx, ce = ce))
    while arr.size() > cap
        Gap g = arr.shift()
        box.delete(g.bx)
        line.delete(g.ce)
    true

if conf and intraday and nyDow == dayofweek.friday
    friClose := close

if conf and bar_index > 1
    // NWOG: Friday's last close to the first open of the new week. On CME that
    // is the Sunday 18:00 ET bell, on an RTH-only chart it is Monday's open.
    if showNwog and newWeekBar and not na(friClose)
        bool _w = addGap(nwogs, friClose, open, maxNwog, "NWOG")
    // NDOG: yesterday's last close to today's first open, on the New York
    // calendar day. On a 24-hour feed midnight is a quiet boundary and this gap
    // is usually tiny — it is the real overnight gap only on a session chart.
    if showNdog and newNyDay and not newWeekBar
        bool _d = addGap(ndogs, close[1], open, maxNdog, "NDOG")

// ═════════════════════════════════════════════════════════════════════════════
// 10 · TIME WINDOWS  ·  DISPLACEMENT
// ═════════════════════════════════════════════════════════════════════════════
bgcolor(showKz  and inKz  ? color.new(kzCol,  winTr) : na, title = "Killzones")
bgcolor(showSb  and inSb  ? color.new(sbCol,  winTr) : na, title = "Silver Bullet")
bgcolor(showMac and inMac ? color.new(macCol, winTr) : na, title = "ICT Macros")

dispUp = showDisp and isDispUp
dispDn = showDisp and isDispDn
plotshape(dispUp, title = "Displacement up",   style = shape.triangleup,   location = location.belowbar, color = color.new(bullCol, 25), size = size.tiny)
plotshape(dispDn, title = "Displacement down", style = shape.triangledown, location = location.abovebar, color = color.new(bearCol, 25), size = size.tiny)

// ═════════════════════════════════════════════════════════════════════════════
// 11 · DAILY BIAS  ·  IRL / ERL DRAW  ·  DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
pdMid  = not na(pdhV) and not na(pdlV) ? math.avg(pdhV, pdlV) : na
bDaily = not na(pdcV) and not na(pdh2V) and not na(pdl2V) ? (pdcV > pdh2V ? 1 : pdcV < pdl2V ? -1 : 0) : 0
bPdRng = not na(pdMid) ? (close < pdMid ? 1 : -1) : 0
bMno   = not na(mnoPx) ? (close > mnoPx ? 1 : -1) : 0
biasScore = bDaily + bPdRng + bias + bMno
biasTxt   = biasScore >= 2 ? "Bullish" : biasScore <= -2 ? "Bearish" : "Neutral"
biasCol   = biasScore >= 2 ? bullCol : biasScore <= -2 ? bearCol : color.gray
drawDir   = biasScore >= 2 ? 1 : biasScore <= -2 ? -1 : bias

dashPos = dashPosIn == "Top left" ? position.top_left : dashPosIn == "Bottom left" ? position.bottom_left : dashPosIn == "Bottom right" ? position.bottom_right : dashPosIn == "Middle right" ? position.middle_right : position.top_right
dashSz  = dashSzIn == "Tiny" ? size.tiny : dashSzIn == "Normal" ? size.normal : size.small

var table dash = na
if barstate.islast
    if showDash
        if na(dash)
            dash := table.new(dashPos, 2, 10, border_color = #22323f, border_width = 1, frame_color = #2b4055, frame_width = 1)

        // nearest external liquidity (a pool) vs nearest internal liquidity (an
        // unmitigated gap) in the draw direction — whichever price meets first
        float poolTgt = na
        float zoneTgt = na
        string poolTag = ""
        int nUp = 0
        int nDn = 0
        for p in pools
            if p.up
                nUp += 1
            else
                nDn += 1
            if drawDir > 0 and p.up and p.px > close and (na(poolTgt) or p.px < poolTgt)
                poolTgt := p.px
                poolTag := p.named ? p.tag : p.touches > 1 ? "EQH" : "old high"
            if drawDir < 0 and not p.up and p.px < close and (na(poolTgt) or p.px > poolTgt)
                poolTgt := p.px
                poolTag := p.named ? p.tag : p.touches > 1 ? "EQL" : "old low"
        for z in fvgs
            if not z.mitigated
                if drawDir > 0 and z.btm > close and (na(zoneTgt) or z.btm < zoneTgt)
                    zoneTgt := z.btm
                if drawDir < 0 and z.top < close and (na(zoneTgt) or z.top > zoneTgt)
                    zoneTgt := z.top
        string drawTxt = "—"
        if drawDir != 0
            bool irlFirst = not na(zoneTgt) and (na(poolTgt) or (drawDir > 0 ? zoneTgt < poolTgt : zoneTgt > poolTgt))
            if irlFirst
                drawTxt := "IRL · FVG " + str.tostring(zoneTgt, format.mintick)
            else if not na(poolTgt)
                drawTxt := "ERL · " + poolTag + " " + str.tostring(poolTgt, format.mintick)

        string po3Txt = na(orHi) ? "—" : po3Stage == 0 ? "Accumulation" : po3Stage == 1 ? "Manipulation " + (po3Dir == 1 ? "↑" : "↓") : "Distribution " + (po3Dir == 1 ? "↓" : "↑")
        string structTxt = bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "Undefined"
        string rangeTxt = not drValid or na(drPos) ? "—" : (drPos > 0.5 ? "Premium " : "Discount ") + str.tostring(drPos, "#.##")
        string biasTip = "Four stated components, each +1 / -1:\n· previous daily close beyond the day-before's range: " + str.tostring(bDaily) + "\n· price in the previous day's discount (draw up) / premium (draw down): " + str.tostring(bPdRng) + "\n· chart structure bias: " + str.tostring(bias) + "\n· price versus the midnight open: " + str.tostring(bMno) + "\nsum " + str.tostring(biasScore) + " → ±2 or beyond commits, otherwise neutral."

        table.cell(dash, 0, 0, "  ICT  ",                      text_color = color.white, bgcolor = #1c3d5a, text_size = dashSz)
        table.cell(dash, 1, 0, "  " + timeframe.period + "  ", text_color = color.white, bgcolor = #1c3d5a, text_size = dashSz)
        table.cell(dash, 0, 1, "  Daily bias  ",   text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz, tooltip = biasTip)
        table.cell(dash, 1, 1, "  " + biasTxt + " " + (biasScore > 0 ? "+" : "") + str.tostring(biasScore) + "  ", text_color = color.white, bgcolor = color.new(biasCol, 25), text_size = dashSz, tooltip = biasTip)
        table.cell(dash, 0, 2, "  Structure  ",    text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 1, 2, "  " + structTxt + "  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 0, 3, "  Dealing range  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 1, 3, "  " + rangeTxt + "  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 0, 4, "  Draw on liquidity  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz, tooltip = "ERL = external range liquidity (an old high or low). IRL = internal range liquidity (an unmitigated gap inside the range). Whichever sits nearer in the bias direction is what price should reach for first.")
        table.cell(dash, 1, 4, "  " + drawTxt + "  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 0, 5, "  Power of 3  ",   text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz, tooltip = "Accumulation = still inside the New York day's opening range. Manipulation = the first excursion out of it, with the side raided. Distribution = price has since closed back through the opposite side.")
        table.cell(dash, 1, 5, "  " + po3Txt + "  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 0, 6, "  Last raid  ",    text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 1, 6, "  " + lastSweepTxt + "  ", text_color = color.white, bgcolor = color.new(lastSweepCol, 25), text_size = dashSz)
        table.cell(dash, 0, 7, "  Raids graded  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 1, 7, "  " + str.tostring(nGraded) + (nGraded > 0 ? "  avg " + str.tostring(sumScore / nGraded, "#") : "") + "  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 0, 8, "  A / A+ raids  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 1, 8, "  " + str.tostring(nHighGrade) + (nGraded > 0 ? "  (" + str.tostring(100.0 * nHighGrade / nGraded, "#") + "%)" : "") + "  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 0, 9, "  Pools live  ",   text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
        table.cell(dash, 1, 9, "  " + str.tostring(nUp) + " BSL / " + str.tostring(nDn) + " SSL  ", text_color = #cfd8e3, bgcolor = #0e141b, text_size = dashSz)
    else if not na(dash)
        table.delete(dash)
        dash := na

// ═════════════════════════════════════════════════════════════════════════════
// 12 · ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(raidUpNow, "Buy-side sweep (any grade)",  "Buy-side liquidity swept")
alertcondition(raidDnNow, "Sell-side sweep (any grade)", "Sell-side liquidity swept")
alertcondition(raidUpNow and raidUpRank >= 4, "Buy-side sweep A or better",  "Grade-A buy-side liquidity sweep")
alertcondition(raidDnNow and raidDnRank >= 4, "Sell-side sweep A or better", "Grade-A sell-side liquidity sweep")
alertcondition(bullStructNow, "Bullish structure break", "Bullish BOS / CHoCH / MSS")
alertcondition(bearStructNow, "Bearish structure break", "Bearish BOS / CHoCH / MSS")
alertcondition(bullCisdNow,   "Bullish CISD", "Bullish change in state of delivery")
alertcondition(bearCisdNow,   "Bearish CISD", "Bearish change in state of delivery")
