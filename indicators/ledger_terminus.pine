//@version=6
indicator("LEDGER·TERMINUS · Trapped-Crowd Reversal Map", shorttitle = "LEDGER·T", overlay = true, max_boxes_count = 300, max_lines_count = 100, max_labels_count = 100)

// ============================================================================
// LEDGER·TERMINUS — where is today's move most likely to end, and how sure?
//
//   WALLS    LEDGER's trapped-crowd zones. Two zigzag trackers (swing and
//            MAJOR, sized in ADR) build a volume-at-price histogram for every
//            leg; when a leg gives back most of its move, the volume now
//            underwater is a trapped crowd and the zone sits at its
//            volume-weighted breakeven.
//   HOLD     Measured, not assumed. Every zone's first test is graded on this
//            chart: held = a close `reactAdr` ADR back from the zone before an
//            accepted break; failed = accepted break first. Rates are kept per
//            class (side × swing/MAJOR × DOUBLE × trend path × stop fuel ×
//            exhaustion) and each level is shrunk toward the one above it, so
//            thin classes lean on their neighbours.
//   REACH    TERMINUS's reflection-principle model: the chance price touches
//            the zone before the session ends, from the session's own average
//            range scaled by the time left.
//   TERMINUS Survival scan outward from price: a far zone can only end the
//            move if every nearer zone on that side breaks first.
//              P(move ends at zone i) = reach_i × hold_i × Π_nearer (1 − hold_j)
//
// Context that feeds the hold classes: trend day (noise area + leading the
// correlated index), DOUBLE (overlaps a short-term absorption node), stop fuel
// (un-run pivot stops parked in front of the zone), exhaustion (effort vs
// result, CVD and SMT divergence, efficiency collapse).
// The dashboard scores the model against what happened: hold model vs held,
// reach said vs hit. All state changes on confirmed bars; nothing repaints.
// ============================================================================

// ════════════════════════════ INPUTS ════════════════════════════
string GL = "Trapped crowds (walls)"
float legThr   = input.float(0.20, "Swing leg size (× ADR)", minval = 0.05, maxval = 1.0, step = 0.01, group = GL, tooltip = "A swing crowd is everyone who traded during a leg of at least this size. A leg is confirmed once price reverses by the same amount.")
bool  useMajor = input.bool(true, "Track MAJOR crowds", group = GL)
float majThr   = input.float(0.40, "MAJOR leg size (× ADR)", minval = 0.1, maxval = 2.0, step = 0.05, group = GL, tooltip = "Must be larger than the swing size, otherwise MAJOR tracking stays off.")
float failFrac = input.float(0.80, "Trapped after giving back (share of leg)", minval = 0.5, maxval = 1.0, step = 0.05, group = GL, tooltip = "Once price retraces this much of a completed leg, the volume now underwater is a trapped crowd.")
int   binTicks = input.int(8, "Cost-basis bin (ticks)", minval = 1, maxval = 100, group = GL, tooltip = "Price resolution of the volume histograms. On symbols with very fine ticks it is coarsened to at least ADR / 400.")
float widthSig = input.float(0.5, "Zone half-height (× entry spread)", minval = 0.1, maxval = 2.0, step = 0.1, group = GL, tooltip = "Multiple of the standard deviation of the trapped crowd's entry prices.")
float minPct   = input.float(0.02, "Min half-height (% of price)", minval = 0.005, maxval = 0.5, step = 0.005, group = GL)
float maxPct   = input.float(0.12, "Max half-height (% of price)", minval = 0.01, maxval = 1.0, step = 0.01, group = GL)
float pendDays = input.float(5.0, "Forget legs that haven't failed after (days)", minval = 0.5, maxval = 30.0, step = 0.5, group = GL)
int   adrLen   = input.int(14, "ADR / average volume length (days)", minval = 2, group = GL)

string GZ = "Zone lifecycle"
int   maxPerSide = input.int(8, "Max live zones per side", minval = 1, maxval = 20, group = GZ)
float maxAgeD    = input.float(10.0, "Max zone age (days)", minval = 1.0, group = GZ, tooltip = "Counted from the zone's last reinforcement by a new trapped crowd.")
float halfLifeD  = input.float(4.0, "Crowd size half-life (days)", minval = 0.5, group = GZ)
float bandPct    = input.float(6.0, "Distance band (% of price)", minval = 0.5, group = GZ, tooltip = "Zones farther than this from price are dropped.")
int   acceptMin  = input.int(10, "Dies after closes hold beyond it for (minutes)", minval = 1, maxval = 240, group = GZ, tooltip = "Measured from the first close beyond the zone. A sweep that is reclaimed sooner leaves the zone alive.")
float breakMult  = input.float(1.0, "…or at once on a close this far past (× zone height)", minval = 0.25, maxval = 5.0, step = 0.25, group = GZ)
float rollPct    = input.float(12.0, "Contract-roll gap wipe (%)", minval = 2.0, group = GZ, tooltip = "An opening gap this large (a futures roll) resets all zones, legs and stop pools.")

string GH = "Hold rate (measured on this chart)"
float reactAdr = input.float(0.20, "Held = reaction of at least (× ADR)", minval = 0.05, maxval = 2.0, step = 0.05, group = GH, tooltip = "After price first reaches a zone, it has held once a bar closes this far beyond the zone's edge on the rejection side, before an accepted break kills the zone. A break first counts as a failure.")
int   minTests = input.int(20, "Rates count as learned after (tests)", minval = 5, maxval = 200, group = GH, tooltip = "Until then hold rates are mostly the neutral prior and are shown with a ~.")
float fuelZone = input.float(3.0, "Stop fuel reach (× zone half-height)", minval = 0.5, step = 0.5, group = GH, tooltip = "Un-run pivot stops parked within this distance in front of a zone mark it as fuelled.")
int   pivLen   = input.int(5, "Stop-pool pivot length", minval = 2, group = GH)
int   divLen   = input.int(20, "Exhaustion: extreme / divergence lookback", minval = 5, group = GH)
int   erLen    = input.int(10, "Exhaustion: efficiency length", minval = 3, group = GH)

string GR = "Reach model · session"
string tz      = input.string("America/New_York", "Session timezone", group = GR)
int    sStartH = input.int(9, "Session start", minval = 0, maxval = 23, inline = "ss", group = GR)
int    sStartM = input.int(30, ":", minval = 0, maxval = 59, inline = "ss", group = GR)
int    sEndH   = input.int(16, "Session end", minval = 0, maxval = 23, inline = "se", group = GR)
int    sEndM   = input.int(0, ":", minval = 0, maxval = 59, inline = "se", group = GR)
string volSrc  = input.string("Session range", "Reach volatility", options = ["Session range", "Daily range"], group = GR, tooltip = "Session range: the average range of the session itself (falls back to the daily range until 5 full sessions are seen). Daily range: the full-day ADR, which on futures includes the overnight range.")

string GT = "Trend-day context"
bool   useTrend = input.bool(true, "Trend-day classes", group = GT, tooltip = "Intraday charts only. A trend day is price outside its time-of-day noise area, or leading the correlated index. Zones in its path form their own hold-rate classes.")
int    nbDays   = input.int(14, "Noise-area lookback (sessions)", minval = 5, maxval = 30, group = GT)
float  nbMult   = input.float(1.0, "Noise-area width (×)", minval = 0.5, maxval = 3.0, step = 0.1, group = GT)
bool   useDiv   = input.bool(true, "Also flag a trend when leading the correlated index", group = GT)
bool   useSMT   = input.bool(true, "Use SMT divergence in exhaustion", group = GT)
bool   corrAuto = input.bool(true, "Auto-pick the correlated index", group = GT, tooltip = "NQ on S&P charts (ES, MES, SPX, SPY…), ES on everything else. Turn off to use the symbol below.")
string corrIn   = input.symbol("CME_MINI:ES1!", "Correlated index", group = GT)
float  betaIn   = input.float(0.0, "Normal move ratio (this / correlated, 0 = auto)", minval = 0.0, maxval = 4.0, step = 0.05, group = GT, tooltip = "0 estimates it from the two symbols' average daily range in %. NQ vs ES is typically 1.2 to 1.35.")
float  divPct   = input.float(0.40, "Divergence threshold (% of price)", minval = 0.05, maxval = 3.0, step = 0.05, group = GT)

string G1 = "Short-term absorption nodes (DOUBLE)"
bool   showShort = input.bool(false, "Draw the absorption nodes", group = G1)
string epochTF   = input.timeframe("1D", "Epoch (node birth cadence)", group = G1)
int    nBins     = input.int(48, "Profile bins per epoch", minval = 12, maxval = 200, group = G1)
float  peakMult  = input.float(1.35, "Peak threshold (x mean density)", minval = 1.0, step = 0.05, group = G1)
int    topK      = input.int(3, "Nodes born per epoch", minval = 1, maxval = 10, group = G1)
float  wCalmPct  = input.float(0.068, "Node height % of price (calm)", minval = 0.005, step = 0.001, group = G1)
float  wVolPct   = input.float(0.102, "Node height % of price (volatile)", minval = 0.005, step = 0.001, group = G1)
int    maxNodes  = input.int(60, "Max live nodes", minval = 5, maxval = 150, group = G1)
float  nodeAgeD  = input.float(20.0, "Max node age (days)", minval = 1.0, group = G1)
float  nodeBand  = input.float(10.0, "Node distance band (% of price)", minval = 1.0, group = G1)
int    hmmLen    = input.int(100, "Regime: range baseline length", minval = 20, group = G1)
float  muC       = input.float(-0.25, "Regime: calm state mean", step = 0.05, group = G1)
float  sdC       = input.float(0.45, "Regime: calm state sd", minval = 0.05, step = 0.05, group = G1)
float  muV       = input.float(0.45, "Regime: volatile state mean", step = 0.05, group = G1)
float  sdV       = input.float(0.60, "Regime: volatile state sd", minval = 0.05, step = 0.05, group = G1)
float  pStay     = input.float(0.98, "Regime: state persistence", minval = 0.5, maxval = 0.999, step = 0.005, group = G1)

string G6 = "Display · structure"
bool  showZones  = input.bool(true, "Zones", group = G6)
bool  showProj   = input.bool(true, "Terminus projection + readout", group = G6)
bool  showLadder = input.bool(true, "Probability ladder", group = G6)
bool  showExp    = input.bool(true, "Expected reversal price (dotted)", group = G6)
bool  showTrail  = input.bool(false, "Terminus trail (historical levels)", group = G6)
int   ladderMax  = input.int(3, "Ladder rows per side", minval = 1, maxval = 8, group = G6)
float minProb    = input.float(4.0, "Ladder threshold (% probability)", minval = 0.5, maxval = 50.0, step = 0.5, group = G6)
int   rightPad   = input.int(6, "Zone extension (bars past price)", minval = 0, maxval = 60, group = G6)

string G7 = "Display · dashboard & palette"
bool   showTable = input.bool(true, "Dashboard", group = G7)
bool   tblFull   = input.bool(true, "Full detail (off = compact)", group = G7)
string tblPos    = input.string(position.top_right, "Dashboard position", options = [position.top_right, position.middle_right, position.bottom_right, position.top_left, position.bottom_left], group = G7)
string tblSize   = input.string(size.small, "Dashboard text size", options = [size.tiny, size.small, size.normal], group = G7)
color  colRes    = input.color(color.rgb(199, 106, 114), "Upside walls (trapped buyers)", group = G7)
color  colSup    = input.color(color.rgb(86, 166, 154), "Downside walls (trapped sellers)", group = G7)
color  colDbl    = input.color(color.rgb(255, 215, 0), "DOUBLE", group = G7)
color  colNeut   = input.color(color.rgb(120, 132, 148), "Dormant structure", group = G7)
color  colPanel  = input.color(color.rgb(14, 17, 22), "Panel background", group = G7)

string G8 = "Alerts"
float alertThr   = input.float(50.0, "Terminus alert threshold (% probability)", minval = 1.0, maxval = 99.0, step = 1.0, group = G8) / 100.0
bool  alertTouch = input.bool(true, "alert() on the first test of a zone", group = G8, tooltip = "Fires through an alert set to 'Any alert() function call'.")
bool  alertNew   = input.bool(false, "alert() when a new zone forms", group = G8)

// ════════════════════════════ CONSTANTS ════════════════════════════
float  DAY_MS   = 86400000.0
int    MAP_CAP  = 40000     // Pine maps hold at most 50,000 keys
float  PRIOR_K  = 8.0       // pseudo-tests each hold-rate level borrows from the level above it
float  NEAR_ADR = 0.25      // within this many ADR the current exhaustion reading describes the arrival
float  loPct    = math.min(minPct, maxPct)
float  hiPct    = math.max(minPct, maxPct)
bool   majOn    = useMajor and majThr > legThr
color  colTxt   = color.rgb(226, 232, 240)
color  colDim   = color.rgb(126, 137, 153)
color  colSect  = color.rgb(24, 29, 37)
string MONO     = font.family_monospace

// the correlated index must be a different market: NQ for the S&P family, ES for everything else
string chartRoot = syminfo.root
bool   chartIsSP = chartRoot == "ES" or chartRoot == "MES" or chartRoot == "SP" or chartRoot == "SPX" or chartRoot == "SPY" or chartRoot == "VOO" or chartRoot == "IVV" or chartRoot == "XSP" or chartRoot == "US500" or chartRoot == "SPX500" or chartRoot == "SPX500USD"
string corrSym   = corrAuto ? (chartIsSP ? "CME_MINI:NQ1!" : "CME_MINI:ES1!") : corrIn
array<string> corrParts = str.split(corrSym, ":")
string corrName  = corrParts.size() > 0 ? corrParts.last() : corrSym
bool   corrOk    = corrName != syminfo.ticker
bool   divOn     = useDiv and corrOk
bool   smtOn     = useSMT and corrOk

// ════════════════════════════ TYPES ════════════════════════════
// short-term absorption node (DOUBLE confirmation)
type Node
    float p
    float m
    float w
    int   t
    int   side
    box   bx

// trapped-crowd zone; side 1 = trapped buyers above price (upside wall), -1 = trapped sellers below
type Zone
    float p
    float w
    float sd
    int   side
    int   t
    float q
    int   spanS
    int   spanE
    int   bornBar
    int   horizon = 0
    bool  stacked = false
    int   crowds  = 1
    int   beyondT = 0
    bool  touched = false
    bool  spent   = false
    bool  dbl     = false
    bool  inPath  = false
    bool  fuel    = false
    int   cell    = -1
    bool  graded  = false
    float prob    = 0.0
    float hold    = na
    box   bx

// zigzag state at one crowd size; A = volume by price from the leg start to its extreme, B = after the extreme
type Tracker
    int   scale
    int   dir    = 0
    bool  primed = false
    float legS   = na
    float extP   = na
    int   startT = 0
    int   extT   = 0
    map<int, float> A
    map<int, float> B

// completed leg with the volume-by-price histogram of its crowd
type Leg
    int   d
    float S
    float E
    int   tS
    int   tE
    int   t
    int   scale
    map<int, float> hist

// Zone field notes: p = the crowd's volume-weighted breakeven, w = half-height, sd = spread of its entries,
// t = last reinforcement (decay and age clock), q = trapped volume as of t, spanS/spanE = time span of the
// volume behind the zone (so merges don't count the same traders twice), horizon 0 = swing / 1 = MAJOR,
// stacked = reinforced by the other crowd size, crowds = distinct crowds merged in, beyondT = time closes
// beyond it began (0 = not beyond), spent = reacted after a test (its crowd got out), fuel = un-run stops
// parked in front of it, cell = hold-rate cell locked at the first test, prob / hold = last scan.
// Tracker.primed: the first leg's true start is unknown, so it is never emitted.

// ════════════════════════════ DATA ════════════════════════════
[adr, adv, adrPct, pdh, pdl] = request.security(syminfo.tickerid, "D", [ta.sma(high - low, adrLen)[1], ta.sma(volume, adrLen)[1], ta.sma((high - low) / close, adrLen)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
float corrAdrPct = request.security(corrSym, "D", ta.sma((high - low) / close, adrLen)[1], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[oO, oC, smtHiGap, smtLoGap] = request.security(corrSym, timeframe.period, [open, close, ta.highest(high, divLen) - high, low - ta.lowest(low, divLen)], ignore_invalid_symbol = true)

float beta   = betaIn > 0 ? betaIn : nz(corrAdrPct) > 0 and nz(adrPct) > 0 ? adrPct / corrAdrPct : na
bool  hasVol = ta.cum(nz(volume)) > 0
float wBar   = hasVol ? nz(volume) : 1.0      // symbols without volume weight every bar equally

// ════════════════════════════ STATE ════════════════════════════
var array<Node>  nodes = array.new<Node>()
var array<float> epP   = array.new<float>()
var array<float> epW   = array.new<float>()
var array<Zone>  zones = array.new<Zone>()
var array<Leg>   pend  = array.new<Leg>()
var array<float> resH  = array.new<float>()
var array<float> resL  = array.new<float>()
var Tracker trkS = Tracker.new(scale = 0, A = map.new<int, float>(), B = map.new<int, float>())
var Tracker trkM = Tracker.new(scale = 1, A = map.new<int, float>(), B = map.new<int, float>())
// hold rates: 64 cells = class (16: side × swing/MAJOR × DOUBLE × trend path) × stop fuel × exhaustion
var array<int>   cN = array.new<int>(64, 0)
var array<int>   cW = array.new<int>(64, 0)
// reach calibration: pending hourly predictions, scored at the session end into 10 probability bins
var array<float> rkP   = array.new<float>()
var array<float> rkE   = array.new<float>()
var array<int>   rkS   = array.new<int>()
var array<bool>  rkHit = array.new<bool>()
var array<float> rbN   = array.new<float>(10, 0.0)
var array<float> rbP   = array.new<float>(10, 0.0)
var array<float> rbH   = array.new<float>(10, 0.0)

// histogram bin, fixed once for the whole chart so bin keys stay comparable
var float binSz = na
if na(binSz) and nz(adr) > 0
    binSz := syminfo.mintick * math.max(binTicks, math.ceil(adr / 400.0 / syminfo.mintick))

// ════════════════════════════ FUNCTIONS ════════════════════════════
f_phi(float x) =>
    float t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    float d = 0.3989422804 * math.exp(-x * x / 2.0)
    float q = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))))
    x >= 0 ? 1.0 - q : q

// chance a driftless walk with this much volatility left touches a level d away (reflection principle)
f_reach(float d, float s) =>
    s > 0 ? math.min(1.0, 2.0 * (1.0 - f_phi(d / s))) : 0.0

f_gauss(float x, float mu, float sd) =>
    math.exp(-0.5 * math.pow((x - mu) / sd, 2)) / sd

// median first-passage time in bars
f_eta(float d, float sb) =>
    sb > 0 ? math.pow(d / (0.6745 * sb), 2) : na

f_fmtMin(float bars) =>
    float m = bars * timeframe.in_seconds() / 60.0
    na(bars) ? "-" : m < 1.0 ? "AT ZONE" : m < 60.0 ? str.tostring(m, "#") + "m" : str.tostring(m / 60.0, "#.#") + "h"

// one decimal below ~10% so small probabilities stay distinguishable
f_pct(float x) =>
    na(x) ? "-" : str.tostring(x * 100.0, math.abs(x) < 0.095 ? "0.#" : "#") + "%"

f_px(float x) =>
    na(x) ? "-" : str.tostring(x, format.mintick)

// distance in units of the volatility still available
f_sig(float d, float s) =>
    na(d) or s <= 0 ? "-" : str.tostring(d / s, "#.##") + "σ"

// five-segment meter
f_gauge(float v) =>
    int n = na(v) ? 0 : int(math.round(math.max(0.0, math.min(1.0, v)) * 5.0))
    string s = ""
    for i = 1 to 5
        s += i <= n ? "▰" : "▱"
    s

f_put(map<int, float> m, int k, float v) =>
    if m.size() < MAP_CAP or m.contains(k)
        m.put(k, nz(m.get(k)) + v)
    true

// spread one bar's weight over its range: exact overlap for up to 16 bins, 16 even slices beyond that
f_addBar(map<int, float> m, float bsz, float v) =>
    float rng = high - low
    int k0 = int(math.floor(low / bsz))
    int k1 = int(math.floor(high / bsz))
    if rng <= 0 or k0 == k1
        f_put(m, k0, v)
    else if k1 - k0 < 16
        for k = k0 to k1
            float ov = math.min(high, (k + 1) * bsz) - math.max(low, k * bsz)
            if ov > 0
                f_put(m, k, v * ov / rng)
    else
        for s = 0 to 15
            f_put(m, int(math.floor((low + (s + 0.5) * rng / 16.0) / bsz)), v / 16.0)
    true

f_merge(map<int, float> dst, map<int, float> src) =>
    for [k, v] in src
        f_put(dst, k, v)
    true

// advance one tracker by one confirmed bar; returns the leg that just completed, or na
f_track(Tracker z, float thr, float bsz, float v) =>
    Leg done = na
    if z.dir == 0
        z.dir    := close >= open ? 1 : -1
        z.legS   := z.dir == 1 ? low : high
        z.extP   := z.dir == 1 ? high : low
        z.startT := time
        z.extT   := time
        f_addBar(z.A, bsz, v)
    else if (z.dir == 1 ? high > z.extP : low < z.extP)
        // new extreme: everything traded since the old one joins the leg
        f_merge(z.A, z.B)
        z.B.clear()
        f_addBar(z.A, bsz, v)
        z.extP := z.dir == 1 ? high : low
        z.extT := time
    else
        f_addBar(z.B, bsz, v)
        // the first bar to reach thr against the leg is also the furthest bar since the extreme,
        // so its low (high) is where the new leg's extreme starts
        float counter = z.dir == 1 ? low : high
        if z.dir * (z.extP - counter) >= thr
            if z.primed
                done := Leg.new(d = z.dir, S = z.legS, E = z.extP, tS = z.startT, tE = z.extT, t = time, scale = z.scale, hist = z.A)
            z.primed := true
            z.dir    := -z.dir
            z.legS   := z.extP
            z.startT := z.extT
            z.extP   := counter
            z.extT   := time
            z.A      := z.B
            z.B      := map.new<int, float>()
    done

f_resetTracker(Tracker z) =>
    z.dir    := 0
    z.primed := false
    z.A.clear()
    z.B.clear()
    true

f_mass(Zone z) =>
    z.q * math.pow(0.5, (time - z.t) / DAY_MS / halfLifeD)

f_score(Zone z) =>
    f_mass(z) * (z.spent ? 0.3 : 1.0)

f_half(float sd) =>
    math.max(close * loPct / 100.0, math.min(close * hiPct / 100.0, widthSig * sd))

f_killZone(int i) =>
    Zone gone = zones.remove(i)
    if not na(gone.bx)
        box.delete(gone.bx)
    true

f_killNode(int i) =>
    Node gone = nodes.remove(i)
    if not na(gone.bx)
        box.delete(gone.bx)
    true

// a pending leg just failed: price its trapped crowd, then file a new zone or reinforce an overlapping one
f_trap(Leg L) =>
    // only the volume now underwater is trapped: above this bar's low for a failed rally, below its high for a failed selloff
    float cut = L.d == 1 ? low : high
    float sv  = 0.0
    float s1  = 0.0
    float s2  = 0.0
    map<int, float> h = L.hist
    for [k, vv] in h
        float pr = (k + 0.5) * binSz
        if L.d * (pr - cut) > 0
            float x = pr - L.E    // moments about the extreme stay well-conditioned at any price level
            sv += vv
            s1 += x * vv
            s2 += x * x * vv
    if sv > 0
        float mu   = s1 / sv
        float vw   = L.E + mu
        float sdv  = math.sqrt(math.max(s2 / sv - mu * mu, 0.0))
        float half = f_half(sdv)
        bool  isClear = L.d == 1 ? close < vw - half : close > vw + half
        bool  isNear  = math.abs(vw - close) / close * 100.0 <= bandPct
        if isClear and isNear
            int mi = -1
            for [j, zz] in zones
                if zz.side == L.d and not zz.spent and math.abs(zz.p - vw) <= zz.w + half
                    mi := j
                    break
            if mi >= 0
                Zone  zm = zones.get(mi)
                float m0 = f_mass(zm)
                // a swing leg inside a MAJOR leg is the same traders: overlap takes the larger count instead of the sum
                bool  overlap = L.tS < zm.spanE and zm.spanS < L.tE
                float wt = m0 + sv
                float pN = (m0 * zm.p + sv * vw) / wt
                float vN = (m0 * (zm.sd * zm.sd + math.pow(zm.p - pN, 2)) + sv * (sdv * sdv + math.pow(vw - pN, 2))) / wt
                float sN = math.sqrt(math.max(vN, 0.0))
                float wN = f_half(sN)
                // re-centre on the pooled crowd unless that would drop the zone onto price
                if (L.d == 1 ? close < pN - wN : close > pN + wN)
                    zm.p  := pN
                    zm.sd := sN
                    zm.w  := wN
                    if not na(zm.bx)
                        box.set_top(zm.bx, pN + wN)
                        box.set_bottom(zm.bx, pN - wN)
                zm.q     := overlap ? math.max(m0, sv) : wt
                zm.t     := time
                zm.spanS := math.min(zm.spanS, L.tS)
                zm.spanE := math.max(zm.spanE, L.tE)
                if zm.horizon != L.scale
                    zm.stacked := true
                zm.horizon := math.max(zm.horizon, L.scale)
                if not overlap
                    zm.crowds := zm.crowds + 1
            else
                box bx = na
                if showZones
                    // born neutral; the last-bar pass re-weights every zone by live probability
                    bx := box.new(bar_index, vw + half, bar_index + 1, vw - half, border_color = color.new(colNeut, 100), border_width = 0, bgcolor = color.new(colNeut, 94), extend = extend.none)
                zones.push(Zone.new(p = vw, w = half, sd = sdv, side = L.d, t = time, q = sv, spanS = L.tS, spanE = L.tE, bornBar = bar_index, horizon = L.scale, bx = bx))
                if alertNew
                    alert("LEDGER·T: new " + (L.scale == 1 ? "MAJOR" : "swing") + (L.d == 1 ? " upside wall (trapped buyers) at " : " downside wall (trapped sellers) at ") + f_px(vw) + " on " + syminfo.ticker, alert.freq_once_per_bar_close)
    true

f_heavy(Zone z) =>
    z.horizon == 1 or z.stacked or z.crowds > 1

// hold-rate class: side × size × DOUBLE × trend path (0-15)
f_cls(Zone z) =>
    (z.side == 1 ? 0 : 8) + (f_heavy(z) ? 4 : 0) + (z.dbl ? 2 : 0) + (z.inPath ? 1 : 0)

f_clsName(int c) =>
    string s = (c >= 8 ? "downside" : "upside") + " · " + (c % 8 >= 4 ? "MAJOR/stacked" : "swing")
    if c % 4 >= 2
        s += " · DOUBLE"
    if c % 2 == 1
        s += " · trend path"
    s

// Lock a zone's hold-rate cell at its first test. Class and stop fuel come from the last confirmed bar,
// before this bar swept anything; exhaustion is read on the test bar itself.
f_lock(Zone z, bool exh) =>
    z.cell := f_cls(z) * 4 + (z.fuel ? 2 : 0) + (exh ? 1 : 0)
    true

f_grade(Zone z, bool held) =>
    cN.set(z.cell, cN.get(z.cell) + 1)
    if held
        cW.set(z.cell, cW.get(z.cell) + 1)
    z.graded := true
    true

// Hold-rate estimate. Each level is shrunk toward the one above it: chart-wide -> class pooled over side
// -> class -> + stop fuel -> + exhaustion (only when price is near enough for the current exhaustion
// reading to describe the arrival). With no history every zone starts at 50%.
f_rate(int c16, bool fuel, bool exh, bool near) =>
    float nAll = cN.sum()
    float wAll = cW.sum()
    int   c8   = c16 % 8
    float n8   = 0.0
    float w8   = 0.0
    float n16  = 0.0
    float w16  = 0.0
    for m = 0 to 3
        n8  += cN.get(c8 * 4 + m) + cN.get((c8 + 8) * 4 + m)
        w8  += cW.get(c8 * 4 + m) + cW.get((c8 + 8) * 4 + m)
        n16 += cN.get(c16 * 4 + m)
        w16 += cW.get(c16 * 4 + m)
    int   f0   = c16 * 4 + (fuel ? 2 : 0)
    float n32  = cN.get(f0) + cN.get(f0 + 1)
    float w32  = cW.get(f0) + cW.get(f0 + 1)
    int   c64  = f0 + (exh ? 1 : 0)
    float pAll = (wAll + 1.0) / (nAll + 2.0)
    float p8   = (w8 + PRIOR_K * pAll) / (n8 + PRIOR_K)
    float p16  = (w16 + PRIOR_K * p8) / (n16 + PRIOR_K)
    float p32  = (w32 + PRIOR_K * p16) / (n32 + PRIOR_K)
    near ? (cW.get(c64) + PRIOR_K * p32) / (cN.get(c64) + PRIOR_K) : p32

// a zone under test keeps the cell it was locked into; an untested zone is priced from its features now
f_hold(Zone z, bool exh, bool near) =>
    int c16 = z.cell >= 0 ? int(math.floor(z.cell / 4.0)) : f_cls(z)
    bool fu = z.cell >= 0 ? z.cell % 4 >= 2 : z.fuel
    bool ex = z.cell >= 0 ? z.cell % 2 == 1 : exh
    f_rate(c16, fu, ex, z.cell >= 0 or near)

f_learning() =>
    cN.sum() < minTests

f_hPct(float h) =>
    (f_learning() ? "~" : "") + f_pct(h)

f_tag(Zone z) =>
    string s = z.stacked ? "STACKED" : z.horizon == 1 ? "MAJOR" : "swing"
    if z.crowds > 1
        s += " ×" + str.tostring(z.crowds)
    if z.inPath
        s += " · trend path"
    if z.dbl
        s += " · DOUBLE"
    if z.fuel
        s += " · stops"
    if z.touched
        s += " · tested"
    s

f_crowd(Zone z) =>
    nz(adv) > 0 ? str.tostring(f_mass(z) / adv * 100.0, "0") + "% ADV trapped" : "crowd " + str.tostring(f_mass(z), "#.#")

f_holdTip(Zone z) =>
    int   c16  = z.cell >= 0 ? int(math.floor(z.cell / 4.0)) : f_cls(z)
    float n16  = 0.0
    float w16  = 0.0
    for m = 0 to 3
        n16 += cN.get(c16 * 4 + m)
        w16 += cW.get(c16 * 4 + m)
    float nAll = cN.sum()
    float wAll = cW.sum()
    float h    = nz(z.hold, 0.5)
    float se   = math.sqrt(h * (1.0 - h) / (n16 + PRIOR_K))
    string rng = str.tostring(math.max(h - 1.2816 * se, 0.0) * 100.0, "0") + "–" + str.tostring(math.min(h + 1.2816 * se, 1.0) * 100.0, "0") + "%"
    string head = f_learning() ? "Still learning: " + str.tostring(nAll, "0") + " of " + str.tostring(minTests) + " tests graded, so this is mostly the 50% prior.\n" : "Chance this zone holds: " + f_pct(h) + " (80% range " + rng + ")\n"
    head + "Class: " + f_clsName(c16) + (z.fuel ? " · stop fuel" : "") + "\nThis class held " + str.tostring(w16, "0") + " of " + str.tostring(n16, "0") + " tests on this chart; all zones " + str.tostring(wAll, "0") + " of " + str.tostring(nAll, "0") + ".\nHeld = a close " + str.tostring(reactAdr, "0.00") + " ADR beyond the zone on the rejection side before an accepted break."

// Survival scan outward from price on one side. Zones whose crowd already got out (spent) are skipped,
// and so are zones price is already past by the decisive-break distance (they die at this bar's close;
// keeping them would flicker the terminus onto a dead level). A zone price is sweeping without a
// decisive break stays in at distance 0: it is being tested, not yet broken.
f_scan(int sd, float px, float sRem, bool exh, float nearD) =>
    array<float> dist = array.new<float>()
    array<int>   idx  = array.new<int>()
    for [i, z] in zones
        if z.side == sd
            z.prob := 0.0
            float farE   = sd == 1 ? z.p + z.w : z.p - z.w
            bool  broken = sd * (px - farE) > breakMult * 2.0 * z.w
            if not z.spent and not broken
                float edge = sd == 1 ? z.p - z.w : z.p + z.w
                dist.push(math.max(0.0, sd * (edge - px)))
                idx.push(i)
    float surv  = 1.0
    float bestP = 0.0
    int   bestI = -1
    float sumP  = 0.0
    float sumPX = 0.0
    if dist.size() > 0
        array<int> ord = dist.sort_indices(order.ascending)
        for j = 0 to ord.size() - 1
            int   k   = ord.get(j)
            Zone  z   = zones.get(idx.get(k))
            float gap = dist.get(k)
            float h   = f_hold(z, exh, gap <= nearD)
            float pr  = f_reach(gap, sRem) * h * surv
            z.hold := h
            z.prob := pr
            surv   *= (1.0 - h)
            sumP   += pr
            sumPX  += pr * z.p
            if pr > bestP
                bestP := pr
                bestI := idx.get(k)
    [bestI, bestP, sumP > 0 ? sumPX / sumP : na, 1.0 - sumP]

// ── dashboard cells ──
f_sec(table tb, int r, string s) =>
    table.cell(tb, 0, r, s, text_color = colTxt, text_size = tblSize, text_halign = text.align_left, bgcolor = colSect, text_font_family = MONO)
    table.cell(tb, 1, r, "", bgcolor = colSect)
    table.cell(tb, 2, r, "", bgcolor = colSect)

f_row(table tb, int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = colDim, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
    table.cell(tb, 1, r, v, text_color = c, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)
    table.cell(tb, 2, r, "", text_size = tblSize)

f_rowG(table tb, int r, string k, string v, color c, float g) =>
    table.cell(tb, 0, r, k, text_color = colDim, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
    table.cell(tb, 1, r, v, text_color = c, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)
    table.cell(tb, 2, r, f_gauge(g), text_color = color.new(c, 35), text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)

// ════════════════════════════ CORE SERIES ════════════════════════════
float atrS = ta.atr(14)
float atrL = ta.atr(200)

// Session clock — handles windows that cross midnight
int yy = year(time, tz)
int mo = month(time, tz)
int dd = dayofmonth(time, tz)
int sS = timestamp(tz, yy, mo, dd, sStartH, sStartM)
int sE = timestamp(tz, yy, mo, dd, sEndH, sEndM)
if sE <= sS
    if time < sE
        sS -= 86400000      // we are in the tail of yesterday's session
    else
        sE += 86400000      // session runs on into tomorrow
// session length in minutes; start == end means a 24-hour session
int  sessMin0 = ((sEndH * 60 + sEndM) - (sStartH * 60 + sStartM) + 1440) % 1440
int  sessMin  = sessMin0 == 0 ? 1440 : sessMin0
bool inSess   = time >= sS and time < sE
// a date change also starts a session: session-only charts have no bar between sessions
bool sessNew  = inSess and (not inSess[1] or sS != sS[1])
bool sessEnd  = inSess[1] and (not inSess or sS != sS[1])
// the scan prices off `close`, so the horizon runs from this bar's close
float tauRem  = inSess ? math.max(0.0, float(sE - nz(time_close, time))) / float(sE - sS) : 1.0

// Volatility regime from session bars only. On charts that include the overnight, a 200-bar ATR at the
// session open is mostly quiet overnight bars, which inflated this ratio (and every reach) at each open.
float trNow = ta.tr(true)
var float trFast = na
var float trSlow = na
var int   trN    = 0
if inSess
    trFast := na(trFast) ? trNow : trFast + (trNow - trFast) / 14.0
    trSlow := na(trSlow) ? trNow : trSlow + (trNow - trSlow) / 200.0
    trN    += 1
bool  trReady  = inSess and trN >= 200 and nz(trSlow) > 0
float volScale = trReady ? math.max(0.6, math.min(1.8, trFast / trSlow)) : 1.0

bool intraday = timeframe.isintraday
bool ctxOn    = useTrend and intraday
int  nbCols   = math.max(sessMin, 1)
int  sessCol  = inSess ? int(math.floor((time - sS) / 60000.0)) : na

// Session bookkeeping: average session range (reach volatility) and the noise area (trend days)
var array<float>  sRanges = array.new<float>()
var matrix<float> nbM     = matrix.new<float>(30, nbCols, na)
var array<float>  curMv   = array.new<float>(nbCols, na)
var int   nbRow    = 0
var int   nbFilled = 0
var float sOpen    = na
var float oOpen    = na
var float sHi      = na
var float sLo      = na
if sessEnd and barstate.isconfirmed and not na(sOpen)
    // only sessions seen from their first bar count
    sRanges.push(sHi - sLo)
    if sRanges.size() > adrLen
        sRanges.shift()
    if ctxOn
        for c = 0 to nbCols - 1
            nbM.set(nbRow, c, curMv.get(c))
        nbRow    := (nbRow + 1) % nbDays
        nbFilled := math.min(nbFilled + 1, nbDays)
if sessEnd and barstate.isconfirmed
    for c = 0 to nbCols - 1
        curMv.set(c, na)
if sessNew
    sOpen := time - sS <= math.max(timeframe.in_seconds() * 1000, 900000) ? open : na
    oOpen := oO
    sHi   := high
    sLo   := low
else if inSess
    sHi := math.max(sHi, high)
    sLo := math.min(sLo, low)

float avgSessR   = sRanges.size() >= 5 ? sRanges.avg() : na
bool  useSessSig = volSrc == "Session range" and inSess and not na(avgSessR)
float sigDay     = useSessSig ? avgSessR / 1.596 : nz(adr) / 1.596
float sigRem     = sigDay * math.sqrt(math.max(tauRem, 0.02)) * volScale
float sigBar     = (trReady ? trSlow : nz(atrL, nz(atrS))) / 1.596 * volScale

// Regime HMM (2-state forward filter on log range ratio) — sizes the absorption nodes
float rngNow  = high - low
float bodyAbs = math.abs(close - open)
float rngBase = ta.sma(rngNow, hmmLen)
float xr = na
if not na(rngBase)
    xr := math.log(math.max(rngNow, syminfo.mintick) / math.max(rngBase, syminfo.mintick))
var float pV = 0.5
if not na(xr)
    float priC = (1.0 - pV) * pStay + pV * (1.0 - pStay)
    float priV = pV * pStay + (1.0 - pV) * (1.0 - pStay)
    float aC  = priC * f_gauss(xr, muC, sdC)
    float aVv = priV * f_gauss(xr, muV, sdV)
    if aC + aVv > 0
        pV := aVv / (aC + aVv)
bool isVolatile = bar_index > hmmLen and pV > 0.5

// Exhaustion: effort vs result, CVD divergence, SMT divergence, efficiency collapse
float effR  = wBar / (bodyAbs + 0.1 * nz(atrS, rngNow) + syminfo.mintick)
float effMu = ta.sma(effR, 50)
float effSd = ta.stdev(effR, 50)
float effZ  = nz(effSd) > 0 ? (effR - nz(effMu)) / effSd : 0.0
float cA    = 1.0 / (1.0 + math.exp(-(effZ - 1.0)))
float cAr   = ta.highest(cA, 5)
float clv   = rngNow > 0 ? (2.0 * close - high - low) / rngNow : 0.0
var float cvd = 0.0
cvd += wBar * clv
bool  newHi   = high >= ta.highest(high, divLen)
bool  newLo   = low <= ta.lowest(low, divLen)
float cvdHi   = ta.highest(cvd, divLen)
float cvdLo   = ta.lowest(cvd, divLen)
bool  bearDiv = newHi and cvd < nz(cvdHi, cvd)
bool  bullDiv = newLo and cvd > nz(cvdLo, cvd)
bool  bearSmt = smtOn and newHi and not na(smtHiGap) and smtHiGap > 0
bool  bullSmt = smtOn and newLo and not na(smtLoGap) and smtLoGap > 0
bool  bearDivR = nz(ta.barssince(bearDiv), 999) <= 5
bool  bullDivR = nz(ta.barssince(bullDiv), 999) <= 5
bool  bearSmtR = nz(ta.barssince(bearSmt), 999) <= 5
bool  bullSmtR = nz(ta.barssince(bullSmt), 999) <= 5
float erDen = math.sum(math.abs(close - close[1]), erLen)
float er    = nz(erDen) > 0 ? math.abs(close - close[erLen]) / erDen : 0.5
float erMA  = ta.sma(er, erLen)
bool  erLow = er < nz(erMA, er)
float wSum  = 3.0 + (smtOn ? 1.0 : 0.0)
float eUp   = (nz(cAr) + (bearDivR ? 1.0 : 0.0) + (bearSmtR ? 1.0 : 0.0) + (erLow ? 1.0 : 0.0)) / wSum
float eDn   = (nz(cAr) + (bullDivR ? 1.0 : 0.0) + (bullSmtR ? 1.0 : 0.0) + (erLow ? 1.0 : 0.0)) / wSum
bool  exhUp = eUp >= 0.5
bool  exhDn = eDn >= 0.5

// Pivots feed the stop pools
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
bool dayChange = timeframe.change("1D")
bool newEpoch  = timeframe.change(epochTF)

// ════════════════════════════ CONTRACT-ROLL WIPE ════════════════════════════
bool rollGap = not na(close[1]) and close[1] > 0 and math.abs(open - close[1]) / close[1] * 100.0 > rollPct
if rollGap and barstate.isconfirmed
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            f_killZone(i)
    if nodes.size() > 0
        for i = nodes.size() - 1 to 0
            f_killNode(i)
    pend.clear()
    f_resetTracker(trkS)
    f_resetTracker(trkM)
    resH.clear()
    resL.clear()
    epP.clear()
    epW.clear()

// ════════════════════════════ STOP POOLS ════════════════════════════
if resH.size() > 0
    for i = resH.size() - 1 to 0
        if high > resH.get(i)
            resH.remove(i)
if resL.size() > 0
    for i = resL.size() - 1 to 0
        if low < resL.get(i)
            resL.remove(i)
if not na(ph)
    resH.push(ph)
if not na(pl)
    resL.push(pl)
if dayChange and not na(pdh) and pdh > high
    resH.push(pdh)
if dayChange and not na(pdl) and pdl < low
    resL.push(pdl)
while resH.size() > 80
    resH.shift()
while resL.size() > 80
    resL.shift()

// ════════════════════════════ SHORT-TERM ABSORPTION NODES ════════════════════════════
if newEpoch and barstate.isconfirmed and epP.size() > 20
    float lo = epP.min()
    float hi = epP.max()
    float bs = (hi - lo) / nBins
    if bs > 0
        array<float> prof = array.new<float>(nBins, 0.0)
        float tot = 0.0
        for i = 0 to epP.size() - 1
            int b = math.max(0, math.min(nBins - 1, int(math.floor((epP.get(i) - lo) / bs))))
            prof.set(b, prof.get(b) + epW.get(i))
            tot += epW.get(i)
        if tot > 0
            array<float> smo = array.new<float>(nBins, 0.0)
            for b = 0 to nBins - 1
                float lv = b > 0 ? prof.get(b - 1) : prof.get(b)
                float rv = b < nBins - 1 ? prof.get(b + 1) : prof.get(b)
                smo.set(b, 0.25 * lv + 0.5 * prof.get(b) + 0.25 * rv)
            float meanSm = smo.avg()
            array<float> pkP = array.new<float>()
            array<float> pkM = array.new<float>()
            for b = 1 to nBins - 2
                float v = smo.get(b)
                if v >= smo.get(b - 1) and v > smo.get(b + 1) and v > meanSm * peakMult
                    float w0 = prof.get(b - 1)
                    float w1 = prof.get(b)
                    float w2 = prof.get(b + 1)
                    float ws = w0 + w1 + w2
                    if ws > 0
                        float c0 = lo + (b - 0.5) * bs
                        float c1 = lo + (b + 0.5) * bs
                        float c2 = lo + (b + 1.5) * bs
                        pkP.push((w0 * c0 + w1 * c1 + w2 * c2) / ws)
                        pkM.push(ws / tot * nBins / 3.0)
            if pkM.size() > 0
                array<int> ordPk = pkM.sort_indices(order.descending)
                int take = math.min(topK, ordPk.size())
                float hgt = close * (isVolatile ? wVolPct : wCalmPct) / 100.0
                for j = 0 to take - 1
                    int q = ordPk.get(j)
                    float np = pkP.get(q)
                    float nm = pkM.get(q)
                    bool inBand = math.abs(np - close) / close * 100.0 <= nodeBand
                    bool merged = false
                    if inBand
                        for e in nodes
                            if math.abs(e.p - np) <= e.w
                                // decay the standing mass to now before adding fresh mass, then re-base the clock
                                float dec = math.pow(0.5, ((time - e.t) / DAY_MS) / halfLifeD)
                                e.m := math.min(e.m * dec + 0.5 * nm, 12.0)
                                e.t := time
                                merged := true
                                break
                    if inBand and not merged and math.abs(np - close) > hgt / 2.0
                        if nodes.size() >= maxNodes
                            int lowI = 0
                            float lowM = 1e10
                            for [k, ek] in nodes
                                float mk = ek.m * math.pow(0.5, ((time - ek.t) / DAY_MS) / halfLifeD)
                                if mk < lowM
                                    lowM := mk
                                    lowI := k
                            f_killNode(lowI)
                        int sd = np > close ? 1 : -1
                        box nbx = na
                        if showShort
                            color base = sd == 1 ? colRes : colSup
                            nbx := box.new(bar_index, np + hgt / 2.0, bar_index + 1, np - hgt / 2.0, border_color = color.new(base, 75), bgcolor = color.new(base, 93), extend = extend.right)
                        nodes.push(Node.new(p = np, m = nm, w = hgt / 2.0, t = time, side = sd, bx = nbx))

if newEpoch and barstate.isconfirmed
    epP.clear()
    epW.clear()

float uw = high - math.max(open, close)
float lw = math.min(open, close) - low
float absorb = rngNow > 0 ? wBar * (1.0 - bodyAbs / rngNow) : 0.0
if barstate.isconfirmed and absorb > 0 and uw + lw > 0
    if uw > 0
        epP.push(math.max(open, close) + uw / 2.0)
        epW.push(absorb * uw / (uw + lw))
    if lw > 0
        epP.push(math.min(open, close) - lw / 2.0)
        epW.push(absorb * lw / (uw + lw))
while epP.size() > 20000
    epP.shift()
    epW.shift()

if barstate.isconfirmed and nodes.size() > 0
    for i = nodes.size() - 1 to 0
        Node n = nodes.get(i)
        bool closedThrough = (n.side == 1 and close > n.p + n.w) or (n.side == -1 and close < n.p - n.w)
        bool tooOld = (time - n.t) > nodeAgeD * DAY_MS
        bool tooFar = math.abs(n.p - close) / close * 100.0 > nodeBand
        if closedThrough or tooOld or tooFar
            f_killNode(i)

// ════════════════════════════ TREND-DAY CONTEXT (noise area + divergence) ════════════════════════════
bool inCtx = ctxOn and inSess
float band = na
if inCtx and not na(sOpen) and sessCol < nbCols
    float acc = 0.0
    int   cnt = 0
    for r = 0 to nbDays - 1
        float x = nbM.get(r, sessCol)
        if not na(x)
            acc += x
            cnt += 1
    if cnt >= 5
        band := acc / cnt * nbMult
if inCtx and barstate.isconfirmed and not na(sOpen) and sessCol < nbCols
    curMv.set(sessCol, math.abs(close - sOpen))

bool  outside  = not na(band) and math.abs(close - sOpen) > band
float chartPct = inCtx and nz(sOpen) > 0 ? (close - sOpen) / sOpen * 100.0 : na
float otherPct = inCtx and nz(oOpen) > 0 and not na(oC) ? (oC - oOpen) / oOpen * 100.0 : na
float relPct   = divOn ? chartPct - beta * otherPct : na
bool  divUp    = not na(relPct) and relPct > divPct and chartPct > 0
bool  divDn    = not na(relPct) and relPct < -divPct and chartPct < 0
bool  trendUp  = inCtx and ((outside and close > sOpen) or divUp)
bool  trendDn  = inCtx and ((outside and close < sOpen) or divDn)

// ════════════════════════════ FAILED LEGS -> ZONES AT THE TRAPPED CROWD'S BREAKEVEN ════════════════════════════
if barstate.isconfirmed and pend.size() > 0
    for i = pend.size() - 1 to 0
        Leg   L = pend.get(i)
        float R = L.S + (1.0 - failFrac) * (L.E - L.S)
        bool  extended = L.d == 1 ? high > L.E : low < L.E
        bool  failed   = not extended and (L.d == 1 ? low <= R : high >= R)
        bool  expired  = time - L.t > pendDays * DAY_MS
        if failed
            f_trap(L)
        if extended or failed or expired
            pend.remove(i)

// ════════════════════════════ TRACK LEGS AT BOTH CROWD SIZES ════════════════════════════
if barstate.isconfirmed and nz(adr) > 0 and not na(binSz)
    Leg ls = f_track(trkS, legThr * adr, binSz, wBar)
    if not na(ls)
        pend.push(ls)
    if majOn
        Leg lm = f_track(trkM, majThr * adr, binSz, wBar)
        if not na(lm)
            pend.push(lm)
    while pend.size() > 80
        pend.shift()

// ════════════════════════════ ZONE LIFECYCLE + HOLD GRADING ════════════════════════════
bool hitRes = false
bool hitSup = false
if barstate.isconfirmed and zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone  zz  = zones.get(i)
        float top = zz.p + zz.w
        float bot = zz.p - zz.w
        bool  exh = zz.side == 1 ? exhUp : exhDn
        bool  inZone = high >= bot and low <= top
        // first test: lock the zone's hold-rate cell
        if inZone and not zz.touched and bar_index > zz.bornBar
            zz.touched := true
            f_lock(zz, exh)
            if zz.side == 1
                hitRes := true
            else
                hitSup := true
            if alertTouch
                alert("LEDGER·T: " + syminfo.ticker + " is testing the " + (zz.side == 1 ? "upside wall " : "downside wall ") + f_px(zz.p) + " · holds " + f_hPct(f_hold(zz, exh, true)) + " · " + f_tag(zz), alert.freq_once_per_bar_close)
        // spent once price has reacted a full zone height away on the rejection side
        bool away = zz.side == 1 ? high < bot and close < bot - zz.w : low > top and close > top + zz.w
        if zz.touched and not zz.spent and away
            zz.spent := true
        // held: after the first test, a close reactAdr ADR beyond the zone edge on the rejection side
        if zz.touched and not zz.graded and nz(adr) > 0 and zz.side * ((zz.side == 1 ? bot : top) - close) >= reactAdr * adr
            f_grade(zz, true)
        float past = zz.side * (close - (zz.side == 1 ? top : bot))
        bool  dead = false
        if past > 0
            int tNow = nz(time_close, time)
            if zz.beyondT == 0
                zz.beyondT := tNow
            dead := past > breakMult * 2.0 * zz.w or tNow - zz.beyondT >= acceptMin * 60000
        else
            zz.beyondT := 0
        // an accepted break before the reaction is a failure, including a gap straight through an untested zone
        if dead and not zz.graded
            if zz.cell < 0
                f_lock(zz, exh)
            f_grade(zz, false)
        bool tooOld = time - zz.t > maxAgeD * DAY_MS
        bool tooFar = math.abs(zz.p - close) / close * 100.0 > bandPct
        if dead or tooOld or tooFar
            f_killZone(i)

// keep the strongest maxPerSide zones on each side
if zones.size() > 0
    for side = -1 to 1 by 2
        int cnt = 0
        for zz in zones
            if zz.side == side
                cnt += 1
        while cnt > maxPerSide
            int   wI = -1
            float wS = 0.0
            for [i, zz] in zones
                if zz.side == side
                    float sc = f_score(zz)
                    if wI < 0 or sc < wS
                        wS := sc
                        wI := i
            f_killZone(wI)
            cnt -= 1

// ════════════════════════════ ZONE FEATURES (trend path, DOUBLE, stop fuel) ════════════════════════════
if barstate.isconfirmed and zones.size() > 0
    for zz in zones
        zz.inPath := zz.side == 1 ? trendUp : trendDn
        bool dbl = false
        if not zz.spent
            for n in nodes
                if n.side == zz.side and math.abs(n.p - zz.p) <= zz.w + n.w
                    dbl := true
                    break
        zz.dbl := dbl
        float fuelR = fuelZone * zz.w
        bool  fu = false
        if zz.side == 1
            for r in resH
                if r >= zz.p - zz.w - fuelR and r <= zz.p + zz.w
                    fu := true
                    break
        else
            for r in resL
                if r <= zz.p + zz.w + fuelR and r >= zz.p - zz.w
                    fu := true
                    break
        zz.fuel := fu

// ════════════════════════════ PRICE-AXIS SURVIVAL SCAN ════════════════════════════
float nearD = NEAR_ADR * nz(adr)
[upI, upP, upE, upNone] = f_scan(1, close, sigRem, exhUp, nearD)
[dnI, dnP, dnE, dnNone] = f_scan(-1, close, sigRem, exhDn, nearD)
Zone tU = na
Zone tD = na
if upI >= 0
    tU := zones.get(upI)
if dnI >= 0
    tD := zones.get(dnI)

// ════════════════════════════ REACH CALIBRATION ════════════════════════════
// At the first bar of each session hour every live zone's reach probability is recorded; each record is
// marked hit if a later bar of the same session reaches the zone, and scored when the session ends.
var int lastCkKey = 0
if barstate.isconfirmed
    if sessEnd and rkP.size() > 0
        for i = 0 to rkP.size() - 1
            int b = math.max(0, math.min(9, int(math.floor(rkP.get(i) * 10.0))))
            rbN.set(b, rbN.get(b) + 1.0)
            rbP.set(b, rbP.get(b) + rkP.get(i))
            rbH.set(b, rbH.get(b) + (rkHit.get(i) ? 1.0 : 0.0))
        rkP.clear()
        rkE.clear()
        rkS.clear()
        rkHit.clear()
    if inSess and rkP.size() > 0
        for i = 0 to rkP.size() - 1
            if not rkHit.get(i) and (rkS.get(i) == 1 ? high >= rkE.get(i) : low <= rkE.get(i))
                rkHit.set(i, true)
    int ckKey = sS + int(math.floor((nz(time_close, time) - sS) / 3600000.0)) * 3600000
    if inSess and ckKey != lastCkKey and tauRem > 0 and sigRem > 0
        lastCkKey := ckKey
        for zz in zones
            float edge = zz.side == 1 ? zz.p - zz.w : zz.p + zz.w
            float d = zz.side * (edge - close)
            if not zz.spent and d > 0 and rkP.size() < 3000
                rkP.push(f_reach(d, sigRem))
                rkE.push(edge)
                rkS.push(zz.side)
                rkHit.push(false)

// ════════════════════════════ PLOTS + ALERTS ════════════════════════════
float tUpPrice = na
float tDnPrice = na
float tUpW = na
float tDnW = na
if not na(tU)
    tUpPrice := tU.p
    tUpW := tU.w
if not na(tD)
    tDnPrice := tD.p
    tDnW := tD.w
plot(tUpPrice, "Terminus high", color = showTrail ? color.new(colRes, 74) : na, style = plot.style_linebr, linewidth = 1)
plot(tDnPrice, "Terminus low", color = showTrail ? color.new(colSup, 74) : na, style = plot.style_linebr, linewidth = 1)

bool armUp   = ta.crossover(upP, alertThr)
bool armDn   = ta.crossover(dnP, alertThr)
bool touchUp = not na(tUpPrice) and high >= tUpPrice - tUpW and upP >= alertThr
bool touchDn = not na(tDnPrice) and low <= tDnPrice + tDnW and dnP >= alertThr
alertcondition(armUp, "Upside terminus armed", "LEDGER·T: upside terminus probability crossed the alert threshold on {{ticker}}")
alertcondition(armDn, "Downside terminus armed", "LEDGER·T: downside terminus probability crossed the alert threshold on {{ticker}}")
alertcondition(touchUp, "Upside terminus touched", "LEDGER·T: price reached a high-probability upside terminus on {{ticker}}")
alertcondition(touchDn, "Downside terminus touched", "LEDGER·T: price reached a high-probability downside terminus on {{ticker}}")
alertcondition(hitRes, "Upside wall tested", "LEDGER·T: price reached a trapped-buyer zone on {{ticker}} {{interval}}")
alertcondition(hitSup, "Downside wall tested", "LEDGER·T: price reached a trapped-seller zone on {{ticker}} {{interval}}")

// ════════════════════════════ LAST-BAR RENDER ════════════════════════════
var line  pjU = na
var line  pjD = na
var line  exU = na
var line  exD = na
var label lbU = na
var label lbD = na
var array<label> ladder = array.new<label>()
var array<line>  ladLn  = array.new<line>()
var table dash = table.new(tblPos, 3, 40, bgcolor = color.new(colPanel, 12), border_width = 1, border_color = color.new(color.gray, 82), frame_width = 1, frame_color = color.new(color.gray, 68))

if barstate.islast
    line.delete(pjU)
    line.delete(pjD)
    line.delete(exU)
    line.delete(exD)
    label.delete(lbU)
    label.delete(lbD)
    for lb in ladder
        label.delete(lb)
    ladder.clear()
    for ln in ladLn
        line.delete(ln)
    ladLn.clear()

    float pMin  = minProb / 100.0
    int   xEdge = bar_index + rightPad

    // terminus readouts resolved once, so nothing below touches a na zone
    float pxU  = na
    float pxD  = na
    float gapU = na
    float gapD = na
    float etaU = na
    float etaD = na
    if not na(tU)
        pxU  := tU.p
        gapU := math.max(0.0, tU.p - tU.w - close)
        etaU := f_eta(gapU, sigBar)
    if not na(tD)
        pxD  := tD.p
        gapD := math.max(0.0, close - tD.p - tD.w)
        etaD := f_eta(gapD, sigBar)

    // ── every zone re-weighted by live probability ──
    for [i, z] in zones
        if not na(z.bx)
            bool  isTop = i == upI or i == dnI
            bool  heavy = f_heavy(z)
            color sc    = z.side == 1 ? colRes : colSup
            box.set_right(z.bx, xEdge)
            box.set_border_style(z.bx, z.spent ? line.style_dotted : line.style_solid)
            if z.spent
                box.set_bgcolor(z.bx, color.new(color.gray, 96))
                box.set_border_color(z.bx, color.new(color.gray, 70))
                box.set_border_width(z.bx, 1)
            else if isTop
                box.set_bgcolor(z.bx, color.new(sc, 80))
                box.set_border_color(z.bx, z.dbl ? colDbl : color.new(sc, 20))
                box.set_border_width(z.bx, heavy ? 2 : 1)
            else if z.prob >= pMin
                int tr = int(math.round(93.0 - 11.0 * math.min(1.0, z.prob / 0.5)))
                box.set_bgcolor(z.bx, color.new(sc, tr))
                box.set_border_color(z.bx, z.dbl ? color.new(colDbl, 40) : color.new(sc, 80))
                box.set_border_width(z.bx, heavy ? 2 : 1)
            else
                box.set_bgcolor(z.bx, color.new(colNeut, 95))
                box.set_border_color(z.bx, z.dbl ? color.new(colDbl, 75) : color.new(colNeut, 100))
                box.set_border_width(z.bx, z.dbl ? 1 : 0)

    // ── tier 1: the two levels that actually matter ──
    if showProj and not na(tU)
        int xU = bar_index + int(math.max(5.0, math.min(nz(etaU, 20.0), 400.0)))
        pjU := line.new(bar_index, pxU, xU, pxU, color = color.new(colRes, 15), width = 2)
        lbU := label.new(xU, pxU, "▲ TERMINUS  " + f_px(pxU) + "\n  reach·hold  " + f_pct(upP) + "\n  zone holds  " + f_hPct(tU.hold) + "\n  " + f_tag(tU) + "\n  " + f_crowd(tU) + "\n  eta " + f_fmtMin(etaU) + "  ·  gap " + f_sig(gapU, sigRem), style = label.style_label_left, color = color.new(colPanel, 12), textcolor = tU.dbl ? colDbl : colRes, size = size.small, textalign = text.align_left, text_font_family = MONO, tooltip = f_holdTip(tU))
    if showProj and not na(tD)
        int xD = bar_index + int(math.max(5.0, math.min(nz(etaD, 20.0), 400.0)))
        pjD := line.new(bar_index, pxD, xD, pxD, color = color.new(colSup, 15), width = 2)
        lbD := label.new(xD, pxD, "▼ TERMINUS  " + f_px(pxD) + "\n  reach·hold  " + f_pct(dnP) + "\n  zone holds  " + f_hPct(tD.hold) + "\n  " + f_tag(tD) + "\n  " + f_crowd(tD) + "\n  eta " + f_fmtMin(etaD) + "  ·  gap " + f_sig(gapD, sigRem), style = label.style_label_left, color = color.new(colPanel, 12), textcolor = tD.dbl ? colDbl : colSup, size = size.small, textalign = text.align_left, text_font_family = MONO, tooltip = f_holdTip(tD))

    // ── probability-weighted expectation: a hairline ──
    if showExp and not na(upE)
        exU := line.new(bar_index, upE, xEdge + 2, upE, color = color.new(colRes, 55), style = line.style_dotted, width = 1)
    if showExp and not na(dnE)
        exD := line.new(bar_index, dnE, xEdge + 2, dnE, color = color.new(colSup, 55), style = line.style_dotted, width = 1)

    // ── tier 2: the walls queued behind the terminus ──
    if showLadder and zones.size() > 0
        array<float> lpr = array.new<float>()
        array<int>   lix = array.new<int>()
        for [i, z] in zones
            bool drawn = showProj and (i == upI or i == dnI)
            if not z.spent and z.prob >= pMin and not drawn
                lpr.push(z.prob)
                lix.push(i)
        if lpr.size() > 0
            array<int> ord = lpr.sort_indices(order.descending)
            int shownU = 0
            int shownD = 0
            for j = 0 to ord.size() - 1
                int  zi = lix.get(ord.get(j))
                Zone z  = zones.get(zi)
                bool room = z.side == 1 ? shownU < ladderMax : shownD < ladderMax
                if room
                    if z.side == 1
                        shownU += 1
                    else
                        shownD += 1
                    bool  isTop = zi == upI or zi == dnI
                    color sc    = z.side == 1 ? colRes : colSup
                    string sz   = z.stacked ? "STACKED" : z.horizon == 1 ? "MAJOR" : "swing"
                    ladLn.push(line.new(bar_index, z.p, xEdge + 3, z.p, color = color.new(sc, isTop ? 30 : 74), width = 1, style = isTop ? line.style_solid : line.style_dotted))
                    ladder.push(label.new(xEdge + 4, z.p, (z.side == 1 ? "▲ " : "▼ ") + f_px(z.p) + "  " + f_gauge(z.prob) + " " + f_pct(z.prob) + "   holds " + f_hPct(z.hold) + "   " + sz + (z.dbl ? " · DOUBLE" : ""), style = label.style_label_left, color = color.new(colPanel, 100), textcolor = z.dbl ? colDbl : color.new(sc, isTop ? 0 : 25), size = size.tiny, text_font_family = MONO, tooltip = f_holdTip(z)))

    // ── dashboard ──
    if showTable
        table.clear(dash, 0, 0, 2, 39)
        int cntU  = 0
        int cntD  = 0
        int cntHv = 0
        int cntDb = 0
        for z in zones
            if not z.spent
                if z.side == 1
                    cntU += 1
                else
                    cntD += 1
                if f_heavy(z)
                    cntHv += 1
                if z.dbl
                    cntDb += 1

        table.cell(dash, 0, 0, "LEDGER·TERMINUS", text_color = colTxt, text_size = tblSize, text_halign = text.align_left, text_font_family = MONO)
        table.cell(dash, 1, 0, "", text_size = tblSize)
        table.cell(dash, 2, 0, "trapped-crowd field", text_color = colDim, text_size = tblSize, text_halign = text.align_right, text_font_family = MONO)

        int r = 1
        f_sec(dash, r, "REGIME")
        r += 1
        f_rowG(dash, r, "state", (isVolatile ? "volatile " : "calm ") + f_pct(isVolatile ? pV : 1.0 - pV), isVolatile ? color.rgb(214, 158, 92) : colTxt, isVolatile ? pV : 1.0 - pV)
        r += 1
        f_rowG(dash, r, "session left", f_pct(tauRem), colTxt, tauRem)
        r += 1
        if tblFull
            f_row(dash, r, "σ left", f_px(sigRem) + (useSessSig ? "  session" : "  daily"), colTxt)
            r += 1
        string ctx = not useTrend ? "off" : not intraday ? "intraday only" : not inSess ? "outside session" : na(sOpen) ? "waiting for a full session" : na(band) ? "learning " + str.tostring(nbFilled) + "/5" : trendUp ? "TREND UP" : trendDn ? "TREND DOWN" : "balanced"
        f_row(dash, r, "day type", ctx, trendUp or trendDn ? color.orange : colTxt)
        r += 1
        if tblFull
            string divTxt = not useDiv ? "off" : not corrOk ? "same symbol · off" : na(oC) ? "no data" : na(relPct) ? "-" : (divUp ? "leading ▲ " : divDn ? "leading ▼ " : "in line ") + (relPct >= 0 ? "+" : "−") + str.tostring(math.abs(relPct), "0.00") + "%"
            f_row(dash, r, "vs " + corrName, divTxt, divUp or divDn ? color.orange : colTxt)
            r += 1

        f_sec(dash, r, "UPSIDE")
        r += 1
        f_row(dash, r, "terminus", f_px(pxU), colRes)
        r += 1
        f_rowG(dash, r, "probability", f_pct(upP), colRes, upP)
        r += 1
        if not na(tU)
            f_rowG(dash, r, "zone holds", f_hPct(tU.hold), colRes, tU.hold)
            r += 1
            if tblFull
                f_row(dash, r, "zone", f_tag(tU), tU.dbl ? colDbl : colRes)
                r += 1
                f_row(dash, r, "crowd", f_crowd(tU), colRes)
                r += 1
        if tblFull
            f_row(dash, r, "distance", na(gapU) ? "-" : f_px(gapU) + "  " + f_sig(gapU, sigRem), colRes)
            r += 1
            f_row(dash, r, "E[top]", f_px(upE), colRes)
            r += 1
            f_rowG(dash, r, "no wall holds", f_pct(upNone), colRes, upNone)
            r += 1
        f_row(dash, r, "eta", f_fmtMin(etaU), colRes)
        r += 1

        f_sec(dash, r, "DOWNSIDE")
        r += 1
        f_row(dash, r, "terminus", f_px(pxD), colSup)
        r += 1
        f_rowG(dash, r, "probability", f_pct(dnP), colSup, dnP)
        r += 1
        if not na(tD)
            f_rowG(dash, r, "zone holds", f_hPct(tD.hold), colSup, tD.hold)
            r += 1
            if tblFull
                f_row(dash, r, "zone", f_tag(tD), tD.dbl ? colDbl : colSup)
                r += 1
                f_row(dash, r, "crowd", f_crowd(tD), colSup)
                r += 1
        if tblFull
            f_row(dash, r, "distance", na(gapD) ? "-" : f_px(gapD) + "  " + f_sig(gapD, sigRem), colSup)
            r += 1
            f_row(dash, r, "E[bot]", f_px(dnE), colSup)
            r += 1
            f_rowG(dash, r, "no wall holds", f_pct(dnNone), colSup, dnNone)
            r += 1
        f_row(dash, r, "eta", f_fmtMin(etaD), colSup)
        r += 1

        f_sec(dash, r, "EXHAUSTION")
        r += 1
        f_rowG(dash, r, "upside", f_pct(eUp), colRes, eUp)
        r += 1
        f_rowG(dash, r, "downside", f_pct(eDn), colSup, eDn)
        r += 1

        // model vs what actually happened on this chart
        f_sec(dash, r, "CALIBRATION")
        r += 1
        float hN = cN.sum()
        float hW = cW.sum()
        f_row(dash, r, "zones held", hN > 0 ? f_pct(hW / hN) + " of " + str.tostring(hN, "#") + " tests" + (f_learning() ? "  (learning)" : "") : "no tests yet", colTxt)
        r += 1
        if tblFull
            float nHv = 0.0
            float wHv = 0.0
            for c = 0 to 63
                if int(math.floor(c / 4.0)) % 8 >= 4
                    nHv += cN.get(c)
                    wHv += cW.get(c)
            f_row(dash, r, "swing / major", (hN - nHv > 0 ? f_pct((hW - wHv) / (hN - nHv)) : "-") + " / " + (nHv > 0 ? f_pct(wHv / nHv) : "-"), colDim)
            r += 1
        float rN  = rbN.sum()
        float rel = 0.0
        for b = 0 to 9
            float nb = rbN.get(b)
            if nb > 0
                rel += math.pow(rbP.get(b) - rbH.get(b), 2) / nb
        f_row(dash, r, "reach said/hit", rN > 0 ? f_pct(rbP.sum() / rN) + " / " + f_pct(rbH.sum() / rN) + "  n " + str.tostring(rN, "#") : "no full session yet", colDim)
        r += 1
        if tblFull
            f_row(dash, r, "reach reliability", rN > 0 ? str.tostring(rel / rN, "0.0000") : "-", colDim)
            r += 1

        if tblFull
            f_sec(dash, r, "FIELD")
            r += 1
            f_row(dash, r, "live zones", str.tostring(cntU) + " up  " + str.tostring(cntD) + " dn  · " + str.tostring(cntHv) + " major · " + str.tostring(cntDb) + " DOUBLE", colDim)
            r += 1
            f_row(dash, r, "stop pools", str.tostring(resH.size()) + " up  " + str.tostring(resL.size()) + " dn", colDim)
            r += 1
            string legTxt = nz(adr) > 0 and not na(binSz) ? "swing " + f_px(legThr * adr) + " · major " + (majOn ? f_px(majThr * adr) : "off") + " · bin " + f_px(binSz) : "waiting for " + str.tostring(adrLen + 1) + " daily bars"
            f_row(dash, r, "legs", legTxt, colDim)
            r += 1
