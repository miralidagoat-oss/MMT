//@version=6
// =============================================================================
//  MNQ 5-MINUTE ETH — OVERNIGHT-RANGE BREAKOUT  ·  RESEARCH INSTRUMENT
// =============================================================================
//  READ THIS BEFORE TRADING IT.  This is NOT a validated edge. It is the best
//  of 36 configurations tested across five strategy families, and it FAILED
//  four independent robustness tests. It is published as a research instrument
//  so the multi-year validation can be run on TradingView Deep Backtesting,
//  which reaches far more history than the free 5m feed used in development.
//
//  Measured on MNQ 5m ETH, 45 usable trading days (2026-06-22 .. 2026-08-21):
//      n=150, WR 67.3%, PF 1.40 (zero cost) / 1.32 (moderate) / 1.24 (harsh),
//      3.3 trades/day.
//
//  WHY IT IS NOT TRUSTED — every one of these is a rejection on its own:
//    1. The identical rule on 1h over 612 trading days (793 trades) returns
//       PF 0.85. The sign inverts on the larger sample.
//    2. Screen (34d) -> holdout (17d): PF collapses 1.50 -> 1.03.
//    3. 49% of all profit comes from a single hour (13:00 ET) on 19 trades at
//       89.5% WR, while 09/11/15 ET are net negative.
//    4. Parameter sensitivity is a spike, not a plateau: PF 1.32 at stop 1.25
//       ATR sits between 0.91 (stop 1.00) and 1.13 (stop 1.50). Only 16 of 45
//       neighbouring cells clear PF 1.2.
//
//  CALIBRATION — the number that matters most. Random entries at this payoff
//  produce, on the real MNQ series:
//      ~70 trades  -> PF p95 1.45, WR p95 69.1%
//      ~200 trades -> PF p95 1.26
//      ~500 trades -> PF p95 1.14
//  So a 69% win rate on ~70 trades is what a COIN FLIP does 5% of the time.
//  The stats panel below computes this threshold live and tells you whether the
//  result on your chart is distinguishable from chance. Use it.
//
//  NON-REPAINTING BY CONSTRUCTION:
//   · No request.security() — every value is native to the chart timeframe, so
//     there is no higher-timeframe leakage possible.
//   · The overnight range is FROZEN at the session open and never updated
//     afterwards. A running extreme is not a level; consuming one would be
//     lookahead by another name.
//   · Signals evaluate on the confirmed close; orders fill at the next bar's
//     open (process_orders_on_close stays false).
//   · The gap filter reads the SIGNAL bar's own gap, not the entry bar's, so
//     nothing consults a price that is not yet in hand.
// =============================================================================

strategy("MNQ 5m ETH — ON Range Breakout [RESEARCH]",
     overlay              = true,
     initial_capital      = 25000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 0.85,
     slippage             = 2,
     calc_on_every_tick   = false,
     process_orders_on_close = false,
     margin_long          = 0,
     margin_short         = 0,
     pyramiding           = 0)

// ─────────────────────────── inputs ────────────────────────────
gRES = "1 · Research window (for in-sample / out-of-sample splits)"
useWindow = input.bool(false, "Limit backtest to a date window", group=gRES,
     tooltip="Turn on to run a specific slice. Develop on one window, then test " +
             "an untouched later window ONCE. If you change anything after seeing " +
             "the untouched result, it is no longer out-of-sample.")
startTime = input.time(timestamp(2024, 1, 1, 0, 0), "Window start", group=gRES)
endTime   = input.time(timestamp(2030, 1, 1, 0, 0), "Window end",   group=gRES)

gSES = "2 · ETH session (America/New_York)"
onStartMin = input.int(1080, "Overnight range starts (min past ET midnight)", minval=0, maxval=1439,
     group=gSES, tooltip="1080 = 18:00 ET, the CME Globex open.")
onEndMin   = input.int(570,  "Overnight range freezes at", minval=0, maxval=1439,
     group=gSES, tooltip="570 = 09:30 ET, the cash open. The range is fixed here " +
                         "and never revised.")
eodMin     = input.int(1005, "Stop new entries / flatten at", minval=0, maxval=1439,
     group=gSES, tooltip="1005 = 16:45 ET. Deliberately EARLIER than the 16:55 " +
                         "final bar: strategy.close_all() placed at a bar's close " +
                         "fills at the NEXT bar's open, so triggering at 16:55 would " +
                         "fill at the 18:00 ET reopen — carrying the position across " +
                         "the maintenance break and any weekend gap.")

gSIG = "3 · Signal"
marginATR = input.float(0.0, "Breakout margin (× ATR beyond the range)", minval=0.0, step=0.05, group=gSIG)
atrLen    = input.int(14, "ATR length", minval=2, group=gSIG)
gapGuard  = input.float(1.5, "Skip signal if bar gapped more than (× ATR)", minval=0.0, step=0.1,
     group=gSIG, tooltip="Suppresses entries across contract-roll splices and data holes.")

gRSK = "4 · Risk (Phase 1 viable region: stop 30-60 pts ≈ 1.0-2.0 × ATR)"
stopATR = input.float(1.25, "Stop (× ATR)", minval=0.1, step=0.05, group=gRSK,
     tooltip="Below ~0.7 ATR costs and intrabar path ambiguity dominate the result. " +
             "See the research notes: at a 15pt stop, 55% of 5m bars can contain " +
             "both stop and target, so the backtest reports an assumption.")
rr = input.float(0.643, "Target (× stop)", minval=0.1, step=0.05, group=gRSK,
     tooltip="0.643 is the payoff that yields PF 1.50 at a 70% win rate.")
cooldownBars = input.int(12, "Cooldown after exit (bars)", minval=0, group=gRSK)
maxHoldBars  = input.int(48, "Max hold (bars)", minval=1, group=gRSK)

gDIR = "5 · Direction"
enableLongs  = input.bool(true, "Longs",  group=gDIR)
enableShorts = input.bool(true, "Shorts", group=gDIR)

gVIS = "6 · Display"
showRange = input.bool(true,  "Plot overnight range", group=gVIS)
showPanel = input.bool(true,  "Show statistics panel", group=gVIS)

// ───────────────────── ET clock and session state ──────────────────────
TZ  = "America/New_York"
etm = hour(time, TZ) * 60 + minute(time, TZ)

// Inside the overnight accumulation window (18:00 ET -> 09:30 ET, wrapping midnight).
inON = etm >= onStartMin or etm < onEndMin

// A new CME trading day begins on the 18:00 ET crossing. The prior bar is the
// 16:55 ET bar, because 17:00-18:00 is the maintenance break.
newSession = etm >= onStartMin and (na(etm[1]) or etm[1] < onStartMin)

var float onH       = na
var float onL       = na
var bool  onFrozen  = false
var int   dayCount  = 0

if newSession
    onH      := high
    onL      := low
    onFrozen := false
    dayCount += 1
else if inON
    onH := na(onH) ? high : math.max(onH, high)
    onL := na(onL) ? low  : math.min(onL, low)

// Freeze on the first bar after the overnight window closes, and never revise.
if not inON and not onFrozen and not na(onH) and not na(onL)
    onFrozen := true

// The range is tradeable only once frozen and before the next session begins.
onValid = onFrozen and not inON and not na(onH) and not na(onL)

// ───────────────────────────── features ──────────────────────────────
atr = ta.atr(atrLen)

// Causal gap measure: this bar's open against the previous close.
gapATR = na(close[1]) or na(atr) or atr <= 0 ? 0.0 : math.abs(open - close[1]) / atr
gapOK  = gapATR <= gapGuard

// ───────────────────────────── signals ───────────────────────────────
longSig  = onValid and not na(atr) and close > onH + marginATR * atr
shortSig = onValid and not na(atr) and close < onL - marginATR * atr

// ──────────────────────── trade state tracking ───────────────────────
// Read from the strategy's own trade ledger, not from position_size transitions.
// That distinction matters here: 30.7% of trades open and close inside a single
// bar, and a `position_size[1] != 0` edge detector never sees those, which would
// silently disable the cooldown for a third of all trades and let the strategy
// re-fire repeatedly into the same move.
var float riskPts = na

flat        = strategy.position_size == 0
nClosed     = strategy.closedtrades
lastExitBar = nClosed > 0 ? strategy.closedtrades.exit_bar_index(nClosed - 1) : -100000
heldBars    = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0

coolOK  = (bar_index - lastExitBar) > cooldownBars
eodFlat = etm >= eodMin and etm < onStartMin
inWin   = not useWindow or (time >= startTime and time <= endTime)

allowNew = inWin and flat and coolOK and gapOK and not eodFlat and not na(atr) and atr > 0

// ───────────────────────────── execution ─────────────────────────────
// Signal is read on the confirmed close; the market order fills at the next
// bar's open.
//
// The protective bracket is armed HERE, on the signal bar, using `loss`/`profit`
// in ticks rather than absolute prices. This matters: 30.7% of trades in the
// Python study resolve on the entry bar itself. A bracket built from
// strategy.position_avg_price can only be placed once the fill exists — i.e. at
// the close of the entry bar — so it cannot act during that bar, and roughly a
// third of trades would diverge from the Python model. Tick-relative exits attach to
// the entry order and go live the instant it fills.
if allowNew and longSig and enableLongs
    riskPts := stopATR * atr
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit L", from_entry="Long",
         loss   = riskPts / syminfo.mintick,
         profit = riskPts * rr / syminfo.mintick)

if allowNew and shortSig and enableShorts
    riskPts := stopATR * atr
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit S", from_entry="Short",
         loss   = riskPts / syminfo.mintick,
         profit = riskPts * rr / syminfo.mintick)

// When one bar contains both the stop and the target, TradingView's emulator
// resolves it conservatively (stop first) — the same pessimistic convention the
// Python study used. The measured path-assumption band at this stop size was
// only 0.02 PF, so the choice is immaterial here; it would NOT be at tight stops.
//
// Time stop and end-of-session flat. These also fill at the next bar's open,
// which is why eodMin is set before the session's final bar.
if strategy.position_size != 0 and (heldBars >= maxHoldBars or eodFlat)
    strategy.close_all(comment = eodFlat ? "EOD" : "time")

// ───────────────────────────── plotting ──────────────────────────────
plot(showRange and onValid ? onH : na, "Overnight high", color.new(color.teal, 0),
     2, plot.style_linebr)
plot(showRange and onValid ? onL : na, "Overnight low",  color.new(color.red, 0),
     2, plot.style_linebr)

plotshape(longSig  and allowNew and enableLongs,  "Long signal",  shape.triangleup,
     location.belowbar, color.new(color.teal, 0), size=size.tiny)
plotshape(shortSig and allowNew and enableShorts, "Short signal", shape.triangledown,
     location.abovebar, color.new(color.red, 0),  size=size.tiny)

bgcolor(onValid ? color.new(color.blue, 96) : na, title="Range active")

// ────────────────────────── statistics panel ─────────────────────────
// The null threshold is the point of this panel. PF p95 ≈ 1 + 3.5/sqrt(n) was
// fitted to Monte-Carlo random-entry runs on the real MNQ series at this payoff
// (measured: 1.45 @ n=70, 1.32 @ n=128, 1.26 @ n=200, 1.19 @ n=313, 1.14 @ n=514).
// A profit factor below this line is not evidence of an edge.
if showPanel and barstate.islast
    n     = strategy.closedtrades
    wins  = strategy.wintrades
    gp    = strategy.grossprofit
    gl    = strategy.grossloss
    pf    = gl > 0 ? gp / gl : na
    wr    = n > 0 ? 100.0 * wins / n : na
    avgT  = n > 0 ? strategy.netprofit / n : na
    tpd   = dayCount > 0 ? n / math.max(dayCount, 1) : na
    p95   = n > 0 ? 1.0 + 3.5 / math.sqrt(n) : na
    beats = not na(pf) and not na(p95) and pf > p95

    var table t = table.new(position.top_right, 2, 11,
         bgcolor = color.new(color.black, 15), border_width = 1,
         border_color = color.new(color.gray, 60))

    hdr = color.new(color.yellow, 0)
    txt = color.new(color.white, 0)

    table.cell(t, 0, 0, "ON RANGE BREAKOUT [RESEARCH]", text_color=hdr, text_size=size.small)
    table.cell(t, 1, 0, "", text_color=hdr, text_size=size.small)

    table.cell(t, 0, 1, "Closed trades",  text_color=txt, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(n),  text_color=txt, text_size=size.small)

    table.cell(t, 0, 2, "Trading days",   text_color=txt, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(dayCount), text_color=txt, text_size=size.small)

    table.cell(t, 0, 3, "Trades / day",   text_color=txt, text_size=size.small)
    table.cell(t, 1, 3, na(tpd) ? "—" : str.tostring(tpd, "#.##"), text_color=txt, text_size=size.small)

    table.cell(t, 0, 4, "Win rate",       text_color=txt, text_size=size.small)
    table.cell(t, 1, 4, na(wr) ? "—" : str.tostring(wr, "#.#") + "%", text_color=txt, text_size=size.small)

    table.cell(t, 0, 5, "Profit factor",  text_color=txt, text_size=size.small)
    table.cell(t, 1, 5, na(pf) ? "—" : str.tostring(pf, "#.##"), text_color=txt, text_size=size.small)

    table.cell(t, 0, 6, "Avg trade ($)",  text_color=txt, text_size=size.small)
    table.cell(t, 1, 6, na(avgT) ? "—" : str.tostring(avgT, "#.##"), text_color=txt, text_size=size.small)

    table.cell(t, 0, 7, "Max drawdown ($)", text_color=txt, text_size=size.small)
    table.cell(t, 1, 7, str.tostring(strategy.max_drawdown, "#.##"), text_color=txt, text_size=size.small)

    table.cell(t, 0, 8, "Chance threshold (PF p95)", text_color=hdr, text_size=size.small)
    table.cell(t, 1, 8, na(p95) ? "—" : str.tostring(p95, "#.##"), text_color=hdr, text_size=size.small)

    table.cell(t, 0, 9, "Verdict",
         text_color = beats ? color.new(color.lime, 0) : color.new(color.orange, 0),
         text_size = size.small)
    table.cell(t, 1, 9, n < 30 ? "TOO FEW TRADES" : beats ? "beats chance (nominal)" : "INSIDE NOISE",
         text_color = beats ? color.new(color.lime, 0) : color.new(color.orange, 0),
         text_size = size.small)

    table.cell(t, 0, 10, "Failed 4 robustness tests — see header", text_color=color.new(color.orange, 0), text_size=size.tiny)
    table.cell(t, 1, 10, "", text_size=size.tiny)
