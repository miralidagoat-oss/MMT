//@version=6
indicator("MNQ Reversal Zones — no-lag zones, audited reclaims", shorttitle = "RevZones",
     overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// WHAT THIS IS
//   Reversal ZONES, not buy/sell signals.
//
//   ZONE     drawn the moment its level becomes known (a session has just
//            closed, or an intraday swing has just been confirmed). It never
//            moves afterwards and nothing is ever painted backwards.
//   TAP      the first bar that trades at the level. Marked on that bar, at the
//            level price, the instant it happens. Zero lag.
//   RECLAIM  after a tap, the first later bar that CLOSES back inside the level
//            (a failed breakout). Marked on that bar, at its close.
//
// WHAT THE BACKTEST SAYS (README.md → "MNQ Reversal Zones", backtest/rz_*.py)
//   1,212 sessions of real 1-minute Nasdaq-100 data, 2022-03 → 2026-11, target
//   100 points, pessimistic fills, before trading costs:
//
//                          reversed   chance   points per mark
//     taps (first touch)     14.6%     17.2%        -3.2     reliably WORSE than chance
//     bottom reclaims        23.3%     22.5%        +2.3     best thing tested, not proven
//     top reclaims           18.9%     19.8%        -0.4     no edge
//
//   chance = risk / (target + risk): what a market with no memory gives the
//   same bet. On real MNQ, markers dropped at random moments reverse 100 points
//   before 30 points of heat 23.0% of the time; the formula says 23.1%.
//
//   So: fading the first touch of a level loses. Waiting for a failed
//   breakDOWN to close back above the level is the least-bad reversal setup
//   and roughly breaks even. Tops showed nothing. Nothing here - and nothing
//   else that was tested - top-ticks or bottom-ticks reliably. The scorecard
//   prints the hit rate on YOUR chart next to the chance rate, so the script
//   can never look better than it is.
//
// GRADING (pessimistic, identical to backtest/rz_engine.py)
//   Tap      FAIL beyond the far edge of the zone · HIT `target` points away
//   Reclaim  FAIL back through the sweep extreme  · HIT `target` points away
//   Inside one bar the failing side is always assumed to print first, and a
//   hit is never credited on the bar that created the mark.
// ============================================================================

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
const string G_CORE  = "Reversal definition"
const string G_RC    = "Reclaim tier (bottoms: the best setup tested, still unproven)"
const string G_ZONES = "Zones — each is known before price gets there"
const string G_UI    = "Display"

targetPts  = input.float(100.0, "Reversal target (points)", minval = 1.0, step = 5.0, group = G_CORE,
     tooltip = "A mark counts as a hit when price travels this far away from it before it fails.")
depthMode  = input.string("Auto (× ADR)", "Zone depth", options = ["Auto (× ADR)", "Fixed points"], group = G_CORE,
     tooltip = "How far past the level price may run before a tap is called failed. Deeper zones hit more often and are less precise - that trade-off is arithmetic, not skill.")
depthAdr   = input.float(0.06, "Depth: fraction of ADR", minval = 0.01, maxval = 0.5, step = 0.01, group = G_CORE)
depthFixed = input.float(30.0, "Depth: fixed points", minval = 1.0, step = 1.0, group = G_CORE)
adrLen     = input.int(20, "ADR length (sessions)", minval = 5, maxval = 60, group = G_CORE)
maxMinutes = input.int(600, "Grade a mark for at most (minutes)", minval = 30, group = G_CORE)

rcWindowMin = input.int(30, "Close back inside within (minutes after the tap)", minval = 1, group = G_RC)
sweepMaxAdr = input.float(0.20, "Level counts as broken beyond (× ADR)", minval = 0.02, step = 0.01, group = G_RC)
stopBufAdr  = input.float(0.01, "Reclaim fails beyond the sweep extreme by (× ADR)", minval = 0.0, step = 0.005, group = G_RC)
showTopRc   = input.bool(false, "Also mark TOP reclaims (tested: no edge)", group = G_RC)
trendLen    = input.int(200, "Long-term trend average (sessions)", minval = 20, group = G_RC,
     tooltip = "Context only, shown on the scorecard. Before costs, bottom reclaims averaged +2.9 points per mark while yesterday's close was above this average and +0.2 while below it.")

showON = input.bool(true, "Overnight high / low        18:00 → 09:30 ET, drawn at 09:30", group = G_ZONES)
showLO = input.bool(true, "London high / low           03:00 → 09:30 ET, drawn at 09:30", group = G_ZONES)
showAS = input.bool(true, "Asia high / low             18:00 → 03:00 ET, drawn at 03:00", group = G_ZONES)
showPD = input.bool(true, "Prior-day RTH high / low    drawn at 18:00 ET",                group = G_ZONES)
showX5 = input.bool(true, "5-session high / low        drawn at 18:00 ET",                group = G_ZONES)
showPW = input.bool(true, "Prior-week high / low       drawn at 18:00 ET",                group = G_ZONES)
showOR = input.bool(true, "Opening range high / low    09:30 → 10:00 ET, drawn at 10:00", group = G_ZONES)
showIB = input.bool(true, "Initial balance high / low  09:30 → 10:30 ET, drawn at 10:30", group = G_ZONES)
showAM = input.bool(true, "Morning high / low          09:30 → 12:00 ET, drawn at 12:00", group = G_ZONES)
showSW = input.bool(true, "Intraday swing high / low   drawn once the swing is confirmed", group = G_ZONES)
swingAdr    = input.float(0.20, "Swing size (× ADR)", minval = 0.05, step = 0.05, group = G_ZONES,
     tooltip = "An intraday high/low becomes a zone once price has retraced this far from it.")
swingMaxMin = input.int(1440, "Drop an untapped swing zone after (minutes)", minval = 60, group = G_ZONES)

showDash   = input.bool(true, "Scorecard", group = G_UI)
showTaps   = input.bool(true, "Tap marks", group = G_UI)
showGraded = input.bool(true, "Keep graded zones on the chart", group = G_UI)
showNames  = input.bool(true, "Zone name tags", group = G_UI)
topColor   = input.color(#EF5350, "Top-zone color", group = G_UI)
botColor   = input.color(#26A69A, "Bottom-zone color", group = G_UI)
hitColor   = input.color(#FFD54F, "Hit color", group = G_UI)

// ─────────────────────────────────────────────────────────────
// CLOCK (New York) — hard-wired to the sessions that were tested
// ─────────────────────────────────────────────────────────────
string TZ = "America/New_York"
int GLOBEX_OPEN = 1080   // 18:00
int ASIA_END    = 180    // 03:00
int RTH_OPEN    = 570    // 09:30
int OR_END      = 600    // 10:00
int IB_END      = 630    // 10:30
int AM_END      = 720    // 12:00
int RTH_CLOSE   = 960    // 16:00

int etMin = hour(time, TZ) * 60 + minute(time, TZ)
// the CME trade date starts at 18:00 ET, so shift the clock 6 hours forward
int shifted  = time + 6 * 3600000
int tradeKey = year(shifted, TZ) * 10000 + month(shifted, TZ) * 100 + dayofmonth(shifted, TZ)
bool newTradeDate = tradeKey != nz(tradeKey[1], tradeKey) or bar_index == 0

bool inAsia   = etMin >= GLOBEX_OPEN or etMin < ASIA_END
bool inLondon = etMin >= ASIA_END and etMin < RTH_OPEN
bool inRth    = etMin >= RTH_OPEN and etMin < RTH_CLOSE
bool dayPart  = etMin < GLOBEX_OPEN        // 00:00–17:59 ET part of the trade date

int  tfSec    = timeframe.in_seconds()
bool tfOk     = timeframe.isintraday and tfSec <= 1800 and 1800 % tfSec == 0
int  maxBars      = math.max(1, math.ceil(maxMinutes * 60.0 / tfSec))
int  winBars      = math.max(1, math.ceil(rcWindowMin * 60.0 / tfSec))
int  swingAgeBars = math.max(1, math.ceil(swingMaxMin * 60.0 / tfSec))

// ─────────────────────────────────────────────────────────────
// DAILY / WEEKLY CONTEXT — completed bars only (no repaint)
// ─────────────────────────────────────────────────────────────
[dAdr, d5h, d5l, dPrevClose, dSma] = request.security(syminfo.tickerid, "D",
     [ta.sma(high - low, adrLen)[1], ta.highest(high, 5)[1], ta.lowest(low, 5)[1], close[1], ta.sma(close, trendLen)[1]],
     lookahead = barmerge.lookahead_on)
[wHigh, wLow] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ─────────────────────────────────────────────────────────────
// TYPES & STATE
// ─────────────────────────────────────────────────────────────
// state   (tap tier)     0 waiting · 1 being graded · 2 hit · 3 failed · 4 timed out
// rcState (reclaim tier) 0 none · 1 watching · 2 being graded · 3 hit · 4 failed · 5 timed out · 6 off
type Zone
    int    fam          // 0 ON 1 LO 2 AS 3 PD 4 X5 5 PW 6 OR 7 IB 8 AM 9 SW
    string name
    int    side         // +1 top zone (prior high), -1 bottom zone (prior low)
    float  level
    float  depth
    float  target
    float  adr
    int    bornBar
    int    tapBar
    float  tapPrice
    int    state
    float  ext          // sweep extreme since the tap
    int    rcState
    int    rcBar
    float  rcPrice
    float  rcStop
    box    bx
    label  tag
    label  rcTag

var array<Zone> live = array.new<Zone>()

// scorecard rows: 0 taps·top  1 taps·bottom  2 reclaims·bottom  3 reclaims·top
var array<int>   sN    = array.new<int>(4, 0)
var array<int>   sHit  = array.new<int>(4, 0)
var array<int>   sFail = array.new<int>(4, 0)
var array<float> sCh   = array.new<float>(4, 0.0)
var array<int>   sDone = array.new<int>(4, 0)       // marks fully graded (hit, failed or timed out)
var array<float> sPts  = array.new<float>(4, 0.0)   // points: +target on a hit, -risk on a fail, timeout marked to the close

var float asH = na
var float asL = na
var float loH = na
var float loL = na
var float rthH = na
var float rthL = na
var float pdH = na
var float pdL = na
var float adr = na
var int   trend = 0
var bool  didAsia = false
var bool  didOpen = false
var bool  didOr = false
var bool  didIb = false
var bool  didAm = false
// trade dates whose 18:00 ET start was actually seen on this chart: the first
// loaded session is partial, so nothing is built from it
var int   dayCount = 0

// causal zigzag for intraday swing zones
var int   zzDir = 0
var float zzHi = na
var float zzLo = na
var int   zzHiBar = -1
var int   zzLoBar = -1
var int   pendSide = 0
var float pendPrice = na

bool tapTop = false
bool tapBot = false
bool rcBot  = false
bool rcTop  = false

f_enabled(int fam) =>
    fam == 0 ? showON : fam == 1 ? showLO : fam == 2 ? showAS : fam == 3 ? showPD : fam == 4 ? showX5 :
     fam == 5 ? showPW : fam == 6 ? showOR : fam == 7 ? showIB : fam == 8 ? showAM : showSW

f_newZone(int fam, string name, int side, float level) =>
    // the level must still be ahead of price: a top zone needs price below it
    bool ahead = side > 0 ? open < level : open > level
    // yesterday's RTH range needs one more fully observed session than the rest
    bool seen  = dayCount >= (fam == 3 ? 2 : 1)
    // one zone per level: an untapped zone already sitting there is the same thing
    bool dup = false
    if live.size() > 0
        for i = 0 to live.size() - 1
            Zone q = live.get(i)
            if q.state == 0 and q.side == side and q.level == level
                dup := true
                break
    if f_enabled(fam) and seen and not dup and not na(level) and not na(adr) and ahead
        float depth = depthMode == "Fixed points" ? depthFixed : depthAdr * adr
        float far   = level + side * depth
        color col   = side > 0 ? topColor : botColor
        int   fade  = fam == 9 ? 6 : 0
        box b = box.new(bar_index, math.max(level, far), bar_index + 1, math.min(level, far),
             bgcolor = color.new(col, 86 + fade), border_color = color.new(col, 35 + 5 * fade), border_width = 1)
        label t = label.new(bar_index + 1, level, showNames ? name : "", style = label.style_label_left,
             color = color.new(col, 100), textcolor = color.new(col, 10 + 5 * fade), size = size.small)
        live.push(Zone.new(fam, name, side, level, depth, targetPts, adr, bar_index, -1, na, 0, na, 0, -1, na, na, b, t, na))

// ─────────────────────────────────────────────────────────────
// 1) NEW TRADE DATE (18:00 ET): prior-day / 5-session / weekly zones
// ─────────────────────────────────────────────────────────────
if newTradeDate
    if live.size() > 0
        for i = live.size() - 1 to 0
            Zone z = live.get(i)
            if z.state == 0 and z.fam != 9
                // never tapped: the zone dies with its session
                box.delete(z.bx)
                label.delete(z.tag)
                live.remove(i)
    if bar_index > 0
        dayCount += 1
    pdH := rthH
    pdL := rthL
    asH := na
    asL := na
    loH := na
    loL := na
    rthH := na
    rthL := na
    didAsia := false
    didOpen := false
    didOr := false
    didIb := false
    didAm := false
    adr := dAdr
    trend := na(dSma) or na(dPrevClose) ? 0 : dPrevClose > dSma ? 1 : dPrevClose < dSma ? -1 : 0
    f_newZone(3, "PDH", 1, pdH)
    f_newZone(3, "PDL", -1, pdL)
    f_newZone(4, "5DH", 1, d5h)
    f_newZone(4, "5DL", -1, d5l)
    f_newZone(5, "PWH", 1, wHigh)
    f_newZone(5, "PWL", -1, wLow)

// ─────────────────────────────────────────────────────────────
// 2) SESSION BOUNDARIES: a range is complete → its zones are born
// ─────────────────────────────────────────────────────────────
if not didAsia and not inAsia
    didAsia := true
    f_newZone(2, "ASH", 1, asH)
    f_newZone(2, "ASL", -1, asL)

if not didOpen and dayPart and etMin >= RTH_OPEN
    didOpen := true
    float onH = na(asH) ? loH : na(loH) ? asH : math.max(asH, loH)
    float onL = na(asL) ? loL : na(loL) ? asL : math.min(asL, loL)
    f_newZone(0, "ONH", 1, onH)
    f_newZone(0, "ONL", -1, onL)
    f_newZone(1, "LOH", 1, loH)
    f_newZone(1, "LOL", -1, loL)

if not didOr and dayPart and etMin >= OR_END
    didOr := true
    f_newZone(6, "ORH", 1, rthH)
    f_newZone(6, "ORL", -1, rthL)

if not didIb and dayPart and etMin >= IB_END
    didIb := true
    f_newZone(7, "IBH", 1, rthH)
    f_newZone(7, "IBL", -1, rthL)

if not didAm and dayPart and etMin >= AM_END
    didAm := true
    f_newZone(8, "AMH", 1, rthH)
    f_newZone(8, "AML", -1, rthL)

// a swing confirmed on the previous bar becomes a zone now
if pendSide != 0
    f_newZone(9, pendSide > 0 ? "SWH" : "SWL", pendSide, pendPrice)
    pendSide := 0

// ─────────────────────────────────────────────────────────────
// 3) ZONE ENGINE: taps (zero lag), reclaims (bar close), pessimistic grading
// ─────────────────────────────────────────────────────────────
if live.size() > 0
    for i = live.size() - 1 to 0
        Zone z = live.get(i)
        int   s  = z.side
        color zc = s > 0 ? topColor : botColor
        float far       = z.level + s * z.depth
        bool  beyondFar = s > 0 ? high > far : low < far
        // a close is only a close once the bar is finished
        bool  closedIn  = barstate.isconfirmed and (s > 0 ? close < z.level : close > z.level)
        int   prevState = z.state
        int   prevRc    = z.rcState
        bool  drop      = false

        // every `if` below stands alone (no mixed-type if/else pairs)
        bool waiting = prevState == 0
        bool expired = waiting and z.fam == 9 and bar_index - z.bornBar > swingAgeBars
        // a zone may be tapped on the bar it is born: its level comes from
        // bars that closed before this bar opened
        bool touched = waiting and not expired and (s > 0 ? high >= z.level : low <= z.level)

        if expired
            box.delete(z.bx)
            label.delete(z.tag)
            drop := true

        if touched
            bool gapped = s > 0 ? open > z.level : open < z.level
            z.tapBar   := bar_index
            z.tapPrice := gapped ? open : z.level
            z.state    := beyondFar ? 3 : 1
            z.ext      := s > 0 ? high : low
            // reclaim watch starts unless the level is already broken or the
            // tap bar itself closed back inside (same-bar rejection)
            z.rcState  := s * (z.ext - z.level) > sweepMaxAdr * z.adr or closedIn ? 6 : 1
            sN.set(s > 0 ? 0 : 1, sN.get(s > 0 ? 0 : 1) + 1)
            tapTop := tapTop or s > 0
            tapBot := tapBot or s < 0
            box.set_right(z.bx, bar_index)
            box.set_bgcolor(z.bx, color.new(zc, 74))
            label.set_xy(z.tag, bar_index, z.tapPrice)
            label.set_style(z.tag, s > 0 ? label.style_label_down : label.style_label_up)
            label.set_color(z.tag, color.new(zc, showTaps ? 45 : 100))
            label.set_textcolor(z.tag, color.new(color.white, showTaps ? 0 : 100))
            label.set_text(z.tag, (s > 0 ? "▼ " : "▲ ") + z.name)
            alert("Reversal zone tapped: " + z.name + " @ " + str.tostring(z.tapPrice, format.mintick) +
                 (s > 0 ? "  (top zone, tap fails above " : "  (bottom zone, tap fails below ") +
                 str.tostring(far, format.mintick) + ")", alert.freq_once_per_bar)

        if waiting and not expired and not touched
            box.set_right(z.bx, bar_index + 1)
            label.set_x(z.tag, bar_index + 1)

        // tier 1 — the tap (graded from the bar after the tap)
        if prevState == 1
            float fav = s > 0 ? z.tapPrice - low : high - z.tapPrice
            if beyondFar
                z.state := 3
            else if fav >= z.target
                z.state := 2
            else if bar_index - z.tapBar >= maxBars
                z.state := 4

        // tier 2 — watching for the reclaim
        if prevRc == 1
            z.ext := s > 0 ? math.max(z.ext, high) : math.min(z.ext, low)
            bool lost = bar_index - z.tapBar > winBars or s * (z.ext - z.level) > sweepMaxAdr * z.adr
            if lost
                z.rcState := 6
            if not lost and closedIn
                z.rcState := 2
                z.rcBar   := bar_index
                z.rcPrice := close
                z.rcStop  := z.ext + s * stopBufAdr * z.adr
                sN.set(s > 0 ? 3 : 2, sN.get(s > 0 ? 3 : 2) + 1)
                rcTop := rcTop or s > 0
                rcBot := rcBot or s < 0
                if s < 0 or showTopRc
                    z.rcTag := label.new(bar_index, close, "⟲ " + z.name,
                         style = s > 0 ? label.style_label_down : label.style_label_up,
                         color = s > 0 ? color.new(color.gray, 25) : color.new(botColor, 0),
                         textcolor = color.white, size = size.small,
                         tooltip = (s > 0 ? "Top reclaim (tested: no edge). Fails above " : "Bottom reclaim. Fails below ") +
                         str.tostring(z.rcStop, format.mintick))
                alert("Reclaim: " + z.name + " closed back " + (s > 0 ? "below" : "above") + " " +
                     str.tostring(z.level, format.mintick) + " @ " + str.tostring(close, format.mintick) +
                     (s > 0 ? "  (top, tested: no edge; fails above " : "  (bottom; fails below ") +
                     str.tostring(z.rcStop, format.mintick) + ")", alert.freq_once_per_bar_close)

        // tier 2 — grading the reclaim (from the bar after it)
        if prevRc == 2
            bool  stopped = s > 0 ? high >= z.rcStop : low <= z.rcStop
            float fav2    = s > 0 ? z.rcPrice - low : high - z.rcPrice
            if stopped
                z.rcState := 4
            else if fav2 >= z.target
                z.rcState := 3
            else if bar_index - z.rcBar >= maxBars
                z.rcState := 5

        // book a tap that was graded on this bar
        if prevState <= 1 and z.state >= 2
            int  row     = s > 0 ? 0 : 1
            bool tapHit  = z.state == 2
            bool tapFail = z.state == 3
            sDone.set(row, sDone.get(row) + 1)
            sPts.set(row, sPts.get(row) + (tapHit ? z.target : tapFail ? -math.abs(far - z.tapPrice) : s * (z.tapPrice - close)))
            if tapHit
                sHit.set(row, sHit.get(row) + 1)
            if tapFail
                sFail.set(row, sFail.get(row) + 1)
            if tapHit or tapFail
                sCh.set(row, sCh.get(row) + z.depth / (z.target + z.depth))
            color gc = tapHit ? hitColor : color.gray
            box.set_bgcolor(z.bx, color.new(gc, tapHit ? 74 : tapFail ? 90 : 92))
            box.set_border_color(z.bx, color.new(gc, tapHit ? 10 : tapFail ? 60 : 72))
            if showTaps and (tapHit or tapFail)
                label.set_text(z.tag, (s > 0 ? "▼ " : "▲ ") + z.name + (tapHit ? " ✓" : " ✗"))
                label.set_color(z.tag, color.new(gc, tapHit ? 15 : 55))
                label.set_textcolor(z.tag, tapHit ? color.black : color.white)

        // book a reclaim that was graded on this bar
        if prevRc == 2 and z.rcState >= 3 and z.rcState <= 5
            int   rrow   = s > 0 ? 3 : 2
            bool  rcHit  = z.rcState == 3
            bool  rcFail = z.rcState == 4
            float risk   = math.abs(z.rcStop - z.rcPrice)
            sDone.set(rrow, sDone.get(rrow) + 1)
            sPts.set(rrow, sPts.get(rrow) + (rcHit ? z.target : rcFail ? -risk : s * (z.rcPrice - close)))
            if rcHit
                sHit.set(rrow, sHit.get(rrow) + 1)
            if rcFail
                sFail.set(rrow, sFail.get(rrow) + 1)
            if rcHit or rcFail
                sCh.set(rrow, sCh.get(rrow) + risk / (z.target + risk))
            // a hidden top reclaim has no label to restyle
            if (rcHit or rcFail) and not na(z.rcTag)
                label.set_text(z.rcTag, "⟲ " + z.name + (rcHit ? " ✓" : " ✗"))
                label.set_color(z.rcTag, rcHit ? color.new(hitColor, 0) : color.new(color.gray, 45))
                label.set_textcolor(z.rcTag, rcHit ? color.black : color.white)

        // retire a zone once neither tier is still running
        bool alive = z.state <= 1 or z.rcState == 1 or z.rcState == 2
        if drop or not alive
            if not drop and not showGraded
                box.delete(z.bx)
                label.delete(z.tag)
            live.remove(i)

// ─────────────────────────────────────────────────────────────
// 4) SESSION TRACKERS — updated after the zones were born, so a level
//    never contains the bar it is first tested on
// ─────────────────────────────────────────────────────────────
if inAsia
    asH := na(asH) ? high : math.max(asH, high)
    asL := na(asL) ? low : math.min(asL, low)
else if inLondon
    loH := na(loH) ? high : math.max(loH, high)
    loL := na(loL) ? low : math.min(loL, low)
else if inRth
    rthH := na(rthH) ? high : math.max(rthH, high)
    rthL := na(rthL) ? low : math.min(rthL, low)

// ─────────────────────────────────────────────────────────────
// 5) CAUSAL ZIGZAG — a swing is only known once price has retraced from it
// ─────────────────────────────────────────────────────────────
if not na(adr)
    float thr   = swingAdr * adr
    bool  zzNew = zzHiBar < 0
    if zzNew
        zzHi := high
        zzLo := low
        zzHiBar := bar_index
        zzLoBar := bar_index
    if not zzNew
        if zzDir >= 0 and high > zzHi
            zzHi := high
            zzHiBar := bar_index
        if zzDir <= 0 and low < zzLo
            zzLo := low
            zzLoBar := bar_index
        if zzDir >= 0 and zzHiBar < bar_index and zzHi - low >= thr
            pendSide  := 1
            pendPrice := zzHi
            zzDir     := -1
            zzLo      := low
            zzLoBar   := bar_index
        else if zzDir <= 0 and zzLoBar < bar_index and high - zzLo >= thr
            pendSide  := -1
            pendPrice := zzLo
            zzDir     := 1
            zzHi      := high
            zzHiBar   := bar_index

// ─────────────────────────────────────────────────────────────
// SCORECARD
// ─────────────────────────────────────────────────────────────
f_cell(table t, int c, int r, string s, color tc, string al) =>
    table.cell(t, c, r, s, text_color = tc, text_halign = al, text_size = size.small)

f_rowName(int r) =>
    r == 0 ? "Taps · top zones" : r == 1 ? "Taps · bottom zones" : r == 2 ? "Reclaims · bottoms" : "Reclaims · tops"

if showDash and barstate.islast
    var table dash = table.new(position.top_right, 7, 12, bgcolor = color.new(#101418, 12),
         border_width = 1, border_color = color.new(color.gray, 75), frame_width = 1, frame_color = color.new(color.gray, 55))
    table.clear(dash, 0, 0, 6, 11)
    color dim = color.new(color.silver, 0)
    float depthNow = depthMode == "Fixed points" ? depthFixed : depthAdr * nz(adr)

    f_cell(dash, 0, 0, "REVERSAL ZONES — SCORECARD (this chart)", color.white, text.align_left)
    table.merge_cells(dash, 0, 0, 6, 0)
    f_cell(dash, 0, 1, "ADR(" + str.tostring(adrLen) + ") " + (na(adr) ? "—" : str.tostring(adr, "#")) +
         " · zone depth " + str.tostring(depthNow, "#.#") + " · target " + str.tostring(targetPts, "#") +
         " · " + str.tostring(trendLen) + "d trend " + (trend > 0 ? "▲" : trend < 0 ? "▼" : "—"), dim, text.align_left)
    table.merge_cells(dash, 0, 1, 6, 1)

    f_cell(dash, 0, 2, "",         dim, text.align_left)
    f_cell(dash, 1, 2, "n",        dim, text.align_right)
    f_cell(dash, 2, 2, "✓",        dim, text.align_right)
    f_cell(dash, 3, 2, "✗",        dim, text.align_right)
    f_cell(dash, 4, 2, "hit %",    dim, text.align_right)
    f_cell(dash, 5, 2, "chance %", dim, text.align_right)
    f_cell(dash, 6, 2, "pts/mark", dim, text.align_right)

    for r = 0 to 3
        int   nH  = sHit.get(r)
        int   nF  = sFail.get(r)
        int   dec = nH + nF
        float hr  = dec > 0 ? 100.0 * nH / dec : na
        float ch  = dec > 0 ? 100.0 * sCh.get(r) / dec : na
        // a hit rate is only evidence once it clears chance by ~2 standard errors
        float se  = dec > 0 and not na(ch) ? 100.0 * math.sqrt(ch / 100.0 * (1.0 - ch / 100.0) / dec) : na
        color hc  = na(hr) or na(se) ? color.white : hr > ch + 2.0 * se ? color.new(color.teal, 0) : hr < ch - 2.0 * se ? color.new(color.red, 0) : color.white
        color rc  = r == 2 ? color.white : dim
        f_cell(dash, 0, 3 + r, f_rowName(r), rc, text.align_left)
        f_cell(dash, 1, 3 + r, str.tostring(sN.get(r)), rc, text.align_right)
        f_cell(dash, 2, 3 + r, str.tostring(nH), rc, text.align_right)
        f_cell(dash, 3, 3 + r, str.tostring(nF), rc, text.align_right)
        f_cell(dash, 4, 3 + r, na(hr) ? "—" : str.tostring(hr, "#.#"), hc, text.align_right)
        f_cell(dash, 5, 3 + r, na(ch) ? "—" : str.tostring(ch, "#.#"), color.orange, text.align_right)
        float ppm = sDone.get(r) > 0 ? sPts.get(r) / sDone.get(r) : na
        f_cell(dash, 6, 3 + r, na(ppm) ? "—" : (ppm > 0 ? "+" : "") + str.tostring(ppm, "#.#"), rc, text.align_right)

    f_cell(dash, 0, 7, "hit % is colored only when it differs from chance by 2+ standard errors · pts before costs", dim, text.align_left)
    table.merge_cells(dash, 0, 7, 6, 7)
    f_cell(dash, 0, 8, "Backtest, 1-min bars, 1,212 sessions (2022-03 → 2026-11): hit % vs chance %, pts/mark", color.white, text.align_left)
    table.merge_cells(dash, 0, 8, 6, 8)
    f_cell(dash, 0, 9, "taps 14.6 vs 17.2 (−3.2) · bottom reclaims 23.3 vs 22.5 (+2.3) · top reclaims 18.9 vs 19.8 (−0.4)", dim, text.align_left)
    table.merge_cells(dash, 0, 9, 6, 9)
    f_cell(dash, 0, 10, "Fading the first touch loses. Bottom reclaims are the best tested and still unproven.", color.orange, text.align_left)
    table.merge_cells(dash, 0, 10, 6, 10)
    f_cell(dash, 0, 11, tfOk ? "Zones are fixed when drawn · taps print on the touch bar · reclaims on the bar close" :
         "⚠ use a 1–30 min chart (sessions end at :00/:30); backtested on 1 min",
         tfOk ? dim : color.orange, text.align_left)
    table.merge_cells(dash, 0, 11, 6, 11)

// ─────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────
alertcondition(tapTop, "Top zone tapped", "Reversal Zones: price tapped a TOP zone")
alertcondition(tapBot, "Bottom zone tapped", "Reversal Zones: price tapped a BOTTOM zone")
alertcondition(rcBot, "Bottom reclaim", "Reversal Zones: BOTTOM reclaim — a bar closed back above a swept low")
alertcondition(rcTop, "Top reclaim (tested: no edge)", "Reversal Zones: TOP reclaim — a bar closed back below a swept high")
