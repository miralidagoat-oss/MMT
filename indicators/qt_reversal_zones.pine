//@version=6
indicator("QT Reversal Zones - New York + Asia", overlay=true, max_boxes_count=300, max_bars_back=500)
string gs="Zones"
useNY=input.bool(true,"New York: 06:00-13:55 California",group=gs)
useAsia=input.bool(true,"Asia: 15:00-19:00 California",group=gs)
useSwings=input.bool(true,"Include confirmed swing zones",group=gs,tooltip="A swing needs two later closed candles. Its zone begins at confirmation, never at the earlier turning candle.")
maxZones=input.int(8,"Maximum active zones",minval=2,maxval=12,group=gs)
keepHistory=input.int(100,"Historical state segments",minval=0,maxval=240,group=gs)
showPanel=input.bool(true,"Show zone and key status",group=gs)
string gk="Optional daily key"
keyText=input.text_area("","Daily key: 25 or 26 columns",group=gk,tooltip="Paste ES/NQ rows separated by semicolons or newlines. Only ranks 5 and 4 are used. A key is optional: price zones work without it.")
priceFrame=input.string("Cash: measured offset","Key price frame",options=["Cash: measured offset","Cash: manual offset","Futures prices"],group=gk)
manualOffset=input.float(0,"Manual cash-to-futures offset",step=.25,group=gk)
legacyKnownFrom=input.time(0,"25-column key: known since (optional)",group=gk,tooltip="Leave at zero for a current-chart preview with unknown publication time. An authentic known-since time enables historical display from that time only. Do not invent an earlier timestamp.")
rollGuard=input.float(25,"Discard carried basis if it jumps by more than",minval=0,step=.25,group=gk,tooltip="Futures roll quarterly and a continuous contract keeps its ticker id across the roll, so the roll is detected from the basis itself. If the first cash-synced reading of a day disagrees with the carried basis by more than this many points, the carried value was measured on the previous front month and is discarded. Zero disables the check.")
keyDateBasis=input.string("California calendar date","Key row is dated by",options=["California calendar date","CME trading day"],group=gk,tooltip="Which date the daily key row is keyed by. California calendar date maps both the New York and the Asia block of one California day to that day's row. CME trading day follows the futures roll at 15:00 California, so the Asia block maps to the next day's row instead. Match this to how your key file is dated; the resolved date is shown on the panel.")
bool nq=syminfo.root=="MNQ" or syminfo.root=="NQ"
bool es=syminfo.root=="MES" or syminfo.root=="ES"
if barstate.isfirst and (not (nq or es) or timeframe.in_seconds()!=300 or not chart.is_standard)
    runtime.error("Use standard 5-minute MNQ, NQ, MES or ES candles.")
string ca="America/Los_Angeles"
// Session codes. The numeric values are kept as-is so nothing downstream
// shifts; SESSION_NONE is the only negative, so "in a block" is != NONE.
int SESSION_NONE=-1
int SESSION_ASIA=0
int SESSION_NY=2
// Daily key row layout, 25 or 26 comma-separated fields. Only these five are
// read; every other field just has to be present for the count to validate.
//   0 symbol tag (NQ or ES)   1 date YYYYMMDD   9 rank 5 price
//   12 rank 4 price           25 publication time, Unix ms (26-column rows)
int KEY_COL_TAG=0
int KEY_COL_DATE=1
int KEY_COL_RANK5=9
int KEY_COL_RANK4=12
int KEY_COL_PUBLISHED=25
// Five days covers a normal weekend plus one adjacent holiday.
int RANGE_MAX_AGE_MS=5*86400000
int BASIS_MAX_AGE_MS=5*86400000
int minute=hour(time,ca)*60+minute(time,ca)
int session=useNY and minute>=360 and minute<835 ? SESSION_NY : useAsia and minute>=900 and minute<1140 ? SESSION_ASIA : SESSION_NONE
bool dayChanged=ta.change(time_tradingday)!=0
bool blockChanged=barstate.isfirst or dayChanged or session!=session[1]
// The key row is looked up by date, and that date has to agree with the block
// deadline below, which is built from the California calendar date. CME equity
// index futures roll the trading day at 15:00 California, so the Asia block
// (15:00-19:00) falls in the NEXT trading day while its deadline stays on the
// current calendar day - the two halves of one lookup disagreed. Both are now
// derived from the California calendar date, and the roll is applied here
// explicitly rather than via time_tradingday, whose session-start anchoring is
// not what the "trading day" label means for an overnight session.
int tradingDayShift=hour(time,ca)>=15 ? 86400000 : 0
string dateKey=str.format_time(keyDateBasis=="CME trading day" ? time+tradingDayShift : time,"yyyyMMdd",ca)
string tag=nq ? "NQ" : "ES"
float atr=ta.atr(14)
float low5=ta.lowest(low,5)
float high5=ta.highest(high,5)
float halfWidth=math.round_to_mintick(math.max(nq ? 2.0 : .5,math.min(nq ? 6.0 : 1.5,atr*.12)))
int deadline=timestamp(ca,year(time,ca),month(time,ca),dayofmonth(time,ca),session==SESSION_NY ? 13 : 19,session==SESSION_NY ? 55 : 0)
type Zone
    float p
    float w
    int side
    int born
    int until
    int sources
    string names
    int touches
    int rejects
    bool rejected
    int bad
    int state
    bool outside
    box drawing
var array<Zone> zones=array.new<Zone>()
var array<box> history=array.new<box>()
var array<float> swingPrices=array.new<float>()
var array<int> swingTimes=array.new<int>()
f_has(int mask,int bit)=>int(math.floor(mask/bit))%2==1
// Source bits: 1 NY high, 2 swing, 4 key, 8 NY low. NY high and NY low were
// both bit 1, so on a narrow range the low merged into the high and vanished
// from the label without adding a source.
f_count(int mask)=>(f_has(mask,1) ? 1 : 0)+(f_has(mask,2) ? 1 : 0)+(f_has(mask,4) ? 1 : 0)+(f_has(mask,8) ? 1 : 0)
// "Rejected" was sticky and outranked the touch count, so a zone that rejected
// once and was then tested three more times still read "Rejected". Report both
// numbers instead: held/tested.
f_state(Zone z)=>z.side==0 ? "At price" : z.touches==0 ? "Fresh" : str.tostring(z.rejects)+"/"+str.tostring(z.touches)+" held"
f_color(Zone z)=>z.side==1 ? color.rgb(31,157,148) : z.side==-1 ? color.rgb(226,139,54) : color.rgb(140,150,165)
f_text(Zone z)=>z.names+" | "+f_state(z)
f_remember(box drawing)=>
    array.push(history,drawing)
    if array.size(history)>keepHistory
        box.delete(array.shift(history))
f_segment(Zone z,int when)=>
    if not na(z.drawing)
        box.set_right(z.drawing,math.min(when,z.until))
        f_remember(z.drawing)
    int right=math.min(when+30*60000,z.until)
    color col=f_color(z)
    z.drawing:=box.new(when,z.p+z.w,right,z.p-z.w,xloc=xloc.bar_time,border_color=color.new(col,20),border_width=f_count(z.sources)>1 ? 2 : 1,bgcolor=color.new(col,z.state==2 ? 82 : z.touches>0 ? 93 : 88),text=f_text(z),text_color=col,text_size=size.tiny,text_halign=text.align_right)
f_retire(Zone z,int when,bool broken)=>
    if not na(z.drawing)
        box.set_right(z.drawing,math.min(when,z.until))
        f_remember(z.drawing)
        if broken
            box marker=box.new(when,z.p+z.w,math.min(when+5*60000,z.until),z.p-z.w,xloc=xloc.bar_time,border_color=color.gray,bgcolor=color.new(color.gray,90),text="Broken",text_size=size.tiny,text_color=color.gray)
            f_remember(marker)
// Returns true when the level ended up represented on the chart, as a new zone
// or merged into an overlapping one. False means it was dropped for want of a
// slot, which previously happened silently.
f_add(float p,float w,int source,string name,int when,float price,float scale,int until)=>
    bool placed=false
    bool candidate=not na(p) and not na(w) and not na(scale) and p>0 and (source==4 or math.abs(p-price)>w and math.abs(p-price)<=12*scale) and when<until
    if candidate
        bool merged=false
        if array.size(zones)>0
            for z in zones
                if not merged and math.abs(p-z.p)<=z.w
                    if not f_has(z.sources,source)
                        z.sources+=source
                        z.names+=" + "+name
                        f_segment(z,when)
                    merged:=true
                    placed:=true
                else if not merged and math.abs(p-z.p)<w+z.w
                    merged:=true
                    placed:=true
        if not merged
            if array.size(zones)>=maxZones
                int farIndex=0
                float farDistance=-1
                for j=0 to array.size(zones)-1
                    float dist=math.abs(array.get(zones,j).p-price)
                    if dist>farDistance and (source!=4 or not f_has(array.get(zones,j).sources,4))
                        farIndex:=j
                        farDistance:=dist
                // Parenthesised: this relied on "and" binding tighter than "or".
                if farDistance>math.abs(p-price) or (source==4 and farDistance>=0)
                    Zone removed=array.remove(zones,farIndex)
                    f_retire(removed,when,false)
                else
                    merged:=true
            if not merged
                // Side 0 means undetermined: the level sits within w of the
                // reference price, so the side it will be tested from is not
                // knowable yet. It is resolved later rather than guessed.
                Zone z=Zone.new(p,w,math.abs(p-price)<=w ? 0 : p<price ? 1 : -1,when,until,source,name,0,0,false,0,math.abs(p-price)<=w ? 3 : 0,true,na)
                f_segment(z,when)
                array.push(zones,z)
                placed:=true
    placed
var float nyHigh=na
var float nyLow=na
var int nyBars=0
var float completedHigh=na
var float completedLow=na
var int completedAt=na
[cash,cashTime]=request.security(nq ? "NASDAQ:NDX" : "SP:SPX",timeframe.period,[close,time],gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true)
var float basisEstimate=na
var int basisSamples=0
var float completedBasis=na
var int basisAt=na
var map<string,string> keys=map.new<string,string>()
var map<string,bool> duplicates=map.new<string,bool>()
var int malformed=0
var int matchingRows=0
if barstate.isfirst and str.length(str.trim(keyText))>0
    string cleaned=str.replace_all(str.replace_all(keyText,"\r",""),"\n",";")
    for raw in str.split(cleaned,";")
        if str.length(str.trim(raw))>0
            f=str.split(str.trim(raw),",")
            if array.size(f)!=25 and array.size(f)!=26
                malformed+=1
            else if str.trim(array.get(f,KEY_COL_TAG))==tag
                string keyDate=str.trim(array.get(f,KEY_COL_DATE))
                if str.length(keyDate)!=8 or na(str.tonumber(keyDate))
                    malformed+=1
                else
                    matchingRows+=1
                    if map.contains(keys,keyDate)
                        map.put(duplicates,keyDate,true)
                    map.put(keys,keyDate,str.trim(raw))
var float key5=na
var float key4=na
var float keyAt=na
var bool legacy=false
var bool haveKey=false
var bool keyAdded=false
var bool keyMissed=false
var string keyStatus="Price zones active; key optional"
// Retiring and re-seeding zones creates and deletes boxes and mutates the zones
// array. blockChanged stays true for every realtime tick of a block's first bar,
// so that work is deferred to the bar's confirmation and runs exactly once. The
// scalar key state below is idempotent and stays here so the panel reflects the
// new block immediately.
var bool pendingSeed=false
if blockChanged
    pendingSeed:=true
    keyAdded:=false
    keyMissed:=false
    key5:=na
    key4:=na
    keyAt:=na
    legacy:=false
    haveKey:=false
    keyStatus:=str.length(str.trim(keyText))==0 ? "Price zones active; key optional" : malformed>0 ? "Malformed key row(s); price zones active" : matchingRows==0 ? "No "+tag+" rows; price zones active" : "No key for "+dateKey+"; price zones active"
    if map.contains(keys,dateKey)
        if map.contains(duplicates,dateKey)
            keyStatus:="Duplicate key date; price zones active"
        else
            f=str.split(map.get(keys,dateKey),",")
            // Trimmed like the tag and date above. A key written with a
            // space after each comma reaches these fields as " 21000.25",
            // and an untrimmed read rejected the whole row as invalid.
            key5:=str.tonumber(str.trim(array.get(f,KEY_COL_RANK5)))
            key4:=str.tonumber(str.trim(array.get(f,KEY_COL_RANK4)))
            legacy:=array.size(f)==25
            keyAt:=legacy ? legacyKnownFrom>0 ? legacyKnownFrom : na : str.tonumber(str.trim(array.get(f,KEY_COL_PUBLISHED)))
            haveKey:=not na(key5) and key5>0 and not na(key4) and key4>0
            if not haveKey
                keyStatus:="Invalid 4/5 level prices; price zones active"
            else if not legacy and (na(keyAt) or keyAt<1000000000000)
                haveKey:=false
                keyStatus:="Invalid publication time; price zones active"
            else
                keyStatus:=legacy and na(keyAt) ? "Legacy key: current preview, timing unknown" : "Key waiting for its availability time"
if barstate.isconfirmed
    // Seeded with the block's open time, so zone birth timestamps and the
    // "born==time ? open : close[1]" reference below are unchanged; only the
    // moment of execution moved.
    if pendingSeed
        pendingSeed:=false
        if array.size(zones)>0
            for z in zones
                f_retire(z,time,false)
            array.clear(zones)
        if session!=SESSION_NONE and not na(atr[1])
            float w=halfWidth[1]
            if not na(completedAt) and time-completedAt<=RANGE_MAX_AGE_MS
                f_add(completedHigh,w,1,"NY high",time,open,atr[1],deadline)
                f_add(completedLow,w,8,"NY low",time,open,atr[1],deadline)
            if useSwings and array.size(swingPrices)>0
                for j=0 to array.size(swingPrices)-1
                    int k=array.size(swingPrices)-1-j
                    if time-array.get(swingTimes,k)<=86400000
                        f_add(array.get(swingPrices,k),w,2,"Swing",time,open,atr[1],deadline)
    if session!=SESSION_NONE and array.size(zones)>0
        int j=array.size(zones)-1
        while j>=0
            Zone z=array.get(zones,j)
            if z.born<=time
                int priorState=z.state
                int priorTouches=z.touches
                int priorRejects=z.rejects
                bool gone=false
                if z.side==0
                    // Undetermined side. A level created around the current
                    // price cannot be touched or broken in any meaningful
                    // direction yet, so nothing is counted until price closes
                    // clear of an edge and settles which side it is tested
                    // from. Guessing here is what made key levels injected at
                    // price classify arbitrarily.
                    if close>z.p+z.w
                        z.side:=1
                        z.outside:=true
                        z.state:=0
                    else if close<z.p-z.w
                        z.side:=-1
                        z.outside:=true
                        z.state:=0
                else
                    float near=z.p+z.side*z.w
                    float far=z.p-z.side*z.w
                    bool contact=low<=z.p+z.w and high>=z.p-z.w
                    bool approached=((z.born==time ? open : close[1])-near)*z.side>0
                    if contact and z.outside and approached
                        z.touches+=1
                        z.outside:=false
                        z.rejected:=false
                        z.state:=1
                    if not contact and (close-near)*z.side>z.w
                        z.outside:=true
                    z.bad:=(close-far)*z.side < -syminfo.mintick ? z.bad+1 : 0
                    if z.bad>=2
                        f_retire(z,time_close,true)
                        array.remove(zones,j)
                        gone:=true
                    else if contact and (close-near)*z.side>0 and not z.rejected
                        // One rejection per touch episode. The flag clears when
                        // the next touch starts, so several closes back on the
                        // approach side during one visit are not recounted.
                        z.rejects+=1
                        z.rejected:=true
                        z.state:=2
                if not gone and (z.state!=priorState or z.touches!=priorTouches or z.rejects!=priorRejects)
                    f_segment(z,time_close)
            j-=1
    if dayChanged or minute==390
        nyHigh:=na
        nyLow:=na
        nyBars:=0
        basisEstimate:=na
        basisSamples:=0
    if minute>=390 and minute<780
        nyHigh:=na(nyHigh) ? high : math.max(nyHigh,high)
        nyLow:=na(nyLow) ? low : math.min(nyLow,low)
        nyBars+=1
        if not na(cash) and cashTime==time
            float observation=close-cash
            // Futures roll quarterly and a continuous contract keeps its ticker
            // id across the roll, so the roll cannot be seen from the symbol.
            // Detect it from the basis: if the day's first cash-synced reading
            // disagrees with the carried value by more than rollGuard, that
            // value was measured on the previous front month. Discard it rather
            // than place key levels off by the whole carry difference; the
            // status line then reports a missing offset until today's capture.
            if rollGuard>0 and basisSamples==0 and not na(completedBasis) and math.abs(observation-completedBasis)>rollGuard
                completedBasis:=na
                basisAt:=na
            basisEstimate:=na(basisEstimate) ? observation : basisEstimate+(observation-basisEstimate)/60
            basisSamples+=1
        if minute==775 and nyBars>=75
            completedHigh:=nyHigh
            completedLow:=nyLow
            completedAt:=time_close
            completedBasis:=basisSamples>=30 ? basisEstimate : na
            basisAt:=basisSamples>=30 ? time_close : na
    bool contiguous=time-time[4]==20*60000
    bool ph=contiguous and high[2]>high[4] and high[2]>high[3] and high[2]>high[1] and high[2]>high and high[2]-low5>=.75*atr
    bool pl=contiguous and low[2]<low[4] and low[2]<low[3] and low[2]<low[1] and low[2]<low and high5-low[2]>=.75*atr
    if useSwings and (ph or pl)
        for side=0 to 1
            if side==0 ? ph : pl
                float p=side==0 ? high[2] : low[2]
                array.push(swingPrices,p)
                array.push(swingTimes,time_close)
                if array.size(swingPrices)>8
                    array.shift(swingPrices)
                    array.shift(swingTimes)
                if session!=SESSION_NONE and time_close<deadline
                    f_add(p,halfWidth,2,"Swing",time_close,close,atr,deadline)
bool previewNow=legacy and na(keyAt) and (barstate.islastconfirmedhistory or barstate.isrealtime)
bool publishedNow=not na(keyAt) and time_close>=keyAt
float offset=priceFrame=="Futures prices" ? 0 : priceFrame=="Cash: manual offset" ? manualOffset : not na(basisAt) and time-basisAt<=BASIS_MAX_AGE_MS ? completedBasis : na
if session!=SESSION_NONE and haveKey and not keyAdded and (previewNow or publishedNow) and barstate.isconfirmed and time_close<deadline
    if na(offset)
        keyStatus:="Key needs cash offset; price zones active"
    else
        string suffix=previewNow ? " preview" : ""
        bool placed5=f_add(math.round_to_mintick(key5+offset),halfWidth,4,"Key 5"+suffix,time_close,close,atr,deadline)
        bool placed4=f_add(math.round_to_mintick(key4+offset),halfWidth,4,"Key 4"+suffix,time_close,close,atr,deadline)
        keyAdded:=true
        keyStatus:=not (placed5 and placed4) ? "Key level dropped; raise Maximum active zones" : previewNow ? "Legacy preview active; timing unknown" : "Key read; ranks 4/5 added or merged"
// The block deadline has passed with a valid key still unplaced, so nothing
// further will happen for it. Replace the pending status rather than leaving
// "waiting for its availability time" on the panel for the rest of the day.
if session!=SESSION_NONE and haveKey and not keyAdded and not keyMissed and barstate.isconfirmed and time_close>=deadline
    keyMissed:=true
    keyStatus:="Key not available before block deadline; price zones active"
if session!=SESSION_NONE and array.size(zones)>0
    for z in zones
        box.set_right(z.drawing,math.min(time_close+30*60000,z.until))
var table panel=table.new(position.top_right,1,10,bgcolor=color.new(color.rgb(15,23,34),9),frame_color=color.new(color.gray,60),frame_width=1)
if barstate.islast and showPanel
    table.cell(panel,0,0,"QT REVERSAL ZONES",text_color=color.white,text_size=size.small)
    string sessionText=session==SESSION_NY ? "NEW YORK | 06:00-13:55 CA" : session==SESSION_ASIA ? "ASIA | 15:00-19:00 CA" : "Outside session | 06:00-19:00 CA"
    table.cell(panel,0,1,sessionText,text_color=color.silver,text_size=size.small)
    table.cell(panel,0,2,"Key date "+dateKey+" | "+(keyDateBasis=="CME trading day" ? "CME trading day" : "CA calendar"),text_color=color.silver,text_size=size.tiny)
    table.cell(panel,0,3,keyStatus,text_color=haveKey and not keyAdded and not keyMissed ? color.orange : color.silver,text_size=size.tiny)
    // The offset the key levels are shifted by, and how old the measurement is,
    // so a basis carried across a roll or a quiet cash feed is visible instead
    // of being applied silently.
    string frameText=priceFrame=="Futures prices" ? "Key frame: futures prices, no offset" : priceFrame=="Cash: manual offset" ? "Key frame: cash + manual "+str.tostring(manualOffset,format.mintick) : na(offset) ? "Key frame: cash, no usable offset measured" : "Key frame: cash + "+str.tostring(offset,format.mintick)+", measured "+str.tostring((time-basisAt)/86400000.0,"#.#")+"d ago"
    table.cell(panel,0,4,frameText,text_color=priceFrame!="Futures prices" and na(offset) ? color.orange : color.silver,text_size=size.tiny)
    table.cell(panel,0,5,"Bold border = multiple sources, not win probability",text_color=color.silver,text_size=size.tiny)
    array<float> distances=array.new<float>()
    if array.size(zones)>0
        for z in zones
            array.push(distances,math.abs(z.p-close))
    for row=0 to 3
        string txt=row==0 and array.size(zones)==0 ? "Waiting for nearby confirmed levels" : ""
        color col=color.silver
        if array.size(distances)>row
            int idx=array.indexof(distances,array.min(distances))
            Zone z=array.get(zones,idx)
            txt:=(z.side==1 ? "Lower " : z.side==-1 ? "Upper " : "At price ")+str.tostring(z.p-z.w,format.mintick)+" - "+str.tostring(z.p+z.w,format.mintick)+" | "+z.names+" | "+f_state(z)
            col=f_color(z)
            array.set(distances,idx,1e20)
        table.cell(panel,0,row+6,txt,text_color=col,text_size=size.tiny)
