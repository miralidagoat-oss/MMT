//@version=6
indicator("Premium & Discount Zones", "P/D Zones", overlay = true, max_boxes_count = 20, max_lines_count = 20, max_labels_count = 20)

// ============================================================================
// Premium & Discount Zones — where price sits inside its dealing range, on
// every timeframe at once.
//
// Dealing range, per timeframe: the most recent confirmed swing high and
// swing low, each trailing to any new extreme so price is always inside the
// range (or, optionally, the highest high and lowest low of the last N bars).
// Equilibrium is the 50% level: above it is premium, below it is discount.
//
//   Depth     how far into its zone price is: 0% = equilibrium,
//             100% = the range high (premium) or the range low (discount)
//   In range  where price sits: 0% = range low, 100% = range high
//
// Higher timeframes come from request.security() and are read on the last
// bar only, so every reading is that timeframe's live state. Timeframes
// below the chart's are not requested (lower-timeframe data from
// request.security() is unreliable); open a lower chart to see them.
// ============================================================================

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
var string G_RNG = "Dealing range"
var string G_ZN  = "Zones on chart"
var string G_TF  = "Timeframes"
var string G_UI  = "Display"

modeIn = input.string("Swing", "Range from", options = ["Swing", "Lookback"], group = G_RNG,
     tooltip = "Swing: the most recent confirmed swing high and swing low, trailing to any new extreme. Lookback: highest high and lowest low of the last N bars.")
lenIn  = input.int(10, "Swing strength (bars each side)", minval = 1, maxval = 100, group = G_RNG)
lbIn   = input.int(100, "Lookback (bars)", minval = 2, maxval = 5000, group = G_RNG)
eqIn   = input.float(2.5, "Equilibrium band (± % of range)", minval = 0.0, maxval = 20.0, step = 0.5, group = G_RNG,
     tooltip = "Price within this distance of the 50% level reads as equilibrium.")

showZn = input.bool(true, "Show zones", group = G_ZN)
zoneTf = input.timeframe("", "Zones from timeframe", group = G_ZN,
     tooltip = "Blank = the chart's timeframe. Pick a higher one to draw that timeframe's zones on this chart.")
showQ  = input.bool(true, "Quarter lines (25% / 75%)", group = G_ZN)
extIn  = input.int(15, "Extend right (bars)", minval = 0, maxval = 200, group = G_ZN)

on1 = input.bool(true, "", inline = "1", group = G_TF)
tf1 = input.timeframe("1", "", inline = "1", group = G_TF)
on2 = input.bool(true, "", inline = "2", group = G_TF)
tf2 = input.timeframe("5", "", inline = "2", group = G_TF)
on3 = input.bool(true, "", inline = "3", group = G_TF)
tf3 = input.timeframe("15", "", inline = "3", group = G_TF)
on4 = input.bool(true, "", inline = "4", group = G_TF)
tf4 = input.timeframe("60", "", inline = "4", group = G_TF)
on5 = input.bool(true, "", inline = "5", group = G_TF)
tf5 = input.timeframe("240", "", inline = "5", group = G_TF)
on6 = input.bool(true, "", inline = "6", group = G_TF)
tf6 = input.timeframe("D", "", inline = "6", group = G_TF)
on7 = input.bool(true, "", inline = "7", group = G_TF)
tf7 = input.timeframe("W", "", inline = "7", group = G_TF)
on8 = input.bool(true, "", inline = "8", group = G_TF)
tf8 = input.timeframe("M", "", inline = "8", group = G_TF)

showTb  = input.bool(true, "Timeframe table", group = G_UI)
posIn   = input.string("Top right", "Table position", options = ["Top right", "Middle right", "Bottom right", "Top left", "Middle left", "Bottom left"], group = G_UI)
premCol = input.color(#F23645, "Premium", group = G_UI)
discCol = input.color(#089981, "Discount", group = G_UI)
eqCol   = input.color(#787B86, "Equilibrium", group = G_UI)

// ─────────────────────────────────────────────────────────────
// FUNCTIONS
// ─────────────────────────────────────────────────────────────
// [top, bottom, time the top was set, time the bottom was set] of the dealing range
dealingRange(string mode, simple int len, simple int lb) =>
    float ph   = ta.pivothigh(high, len, len)
    float pl   = ta.pivotlow(low, len, len)
    float hh   = ta.highest(high, lb)
    float ll   = ta.lowest(low, lb)
    int   tLen = time[len]
    int   tLb  = time[lb - 1]
    var float top  = na
    var float bot  = na
    var int   topT = na
    var int   botT = na
    if mode == "Swing"
        // a confirmed swing resets its side of the range to the newest swing...
        if not na(ph)
            top  := ph
            topT := tLen
        if not na(pl)
            bot  := pl
            botT := tLen
        // ...and each side trails any new extreme, so price never leaves the range
        if na(top) or high > top
            top  := high
            topT := time
        if na(bot) or low < bot
            bot  := low
            botT := time
    else
        top  := hh
        bot  := ll
        topT := tLb
        botT := tLb
    [top, bot, topT, botT]

// short label for a timeframe string ("5", "60", "240", "1D", "W", "3M", "30S"):
// 5m, 1H, 4H, D, W, 3M, 30s
tfLabel(string tf) =>
    int    nChars = str.length(tf)
    string unit   = nChars > 0 ? str.substring(tf, nChars - 1) : ""
    bool   hasU   = unit == "S" or unit == "D" or unit == "W" or unit == "M" or unit == "T"
    string numS   = hasU ? str.substring(tf, 0, nChars - 1) : tf
    float  numF   = numS == "" ? 1.0 : str.tonumber(numS)
    int    n      = na(numF) ? 1 : math.round(numF)
    string out    = ""
    if unit == "S"
        out := str.tostring(n) + "s"
    else if unit == "D"
        out := n == 1 ? "D" : str.tostring(n) + "D"
    else if unit == "W"
        out := n == 1 ? "W" : str.tostring(n) + "W"
    else if unit == "M"
        out := n == 1 ? "M" : str.tostring(n) + "M"
    else if unit == "T"
        out := str.tostring(n) + "T"
    else
        out := n % 60 == 0 ? str.tostring(math.round(n / 60.0)) + "H" : str.tostring(n) + "m"
    out

pctTxt(float x) =>
    str.tostring(math.round(x * 100)) + "%"

// ─────────────────────────────────────────────────────────────
// TIMEFRAMES (never request one below the chart's)
// ─────────────────────────────────────────────────────────────
float  eqB     = eqIn / 100.0
string chartTf = timeframe.period
int    chartS  = timeframe.in_seconds(chartTf)

string r1 = tf1 == "" ? chartTf : tf1
string r2 = tf2 == "" ? chartTf : tf2
string r3 = tf3 == "" ? chartTf : tf3
string r4 = tf4 == "" ? chartTf : tf4
string r5 = tf5 == "" ? chartTf : tf5
string r6 = tf6 == "" ? chartTf : tf6
string r7 = tf7 == "" ? chartTf : tf7
string r8 = tf8 == "" ? chartTf : tf8
string rz = zoneTf == "" ? chartTf : zoneTf
int s1 = timeframe.in_seconds(r1)
int s2 = timeframe.in_seconds(r2)
int s3 = timeframe.in_seconds(r3)
int s4 = timeframe.in_seconds(r4)
int s5 = timeframe.in_seconds(r5)
int s6 = timeframe.in_seconds(r6)
int s7 = timeframe.in_seconds(r7)
int s8 = timeframe.in_seconds(r8)
int sz = timeframe.in_seconds(rz)
string q1 = s1 < chartS ? chartTf : r1
string q2 = s2 < chartS ? chartTf : r2
string q3 = s3 < chartS ? chartTf : r3
string q4 = s4 < chartS ? chartTf : r4
string q5 = s5 < chartS ? chartTf : r5
string q6 = s6 < chartS ? chartTf : r6
string q7 = s7 < chartS ? chartTf : r7
string q8 = s8 < chartS ? chartTf : r8
string qz = sz < chartS ? chartTf : rz

// lookahead_on gives the developing higher-timeframe bar on the last chart bar,
// including after the session closes; these values are only read there
[t1, b1, a1, c1] = request.security(syminfo.tickerid, q1, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t2, b2, a2, c2] = request.security(syminfo.tickerid, q2, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t3, b3, a3, c3] = request.security(syminfo.tickerid, q3, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t4, b4, a4, c4] = request.security(syminfo.tickerid, q4, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t5, b5, a5, c5] = request.security(syminfo.tickerid, q5, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t6, b6, a6, c6] = request.security(syminfo.tickerid, q6, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t7, b7, a7, c7] = request.security(syminfo.tickerid, q7, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[t8, b8, a8, c8] = request.security(syminfo.tickerid, q8, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)
[zTop, zBot, zTopT, zBotT] = request.security(syminfo.tickerid, qz, dealingRange(modeIn, lenIn, lbIn), lookahead = barmerge.lookahead_on)

string lab1 = tfLabel(r1)
string lab2 = tfLabel(r2)
string lab3 = tfLabel(r3)
string lab4 = tfLabel(r4)
string lab5 = tfLabel(r5)
string lab6 = tfLabel(r6)
string lab7 = tfLabel(r7)
string lab8 = tfLabel(r8)
string labZ = tfLabel(qz)

// ─────────────────────────────────────────────────────────────
// ALERTS (chart timeframe, computed bar by bar: no lookahead)
// ─────────────────────────────────────────────────────────────
[cTop, cBot, cTopT, cBotT] = dealingRange(modeIn, lenIn, lbIn)
float cPos  = cTop > cBot ? (close - cBot) / (cTop - cBot) : na
int   cZone = na(cPos) ? 0 : cPos > 0.5 + eqB ? 1 : cPos < 0.5 - eqB ? -1 : 0
bool  cOk   = not na(cPos) and not na(cPos[1])
alertcondition(cOk and cZone == -1 and cZone[1] != -1, "Entered discount", "{{ticker}} entered the discount zone")
alertcondition(cOk and cZone == 1 and cZone[1] != 1, "Entered premium", "{{ticker}} entered the premium zone")
alertcondition(cOk and cZone == 0 and cZone[1] != 0, "Reached equilibrium", "{{ticker}} reached equilibrium")

// ─────────────────────────────────────────────────────────────
// DISPLAY
// ─────────────────────────────────────────────────────────────
var box   bxP  = na
var box   bxE  = na
var box   bxD  = na
var line  lnM  = na
var line  lnQ1 = na
var line  lnQ3 = na
var label lbN  = na
var table tb   = na
string tbPos = posIn == "Top right" ? position.top_right : posIn == "Middle right" ? position.middle_right : posIn == "Bottom right" ? position.bottom_right : posIn == "Top left" ? position.top_left : posIn == "Middle left" ? position.middle_left : position.bottom_left

if barstate.islast
    if not na(bxP)
        box.delete(bxP)
    if not na(bxE)
        box.delete(bxE)
    if not na(bxD)
        box.delete(bxD)
    if not na(lnM)
        line.delete(lnM)
    if not na(lnQ1)
        line.delete(lnQ1)
    if not na(lnQ3)
        line.delete(lnQ3)
    if not na(lbN)
        label.delete(lbN)
    bxP  := na
    bxE  := na
    bxD  := na
    lnM  := na
    lnQ1 := na
    lnQ3 := na
    lbN  := na

    // ── zones of the selected timeframe ──
    if showZn and not na(zTop) and not na(zBot) and zTop > zBot
        float rng  = zTop - zBot
        float mid  = zBot + 0.5 * rng
        float eqHi = zBot + (0.5 + eqB) * rng
        float eqLo = zBot + (0.5 - eqB) * rng
        int   x0   = math.min(na(zTopT) ? time : zTopT, na(zBotT) ? time : zBotT)
        int   x1   = time + (extIn + 1) * chartS * 1000
        bxP := box.new(x0, zTop, x1, eqHi, xloc = xloc.bar_time, border_color = color.new(premCol, 70), bgcolor = color.new(premCol, 88),
             text = "Premium", text_color = premCol, text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        if eqB > 0
            bxE := box.new(x0, eqHi, x1, eqLo, xloc = xloc.bar_time, border_color = color.new(eqCol, 80), bgcolor = color.new(eqCol, 88),
                 text = "Equilibrium", text_color = eqCol, text_size = size.small, text_halign = text.align_right, text_valign = text.align_center)
        bxD := box.new(x0, eqLo, x1, zBot, xloc = xloc.bar_time, border_color = color.new(discCol, 70), bgcolor = color.new(discCol, 88),
             text = "Discount", text_color = discCol, text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
        lnM := line.new(x0, mid, x1, mid, xloc = xloc.bar_time, color = color.new(eqCol, 20), style = line.style_dashed, width = 1)
        if showQ
            lnQ1 := line.new(x0, zBot + 0.25 * rng, x1, zBot + 0.25 * rng, xloc = xloc.bar_time, color = color.new(discCol, 55), style = line.style_dotted, width = 1)
            lnQ3 := line.new(x0, zBot + 0.75 * rng, x1, zBot + 0.75 * rng, xloc = xloc.bar_time, color = color.new(premCol, 55), style = line.style_dotted, width = 1)

        // reading at the current price
        float p     = (close - zBot) / rng
        int   z     = p > 0.5 + eqB ? 1 : p < 0.5 - eqB ? -1 : 0
        float depth = math.abs(p - 0.5) / 0.5
        color zc    = z == 1 ? premCol : z == -1 ? discCol : eqCol
        string txt  = z == 1 ? "PREMIUM " + pctTxt(depth) : z == -1 ? "DISCOUNT " + pctTxt(depth) : "EQUILIBRIUM"
        float  vsEq = (close - mid) / mid
        string tip  = labZ + " dealing range " + str.tostring(zBot, format.mintick) + " – " + str.tostring(zTop, format.mintick) +
             "\nEquilibrium " + str.tostring(mid, format.mintick) +
             "\nPrice at " + pctTxt(p) + " of the range, " + pctTxt(depth) + " of the way from equilibrium to the " + (p >= 0.5 ? "high" : "low") +
             "\n" + str.tostring(math.abs(vsEq) * 100, "#.##") + "% " + (vsEq >= 0 ? "above" : "below") + " equilibrium in price"
        lbN := label.new(x1, close, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(zc, 10),
             textcolor = color.white, size = size.small, tooltip = tip)

    // ── every timeframe at once ──
    if not na(tb)
        table.delete(tb)
        tb := na
    if showTb
        color fg    = chart.fg_color
        color muted = color.new(chart.fg_color, 40)
        color faint = color.new(chart.fg_color, 65)
        tb := table.new(tbPos, 4, 12, bgcolor = color.new(chart.bg_color, 6), frame_color = color.new(chart.fg_color, 82),
             frame_width = 1, border_color = color.new(chart.fg_color, 92), border_width = 1)
        table.cell(tb, 0, 0, "PREMIUM / DISCOUNT", text_color = fg, text_halign = text.align_left, text_size = size.small,
             tooltip = "Dealing range: " + (modeIn == "Swing" ? "swings of " + str.tostring(lenIn) + " bars each side" : "last " + str.tostring(lbIn) + " bars") + " on each timeframe")
        table.merge_cells(tb, 0, 0, 3, 0)
        table.cell(tb, 0, 1, "TF", text_color = faint, text_halign = text.align_left, text_size = size.small)
        table.cell(tb, 1, 1, "Zone", text_color = faint, text_halign = text.align_left, text_size = size.small)
        table.cell(tb, 2, 1, "Depth", text_color = faint, text_halign = text.align_right, text_size = size.small,
             tooltip = "How far into its zone price is: 0% = equilibrium, 100% = the range high (premium) or the range low (discount)")
        table.cell(tb, 3, 1, "In range", text_color = faint, text_halign = text.align_right, text_size = size.small,
             tooltip = "Where price sits in the dealing range: 0% = range low, 100% = range high")

        array<bool>   ons  = array.from(on1, on2, on3, on4, on5, on6, on7, on8)
        array<string> labs = array.from(lab1, lab2, lab3, lab4, lab5, lab6, lab7, lab8)
        array<int>    secs = array.from(s1, s2, s3, s4, s5, s6, s7, s8)
        array<float>  tops = array.from(t1, t2, t3, t4, t5, t6, t7, t8)
        array<float>  bots = array.from(b1, b2, b3, b4, b5, b6, b7, b8)
        int row = 2
        int nP  = 0
        int nD  = 0
        int nE  = 0
        for i = 0 to 7
            if array.get(ons, i)
                float tp = array.get(tops, i)
                float bt = array.get(bots, i)
                table.cell(tb, 0, row, array.get(labs, i), text_color = fg, text_halign = text.align_left, text_size = size.small)
                if array.get(secs, i) < chartS
                    table.cell(tb, 1, row, "—", text_color = faint, text_halign = text.align_left, text_size = size.small,
                         tooltip = "Below the chart's timeframe: open a lower timeframe chart to see it")
                    table.merge_cells(tb, 1, row, 3, row)
                else if na(tp) or na(bt) or tp <= bt
                    table.cell(tb, 1, row, "—", text_color = faint, text_halign = text.align_left, text_size = size.small,
                         tooltip = "Not enough history on this timeframe yet")
                    table.merge_cells(tb, 1, row, 3, row)
                else
                    float p     = (close - bt) / (tp - bt)
                    int   z     = p > 0.5 + eqB ? 1 : p < 0.5 - eqB ? -1 : 0
                    float depth = math.abs(p - 0.5) / 0.5
                    color zc    = z == 1 ? premCol : z == -1 ? discCol : eqCol
                    string tip  = "Range " + str.tostring(bt, format.mintick) + " – " + str.tostring(tp, format.mintick) +
                         " · equilibrium " + str.tostring(bt + 0.5 * (tp - bt), format.mintick)
                    table.cell(tb, 1, row, z == 1 ? "Premium" : z == -1 ? "Discount" : "Equilibrium", text_color = zc,
                         text_halign = text.align_left, text_size = size.small, tooltip = tip)
                    table.cell(tb, 2, row, pctTxt(depth), text_color = fg, bgcolor = color.new(zc, 88 - 58 * depth),
                         text_halign = text.align_right, text_size = size.small, tooltip = tip)
                    table.cell(tb, 3, row, pctTxt(p), text_color = muted, text_halign = text.align_right, text_size = size.small, tooltip = tip)
                    nP += z == 1 ? 1 : 0
                    nD += z == -1 ? 1 : 0
                    nE += z == 0 ? 1 : 0
                row += 1

        int nAll = nP + nD + nE
        if nAll > 0
            string sumTxt = nD > nP ? "Discount on " + str.tostring(nD) + " of " + str.tostring(nAll) + " timeframes" :
                 nP > nD ? "Premium on " + str.tostring(nP) + " of " + str.tostring(nAll) + " timeframes" :
                 "Mixed · " + str.tostring(nP) + " premium · " + str.tostring(nD) + " discount"
            table.cell(tb, 0, row, sumTxt, text_color = nD > nP ? discCol : nP > nD ? premCol : eqCol, text_halign = text.align_left, text_size = size.small)
            table.merge_cells(tb, 0, row, 3, row)
