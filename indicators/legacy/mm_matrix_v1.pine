//@version=6
indicator("MM MATRIX — Sponsorship, POI, Inducement", "MM MATRIX", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════ INPUTS ═════════════════════════════
gS = "1 · Structure"
sw      = input.int(5, "Swing length", minval = 2, group = gS)
bodyBOS = input.bool(true, "BOS requires candle BODY break", group = gS)
showBOS = input.bool(true, "Label BOS / CHoCH", group = gS)
showCode= input.bool(false, "Label RBD / DBR / RBR / DBD", group = gS)

gP = "2 · Points of interest"
poiDepth = input.int(25, "POI search depth (bars)", minval = 3, maxval = 100, group = gP)
bodyPOI  = input.bool(false, "POI from candle body only", group = gP)
reqInd   = input.bool(true,  "Require inducement to be swept first", group = gP)
reqPD    = input.bool(true,  "Require premium (sell) / discount (buy)", group = gP)
useBRK   = input.bool(true,  "Failed POI flips to breaker", group = gP)
poiLife  = input.int(400, "Max POI age (bars)", minval = 20, group = gP)
slTicks  = input.int(4, "Stop buffer (ticks beyond sponsorship)", minval = 0, group = gP)

gQ = "3 · Liquidity"
showEQ  = input.bool(true, "Equal highs / lows pools", group = gQ)
eqTol   = input.float(0.15, "Equal-level tolerance (ATR)", minval = 0.01, step = 0.05, group = gQ)
showPD  = input.bool(true, "Premium / discount", group = gQ)
showRR  = input.bool(true, "Draw stop / target on signal", group = gQ)

gC = "4 · Colours"
cS = input.color(#ef5350, "Supply", group = gC)
cD = input.color(#26a69a, "Demand", group = gC)
cB = input.color(#ffb74d, "Breaker", group = gC)

atr = ta.atr(14)
tick = syminfo.mintick

// ═════════════════════════════ TYPE ═════════════════════════════
type Zone
    box    bx
    float  top
    float  bot
    float  sl
    float  ind
    int    dir
    string kind
    int    birth
    bool   indTaken
    bool   fired
    bool   dead

var array<Zone> zones = array.new<Zone>()

// ══════════════════════════ STRUCTURE ══════════════════════════
ph = ta.pivothigh(high, sw, sw)
pl = ta.pivotlow(low,  sw, sw)

var float lastPH = na, var float lastPL = na
var float prevPH = na, var float prevPL = na
var bool  phLive = false, var bool plLive = false
var int   trend  = 0

if not na(ph)
    prevPH := lastPH
    lastPH := ph
    phLive := true
if not na(pl)
    prevPL := lastPL
    lastPL := pl
    plLive := true

brkUp = phLive and not na(lastPH) and (bodyBOS ? close > lastPH : high > lastPH)
brkDn = plLive and not na(lastPL) and (bodyBOS ? close < lastPL : low  < lastPL)

bool bosUp = false, bool bosDn = false
if brkUp
    bosUp  := true
    phLive := false
    trend  := 1
if brkDn
    bosDn  := true
    plLive := false
    trend  := -1

eqLine = na(lastPH) or na(lastPL) ? na : (lastPH + lastPL) / 2
premium  = not na(eqLine) and close > eqLine
discount = not na(eqLine) and close < eqLine

if showBOS and bosUp
    label.new(bar_index, low, trend[1] == -1 ? "CHoCH ▲" : "BOS ▲", style = label.style_label_up, yloc = yloc.belowbar,
         color = color.new(color.black, 100), textcolor = cD, size = size.tiny)
if showBOS and bosDn
    label.new(bar_index, high, trend[1] == 1 ? "CHoCH ▼" : "BOS ▼", style = label.style_label_down, yloc = yloc.abovebar,
         color = color.new(color.black, 100), textcolor = cS, size = size.tiny)

// RBD / DBR / RBR / DBD — base candle sits at [2]
up(int k) => close[k] > open[k]
dn(int k) => close[k] < open[k]
if showCode and bar_index > 5
    string code = na
    if up(4) and up(3) and dn(1) and dn(0)
        code := "RBD"
    else if dn(4) and dn(3) and up(1) and up(0)
        code := "DBR"
    else if up(4) and up(3) and up(1) and up(0)
        code := "RBR"
    else if dn(4) and dn(3) and dn(1) and dn(0)
        code := "DBD"
    if not na(code)
        label.new(bar_index - 2, low[2], code, style = label.style_label_up, yloc = yloc.belowbar,
             color = color.new(color.black, 100), textcolor = color.new(color.gray, 20), size = size.tiny)

// ══════════════════════ POI / SPONSORSHIP ══════════════════════
mkPOI(float t, float b, float sl, int d, string k) =>
    col = k == "BRK" ? cB : (d == -1 ? cS : cD)
    bx  = box.new(bar_index, t, bar_index + 2, b, border_color = col, border_width = 1, bgcolor = color.new(col, 86))
    array.push(zones, Zone.new(bx, t, b, sl, na, d, k, bar_index, false, false, false))
    if array.size(zones) > 70
        z0 = array.shift(zones)
        box.delete(z0.bx)

depth = math.min(poiDepth, bar_index)
if bosDn and depth > 1
    sponsor = ta.highest(high, depth)
    for k = 1 to depth
        if close[k] > open[k]
            t = bodyPOI ? math.max(open[k], close[k]) : high[k]
            b = bodyPOI ? math.min(open[k], close[k]) : low[k]
            mkPOI(t, b, sponsor + slTicks * tick, -1, "POI")
            break
if bosUp and depth > 1
    sponsor = ta.lowest(low, depth)
    for k = 1 to depth
        if close[k] < open[k]
            t = bodyPOI ? math.max(open[k], close[k]) : high[k]
            b = bodyPOI ? math.min(open[k], close[k]) : low[k]
            mkPOI(t, b, sponsor - slTicks * tick, 1, "POI")
            break

// ════════════════════════ ZONE ENGINE ════════════════════════
bool   sellSig = false
bool   buySig  = false
float  sigSL   = na
string sigType = ""

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)
        if not z.dead
            box.set_right(z.bx, bar_index + 2)

            // inducement bookkeeping
            if z.dir == -1
                if not na(ph) and ph < z.bot
                    z.ind := ph
                if not na(z.ind) and high > z.ind
                    z.indTaken := true
            else
                if not na(pl) and pl > z.top
                    z.ind := pl
                if not na(z.ind) and low < z.ind
                    z.indTaken := true

            broke = (z.dir == -1 and close > z.top) or (z.dir == 1 and close < z.bot)
            if broke
                if useBRK and z.kind != "BRK"
                    z.kind     := "BRK"
                    z.dir      := z.dir * -1
                    z.fired    := false
                    z.indTaken := false
                    z.ind      := na
                    z.birth    := bar_index
                    z.sl       := z.dir == -1 ? z.top + slTicks * tick : z.bot - slTicks * tick
                    box.set_border_color(z.bx, cB)
                    box.set_bgcolor(z.bx, color.new(cB, 86))
                else
                    z.dead := true
                    box.set_right(z.bx, bar_index)
                    box.set_bgcolor(z.bx, color.new(color.gray, 93))
                    box.set_border_color(z.bx, color.new(color.gray, 60))
            else if bar_index - z.birth > poiLife
                z.dead := true
                box.set_right(z.bx, bar_index)
            else if not z.fired and bar_index > z.birth + 1
                tapped = high >= z.bot and low <= z.top
                indOK  = z.indTaken or not reqInd
                if tapped and indOK and z.dir == -1 and close < open and (not reqPD or premium)
                    z.fired := true
                    sellSig := true
                    sigSL   := z.sl
                    sigType := z.indTaken ? (z.kind == "BRK" ? "BRK+IDM" : "Type 3") : (z.kind == "BRK" ? "BRK" : "Type 1")
                if tapped and indOK and z.dir == 1 and close > open and (not reqPD or discount)
                    z.fired := true
                    buySig  := true
                    sigSL   := z.sl
                    sigType := z.indTaken ? (z.kind == "BRK" ? "BRK+IDM" : "Type 3") : (z.kind == "BRK" ? "BRK" : "Type 1")

// ═══════════════════════ LIQUIDITY POOLS ═══════════════════════
if showEQ and not na(ph) and not na(prevPH) and math.abs(ph - prevPH) <= eqTol * atr
    line.new(bar_index - sw, ph, bar_index + 10, ph, color = color.new(cS, 30), style = line.style_dashed)
    label.new(bar_index + 10, ph, "$$$", style = label.style_label_left, color = color.new(color.black, 100),
         textcolor = cS, size = size.tiny)
if showEQ and not na(pl) and not na(prevPL) and math.abs(pl - prevPL) <= eqTol * atr
    line.new(bar_index - sw, pl, bar_index + 10, pl, color = color.new(cD, 30), style = line.style_dashed)
    label.new(bar_index + 10, pl, "$$$", style = label.style_label_left, color = color.new(color.black, 100),
         textcolor = cD, size = size.tiny)

// ═════════════════════════ RISK DISPLAY ═════════════════════════
if showRR and (sellSig or buySig) and not na(sigSL)
    tgt = sellSig ? lastPL : lastPH
    if not na(tgt)
        line.new(bar_index, sigSL, bar_index + 20, sigSL, color = color.new(color.red, 20), style = line.style_solid, width = 1)
        line.new(bar_index, tgt,   bar_index + 20, tgt,   color = color.new(color.green, 20), style = line.style_solid, width = 1)
        risk = math.abs(close - sigSL)
        rew  = math.abs(tgt - close)
        rr   = risk > 0 ? rew / risk : na
        label.new(bar_index + 20, tgt, (na(rr) ? "" : str.tostring(rr, "#.#") + "R") + " · " + sigType,
             style = label.style_label_left, color = color.new(color.black, 100),
             textcolor = sellSig ? cS : cD, size = size.tiny)

if sellSig
    label.new(bar_index, high, "MM ▼", style = label.style_label_down, yloc = yloc.abovebar,
         color = color.new(cS, 20), textcolor = color.white, size = size.tiny)
if buySig
    label.new(bar_index, low, "MM ▲", style = label.style_label_up, yloc = yloc.belowbar,
         color = color.new(cD, 20), textcolor = color.white, size = size.tiny)

plotshape(sellSig, "Sell", shape.triangledown, location.abovebar, cS, size = size.small)
plotshape(buySig,  "Buy",  shape.triangleup,   location.belowbar, cD, size = size.small)

// premium / discount
var line eqLn = na
if showPD and not na(eqLine)
    if na(eqLn)
        eqLn := line.new(bar_index, eqLine, bar_index + 3, eqLine, color = color.new(color.gray, 40), style = line.style_dashed)
    line.set_y1(eqLn, eqLine)
    line.set_y2(eqLn, eqLine)
    line.set_x1(eqLn, bar_index - 60)
    line.set_x2(eqLn, bar_index + 3)

// ═══════════════════════════ DASHBOARD ═══════════════════════════
var table t = table.new(position.bottom_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "MM MATRIX", text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.tiny)
    table.cell(t, 1, 0, timeframe.period, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.tiny)
    table.cell(t, 0, 1, "Structure", text_size = size.tiny, text_color = color.gray)
    table.cell(t, 1, 1, trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "flat", text_size = size.tiny,
         text_color = trend == 1 ? cD : trend == -1 ? cS : color.gray)
    table.cell(t, 0, 2, "Location", text_size = size.tiny, text_color = color.gray)
    table.cell(t, 1, 2, premium ? "premium" : discount ? "discount" : "eq", text_size = size.tiny, text_color = color.white)
    int live = 0
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            if not array.get(zones, i).dead
                live += 1
    table.cell(t, 0, 3, "Live POIs", text_size = size.tiny, text_color = color.gray)
    table.cell(t, 1, 3, str.tostring(live), text_size = size.tiny, text_color = color.white)

alertcondition(sellSig, "MM MATRIX sell", "MM MATRIX: supply POI mitigated")
alertcondition(buySig,  "MM MATRIX buy",  "MM MATRIX: demand POI mitigated")
