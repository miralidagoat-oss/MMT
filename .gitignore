__pycache__/
*.pyc
data_po3/
data_holdout/
data/
data_long/
# Bar files are large and refetchable from a pinned date window; the
# PROVENANCE.json beside them is neither, so it stays tracked.
# (gitignore has no inline comments - a trailing # becomes part of the pattern.)
data_ndx/*.csv
data_ndx_q/*.csv
data_nq/*.csv

# ── secrets: never commit credentials or anything that could carry them ─────
.env
.env.*
*.env
secrets/
*.key
*.pem
*credentials*
*api_key*
*apikey*
.databento
databento.json
